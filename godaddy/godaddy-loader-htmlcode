<div id="eikon-embed-root" style="width:100%;max-width:1200px;margin:0 auto;">
  <div id="eikon-embed-loader" style="font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;padding:14px;border:1px solid #ddd;border-radius:14px;background:#fff;color:#111;">
    <div style="font-weight:900;font-size:16px;margin-bottom:6px;">Eikon</div>
    <div style="opacity:.75;">Loading…</div>
  </div>
</div>

<script>
(function () {
  "use strict";

  try {
    // ── Fix GoDaddy's sandbox ────────────────────────────────────────────
    // GoDaddy wraps custom HTML blocks in a sandboxed iframe with
    // allow-scripts + allow-same-origin. That combination lets us modify
    // our own sandbox (the browser even warns about this). We add the
    // missing permissions so downloads, popups, and forms work properly.
    try {
      var fe = window.frameElement;
      if (fe && fe.getAttribute("sandbox") !== null) {
        var needed = ["allow-downloads", "allow-popups", "allow-popups-to-escape-sandbox",
                      "allow-forms", "allow-modals", "allow-top-navigation-by-user-activation"];
        var sb = fe.sandbox;
        for (var ni = 0; ni < needed.length; ni++) {
          if (!sb.contains(needed[ni])) {
            sb.add(needed[ni]);
            console.log("[EIKON][godaddy] sandbox: added " + needed[ni]);
          }
        }
        console.log("[EIKON][godaddy] sandbox fixed:", fe.getAttribute("sandbox"));
      } else {
        console.log("[EIKON][godaddy] no sandbox detected on frameElement");
      }
    } catch (sbErr) {
      console.warn("[EIKON][godaddy] could not modify sandbox:", sbErr);
    }

    if (window.__EIKON_EMBEDDED__) {
      console.warn("[EIKON][godaddy] embed already mounted in this document, skipping");
      return;
    }
    window.__EIKON_EMBEDDED__ = true;

    var root = document.getElementById("eikon-embed-root");
    var loader = document.getElementById("eikon-embed-loader");
    if (!root) {
      console.error("[EIKON][godaddy] missing eikon-embed-root");
      return;
    }

    // Listen for logs forwarded from iframe (dbg=2 only)
    window.addEventListener("message", function (ev) {
      try {
        if (!ev || !ev.data) return;

        if (ev.data.type === "EIKON_LOG") {
          var lvl = ev.data.level || "log";
          var msg = "[EIKON][iframe][" + (ev.data.time || "") + "] " + (ev.data.msg || "");
          if (lvl === "error") console.error(msg);
          else if (lvl === "warn") console.warn(msg);
          else console.log(msg);
        }

        // ── Download delegation ─────────────────────────────────────────
        // The inner cross-origin iframe cannot trigger downloads due to
        // browser restrictions. It sends us the file content via postMessage
        // and we perform the download from this context (level 2) which has
        // allow-downloads on its sandbox.
        if (ev.data.type === "EIKON_DOWNLOAD") {
          console.log("[EIKON][godaddy] download request:", ev.data.filename);
          try {
            var blob = new Blob([ev.data.content], { type: ev.data.mimeType || "application/octet-stream" });
            var dlUrl = URL.createObjectURL(blob);
            var dlA = document.createElement("a");
            dlA.href = dlUrl;
            dlA.download = ev.data.filename || "download";
            dlA.style.display = "none";
            document.body.appendChild(dlA);
            dlA.click();
            console.log("[EIKON][godaddy] download triggered:", ev.data.filename);
            setTimeout(function () {
              document.body.removeChild(dlA);
              URL.revokeObjectURL(dlUrl);
            }, 500);
          } catch (dlErr) {
            console.error("[EIKON][godaddy] download failed:", dlErr);
          }
        }
      } catch (e) {}
    });

    var base = "https://eikon-api.labrint.workers.dev/ui/index.html";
    var v = Date.now();

    var hash = "#temperature";
    try {
      if (window.location.hash && window.location.hash.length > 1) {
        hash = window.location.hash;
      }
    } catch (e) {}

    var src = base + "?v=" + encodeURIComponent(String(v)) + "&dbg=2" + hash;

    console.log("[EIKON][godaddy] loading iframe:", src);

    var iframe = document.createElement("iframe");
    iframe.src = src;

    // IMPORTANT:
    // Do NOT set sandbox here. Sandboxing is what is blocking downloads.
    // Leaving it unset allows normal browser download behavior.
    // iframe.setAttribute("sandbox", "...");  // <-- intentionally removed

    iframe.allow = "clipboard-read; clipboard-write";
    iframe.loading = "lazy";
    iframe.referrerPolicy = "no-referrer";

    iframe.style.width = "100%";
    iframe.style.height = "85vh";
    iframe.style.minHeight = "720px";
    iframe.style.border = "0";
    iframe.style.borderRadius = "14px";
    iframe.style.background = "#0b0f14";

    iframe.onload = function () {
      console.log("[EIKON][godaddy] iframe loaded OK");
      if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
    };

    iframe.onerror = function (e) {
      console.error("[EIKON][godaddy] iframe load error:", e);
      if (loader) {
        loader.innerHTML =
          '<div style="font-weight:900;font-size:16px;margin-bottom:6px;color:#b00020;">Eikon failed to load</div>' +
          '<div style="opacity:.75;">Check browser console for details.</div>';
      }
    };

    root.appendChild(iframe);
  } catch (err) {
    console.error("[EIKON][godaddy] embed crash:", err);
  }
})();
</script>
