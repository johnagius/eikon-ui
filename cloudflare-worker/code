async function handleScarceOfferRequestCreate(request, env, corsOkHeaders, authUser, offerId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureScarceStockSchema(env);

  const id = Number(offerId);
  if (!Number.isFinite(id) || id <= 0) return jsonResponse({ ok: false, error: "Invalid offer id" }, 400, corsOkHeaders);

  const offer = await dbFirst(env, `SELECT id, is_closed, org_id, location_id, quantity_available FROM scarce_stock_offers WHERE id = ?`, [id]);
  if (!offer || !ssSameGroup(authUser, offer.org_id)) return jsonResponse({ ok: false, error: "Offer not found" }, 404, corsOkHeaders); // W4: another group's offer is not there for this pharmacy
  if (Number(offer.is_closed || 0) === 1) return jsonResponse({ ok: false, error: "Offer is closed" }, 400, corsOkHeaders);
  if (offer.org_id === authUser.org_id && offer.location_id === authUser.location_id) {
    return jsonResponse({ ok: false, error: "You cannot request your own offer" }, 400, corsOkHeaders);
  }

  const body = await readJson(request);
  const qty = ssIntNonNeg(body.quantity_requested);
  const note = ssText(body.note, 4000);

  if (qty === null || qty <= 0) return jsonResponse({ ok: false, error: "Invalid quantity_requested (>= 1)" }, 400, corsOkHeaders);

  // Never request more than is left.
  const reqSum = await dbFirst(env, "SELECT COALESCE(SUM(quantity_requested), 0) AS total FROM scarce_stock_offer_requests WHERE offer_id = ?", [id]);
  const left = Number(offer.quantity_available || 0) - Number(reqSum?.total || 0);
  if (qty > left) return jsonResponse({ ok: false, error: left > 0 ? ("Only " + left + " left on this offer") : "Nothing left on this offer" }, 400, corsOkHeaders);

  const res = await dbRun(env, `
    INSERT INTO scarce_stock_offer_requests
      (offer_id, requester_org_id, requester_location_id, quantity_requested, note, created_by, created_at, updated_at, updated_by)
    VALUES (?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'), ?)
  `, [
    id, authUser.org_id, authUser.location_id,
    qty, note,
    authUser.user_id, authUser.user_id
  ]);

  const insertedId = res?.meta?.last_row_id || null;
  await writeAudit(env, authUser.org_id, authUser.user_id, "SCARCE_REQUEST_CREATE", "scarce_stock_offer_requests", String(insertedId || ""), { offer_id: id, quantity_requested: qty }, authUser.location_id);

  // Check if stock is fully requested — auto-delete linked near expiry item
  await checkScarceStockDepletion(env, id, authUser);

  return jsonResponse({ ok: true, id: insertedId }, 200, corsOkHeaders);
}

