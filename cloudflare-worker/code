// ----- Delete transfer item (cascades: removes linked returns/scarce stock entries, cancels pending requests)
async function handleStockTransferItemDelete(request, env, corsOkHeaders, authUser, itemId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const existing = await dbFirst(env, "SELECT * FROM stock_transfer_items WHERE id = ?", [itemId]);
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  if (existing.org_id !== authUser.org_id || existing.location_id !== authUser.location_id) {
    return jsonResponse({ ok: false, error: "Forbidden: not your item" }, 403, corsOkHeaders);
  }

  // Remove linked returns entry if placed via transfer
  if (existing.placed_on_returns && existing.placed_on_returns_id) {
    await dbRun(env, "DELETE FROM returns_entries WHERE id = ? AND org_id = ? AND location_id = ?",
      [existing.placed_on_returns_id, authUser.org_id, authUser.location_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "RETURNS_AUTO_DELETE", "returns_entries", String(existing.placed_on_returns_id), { reason: "transfer_item_removed", transfer_item_id: itemId }, authUser.location_id);
  }

  // Remove linked scarce stock offer if placed via transfer
  if (existing.placed_on_scarce_stock && existing.placed_on_scarce_stock_id) {
    await dbRun(env, "DELETE FROM scarce_stock_offer_requests WHERE offer_id = ?", [existing.placed_on_scarce_stock_id]);
    await dbRun(env, "DELETE FROM scarce_stock_offers WHERE id = ? AND org_id = ? AND location_id = ?",
      [existing.placed_on_scarce_stock_id, authUser.org_id, authUser.location_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "SCARCE_OFFER_AUTO_DELETE", "scarce_stock_offers", String(existing.placed_on_scarce_stock_id), { reason: "transfer_item_removed", transfer_item_id: itemId }, authUser.location_id);
  }

  // Delete all requests for this item
  await dbRun(env, "DELETE FROM stock_transfer_requests WHERE item_id = ?", [itemId]);
  // Delete the item
  await dbRun(env, "DELETE FROM stock_transfer_items WHERE id = ?", [itemId]);

  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_DELETE", "stock_transfer_items", String(itemId), { item_description: existing.item_description }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

// ----- Create transfer request
async function handleStockTransferRequestCreate(request, env, corsOkHeaders, authUser, itemId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const item = await dbFirst(env, "SELECT * FROM stock_transfer_items WHERE id = ?", [itemId]);
  if (!item) return jsonResponse({ ok: false, error: "Item not found" }, 404, corsOkHeaders);
  if (item.is_closed) return jsonResponse({ ok: false, error: "Item is closed" }, 400, corsOkHeaders);

  // Cannot request from own location
  if (item.org_id === authUser.org_id && item.location_id === authUser.location_id) {
    return jsonResponse({ ok: false, error: "Cannot request transfer from your own location" }, 400, corsOkHeaders);
  }

  // Must be same org
  if (item.org_id !== authUser.org_id) {
    return jsonResponse({ ok: false, error: "Item not visible to your organisation" }, 403, corsOkHeaders);
  }

  // Check expiry
  if (item.expiry_date && item.expiry_date < todayYmdSt()) {
    return jsonResponse({ ok: false, error: "Item is expired" }, 400, corsOkHeaders);
  }

  const body = await readJson(request);
  const qty = stInt(body.quantity_requested);
  const note = stText(body.note, 1000);

  if (qty === null || qty < 1) return jsonResponse({ ok: false, error: "quantity_requested must be at least 1" }, 400, corsOkHeaders);

  // Check remaining quantity (only count delivered as actually consumed)
  const delivered = await dbFirst(env,
    "SELECT COALESCE(SUM(quantity_requested), 0) AS total FROM stock_transfer_requests WHERE item_id = ? AND status = 'delivered'",
    [itemId]);
  const remaining = (item.quantity_available || 0) - (delivered?.total || 0);
  if (qty > remaining) return jsonResponse({ ok: false, error: "Requested quantity exceeds available (" + remaining + " remaining)" }, 400, corsOkHeaders);

  const res = await dbRun(env, `
    INSERT INTO stock_transfer_requests (item_id, requester_org_id, requester_location_id, quantity_requested, note, status, created_by, updated_by)
    VALUES (?, ?, ?, ?, ?, 'pending', ?, ?)
  `, [itemId, authUser.org_id, authUser.location_id, qty, note, authUser.user_id, authUser.user_id]);

  const newId = res.meta?.last_row_id || null;
  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_REQUEST_CREATE", "stock_transfer_requests", String(newId), { item_id: itemId, quantity: qty }, authUser.location_id);

  return jsonResponse({ ok: true, id: newId }, 201, corsOkHeaders);
}

