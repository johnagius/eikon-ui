// Wipes the old values of erasures whose undo window has passed. Never creates a table (no table: nothing to do).
// Called from scheduled() and from every privacy route; reads one indexed row when nothing is due.
async function gdprPurgeExpired(env) {
  let due = [];
  try { due = await dbAll(env, "SELECT erasure_id FROM gdpr_erasures WHERE purged_at IS NULL AND undo_until < datetime('now') LIMIT 20", []); } catch (e) { return 0; }
  for (const d of due) {
    await env.DB.batch([
      env.DB.prepare("DELETE FROM gdpr_erasure_rows WHERE erasure_id = ?").bind(d.erasure_id),
      env.DB.prepare("UPDATE gdpr_erasures SET purged_at = datetime('now'), status = CASE WHEN status = 'done' THEN 'final' ELSE status END WHERE erasure_id = ? AND purged_at IS NULL").bind(d.erasure_id)
