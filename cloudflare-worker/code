async function ensureQuotationsSchema__impl(env) {
  // Flat table — each row is one quotation line (supplier is just a column)
  await dbRun(env, `CREATE TABLE IF NOT EXISTS quotation_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    supplier TEXT NOT NULL DEFAULT '',
    barcode TEXT NOT NULL DEFAULT '',
    stock_code TEXT NOT NULL DEFAULT '',
    item_description TEXT NOT NULL DEFAULT '',
    qty_purchased INTEGER NOT NULL DEFAULT 1,
    qty_free INTEGER NOT NULL DEFAULT 0,
    vat_rate REAL NOT NULL DEFAULT 18,
    cost_excl_vat REAL NOT NULL DEFAULT 0,
    cost_incl_vat REAL NOT NULL DEFAULT 0,
    discount_pct REAL NOT NULL DEFAULT 0,
    discount_euro REAL NOT NULL DEFAULT 0,
    total_incl_vat REAL NOT NULL DEFAULT 0,
    retail_price REAL NOT NULL DEFAULT 0,
    profit REAL NOT NULL DEFAULT 0,
    profit_margin REAL NOT NULL DEFAULT 0,
    quote_date TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    created_by INTEGER,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);

  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_quotation_entries_org_loc_date ON quotation_entries (org_id, location_id, quote_date)`, []);
}

function normalizeVatRate(v) {
  const n = Number(v);
  if (n === 0 || n === 5 || n === 18) return n;
  return 18;
}

function computeItemProfitFields(body) {
  const vatRate = normalizeVatRate(body.vat_rate);
  const mult = 1 + vatRate / 100;
  const costExcl = Math.max(0, Number(body.cost_excl_vat) || 0);
  const costIncl = Math.max(0, Number(body.cost_incl_vat) || 0);
  const discEuro = Math.max(0, Number(body.discount_euro) || 0);
  const discPct = Math.max(0, Number(body.discount_pct) || 0);
  const qtyPurchased = Math.max(1, Math.round(Number(body.qty_purchased) || 1));
  const qtyFree = Math.max(0, Math.round(Number(body.qty_free) || 0));
  const retailPrice = Math.max(0, Number(body.retail_price) || 0);

  const effExcl = Math.max(0, costExcl - discEuro);
  const effIncl = vatRate === 0 ? effExcl : effExcl * mult;
  const totalInclVat = Math.round(effIncl * qtyPurchased * 100) / 100;
  const totalRetail = retailPrice * (qtyPurchased + qtyFree);
  // Profit uses cost EXCL VAT — input VAT is reclaimed by the business
  const profit = Math.round((totalRetail - effExcl * qtyPurchased) * 100) / 100;
  const profitMargin = totalRetail > 0 ? Math.round((profit / totalRetail) * 10000) / 100 : 0;

  return {
    cost_excl_vat: Math.round(costExcl * 100) / 100,
    cost_incl_vat: Math.round(costIncl * 100) / 100,
    discount_pct: Math.round(discPct * 100) / 100,
    discount_euro: Math.round(discEuro * 100) / 100,
    total_incl_vat: totalInclVat,
    retail_price: Math.round(retailPrice * 100) / 100,
    profit: profit,
    profit_margin: profitMargin
  };
}

async function handleQuotationsEntriesList(request, env, corsOkHeaders, authUser, url) {
  await ensureQuotationsSchema(env);

  const q = (url.searchParams.get("q") || "").trim();
  const allOrg = url.searchParams.get("all_org") === "1";

  const sql = allOrg
    ? `SELECT e.*, l.name AS location_name, u.full_name AS created_by_name
       FROM quotation_entries e
       LEFT JOIN locations l ON l.id = e.location_id
       LEFT JOIN users u ON u.id = e.created_by
       WHERE e.org_id = ?
       ORDER BY e.quote_date DESC, e.id DESC`
    : `SELECT e.*, l.name AS location_name, u.full_name AS created_by_name
       FROM quotation_entries e
       LEFT JOIN locations l ON l.id = e.location_id
       LEFT JOIN users u ON u.id = e.created_by
       WHERE e.org_id = ? AND e.location_id = ?
       ORDER BY e.quote_date DESC, e.id DESC`;
  const bind = allOrg ? [authUser.org_id] : [authUser.org_id, authUser.location_id];

  let entries = await dbAll(env, sql, bind);

  if (q) {
    const qLow = q.toLowerCase();
    entries = entries.filter(row =>
      (row.supplier || "").toLowerCase().includes(qLow) ||
      (row.item_description || "").toLowerCase().includes(qLow) ||
      (row.barcode || "").toLowerCase().includes(qLow) ||
      (row.stock_code || "").toLowerCase().includes(qLow) ||
      (row.quote_date || "").toLowerCase().includes(qLow) ||
      (row.notes || "").toLowerCase().includes(qLow)
    );
  }

  return jsonResponse({ ok: true, entries }, 200, corsOkHeaders);
}

