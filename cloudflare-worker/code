  const lastNote = (j) => { try { const a = JSON.parse(j || "[]"); const l = Array.isArray(a) ? a[a.length - 1] : null; return l && l.text ? String(l.text).slice(0, 300) : ""; } catch (e) { return ""; } };
  return jsonResponse({ ok: true, person, today,
    waiting: {
      orders: orders.map((o) => ({ id: o.id, code: o.order_code || "", items: o.items_text || "", order_date: o.order_date || "", needed_by: o.needed_by || "", pickup_date: o.pickup_date || "", priority: Number(o.priority) || 2, follow_up: o.follow_up_status || "" })),
      ready: ready.map((o) => ({ id: o.id, code: o.order_code || "", items: o.items_text || "", order_date: o.order_date || "", ready_at: o.fulfilled_at || "" })),
      questions: questions.map((t) => ({ id: t.id, ref: t.ticket_id || "", issue: t.issue || "", status: t.status || "Open", open_date: t.open_date || "", followup_date: t.followup_date || "", done: !!Number(t.resolved) || t.status === "Resolved" || t.status === "Closed", done_at: t.resolved_at || "", last_note: lastNote(t.notes_log) })),
      deliveries: deliveries.map((d) => ({ id: d.id, ref: d.delivery_id || "", items: d.items || "", status: d.status || "", date: d.scheduled_date || d.order_date || "", slot: d.scheduled_time_slot || "", address: d.delivery_address || "" })),
      repeats, bookings: bookings.map((b) => ({ id: b.id, ref: b.ref || "", date: b.date, time: b.start_time, status: b.status, service: b.service || "" }))
    },
    activity: activity.slice(0, 80), counts,
    profile: cmProfileOut(prof), messages: msgs.map(cmMsgOut),
    email: { ready: email.ready, why: email.why, opted_out: optedOut }, pharmacy }, 200, cors);
