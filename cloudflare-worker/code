async function handlePharmacyDetailsPut(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin"])) return jsonResponse({ ok: false, error: "Only the pharmacy's admin can change its details." }, 403, corsOkHeaders);
  await ensureLabelsSchema(env);
