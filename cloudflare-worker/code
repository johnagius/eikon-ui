// Superuser actions are audited under the TARGET org (and location when there is one), naming the superuser.
const SU_ACTOR = new WeakMap();
function suUserSafe(u) {
  if (!u) return u;
  const o = Object.assign({}, u); delete o.pass_salt_b64; delete o.pass_hash_b64; delete o.pass_iters; return o;
}
async function suAudit(request, env, orgId, locationId, action, entityType, entityId, details) {
  const su = SU_ACTOR.get(request) || null;
  await writeAudit(env, orgId == null ? 0 : orgId, su ? su.user_id : null, action, entityType, String(entityId == null ? "" : entityId),
    Object.assign({ superuser: su ? su.email : null }, details || {}), locationId);
}
// Rows per table for one location, read before a wipe so the audit says what went.
async function suLocationCounts(env, tables, locationId) {
  const out = {};
  for (const t of tables) { try { const r = await dbFirst(env, `SELECT COUNT(1) AS c FROM ${t} WHERE location_id=?`, [locationId]); if (r && r.c) out[t] = r.c; } catch (e) {} }
  return out;
}

