  const pharmacy = (loc && loc.name) || "Pharmacy", svcName = (svc && svc.name) || "Appointment";
  const base = `/b/${m[1]}`;

  if (m[2] === ".ics") return new Response(bkIcs(b, svcName, pharmacy), { headers: { "Content-Type": "text/calendar; charset=utf-8", "Content-Disposition": "attachment; filename=booking.ics", "Cache-Control": "no-store" } });

