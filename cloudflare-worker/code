function normalizeMoneyPositive(v) {
  const n = Number(v);
  if (!Number.isFinite(n) || n <= 0) return null;
  // Keep 2dp for storage (avoid floating junk)
  return Math.round(n * 100) / 100;
}

function normalizePaidOutMethod(v) {
  const s = String(v || "").trim().toLowerCase();
  return (s === "cheque") ? "cheque" : "cash";
}

async function ensurePaidOutSchema__impl(env) {
  // Paid Out schema is created lazily on first use.
  // IMPORTANT: D1 does not change an existing table when you update the CREATE TABLE statement.
  // So we also run a tiny migration to add any missing columns (e.g. older deployments).
  await dbRun(env, `
    CREATE TABLE IF NOT EXISTS paid_out_entries (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      org_id INTEGER NOT NULL,
      location_id INTEGER NOT NULL,
      entry_date TEXT NOT NULL,
      entry_time TEXT NOT NULL,
      payee_name TEXT NOT NULL,
      fee REAL NOT NULL,
      payment_method TEXT NOT NULL DEFAULT 'cash',
      invoice_no TEXT NOT NULL DEFAULT '',
      cheque_no TEXT NOT NULL DEFAULT '',
      reason TEXT NOT NULL DEFAULT '',
      created_by INTEGER,
      created_at TEXT NOT NULL DEFAULT (datetime('now')),
      updated_at TEXT NOT NULL DEFAULT (datetime('now')),
      updated_by INTEGER
    )
  `, []);

  // --- Migration: add missing columns safely (ignore "duplicate column name" errors) ---
  const cols = await dbAll(env, "PRAGMA table_info(paid_out_entries)", []);
  const colNames = new Set((cols || []).map((c) => String(c && c.name || "").trim()).filter(Boolean));

  async function addColIfMissing(colName, colDefSql) {
    if (colNames.has(colName)) return;
    try {
      await dbRun(env, `ALTER TABLE paid_out_entries ADD COLUMN ${colDefSql}`, []);
    } catch (e) {
      // In rare cases of concurrent requests, another request may add the column first.
      // SQLite will then throw "duplicate column name" — safe to ignore.
    }
    colNames.add(colName);
  }

  // Keep this list minimal + backwards compatible.
  await addColIfMissing("updated_by", "updated_by INTEGER");
  await addColIfMissing("updated_at", "updated_at TEXT");

  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_paid_out_org_loc_date ON paid_out_entries (org_id, location_id, entry_date)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_paid_out_org_loc_name ON paid_out_entries (org_id, location_id, payee_name)", []);
}

function paidOutRowToUi(r) {
  if (!r) return null;
  return {
    id: r.id,
    entry_date: r.entry_date,
    entry_time: r.entry_time,
    payee_name: r.payee_name,
    fee: r.fee,
    payment_method: r.payment_method || "cash",
    invoice_no: r.invoice_no || "",
    cheque_no: r.cheque_no || "",
    reason: r.reason || "",
    created_by: r.created_by,
    created_at: r.created_at,
    updated_at: r.updated_at
  };
}

