  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await ensureNearExpirySchema(env);

  const q = (url.searchParams.get("q") || "").trim();
  const hasQ = !!q;
  const qLike = `%${q}%`;

  const includeReturned = String(url.searchParams.get("include_returned") || "").trim() === "1";

  const sql = `
    SELECT
      ne.id,
      ne.product_name,
      ne.expiry_date,
      ne.location,
      ne.notes,
      ne.return_id,
      ne.return_status,
      ne.scarce_stock_offer_id,
      COALESCE(ret.supplier_refused, 0) AS supplier_refused,
      COALESCE(ret.damaged, 0) AS damaged,
      ne.created_by,
      ne.created_at,
      ne.updated_at,
      ne.updated_by
    FROM near_expiry_entries ne
    LEFT JOIN returns_entries ret ON ret.id = ne.return_id
    WHERE ne.org_id = ?
      AND ne.location_id = ?
      ${!includeReturned ? "AND ne.return_status != 'handed_over'" : ""}
      ${hasQ ? `AND (
        ne.product_name LIKE ?
        OR ne.expiry_date LIKE ?
        OR ne.location LIKE ?
        OR ne.notes LIKE ?
      )` : ""}
    ORDER BY ne.expiry_date ASC, ne.product_name ASC, ne.id DESC
  `;

  const bind = [authUser.org_id, authUser.location_id];
  if (hasQ) bind.push(qLike, qLike, qLike, qLike);

  const rows = await dbAll(env, sql, bind);
  const entries = rows.map(nearExpiryRowToUi);
  return jsonResponse({ ok: true, entries }, 200, corsOkHeaders);
