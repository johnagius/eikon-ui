  return 0;
}
async function bkRoomNameFor(env, booking) {
  const p = await dbFirst(env, `SELECT hours_json FROM bk_providers WHERE id=?`, [booking.provider_id]);
  const rid = p ? bkRoomIdFor(bkJson(p.hours_json, {}), booking.date, booking.start_time) : 0;
  if (!rid) return "";
  const r = await dbFirst(env, `SELECT name FROM bk_rooms WHERE id=? AND org_id=? AND location_id=?`, [rid, booking.org_id, booking.location_id]);
  return r ? r.name : "";
}
function bkProviderLabel(p) { return [p.title, p.name].filter(Boolean).join(" "); }
function bkBookingRow(r) {
  return { id: r.id, ref: r.ref, serviceId: r.service_id, providerId: r.provider_id, personName: r.person_name,
    personPhone: r.person_phone, personEmail: r.person_email, personIdCard: r.person_id_card, date: r.date,
    start: r.start_time, end: r.end_time, status: r.status, priceCents: r.price_cents, notes: r.notes,
    cancelReason: r.cancel_reason, version: r.version, createdAt: r.created_at, updatedAt: r.updated_at,
