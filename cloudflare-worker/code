// The month at a glance (till, money batch): one grouped read on the (org, location, sale_date) index, a row per day
// with sales. Voided sales are left out of the money (as the day list adds them) and counted apart. Read only.
async function handlePosSalesDays(request, env, corsOkHeaders, authUser, url) {
  await ensurePosSchema(env);
  const month = (url.searchParams.get("month") || "").trim() || tzYmd().slice(0, 7);
  if (!/^\d{4}-\d{2}$/.test(month)) return jsonResponse({ ok: false, error: "month must be YYYY-MM" }, 400, corsOkHeaders);
  const rows = await dbAll(env, `SELECT sale_date,
      SUM(CASE WHEN COALESCE(voided,0)=1 THEN 0 ELSE 1 END) AS sales,
      SUM(CASE WHEN COALESCE(voided,0)=1 THEN 1 ELSE 0 END) AS voided,
      ROUND(SUM(CASE WHEN COALESCE(voided,0)=1 THEN 0 ELSE total END), 2) AS total,
      ROUND(SUM(CASE WHEN COALESCE(voided,0)<>1 AND payment_method='cash' THEN total ELSE 0 END), 2) AS cash,
      ROUND(SUM(CASE WHEN COALESCE(voided,0)<>1 AND payment_method='card' THEN total ELSE 0 END), 2) AS card,
      ROUND(SUM(CASE WHEN COALESCE(voided,0)<>1 AND payment_method='other' THEN total ELSE 0 END), 2) AS other,
      ROUND(SUM(CASE WHEN COALESCE(voided,0)=1 THEN 0 ELSE vat_total END), 2) AS vat
    FROM pos_sales WHERE org_id=? AND location_id=? AND sale_date>=? AND sale_date<=?
    GROUP BY sale_date ORDER BY sale_date DESC`,
    [authUser.org_id, authUser.location_id, month + "-01", month + "-31"]);
  return jsonResponse({ ok: true, month, days: rows }, 200, corsOkHeaders);
}

// The server computes the money of a sale from its lines; it never trusts client totals.
// VAT is extracted from VAT-inclusive prices and reduced by the discount (max 10 %).
function posComputeSale(body) {
  const r2 = (n) => Math.round((Number(n) || 0) * 100) / 100;
  const items = Array.isArray(body.items) ? body.items : [];
  let subtotal = 0, vat = 0;
  for (const it of items) {
    const qty = Number(it && it.qty) || 0;
    const price = Number(it && it.price) || 0;
    const line = r2(qty * price);
    subtotal = r2(subtotal + line);
    const rate = Number(it && it.vat_rate) || 0;
    if (rate > 0) vat = r2(vat + r2(line - line / (1 + rate / 100)));
  }
  const discountPct = Math.min(10, Math.max(0, Number(body.discount_pct) || 0));
  const discountAmt = r2(subtotal * discountPct / 100);
  const total = r2(subtotal - discountAmt);
  const vatTotal = r2(vat * (1 - discountPct / 100));
  const paymentMethod = String(body.payment_method || "").trim().toLowerCase() || "cash";
  const tendered = body.amount_tendered != null && body.amount_tendered !== "" ? r2(body.amount_tendered) : null;
  const short = paymentMethod === "cash" && (tendered == null || tendered + 0.005 < total);
  const change = paymentMethod === "cash" && tendered != null ? r2(tendered - total) : null;
  return { subtotal, vatTotal, discountPct, discountAmt, total, paymentMethod, tendered, change, short };
}

async function handlePosSaleCreate(request, env, corsOkHeaders, authUser) {
  await ensurePosSchema(env);
  const body = await readJson(request);
  const saleDate = String(body.sale_date || "").trim() || tzYmd();
  const receiptNo = String(body.receipt_no || "").trim();
  const itemsJson = JSON.stringify(Array.isArray(body.items) ? body.items : []);
  // A retried sale (same offline_id) is answered idempotently before any validation.
  const offlineIdEarly = String(body.offline_id || "").trim() || null;
  if (offlineIdEarly) {
    const existing = await dbFirst(env, `SELECT id FROM pos_sales WHERE org_id=? AND location_id=? AND offline_id=?`,
      [authUser.org_id, authUser.location_id, offlineIdEarly]);
    if (existing) return jsonResponse({ ok: true, id: existing.id, duplicate: true }, 200, corsOkHeaders);
  }
  const m = posComputeSale(body);
  if (!Array.isArray(body.items) || body.items.length === 0) return jsonResponse({ ok: false, error: "A sale needs at least one line" }, 400, corsOkHeaders);
  if (m.short) return jsonResponse({ ok: false, error: "Amount tendered (" + (m.tendered == null ? "none" : m.tendered.toFixed(2)) + ") is less than the total (" + m.total.toFixed(2) + ")" }, 400, corsOkHeaders);
  const subtotal = m.subtotal;
  const vatTotal = m.vatTotal;
  const total = m.total;
  const paymentMethod = m.paymentMethod;
  const amountTendered = m.tendered;
  const changeGiven = m.change;
  const notes = String(body.notes || "").trim();
  const clientName = String(body.client_name || "").trim();
  const clientId = String(body.client_id || "").trim();
  const offlineId = String(body.offline_id || "").trim() || null;

  const row = await dbFirst(env, `INSERT INTO pos_sales
    (org_id, location_id, sale_date, receipt_no, items_json, subtotal, vat_total, total,
     payment_method, amount_tendered, change_given, notes, client_name, client_id,
     offline_id, voided, created_by, created_at, updated_at, discount_pct)
    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,?,datetime('now'),datetime('now'),?)
    RETURNING id`,
    [authUser.org_id, authUser.location_id, saleDate, receiptNo, itemsJson,
     subtotal, vatTotal, total, paymentMethod, amountTendered, changeGiven,
     notes, clientName, clientId, offlineId, authUser.user_id, m.discountPct]);

  await writeAudit(env, authUser.org_id, authUser.user_id, "EPOS_SALE_CREATE", "pos_sales", String(row.id), { total, vat_total: vatTotal, discount_pct: m.discountPct, payment_method: paymentMethod }, authUser.location_id);
  return jsonResponse({ ok: true, id: row.id, subtotal, vat_total: vatTotal, total, change_given: changeGiven }, 200, corsOkHeaders);
}

