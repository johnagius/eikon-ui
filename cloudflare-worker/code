  `, [authUser.org_id, authUser.location_id, offer.entry_date || todayStr, offer.item_name, offer.batch || "", offer.expiry_date || null, offer.quantity_available, id, authUser.user_id, authUser.user_id]);

  const transferId = res.meta?.last_row_id || null;
  await dbRun(env, "UPDATE scarce_stock_offers SET transfer_item_id = ?, updated_at = datetime('now'), updated_by = ? WHERE id = ?",
    [transferId, authUser.user_id, id]);

