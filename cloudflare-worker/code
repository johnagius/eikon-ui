  if (status === "pending") return "Your leave request for " + span.replace(/^on /, "") + part + " is waiting for approval";
  return status === "approved" ? "Your leave " + span + part + " was approved" : "Your leave request for " + span.replace(/^on /, "") + part + " was not approved";
}

// ---- the people this pharmacy has devices for (one indexed read; empty = nothing else is done)
async function rpnSubscribed(env, org, loc) {
