  if (p.endsWith(".json")) return "application/json; charset=utf-8";
  if (p.endsWith(".svg")) return "image/svg+xml";
  if (p.endsWith(".png")) return "image/png";
  if (p.endsWith(".jpg") || p.endsWith(".jpeg")) return "image/jpeg";
  if (p.endsWith(".webp")) return "image/webp";
  if (p.endsWith(".txt")) return "text/plain; charset=utf-8";
  return "application/octet-stream";
}

// Which git ref the /ui/ files come from (staging, security audit 2026-11-10): UI_GITHUB_REF (a branch such as "release",
// or a tag) wins; else UI_GITHUB_BRANCH; else "main" — so a worker without UI_GITHUB_REF serves exactly what it did.
// A ref that is not a plain git name (spaces, "..", a leading "/" or "-") is ignored, never put in the URL.
function uiGithubRef(env) {
  const okRef = (v) => /^[A-Za-z0-9][A-Za-z0-9._\/-]{0,99}$/.test(v) && v.indexOf("..") < 0 && !/\/$|\.lock$|\/\//.test(v);
  for (const k of ["UI_GITHUB_REF", "UI_GITHUB_BRANCH"]) {
    const v = String((env && env[k]) || "").trim();
    if (v && okRef(v)) return v;
  }
  return "main";
}

function buildGithubRawUrl(env, uiPath) {
  const owner = (env.UI_GITHUB_OWNER || "").trim() || "johnagius";
  const repo = (env.UI_GITHUB_REPO || "").trim() || "eikon-ui";
  const ref = uiGithubRef(env);
  const dir = (env.UI_GITHUB_DIR || "").trim() || "ui";

  const safe = uiPath.replace(/^\/+/, "").replace(/\.\.+/g, ".");
  return `https://raw.githubusercontent.com/${owner}/${repo}/${ref}/${dir}/${safe}`;
}

function sanitizeJsSourceText(s) {
  return String(s || "")
    .replace(/\uFEFF/g, "")
    .replace(/\u0000/g, "")
    .replace(/\u2028/g, "\n")
    .replace(/\u2029/g, "\n");
}

// ------------------------------------------------------------
// Clean addresses (eikonhq.com/, eikonhq.com/today)
// The app's page is served at "/" and at a one-word path when, and only when, a BROWSER NAVIGATES there:
//   - GET or HEAD, with no Authorization header (every API call the app makes carries its Bearer token);
//   - Sec-Fetch-Mode: navigate. Browsers set it themselves on address-bar, link, reload and new-tab loads, and a
//     script cannot (it is a forbidden header): fetch() and XHR always send cors / same-origin / no-cors. Browsers too
//     old to send it are recognised by Accept beginning with text/html, which fetch() never sends unless told to;
//   - the path is "/" or one word (letters, digits, - and _), and not one of the worker's own pages below.
// So /today asked for by the app (fetch + Bearer) still gets Today's JSON; /today typed in the address bar gets the
// app, which opens the Today screen. /ui/index.html#today and every other path answer exactly as before.
// ------------------------------------------------------------
const APP_PAGE_RESERVED = new Set(["ui", "api", "b", "book", "bootstrap", "admin-recover", "su", "health", "go", "auth"]);
function isAppPageRequest(request, url) {
  if (request.method !== "GET" && request.method !== "HEAD") return false;
  if (request.headers.has("Authorization")) return false;
  const p = url.pathname;
  if (p !== "/") {
    const m = /^\/([A-Za-z][A-Za-z0-9_-]{0,63})$/.exec(p);
    if (!m || APP_PAGE_RESERVED.has(m[1].toLowerCase())) return false;
  }
  const mode = request.headers.get("Sec-Fetch-Mode");
  if (mode) return mode === "navigate";
  return /^\s*text\/html/i.test(request.headers.get("Accept") || "");
}

// ------------------------------------------------------------
// The old address moves to eikonhq.com (owner's decision, 2026-11-03)
// A person who opens the old workers.dev address in a browser tab is sent to the same path and query on eikonhq.com
// (the browser keeps the #hash across a redirect). They sign in there once: a browser keeps sign-ins per address.
// Only a top-level page load, when ALL of these hold:
//   - the host is exactly OLD_APP_HOST (eikonhq.com and every other host: never);
//   - GET or HEAD, with no Authorization header;
//   - Sec-Fetch-Mode: navigate AND Sec-Fetch-Dest: document. Browsers set both themselves and a script cannot. A frame
//     (the page on swiftdataautomation.com) sends Dest: iframe, fetch()/XHR send Mode: cors/same-origin/no-cors and
//     Dest: empty, servers and old browsers send neither: none of them is ever moved;
//   - no ?stay=1 (the opt-out; nothing is remembered here, the query string itself keeps it on reloads);
//   - the path is "/", "/ui", "/ui/" or a one-word screen path the app page answers (see isAppPageRequest).
// /ui/index.html is NOT moved here: it is the start_url of apps installed on a home screen or desktop from the old
// address, and their launch looks exactly like a bookmark (Mode navigate, Dest document, Site none). index.html
// itself moves a browser tab (it can tell: not in a frame, not display-mode standalone). Booking links (/b/, /book/),
// /health, /su, every API route and every file under /ui/ answer exactly as before.
// ------------------------------------------------------------
const OLD_APP_HOST = "eikon-api.labrint.workers.dev";
const NEW_APP_ORIGIN = "https://eikonhq.com";
function oldAddressMove(request, url) {
  if (url.hostname !== OLD_APP_HOST) return null;
  if (request.method !== "GET" && request.method !== "HEAD") return null;
  if (request.headers.has("Authorization")) return null;
  if (request.headers.get("Sec-Fetch-Mode") !== "navigate" || request.headers.get("Sec-Fetch-Dest") !== "document") return null;
  if (url.searchParams.get("stay") === "1") return null;
  const p = url.pathname;
  if (p !== "/" && p !== "/ui" && p !== "/ui/" && !isOneWordScreenPath(p)) return null;
  return new Response(null, {
    status: 302,
    headers: { "Location": NEW_APP_ORIGIN + p + url.search, "Cache-Control": "no-store", "Vary": "Sec-Fetch-Mode, Sec-Fetch-Dest, Authorization" }
  });
}
function isOneWordScreenPath(p) {
  const m = /^\/([A-Za-z][A-Za-z0-9_-]{0,63})$/.exec(p);
  return !!m && !APP_PAGE_RESERVED.has(m[1].toLowerCase());
}

// index.html with a mark that tells it to load its files from /ui/ and to name screens by path. Returns null (and the
// request goes on as before: "/" redirects to /ui/index.html, a screen path to the API) when the page cannot be had or
// is an index.html that does not know the mark yet, so a worker deployed ahead of the UI changes nothing.
async function handleAppPage(request, env, url) {
  try {
    const pageUrl = new URL("/ui/index.html", url);
    const res = await handleUiAsset(new Request(pageUrl.toString(), { method: "GET" }), env, pageUrl);
    if (!res || res.status !== 200) return null;
    const html = await res.text();
    if (html.indexOf("EIKON_UI_BASE") < 0 || !/<head[^>]*>/i.test(html)) return null;
    const out = html.replace(/<head[^>]*>/i, (h) => h + '\n  <meta name="eikon-ui-base" content="/ui/" />');
    return new Response(request.method === "HEAD" ? null : out, {
      status: 200,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        // Never kept by the browser: the same address also answers the app's API call (/today), and a stored page must
        // not be handed to that call (nor the other way round).
        "Cache-Control": "no-store",
        "Vary": "Accept, Sec-Fetch-Mode, Authorization",
        "X-Eikon-Page": "app",
        ...(await appSecurityHeaders(out, env)) // backlog 2-9: nosniff, Referrer-Policy, CSP Report-Only
      }
    });
  } catch (e) {
    return null;
  }
}

async function handleUiAsset(request, env, url) {
  const p = url.pathname;
  const rel = p.replace(/^\/ui\/?/, "");
  if (!rel || rel.endsWith("/")) {
    return new Response("Not found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
  }

  // Serve supplier product template CSV with Content-Disposition: attachment
  if (rel === "product-template.csv") {
    const hdrs = [
      "Stock Code","Barcode","Description","Cost Excl Vat","Cost Incl Vat",
      "VAT","Discount (%)","Discount (\u20ac)","Quantity Purchased",
      "Quantity Free","Batch","Expiry Date","Retail Price"
    ];
    const csv = hdrs.map(h => '"' + h.replace(/"/g, '""') + '"').join(",") + "\n";
    return new Response(csv, {
      status: 200,
      headers: {
        "Content-Type": "text/csv; charset=utf-8",
        "Content-Disposition": 'attachment; filename="product-template.csv"',
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-store"
      }
    });
  }

  const cacheSeconds = parseInt((env.UI_CACHE_SECONDS || "300").trim(), 10);
  const ct = contentTypeForPath(rel);

  const cache = caches.default;

  // Files requested with the build stamp (?v=YYYY-MM-DD.N, see BUILD in ui/index.html) never change
  // under that URL, so they are cached at the edge and in browsers for a day even when UI_CACHE_SECONDS
  // is 0 (it only governs index.html and unstamped files). Without this every visit re-fetched ~60 files from GitHub.
  const stamped = /^\d{4}-\d{2}-\d{2}\.\d+$/.test(url.searchParams.get("v") || "") && !/\.html?$/i.test(rel);
  const cachingEnabled = stamped || (Number.isFinite(cacheSeconds) && cacheSeconds > 0);

  if (cachingEnabled) {
    const cached = await cache.match(request);
    if (cached) return withUiSecurityHeaders(cached, rel, env); // backlog 2-9: security headers
  }

  const ghUrl = buildGithubRawUrl(env, rel);
  const ghRes = await fetch(ghUrl, {
    method: "GET",
    headers: {
      "User-Agent": "eikon-worker-ui-proxy",
      "Cache-Control": "no-cache"
    }
  });

  if (!ghRes.ok) {
    return new Response("Not found", {
      status: 404,
      headers: { "Content-Type": "text/plain; charset=utf-8" }
    });
  }

  let body = await ghRes.arrayBuffer();

  // Patch: sanitize problematic Unicode that can cause "Invalid or unexpected token"
  if (rel.toLowerCase().endsWith(".js")) {
    try {
      const dec = new TextDecoder("utf-8");
      const txt = dec.decode(body);
      const clean = sanitizeJsSourceText(txt);
      if (clean !== txt) {
        body = new TextEncoder().encode(clean).buffer;
      }
    } catch (e) {
      // serve original bytes if sanitize fails
    }
  }

  const headers = new Headers();
  headers.set("Content-Type", ct);
  const maxAge = stamped ? 86400 : cacheSeconds;
  headers.set("Cache-Control", cachingEnabled ? `public, max-age=${maxAge}` : "no-store");
  headers.set("X-Source", "github-raw");
  headers.set("Access-Control-Allow-Origin", "*");

  const out = new Response(body, { status: 200, headers });

  if (cachingEnabled) {
    await cache.put(request, out.clone());
  }

  return withUiSecurityHeaders(out, rel, env); // backlog 2-9: security headers
}

/* ══════════════════════════════════════════════════════════════════════════════
   APP PAGE SECURITY HEADERS (backlog 2, item 9). Self-contained: the only other lines are three hooks
   (handleAppPage's headers, handleUiAsset's two returns), nosniff in jsonResponse and "csp" in CLIENT_LOG_KINDS.
   - Every /ui/* file and the app page: X-Content-Type-Options nosniff, Referrer-Policy same-origin.
   - HTML (the app page at "/" and /<screen>, /ui/index.html, next.html, ...): also Content-Security-Policy-Report-Only.
     REPORT-ONLY by default: the browser blocks nothing, it only tells the page (securitypolicyviolation, which core.js
     sends to /client-log as kind "csp") and POSTs a report to /csp-report (report-uri; logged, not stored).
     CSP_ENFORCE=1 (a worker variable, security audit 2026-11-10) enforces it, frame-ancestors excepted (see cspEnforced).
   - script-src: 'self' plus the sha256 of each inline <script> of THAT page, worked out here from the very HTML
     being sent: index.html's inline script holds BUILD, so a fixed list would go stale on every UI release
     (the UI ships from GitHub without a worker deploy). 'wasm-unsafe-eval' lets the vendored OCR engine
     (tesseract, Emergency POS photo search) compile WebAssembly; it does not allow eval() of JavaScript.
   - style-src 'unsafe-inline': the screens build their markup with style="..." attributes and <style> blocks
     (index.html's loading screen, every module); removing it means rewriting them. Styles cannot read the token.
   - No X-Frame-Options: swiftdataautomation.com/eikon frames the app (godaddy/godaddy-loader-htmlcode, core.js
     PARENT_ORIGIN) and X-Frame-Options cannot name another site. frame-ancestors carries the list instead, in the
     report-only policy for now: GoDaddy puts custom HTML in a frame of its own, whose origin is not known here.
   Map tiles: *.tile.openstreetmap.org (Deliveries map, Leaflet); geocoding: geocode.arcgis.com, nominatim.
   ══════════════════════════════════════════════════════════════════════════════ */
const APP_FRAME_ANCESTORS = ["'self'", "https://eikonhq.com", "https://www.eikonhq.com", "https://eikon-api.labrint.workers.dev",
  "https://swiftdataautomation.com", "https://*.swiftdataautomation.com"];
const APP_CSP_IMG = ["https://tile.openstreetmap.org", "https://*.tile.openstreetmap.org"];
const APP_CSP_CONNECT = ["https://geocode.arcgis.com", "https://nominatim.openstreetmap.org"];

// The text of every inline <script> (no src) in a page, as the browser hashes it (the HTML parser turns CRLF and CR into LF).
function appInlineScripts(html) {
  const out = [];
  const re = /<script\b([^>]*)>([\s\S]*?)<\/script\s*>/gi;
  let m;
  while ((m = re.exec(String(html || "")))) {
    if (/\bsrc\s*=/i.test(m[1])) continue;
    out.push(m[2].replace(/\r\n?/g, "\n"));
  }
  return out;
}

async function appCspHashes(html) {
  const hashes = [];
  for (const s of appInlineScripts(html)) {
    const d = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s));
    hashes.push("'sha256-" + base64FromBytes(new Uint8Array(d)) + "'");
  }
  return hashes;
}

// CSP_ENFORCE (security audit 2026-11-10): "1"/"true"/"on" sends the policy as Content-Security-Policy (the browser
// blocks), still with a report-only copy that alone carries frame-ancestors (the GoDaddy custom-HTML frame's origin is
// not known, so frames are reported, never refused). Unset (the default): report-only, exactly as before.
function cspEnforced(env) { return /^(1|true|on|yes)$/i.test(String((env && env.CSP_ENFORCE) || "").trim()); }

function appCspPolicy(hashes, frames = true) {
  return [
    "default-src 'self'",
    "script-src 'self' 'wasm-unsafe-eval'" + (hashes.length ? " " + hashes.join(" ") : ""),
    "worker-src 'self' blob:",
    "style-src 'self' 'unsafe-inline'",
    "img-src 'self' data: blob: " + APP_CSP_IMG.join(" "),
    "font-src 'self' data:",
    "connect-src 'self' " + APP_CSP_CONNECT.join(" "),
    "media-src 'self' blob:",
    "frame-src 'self' blob:",
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'self'",
    ...(frames ? ["frame-ancestors " + APP_FRAME_ANCESTORS.join(" ")] : []),
    "report-uri /csp-report"
  ].join("; ");
}

// Headers for the app page / a /ui/ file. html: the page's text when it is a page (adds the policy: report-only, or
// enforced without frame-ancestors plus the full report-only copy when CSP_ENFORCE is on).
async function appSecurityHeaders(html, env) {
  const h = { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "same-origin" };
  if (html != null) {
    const hashes = await appCspHashes(html);
    if (cspEnforced(env)) h["Content-Security-Policy"] = appCspPolicy(hashes, false);
    h["Content-Security-Policy-Report-Only"] = appCspPolicy(hashes);
  }
  return h;
}

// A /ui/ response with the headers above (a new Response: one from the edge cache cannot be changed in place).
async function withUiSecurityHeaders(res, rel, env) {
  try {
    if (!res || res.status !== 200) return res;
    const isHtml = /\.html?$/i.test(String(rel || "")) || /^text\/html/i.test(res.headers.get("Content-Type") || "");
    const add = await appSecurityHeaders(isHtml ? await res.clone().text() : null, env);
    const out = new Response(res.body, res);
    for (const [k, v] of Object.entries(add)) out.headers.set(k, v);
    return out;
  } catch (e) {
    return res;
  }
}
// POST /csp-report (the policy's report-uri; public: a browser sends it with no sign-in, also before sign-in, which
// the page's own /client-log reporter cannot). Nothing is stored: one console line per violation (wrangler tail /
// Workers logs), the blocked address cut to its origin and the source to file:line, so no token or query is kept.
// Both report shapes: report-uri's {"csp-report":{...}} and the Reporting API's [{type:"csp-violation",body:{...}}].
async function handleCspReport(request) {
  try {
    const len = Number(request.headers.get("Content-Length") || 0);
    if (len > 16384) return new Response(null, { status: 413 });
    const text = await request.text();
    if (text.length > 16384) return new Response(null, { status: 413 });
    let j = null; try { j = JSON.parse(text); } catch (e) { j = null; }
    const list = Array.isArray(j) ? j.map((x) => x && x.body).filter(Boolean) : j && j["csp-report"] ? [j["csp-report"]] : [];
    const origin = (u) => { const v = String(u || ""); if (!/^https?:/i.test(v)) return v.slice(0, 40); try { return new URL(v).origin; } catch (e) { return "?"; } };
    const file = (u) => { const v = String(u || ""); try { return new URL(v).pathname.split("/").pop().slice(0, 80); } catch (e) { return v.slice(0, 40); } };
    for (const r of list.slice(0, 5)) {
      console.log("[csp] " + JSON.stringify({
        d: String(r["effective-directive"] || r.effectiveDirective || r["violated-directive"] || "").slice(0, 40),
        blocked: origin(r["blocked-uri"] || r.blockedURL),
        page: file(r["document-uri"] || r.documentURL),
        src: file(r["source-file"] || r.sourceFile) + ":" + (Number(r["line-number"] || r.lineNumber) || 0),
        mode: String(r.disposition || "").slice(0, 10)
      }));
    }
  } catch (e) {}
  return new Response(null, { status: 204, headers: { "Cache-Control": "no-store" } });
}
