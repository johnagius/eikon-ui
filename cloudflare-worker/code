  return async function (env) {
    const key = (env && typeof env.DB === "object" && env.DB) ? env.DB : globalThis;
    let m = __schemaDone.get(key);
    if (!m) { m = new Map(); __schemaDone.set(key, m); }
    let p = m.get(name);
