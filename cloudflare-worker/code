const CONTACTS_TABLES = {
  suppliers:      { db: "contacts_suppliers",      cols: ["name", "phone", "email"] },
  medreps:        { db: "contacts_medreps",        cols: ["name", "phone", "email"] },
  headoffice:     { db: "contacts_headoffice",     cols: ["name", "phone"] },
  orgpharmacies:  { db: "contacts_orgpharmacies",  cols: ["name", "phone"] },
  poyc:           { db: "contacts_poyc",           cols: ["name", "phone"] },
  locums:         { db: "contacts_locums",         cols: ["name", "phone"] },
  doctors:        { db: "contacts_doctors",        cols: ["name", "phone_personal", "phone_patient"] },
  specialists:    { db: "contacts_specialists",    cols: ["name", "specialty", "phone_personal", "phone_patient"] },
  clients:        { db: "contacts_clients",        cols: ["name", "id_card", "address", "phone", "alt_phone"], locScoped: true }
};

let _contactsSchemaReady = false;
async function ensureContactsSchema__impl(env) {
  if (_contactsSchemaReady) return;
  for (const key of Object.keys(CONTACTS_TABLES)) {
    const def = CONTACTS_TABLES[key];
    const colDefs = def.cols.map(c => `${c} TEXT NOT NULL DEFAULT ''`).join(",\n      ");
    const locCol = def.locScoped ? "location_id INTEGER NOT NULL DEFAULT 0," : "";
    await dbRun(env, `
      CREATE TABLE IF NOT EXISTS ${def.db} (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        org_id INTEGER NOT NULL,
        ${locCol}
        ${colDefs},
        created_at TEXT NOT NULL DEFAULT (datetime('now')),
        updated_at TEXT NOT NULL DEFAULT (datetime('now')),
        created_by INTEGER,
        updated_by INTEGER
      )
    `);
    await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_${def.db}_org ON ${def.db}(org_id)`);

    /* migration: add any missing columns to existing tables
       D1 quirks: PRAGMA may not work via .prepare().all(), and
       ALTER TABLE ADD COLUMN with NOT NULL can crash the worker.
       So we use SELECT to probe columns and DEFAULT '' without NOT NULL. */
    for (const col of def.cols) {
      try {
        await env.DB.prepare(`SELECT ${col} FROM ${def.db} LIMIT 0`).all();
      } catch (e) {
        /* column does not exist — add it */
        await dbRun(env, `ALTER TABLE ${def.db} ADD COLUMN ${col} TEXT DEFAULT ''`);
      }
    }
    if (def.locScoped) {
      try {
        await env.DB.prepare(`SELECT location_id FROM ${def.db} LIMIT 0`).all();
      } catch (e) {
        await dbRun(env, `ALTER TABLE ${def.db} ADD COLUMN location_id INTEGER DEFAULT 0`);
      }
      await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_${def.db}_org_loc ON ${def.db}(org_id, location_id)`);
    }
  }
  _contactsSchemaReady = true;
}

