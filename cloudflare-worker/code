}
async function schemaMark(env, name, fp) {
  try {
    await env.DB.prepare("CREATE TABLE IF NOT EXISTS eikon_schema (k TEXT PRIMARY KEY, v TEXT NOT NULL, at TEXT NOT NULL DEFAULT (datetime('now')))").run();
    await env.DB.prepare("INSERT INTO eikon_schema (k, v) VALUES (?, ?) ON CONFLICT(k) DO UPDATE SET v = excluded.v, at = datetime('now')").bind(name, fp).run();
  } catch (e) {} // a mark is only a shortcut: without it the step simply runs again next time
}
function schemaOnce(name, impl) {
