async function ensureCherubinoOrdersSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS cherubino_orders (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id        INTEGER NOT NULL,
    location_id   INTEGER NOT NULL,
    location_name TEXT NOT NULL DEFAULT '',
    order_date    TEXT NOT NULL,
    description   TEXT NOT NULL DEFAULT '',
    quantity      INTEGER NOT NULL DEFAULT 1,
    oos           INTEGER NOT NULL DEFAULT 0,
    ordered       INTEGER NOT NULL DEFAULT 0,
    available_wsl INTEGER NOT NULL DEFAULT 0,
    pending_wsl   INTEGER NOT NULL DEFAULT 0,
    created_by    INTEGER,
    created_at    TEXT DEFAULT (datetime('now')),
    updated_at    TEXT DEFAULT (datetime('now'))
  )`);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_cherubino_orders_org_date ON cherubino_orders (org_id, order_date)`);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_cherubino_orders_org_loc_date ON cherubino_orders (org_id, location_id, order_date)`);
}

function cherubinoDateTooOld(dateStr) {
  const d = new Date(dateStr + "T00:00:00Z");
  const now = new Date();
  const cutoff = new Date(now);
  cutoff.setUTCDate(cutoff.getUTCDate() - 14);
  cutoff.setUTCHours(0, 0, 0, 0);
  return d < cutoff;
}

async function handleCherubinoOrdersList(request, env, corsOkHeaders, authUser, url) {
  await ensureCherubinoOrdersSchema(env);
  const date = (url.searchParams.get("date") || "").trim();
  if (!date || !isValidYmd(date)) return jsonResponse({ ok: false, error: "date required (YYYY-MM-DD)" }, 400, corsOkHeaders);
  if (cherubinoDateTooOld(date)) return jsonResponse({ ok: false, error: "Cannot query more than 2 weeks back" }, 400, corsOkHeaders);

  const allOrg = url.searchParams.get("all_org") === "1";
  let rows;
  if (allOrg) {
    rows = await dbAll(env,
      `SELECT id, org_id, location_id, location_name, order_date, description, quantity,
              oos, ordered, available_wsl, pending_wsl, created_at
       FROM cherubino_orders WHERE org_id = ? AND order_date = ? ORDER BY created_at ASC`,
      [authUser.org_id, date]);
  } else {
    rows = await dbAll(env,
      `SELECT id, org_id, location_id, location_name, order_date, description, quantity,
              oos, ordered, available_wsl, pending_wsl, created_at
       FROM cherubino_orders WHERE org_id = ? AND location_id = ? AND order_date = ? ORDER BY created_at ASC`,
      [authUser.org_id, authUser.location_id, date]);
  }
  return jsonResponse({ ok: true, orders: rows }, 200, corsOkHeaders);
}

