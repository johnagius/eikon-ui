async function handleOrderItemFeedbackCreate(request, env, corsOkHeaders, authUser, itemId) {
  await ensureSupplierProductsSchema(env);
  const body = await readJson(request);

  // Look up the item and its order
  const item = await dbFirst(env,
    `SELECT oi.*, o.id AS oid, o.supplier_location_id, o.pharmacy_location_id, o.supplier_name, o.pharmacy_name, o.created_at AS order_created_at
     FROM supplier_order_items oi
     JOIN supplier_orders o ON o.id = oi.order_id
     WHERE oi.id = ?`, [itemId]);
  if (!item) return jsonResponse({ ok: false, error: "Item not found" }, 404, corsOkHeaders);

  // Only the pharmacy that placed the order can leave feedback
  if (item.pharmacy_location_id !== authUser.location_id) {
    return jsonResponse({ ok: false, error: "Access denied" }, 403, corsOkHeaders);
  }

  const problemType = String(body.problem_type || "").trim();
  if (!problemType) return jsonResponse({ ok: false, error: "problem_type is required" }, 400, corsOkHeaders);

  const qtyLabel = (item.qty_requested || 0) + (item.qty_free ? "+" + item.qty_free : "");

  const fb = await dbFirst(env,
    `INSERT INTO supplier_order_item_feedback
     (order_id, order_item_id, supplier_location_id, pharmacy_location_id, pharmacy_name, supplier_name,
      item_description, item_barcode, item_qty, item_batch, item_expiry_date, problem_type, notes, order_created_at, created_by)
     VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
     RETURNING id`,
    [
      item.order_id, itemId, item.supplier_location_id, item.pharmacy_location_id,
      item.pharmacy_name || "", item.supplier_name || "",
      item.description || "", item.barcode || "", qtyLabel,
      item.batch || "", item.expiry_date || "",
      problemType, String(body.notes || "").trim(),
      item.order_created_at || "", authUser.user_id
    ]);

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_FEEDBACK_CREATE", "supplier_order_item_feedback", String(fb.id), { order_id: item.order_id, order_item_id: itemId, problem_type: problemType, after: await auditSnap(env, "supplier_order_item_feedback", fb.id, null) }, authUser.location_id);
  return jsonResponse({ ok: true, id: fb.id }, 200, corsOkHeaders);
}

