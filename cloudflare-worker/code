    return jsonResponse({ ok: false, error: "Choose the day of the last inspection" }, 400, corsOkHeaders);
  if (date && date > tzYmd()) return jsonResponse({ ok: false, error: "The day of the last inspection cannot be after today" }, 400, corsOkHeaders);
  const had = await read();
  if (had && had.last_date === date) return jsonResponse({ ok: true, unchanged: true, ...lastInspectionOut(had) }, 200, corsOkHeaders);
  const me = await dbFirst(env, "SELECT full_name, email FROM users WHERE id = ?", [authUser.user_id]);
  const name = String((me && (me.full_name || me.email)) || "").trim();
  await dbRun(env, `INSERT INTO register_last_inspection (org_id, location_id, last_date, set_by, set_name, updated_at) VALUES (?,?,?,?,?,datetime('now'))
