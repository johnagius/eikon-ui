        if (!o) continue;
        const target = x.sub ? (o[d.json.list] || [])[x.sub.index] : o;
        if (!target || gdprScrubObj(target, d.json.scrub, (k) => newVal(k, x.rid)) === 0) continue;
        changes.push({ c: d.json.col, old: x.row[d.json.col], json: true, target: x.sub ? { index: x.sub.index, id: x.sub.id } : null });
      } else {
