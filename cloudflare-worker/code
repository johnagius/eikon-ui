function gdprRowOut(r) { const o = {}; for (const k of Object.keys(r || {})) if (k !== "__rid" && k !== "__n") o[k] = r[k]; return o; }

// POST /people/:id/export { rows } — everything, own pharmacy only. Read only; audited with counts.
async function handlePersonExport(request, env, cors, authUser, id) {
  const g = await gdprGuard(request, env, cors, authUser); if (g) return g;
  const org = authUser.org_id, loc = authUser.location_id;
  const ctx = await gdprContext(env, org, loc, id);
  if (!ctx) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  const picked = gdprPicked(await gdprBody(request));
  const pol = gdprPolicy(env);
  const sections = await gdprCollect(env, org, loc, ctx);
  const out = [], counts = {};
  for (const sec of sections) {
    const d = sec.def;
    const rows = sec.rows.filter((x) => x.cls === "sure" || (x.cls === "maybe" && picked.has(x.key)));
    if (!rows.length) continue;
    const act = gdprPolicyOf(pol, d.policy);
    out.push({ table: d.t, label: d.label, group: d.group, on_erase: act === "erase" && !d.fixed ? "anonymised" : "kept", why_kept: act === "erase" && !d.fixed ? "" : (GDPR_WHY[d.policy] || ""),
      rows: rows.map((x) => {
        if (x.sub) return { row_id: x.rid, record: d.t === "screening_campaigns" ? { campaign_id: x.row.campaign_id, name: (() => { try { return JSON.parse(x.row.campaign_json).name || ""; } catch (e) { return ""; } })() } : {}, entry: x.sub.entry, matched: x.why };
        const o = gdprRowOut(x.row);
        if (d.json) { try { o[d.json.col] = JSON.parse(o[d.json.col]); } catch (e) {} }
        return Object.assign(o, { _matched: x.why });
      }) });
    counts[d.t] = rows.length;
  }
  let profile = null, audit = [], links = [];
  try { audit = await dbAllChunked(env, (ph) => "SELECT id, action, entity_type, entity_id, user_id, created_at, details_json FROM audit_log WHERE org_id = ? AND entity_type = 'people' AND entity_id IN (" + ph + ") AND (location_id = ? OR location_id IS NULL) ORDER BY id LIMIT 500", ctx.personIds.map(String), [org], [loc]); } catch (e) { audit = []; }
  audit = audit.map((a) => { let det = null; try { det = JSON.parse(a.details_json || "{}"); } catch (e) { det = a.details_json; } return { id: a.id, action: a.action, at: a.created_at, by_user_id: a.user_id, details: det }; });
  try { links = await dbAllChunked(env, (ph) => "SELECT link_group, source_kind, source_table, source_id, created_at, undone_at FROM people_links WHERE org_id = ? AND location_id = ? AND source_table = 'people' AND source_id IN (" + ph + ")", ctx.personIds.map(String), [org, loc]); } catch (e) { links = []; }
  let pharmacy = "";
  try { const l = await dbFirst(env, "SELECT name FROM locations WHERE id = ? AND org_id = ?", [loc, org]); pharmacy = (l && l.name) || ""; } catch (e) {}
  const total = Object.values(counts).reduce((a, b) => a + b, 0);
  await writeAudit(env, org, authUser.user_id, "PERSON_EXPORT", "people", String(ctx.person.id), { location_id: loc, tables: counts, rows: total, ticked: picked.size }, loc);
  return jsonResponse({ ok: true, format: "eikon.person-export.v1", made_at: new Date().toISOString(), timezone: PHARMACY_TZ,
    pharmacy: { name: pharmacy }, made_by: { user_id: authUser.user_id, name: authUser.full_name || "", email: authUser.email || "" },
    person: gdprRowOut(ctx.aliases.find((a) => Number(a.id) === Number(ctx.person.id)) || ctx.person),
    merged_records: ctx.aliases.filter((a) => Number(a.id) !== Number(ctx.person.id)).map(gdprRowOut),
    sections: out, links, audit, rows: total,
    notes: ["Only this pharmacy's records are included.", "Rows marked 'same name only' were included because a pharmacist ticked them."] }, 200, cors);
}

// POST /people/:id/erase { rows, confirm, plan, reason }
async function handlePersonErase(request, env, cors, authUser, id) {
  const g = await gdprGuard(request, env, cors, authUser); if (g) return g;
  const org = authUser.org_id, loc = authUser.location_id, uid = authUser.user_id;
  const ctx = await gdprContext(env, org, loc, id);
  if (!ctx) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  const body = await gdprBody(request);
  const open = await gdprOpenErasure(env, org, loc, ctx.person.id);
  if (ctx.erased) return jsonResponse({ ok: false, code: "already_erased", error: "This person was already erased", open_erasure: open }, 409, cors);
  const pol = gdprPolicy(env);
  const plan = gdprPlan(ctx, await gdprCollect(env, org, loc, ctx), gdprPicked(body), pol);
  if (body.confirm !== true) return jsonResponse(gdprPreviewJson(ctx, plan, open, pol), 200, cors);
  if (String(body.plan || "") !== plan.fingerprint) return jsonResponse(Object.assign(gdprPreviewJson(ctx, plan, open, pol), { ok: false, code: "plan_changed", error: "The records changed since you looked. Check the new list." }), 409, cors);
  if (plan.total > GDPR_MAX_ROWS) return jsonResponse({ ok: false, error: "Too many records (" + plan.total + ") to change at once. Ask Eikon support." }, 413, cors);
  const reason = String(body.reason || "").replace(/\s+/g, " ").trim().slice(0, 300);
  const eid = "gdpr_" + crypto.randomUUID();
  const P = (sql, ...b) => env.DB.prepare(sql).bind(...b);
  const counts = {}, kept = {};
  for (const k of plan.kept) kept[k.table] = (kept[k.table] || 0) + 1;
  const stmts = [P("INSERT INTO gdpr_erasures (erasure_id, org_id, location_id, person_id, rows_changed, summary_json, reason, created_by, undo_until) VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now', ?))",
    eid, org, loc, ctx.person.id, plan.total, "{}", reason, uid, "+" + GDPR_UNDO_HOURS + " hours")];
  const byTable = new Map();
  const tomb = gdprTombstone(ctx.person.id);
  for (const it of plan.items) {
    counts[it.table] = (counts[it.table] || 0) + 1;
    if (it.def && it.def.json) {
      // JSON registers: the row is changed only if still as read; every person in one row (screening) in one update.
      const k = it.table + ":" + it.rid;
      if (!byTable.has(k)) byTable.set(k, { it, json: (() => { try { return JSON.parse(String(it.row[it.def.json.col])); } catch (e) { return null; } })() });
      const e = byTable.get(k);
      if (!e.json) continue;
      const target = it.sub ? (e.json[it.def.json.list] || [])[it.sub.index] : e.json;
      if (target) gdprScrubObj(target, it.def.json.scrub, (k) => (k === "@name" ? tomb : k));
      continue;
    }
    const sets = [], vals = [];
    for (const ch of it.changes) {
      if (GDPR_UNDO_HOURS > 0) stmts.push(P("INSERT INTO gdpr_erasure_rows (erasure_id, org_id, location_id, table_name, row_id, column_name, old_value, new_value) SELECT ?, ?, ?, ?, rowid, ?, " + ch.c + ", ? FROM " + it.table + " WHERE rowid = ? AND org_id = ? AND location_id = ?",
        eid, org, loc, it.table, ch.c, ch.nv, it.rid, org, loc));
      sets.push(ch.c + " = ?"); vals.push(ch.nv);
    }
    if (it.people) { sets.push("version = version + 1", "updated_at = datetime('now')", "updated_by = ?"); vals.push(uid); }
    stmts.push(P("UPDATE " + it.table + " SET " + sets.join(", ") + " WHERE rowid = ? AND org_id = ? AND location_id = ?", ...vals, it.rid, org, loc));
  }
  for (const { it, json } of byTable.values()) {
    if (!json) continue;
    const col = it.def.json.col, nv = JSON.stringify(json);
    if (GDPR_UNDO_HOURS > 0) stmts.push(P("INSERT INTO gdpr_erasure_rows (erasure_id, org_id, location_id, table_name, row_id, column_name, old_value, new_value) SELECT ?, ?, ?, ?, rowid, ?, " + col + ", ? FROM " + it.table + " WHERE rowid = ? AND org_id = ? AND location_id = ? AND " + col + " = ?",
      eid, org, loc, it.table, col, nv, it.rid, org, loc, String(it.row[col])));
    stmts.push(P("UPDATE " + it.table + " SET " + col + " = ? WHERE rowid = ? AND org_id = ? AND location_id = ? AND " + col + " = ?", nv, it.rid, org, loc, String(it.row[col])));
  }
  const summary = { changed: counts, kept, policy: pol, maybe_ticked: gdprPicked(body).size };
  stmts.push(P("UPDATE gdpr_erasures SET summary_json = ? WHERE erasure_id = ?", JSON.stringify(summary), eid));
  await env.DB.batch(stmts);
  const logged = await dbFirst(env, "SELECT COUNT(*) AS c, COUNT(DISTINCT table_name || ':' || row_id) AS r FROM gdpr_erasure_rows WHERE erasure_id = ?", [eid]);
  await writeAudit(env, org, uid, "PERSON_ERASE", "people", String(ctx.person.id), { location_id: loc, erasure_id: eid, rows: plan.total, changed: counts, kept, reason: reason || undefined, undo_hours: GDPR_UNDO_HOURS }, loc);
  const head = await dbFirst(env, "SELECT undo_until FROM gdpr_erasures WHERE erasure_id = ?", [eid]);
  return jsonResponse({ ok: true, erasure_id: eid, person: await peopleLoad(env, org, loc, ctx.person.id), changed: plan.total, tables: counts, kept, logged_values: Number(logged && logged.c || 0), logged_rows: Number(logged && logged.r || 0), undo_until: head && head.undo_until }, 200, cors);
}

// POST /people/erasures/:id/undo
async function handlePersonEraseUndo(request, env, cors, authUser, eid) {
  const g = await gdprGuard(request, env, cors, authUser); if (g) return g;
  const org = authUser.org_id, loc = authUser.location_id, uid = authUser.user_id;
  const head = await dbFirst(env, "SELECT *, (undo_until >= datetime('now')) AS open FROM gdpr_erasures WHERE erasure_id = ? AND org_id = ? AND location_id = ?", [eid, org, loc]);
  if (!head) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  if (head.status === "undone") return jsonResponse({ ok: false, error: "Already undone" }, 409, cors);
  if (!Number(head.open) || head.purged_at) return jsonResponse({ ok: false, code: "too_late", error: "The " + GDPR_UNDO_HOURS + " hours to undo this are over" }, 409, cors);
  const logs = await dbAll(env, "SELECT * FROM gdpr_erasure_rows WHERE erasure_id = ? AND org_id = ? AND location_id = ? ORDER BY id", [eid, org, loc]);
  const allowed = new Set(["people"].concat(GDPR_TABLES.map((d) => d.t)));
  const byRow = new Map();
  for (const l of logs) { if (!allowed.has(l.table_name)) continue; const k = l.table_name + ":" + l.row_id; if (!byRow.has(k)) byRow.set(k, []); byRow.get(k).push(l); }
  const P = (sql, ...b) => env.DB.prepare(sql).bind(...b);
  const stmts = [], skipped = [];
  let restored = 0;
  for (const ls of byRow.values()) {
    const t = ls[0].table_name, rid = ls[0].row_id;
    let cur = null;
    try { cur = await dbFirst(env, "SELECT * FROM " + t + " WHERE rowid = ? AND org_id = ? AND location_id = ?", [rid, org, loc]); } catch (e) { cur = null; }
    if (!cur) { skipped.push({ table: t, row_id: rid, reason: "no longer there" }); continue; }
    if (!ls.every((l) => gdprSame(cur[l.column_name], l.new_value))) { skipped.push({ table: t, row_id: rid, reason: "changed since" }); continue; }
    const def = GDPR_TABLES.find((d) => d.t === t);
    const uq = t === "people" ? "id_card" : def && def.unique;
    const uqLog = uq && ls.find((l) => l.column_name === uq && l.old_value);
    if (uqLog) {
      const clash = await dbFirst(env, "SELECT rowid AS r FROM " + t + " WHERE org_id = ? AND location_id = ? AND " + uq + " = ? AND rowid <> ?", [org, loc, uqLog.old_value, rid]);
      if (clash) {
        if (t === "people") return jsonResponse({ ok: false, error: "The ID card " + uqLog.old_value + " is now on another customer, so this cannot be put back" }, 409, cors);
        skipped.push({ table: t, row_id: rid, reason: "the old card is on another row now" }); continue;
      }
    }
    const sets = ls.map((l) => l.column_name + " = ?"), vals = ls.map((l) => l.old_value);
    if (t === "people") { sets.push("version = version + 1", "updated_at = datetime('now')", "updated_by = ?"); vals.push(uid); }
    stmts.push(P("UPDATE " + t + " SET " + sets.join(", ") + " WHERE rowid = ? AND org_id = ? AND location_id = ?", ...vals, rid, org, loc));
    restored++;
  }
  stmts.push(P("UPDATE gdpr_erasures SET status = 'undone', undone_at = datetime('now'), undone_by = ? WHERE erasure_id = ? AND status = 'done'", uid, eid));
  stmts.push(P("DELETE FROM gdpr_erasure_rows WHERE erasure_id = ?", eid));
  await env.DB.batch(stmts);
  await writeAudit(env, org, uid, "PERSON_ERASE_UNDO", "people", String(head.person_id), { location_id: loc, erasure_id: eid, restored, skipped: skipped.length ? skipped.slice(0, 50) : undefined }, loc);
  return jsonResponse({ ok: true, erasure_id: eid, restored, skipped, person: await peopleLoad(env, org, loc, head.person_id) }, 200, cors);
}

// GET /people/:id/erasures
async function handlePersonErasures(request, env, cors, authUser, id) {
  const g = await gdprGuard(request, env, cors, authUser); if (g) return g;
