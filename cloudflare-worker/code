  let etag = null;
  try { const dg = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(ics))); etag = '"' + [...dg.slice(0, 16)].map((b) => b.toString(16).padStart(2, "0")).join("") + '"'; } catch (e) {}
