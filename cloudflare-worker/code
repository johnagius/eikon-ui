// End of day, one read for the screen (Money department, eod): every saved day of a month (the register of past days,
// its gaps and differences, and the month's totals), and for the day being closed: the last day saved before it (its
// float and shift, "yesterday not closed") and that day's paid outs (the Paid out register); and the opening hours
// (closed days and Malta public holidays are not gaps). The emergency till is not part of the end of day (John, 2026-11-09). Read only; each query date-bounded on its table's (org, location, date) index.
// Replaces the screen's one-request-per-saved-day month read; the old routes stay as they are.
async function handleEodOverview(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureEndOfDaySchema(env);
  const month = String(url.searchParams.get("month") || "").trim();
  if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) return jsonResponse({ ok: false, error: "Missing/invalid month (YYYY-MM)" }, 400, corsOkHeaders);
  const range = monthRange(month);
  if (!range) return jsonResponse({ ok: false, error: "Invalid month" }, 400, corsOkHeaders);
  const date = String(url.searchParams.get("date") || "").trim();
  if (date && !isValidYmd(date)) return jsonResponse({ ok: false, error: "Invalid date (YYYY-MM-DD)" }, 400, corsOkHeaders);
  const sel = "SELECT e.*, l.name AS location_name FROM end_of_day e LEFT JOIN locations l ON l.id = e.location_id AND l.org_id = e.org_id WHERE e.org_id = ? AND e.location_id = ?";
  const ui = (row) => { const u = eodRowToUi(row); if (u && !u.location_name && authUser.location_name) u.location_name = authUser.location_name; return u; };
  const rows = await dbAll(env, sel + " AND e.eod_date >= ? AND e.eod_date < ? ORDER BY e.eod_date ASC", [authUser.org_id, authUser.location_id, range.startStr, range.endStr]);
  const out = { ok: true, month: month, records: rows.map(ui) };
  if (date) {
    out.date = date;
    out.before = ui(await dbFirst(env, sel + " AND e.eod_date < ? ORDER BY e.eod_date DESC LIMIT 1", [authUser.org_id, authUser.location_id, date]));
    await ensurePaidOutSchema(env);
    out.paid_out = await dbAll(env, "SELECT id, entry_time, payee_name, fee, payment_method, invoice_no, reason FROM paid_out_entries WHERE org_id = ? AND location_id = ? AND entry_date = ? ORDER BY entry_time ASC, id ASC", [authUser.org_id, authUser.location_id, date]);
  }
  // the Shifts screen's opening hours (one row): which days without an end of day are gaps and which were closed days
  try { await ensureShiftsSchema(env); const h = await dbFirst(env, "SELECT hours_json FROM shift_opening_hours WHERE org_id = ? AND location_id = ?", [authUser.org_id, authUser.location_id]); out.hours = h ? JSON.parse(h.hours_json || "{}") : {}; } catch (e) { out.hours = {}; }
  return jsonResponse(out, 200, corsOkHeaders);
}

