    if (!now.length) return "Your " + rpnDay(d) + (was.length > 1 ? " shifts (" + rpnTimes(was) + ") were removed" : " shift (" + rpnTimes(was) + ") was removed");
    if (rpnTimes(was) === rpnTimes(now)) return "Your " + rpnDay(d) + " shift " + rpnTimes(now) + " was updated";
