    counts[got.src.kind] = got.rows.length;
    for (const r of got.rows) activity.push({ kind: got.src.kind, label: got.src.label, id: r.id, date: String(r.date || "").slice(0, 10), title: String(r.title || "").slice(0, 200), ref: r.ref || "", doctor: r.doctor || "" });
  }
