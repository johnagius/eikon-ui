  const newStatus = String(body.status || "").trim();
  if (newStatus && !allowedStatuses.includes(newStatus)) {
    return jsonResponse({ ok: false, error: "Invalid status" }, 400, corsOkHeaders);
  }

  if (newStatus) {
    await dbRun(env, "UPDATE supplier_orders SET status = ?, updated_at = datetime('now') WHERE id = ?",
      [newStatus, orderId]);
  }
  if (body.notes !== undefined) {
    await dbRun(env, "UPDATE supplier_orders SET notes = ?, updated_at = datetime('now') WHERE id = ?",
      [String(body.notes).trim(), orderId]);
  }
  if (body.supplier_notes !== undefined) {
