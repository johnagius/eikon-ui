/* ══════════════════════════════════════════════════════════════════════════════
   VACCINATIONS GIVEN (Services, 2026-11-09) — a record of each vaccine given in the pharmacy: who, which vaccine,
   batch and expiry, site, dose, consent, and when the next dose is due (the recall).
   GET  /vaccines/given?month=YYYY-MM            { ok, given:[...] }  the month's vaccinations (index org/loc/given_on)
   GET  /vaccines/given?first=&last=&phone=      { ok, given:[...] }  one person's history (exact name or phone, 100 max)
   GET  /vaccines/given/due?to=YYYY-MM-DD        { ok, due:[...] }    recalls still open, due on or before `to`
                                                 (and not more than a year overdue), earliest first, 100 max
   POST /vaccines/given {...}                    { ok, given }        records one; closes this person's earlier open
                                                 recall for the same vaccine (that dose has now been given)
   POST /vaccines/given/:id/close                { ok }               a recall that is no longer needed (never deleted)
   next_state: 0 = recall open, 1 = answered by a later dose (closed_at/closed_by = who recorded it), 2 = closed by hand.
   Signed-in staff and admins; org_id and location_id come from the session, never the body. Audited.
   Additive: a new table only. Orders, their items and vaccine stock are not read or changed here.
   ══════════════════════════════════════════════════════════════════════════════ */
const VAX_SITES = ["Left upper arm", "Right upper arm", "Left thigh", "Right thigh", "By mouth", "Nose", "Other"];
const VAX_CONSENT = ["Patient", "Parent or guardian"];
async function ensureVaccinationsSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS vaccinations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    given_on TEXT NOT NULL,
    client_first TEXT NOT NULL,
    client_last TEXT NOT NULL,
    phone TEXT NOT NULL DEFAULT '',
    email TEXT NOT NULL DEFAULT '',
    id_card TEXT NOT NULL DEFAULT '',
    vaccine_name TEXT NOT NULL,
    dose TEXT NOT NULL DEFAULT '',
    batch TEXT NOT NULL DEFAULT '',
    expiry_date TEXT NOT NULL DEFAULT '',
    site TEXT NOT NULL DEFAULT '',
    consent_by TEXT NOT NULL DEFAULT '',
    next_due TEXT NOT NULL DEFAULT '',
    next_state INTEGER NOT NULL DEFAULT 0,
    order_id INTEGER NOT NULL DEFAULT 0,
    notes TEXT NOT NULL DEFAULT '',
    closed_at TEXT NOT NULL DEFAULT '',
    closed_by INTEGER,
    given_by INTEGER,
    given_by_name TEXT NOT NULL DEFAULT '',
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_vaccinations_org_loc_given ON vaccinations (org_id, location_id, given_on)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_vaccinations_org_loc_due ON vaccinations (org_id, location_id, next_state, next_due)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_vaccinations_org_loc_name ON vaccinations (org_id, location_id, client_last COLLATE NOCASE, client_first COLLATE NOCASE)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_vaccinations_org_loc_phone ON vaccinations (org_id, location_id, phone)`, []);
}
const ensureVaccinationsSchema = schemaOnce("ensureVaccinationsSchema", ensureVaccinationsSchema__impl);
const VAX_GIVEN_COLS = "id, given_on, client_first, client_last, phone, email, id_card, vaccine_name, dose, batch, expiry_date, site, consent_by, next_due, next_state, closed_at, order_id, notes, given_by_name, created_at";
function vaxRealYmd(s) { return isValidYmd(s) && new Date(s + "T12:00:00Z").toISOString().slice(0, 10) === s; }
async function handleVaccinationsGiven(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = Number(authUser.org_id), loc = Number(authUser.location_id);
  const parts = url.pathname.split("/").filter(Boolean); // vaccines, given, [due | :id, close]
  await ensureVaccinationsSchema(env);
  if (parts.length === 3 && parts[2] === "due") {
    if (request.method !== "GET") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, corsOkHeaders);
    let to = String(url.searchParams.get("to") || "").trim();
    if (!to) to = ymdPlusDays(tzYmd(), 14);
    if (!vaxRealYmd(to)) return jsonResponse({ ok: false, error: "Missing/invalid to (YYYY-MM-DD)" }, 400, corsOkHeaders);
    const from = ymdPlusDays(tzYmd(), -366);
    const due = await dbAll(env, `SELECT ${VAX_GIVEN_COLS} FROM vaccinations WHERE org_id = ? AND location_id = ? AND next_state = 0 AND next_due >= ? AND next_due <= ? ORDER BY next_due ASC, id ASC LIMIT 100`, [org, loc, from, to]);
    return jsonResponse({ ok: true, due, to }, 200, corsOkHeaders);
  }
  if (parts.length === 4 && parts[3] === "close") {
    if (request.method !== "POST") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, corsOkHeaders);
    const id = parseInt(parts[2], 10);
    if (!id) return jsonResponse({ ok: false, error: "Invalid id" }, 400, corsOkHeaders);
    const row = await dbFirst(env, "SELECT id, next_state, vaccine_name, client_first, client_last FROM vaccinations WHERE id = ? AND org_id = ? AND location_id = ?", [id, org, loc]);
    if (!row) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
    if (Number(row.next_state) !== 0) return jsonResponse({ ok: true, already: true }, 200, corsOkHeaders);
    await dbRun(env, "UPDATE vaccinations SET next_state = 2, closed_at = ?, closed_by = ? WHERE id = ? AND org_id = ? AND location_id = ?", [nowIso(), authUser.user_id, id, org, loc]);
    await writeAudit(env, org, authUser.user_id, "VAX_RECALL_CLOSE", "vaccinations", String(id), { vaccine_name: row.vaccine_name, client_first: row.client_first, client_last: row.client_last }, loc);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }
  if (parts.length !== 2) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  if (request.method === "GET") {
    const month = String(url.searchParams.get("month") || "").trim();
    const first = vaxNormName(url.searchParams.get("first") || ""), last = vaxNormName(url.searchParams.get("last") || ""), phone = vaxNormName(url.searchParams.get("phone") || "");
    if (month) {
      const range = /^\d{4}-(0[1-9]|1[0-2])$/.test(month) ? monthRange(month) : null;
      if (!range) return jsonResponse({ ok: false, error: "Missing/invalid month (YYYY-MM)" }, 400, corsOkHeaders);
      const given = await dbAll(env, `SELECT ${VAX_GIVEN_COLS} FROM vaccinations WHERE org_id = ? AND location_id = ? AND given_on >= ? AND given_on < ? ORDER BY given_on DESC, id DESC LIMIT 500`, [org, loc, range.startStr, range.endStr]);
      return jsonResponse({ ok: true, given }, 200, corsOkHeaders);
    }
    if ((first && last) || phone) { // two index reads (surname, phone), merged: never a scan of the pharmacy's rows
      const byName = first && last ? await dbAll(env, `SELECT ${VAX_GIVEN_COLS} FROM vaccinations WHERE org_id = ? AND location_id = ? AND client_last = ? COLLATE NOCASE AND client_first = ? COLLATE NOCASE LIMIT 100`, [org, loc, last, first]) : [];
      const byPhone = phone ? await dbAll(env, `SELECT ${VAX_GIVEN_COLS} FROM vaccinations WHERE org_id = ? AND location_id = ? AND phone = ? LIMIT 100`, [org, loc, phone]) : [];
      const seen = new Set(), given = [];
      for (const r of byName.concat(byPhone)) if (!seen.has(r.id)) { seen.add(r.id); given.push(r); }
      given.sort((a, b) => String(b.given_on).localeCompare(String(a.given_on)) || b.id - a.id);
      given.length = Math.min(given.length, 100);
      return jsonResponse({ ok: true, given }, 200, corsOkHeaders);
    }
    return jsonResponse({ ok: false, error: "Give a month, or a person (first and last name, or phone)" }, 400, corsOkHeaders);
  }
  if (request.method !== "POST") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, corsOkHeaders);
  const b = (await readJson(request)) || {};
  const s = (k, n) => vaxNormName(b[k] == null ? "" : b[k]).slice(0, n || 200);
  const rec = { given_on: s("given_on", 10), client_first: s("client_first"), client_last: s("client_last"), phone: s("phone", 40), email: s("email"), id_card: s("id_card", 20),
    vaccine_name: s("vaccine_name"), dose: s("dose", 40), batch: s("batch", 60), expiry_date: s("expiry_date", 10), site: s("site", 40), consent_by: s("consent_by", 40),
    next_due: s("next_due", 10), order_id: Math.max(0, vaxInt(b.order_id, 0)), notes: s("notes", 1000) };
  const today = tzYmd();
  if (!rec.given_on) rec.given_on = today;
  if (!vaxRealYmd(rec.given_on) || rec.given_on > today || rec.given_on < "2000-01-01") return jsonResponse({ ok: false, error: "Choose the day it was given (not after today)" }, 400, corsOkHeaders);
  if (!rec.client_first || !rec.client_last) return jsonResponse({ ok: false, error: "Missing client name" }, 400, corsOkHeaders);
  if (!rec.vaccine_name) return jsonResponse({ ok: false, error: "Missing vaccine" }, 400, corsOkHeaders);
  if (rec.expiry_date && !vaxRealYmd(rec.expiry_date)) return jsonResponse({ ok: false, error: "Expiry must be a date (YYYY-MM-DD)" }, 400, corsOkHeaders);
  if (rec.next_due && (!vaxRealYmd(rec.next_due) || rec.next_due <= rec.given_on)) return jsonResponse({ ok: false, error: "The next dose must be due after the day it was given" }, 400, corsOkHeaders);
  if (VAX_SITES.indexOf(rec.site) < 0) return jsonResponse({ ok: false, error: "Choose where it was given" }, 400, corsOkHeaders);
  if (VAX_CONSENT.indexOf(rec.consent_by) < 0) return jsonResponse({ ok: false, error: "Consent is needed: by the patient, or a parent or guardian" }, 400, corsOkHeaders);
  const me = await dbFirst(env, "SELECT full_name, email FROM users WHERE id = ?", [authUser.user_id]);
  const byName = String((me && (me.full_name || me.email)) || "").trim();
  const ins = await dbRun(env, `INSERT INTO vaccinations (org_id, location_id, given_on, client_first, client_last, phone, email, id_card, vaccine_name, dose, batch, expiry_date, site, consent_by, next_due, next_state, order_id, notes, given_by, given_by_name)
    VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,?,?,?,?)`,
    [org, loc, rec.given_on, rec.client_first, rec.client_last, rec.phone, rec.email, rec.id_card, rec.vaccine_name, rec.dose, rec.batch, rec.expiry_date, rec.site, rec.consent_by, rec.next_due, rec.order_id, rec.notes, authUser.user_id, byName]);
  const id = ins && ins.meta && ins.meta.last_row_id ? Number(ins.meta.last_row_id) : 0;
  if (!id) return jsonResponse({ ok: false, error: "Could not save the vaccination" }, 500, corsOkHeaders);
  // this dose answers the person's earlier open recall for the same vaccine
  const closed = await dbRun(env, `UPDATE vaccinations SET next_state = 1, closed_at = ?, closed_by = ? WHERE org_id = ? AND location_id = ? AND id <> ? AND next_state = 0 AND next_due <> '' AND vaccine_name = ? COLLATE NOCASE
      AND ((client_last = ? COLLATE NOCASE AND client_first = ? COLLATE NOCASE)` + (rec.phone ? " OR phone = ?" : "") + ")",
    [nowIso(), authUser.user_id, org, loc, id, rec.vaccine_name, rec.client_last, rec.client_first].concat(rec.phone ? [rec.phone] : []));
  await writeAudit(env, org, authUser.user_id, "VAX_GIVEN_CREATE", "vaccinations", String(id), rec, loc);
  const given = await dbFirst(env, `SELECT ${VAX_GIVEN_COLS} FROM vaccinations WHERE id = ?`, [id]);
  return jsonResponse({ ok: true, given, closed_recalls: (closed && closed.meta && closed.meta.changes) || 0 }, 200, corsOkHeaders);
}

