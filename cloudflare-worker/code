async function handleAdminRecoverPost(request, env) {
  try {
    let payload = await parseForm(request);
    if (!payload) {
      try { payload = await readJson(request); } catch { payload = {}; }
    }

    const bootstrapToken = (payload.bootstrap_token || "").trim();
    const email = (payload.email || "").trim().toLowerCase();
    const verifyPassword = (payload.verify_password || "").trim();
    const newPassword = (payload.new_password || "").trim();

    if (!bootstrapToken || !email) {
      return htmlPage("Recovery error", `<h1>Recovery error</h1><p class="err">Bootstrap token and email are required.</p>`);
    }

    // Rate limit: max 5 attempts per 15 minutes (keyed by email)
    const RATE_WINDOW_SECONDS = 900;
    const RATE_MAX_ATTEMPTS = 5;
    try {
      await dbRun(env, `CREATE TABLE IF NOT EXISTS recover_attempts (email TEXT NOT NULL, attempted_at TEXT NOT NULL)`, []);
      // Clean up old entries
      await dbRun(env, `DELETE FROM recover_attempts WHERE attempted_at < datetime('now', '-${RATE_WINDOW_SECONDS} seconds')`, []);
      const countRow = await dbFirst(env, `SELECT COUNT(*) AS c FROM recover_attempts WHERE email = ?`, [email]);
      if (countRow && countRow.c >= RATE_MAX_ATTEMPTS) {
        return htmlPage("Recovery error", `<h1>Recovery error</h1><p class="err">Too many attempts. Please wait 15 minutes before trying again.</p>`);
      }
      // Record this attempt
      await dbRun(env, `INSERT INTO recover_attempts (email, attempted_at) VALUES (?, datetime('now'))`, [email]);
    } catch { /* if table ops fail, continue — don't block recovery entirely */ }

    if ((env.BOOTSTRAP_TOKEN || "").trim() !== bootstrapToken) {
      // Audit: log failed token attempt
      try { await writeAudit(env, 0, null, "ADMIN_RECOVER_BAD_TOKEN", "user", "", { email }); } catch {}
      // Deliberate delay to slow brute-force
      await new Promise(r => setTimeout(r, 2000));
      return htmlPage("Recovery error", `<h1>Recovery error</h1><p class="err">Invalid bootstrap token.</p>`);
    }

    if (!verifyPassword && !newPassword) {
      return htmlPage("Recovery error", `<h1>Recovery error</h1><p class="err">Provide a password to verify, a new password to set, or both.</p>`);
    }

    const user = await dbFirst(
      env,
      `SELECT id, org_id, email, full_name, role, pass_salt_b64, pass_hash_b64, pass_iters, is_active, default_location_id
       FROM users WHERE email = ?`,
      [email]
    );

    if (!user) {
      // Don't reveal whether email exists — use same generic message
      try { await writeAudit(env, 0, null, "ADMIN_RECOVER_NOT_FOUND", "user", "", { email }); } catch {}
      return htmlPage("Recovery error", `<h1>Recovery error</h1><p class="err">No user found with email <code>${escapeHtml(email)}</code>.</p>`);
    }

    let results = [];

    // Account status info
    results.push(`<p><b>Account:</b> ${escapeHtml(user.email)} (${escapeHtml(user.full_name || "no name")})</p>`);
    results.push(`<p><b>Role:</b> ${escapeHtml(user.role)}</p>`);
    results.push(`<p><b>Active:</b> ${user.is_active === 1 ? '<span class="ok">Yes</span>' : '<span class="err">No (account is on hold)</span>'}</p>`);
    results.push(`<p><b>Default Location ID:</b> ${user.default_location_id ? user.default_location_id : '<span class="err">None (login will fail!)</span>'}</p>`);

    // Verify current password if provided
    if (verifyPassword) {
      const saltBytes = bytesFromBase64(user.pass_salt_b64);
      const derived = await pbkdf2Hash(verifyPassword, saltBytes, user.pass_iters);
      const stored = bytesFromBase64(user.pass_hash_b64);
      const match = constantTimeEqual(derived, stored);

      if (match) {
        results.push(`<p class="ok">Password verification: CORRECT — the password you entered matches.</p>`);
        try { await writeAudit(env, user.org_id, user.id, "ADMIN_RECOVER_VERIFY_OK", "user", String(user.id), { email }); } catch {}
      } else {
        results.push(`<p class="err">Password verification: INCORRECT — the password you entered does NOT match.</p>`);
        try { await writeAudit(env, user.org_id, user.id, "ADMIN_RECOVER_VERIFY_FAIL", "user", String(user.id), { email }); } catch {}
      }
    }

    // Reset password if new_password provided
    if (newPassword) {
      const iters = 100000;
      const salt = crypto.getRandomValues(new Uint8Array(16));
      const hash = await pbkdf2Hash(newPassword, salt, iters);
      const saltB64 = base64FromBytes(salt);
      const hashB64 = base64FromBytes(hash);

      await dbRun(env, "UPDATE users SET pass_salt_b64=?, pass_hash_b64=?, pass_iters=? WHERE id=?", [saltB64, hashB64, iters, user.id]);
      try { await dbRun(env, "DELETE FROM sessions WHERE user_id=?", [user.id]); } catch {}

      results.push(`<p class="ok">Password has been RESET successfully. All existing sessions have been cleared.</p>`);
      try { await writeAudit(env, user.org_id, user.id, "ADMIN_RECOVER_RESET", "user", String(user.id), { email }); } catch {}
    }

    return htmlPage(
      "Admin Recovery",
      `<h1>Admin Recovery Result</h1>
<div class="card">
  ${results.join("\n  ")}
  <p style="margin-top:12px;"><a href="/admin-recover">← Back</a></p>
</div>`
    );
  } catch (e) {
    return htmlPage(
      "Recovery error",
      `<h1>Recovery error</h1>
<p class="err">The Worker caught an exception.</p>
<pre style="white-space:pre-wrap;background:#f6f6f6;padding:12px;border-radius:10px;border:1px solid #ddd;">${escapeHtml(e && (e.stack || e.message || String(e)))}</pre>`
    );
  }
}

