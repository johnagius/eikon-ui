    `CREATE TABLE IF NOT EXISTS bk_bookings (
      id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
      ref TEXT NOT NULL DEFAULT '', service_id INTEGER NOT NULL, provider_id INTEGER NOT NULL,
      person_name TEXT NOT NULL, person_phone TEXT NOT NULL DEFAULT '', person_email TEXT NOT NULL DEFAULT '',
      person_id_card TEXT NOT NULL DEFAULT '', date TEXT NOT NULL, start_time TEXT NOT NULL, end_time TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'booked', price_cents INTEGER NOT NULL DEFAULT 0, notes TEXT NOT NULL DEFAULT '',
      cancel_reason TEXT NOT NULL DEFAULT '', link_id TEXT NOT NULL DEFAULT '', version INTEGER NOT NULL DEFAULT 1,
