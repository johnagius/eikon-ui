async function handlePosSalesSync(request, env, corsOkHeaders, authUser) {
  await ensurePosSchema(env);
  const body = await readJson(request);
  const sales = Array.isArray(body.sales) ? body.sales : [];
  if (!sales.length) return jsonResponse({ ok: true, synced: 0, results: [] }, 200, corsOkHeaders);
  const results = [];
  for (const s of sales) {
    try {
      const offlineId = String(s.offline_id || "").trim() || null;
      if (!offlineId) { results.push({ offline_id: null, ok: false, error: "Missing offline_id" }); continue; }
      const existing = await dbFirst(env, `SELECT id FROM pos_sales WHERE org_id=? AND location_id=? AND offline_id=?`,
        [authUser.org_id, authUser.location_id, offlineId]);
      if (existing) { results.push({ offline_id: offlineId, ok: true, id: existing.id, duplicate: true }); continue; }
      const saleDate = String(s.sale_date || "").trim() || tzYmd();
      const itemsJson = JSON.stringify(Array.isArray(s.items) ? s.items : []);
      // Queued offline sales are accepted (the money already changed hands) but recomputed;
      // a short cash sale is kept and flagged in the notes rather than lost.
      const m = posComputeSale(s);
      const noteParts = [String(s.notes || "").trim()];
      if (m.short) noteParts.push("[tendered below total at the till]");
      const row = await dbFirst(env, `INSERT INTO pos_sales
        (org_id, location_id, sale_date, receipt_no, items_json, subtotal, vat_total, total,
         payment_method, amount_tendered, change_given, notes, client_name, client_id,
         offline_id, voided, created_by, created_at, updated_at, discount_pct)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,?,datetime('now'),datetime('now'),?)
        RETURNING id`,
        [authUser.org_id, authUser.location_id, saleDate,
         String(s.receipt_no || "").trim(), itemsJson,
         m.subtotal, m.vatTotal, m.total, m.paymentMethod, m.tendered, m.change,
         noteParts.filter(Boolean).join(" "),
         String(s.client_name || "").trim(),
         String(s.client_id || "").trim(),
         offlineId, authUser.user_id, m.discountPct]);
      results.push({ offline_id: offlineId, ok: true, id: row.id });
    } catch (e) {
      results.push({ offline_id: s.offline_id, ok: false, error: String(e && (e.message || e)) });
    }
  }
  const synced = results.filter(r => r.ok && !r.duplicate).length;
  await writeAudit(env, authUser.org_id, authUser.user_id, "EPOS_SALES_SYNC", "pos_sales", "", { synced, total: sales.length }, authUser.location_id);
  return jsonResponse({ ok: true, synced, results }, 200, corsOkHeaders);
}

