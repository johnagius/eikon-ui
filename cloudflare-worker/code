// ═══════════════════════════════════════════════════════════════════════════
const PHARMACY_TZ = "Europe/Malta";
// /today's repeats superset (see __p_rep): how far ahead an expiry is sent, and at most how many lines.
// The screen's "running out within N days" (ui/eikon.repeatdue.js RULES.RUN_OUT_WITHIN_DAYS) must not exceed this.
const REPEATS_LOOKAHEAD_DAYS = 92;
const REPEATS_MAX_ROWS = 400;
function tzYmd(d) {
  return new Intl.DateTimeFormat("en-CA", { timeZone: PHARMACY_TZ, year: "numeric", month: "2-digit", day: "2-digit" }).format(d || new Date());
}
function tzHm(d) {
  return new Intl.DateTimeFormat("en-GB", { timeZone: PHARMACY_TZ, hour: "2-digit", minute: "2-digit", hour12: false }).format(d || new Date());
}
function ymdPlusDays(ymd, n) {
  const p = String(ymd || "").split("-").map(Number);
  if (p.length !== 3 || p.some((x) => !Number.isFinite(x))) return "";
  return new Date(Date.UTC(p[0], p[1] - 1, p[2] + n)).toISOString().slice(0, 10);
}
function ymdDiffDays(from, to) {
