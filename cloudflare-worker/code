//  8. only when there are handover points and the handover's "I've read it" table exists (T-C3, never made here):
//     whether this person read them.
// Nothing is written. No new table, column or index.
// ═══════════════════════════════════════════════════════════════════════════
const TEAM_HANDOVER_BACK = 4; // the Handover screen looks this many days back for the last points left
function teamStr(v, n) { return String(v == null ? "" : v).slice(0, n || 120); }
// Opening hours for a day as the new Plan shifts screen reads them (hoursFor in ui/modules.shfreg.js): a one-day override,
// the weekly hours, then the old default with the Saturday/Sunday flags. A public holiday is the screen's decision
// (E.teamCover: closed unless a one-day override opens it), so the override is flagged and the holiday named apart.
function teamHoursFor(h, ymd) {
  h = h && typeof h === "object" ? h : {};
  const ov = h.overrides && typeof h.overrides === "object" ? h.overrides[ymd] : null;
  if (ov && typeof ov === "object") return { open: teamStr(ov.open, 5), close: teamStr(ov.close, 5), closed: moneyBool(ov.closed), override: true };
