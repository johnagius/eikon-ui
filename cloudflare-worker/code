async function handleSupplierOrderConfirm(request, env, corsOkHeaders, authUser, orderId) {
  await ensureSupplierProductsSchema(env);

  const order = await dbFirst(env,
    `SELECT * FROM supplier_orders WHERE supplier_location_id = ? AND id = ?`,
    [authUser.location_id, orderId]);
  if (!order) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

  const body = await readJson(request);
  const newStatus = String(body.status || "shipped").trim();
  if (newStatus !== "shipped" && newStatus !== "confirmed") {
    return jsonResponse({ ok: false, error: "Invalid status" }, 400, corsOkHeaders);
  }

  // Update item-level unavailability if provided
  const itemUpdates = Array.isArray(body.items) ? body.items : [];
  for (const iu of itemUpdates) {
    if (iu.id) {
      await dbRun(env,
        `UPDATE supplier_order_items SET unavailable = ?, qty_confirmed = ?, notes = ? WHERE order_id = ? AND id = ?`,
        [
          iu.unavailable ? 1 : 0,
          Math.max(0, Math.round(Number(iu.qty_confirmed) || 0)),
          String(iu.notes || "").trim(),
          orderId, iu.id
        ]
      );
    }
  }

  // Build update fields for order
  const setParts = ["status = ?", "updated_at = datetime('now')"];
  const setBinds = [newStatus];
  if (body.supplier_notes !== undefined) {
    setParts.push("supplier_notes = ?");
    setBinds.push(String(body.supplier_notes).trim());
  }
  if (body.scheduled_delivery_date !== undefined) {
    setParts.push("scheduled_delivery_date = ?");
    setBinds.push(String(body.scheduled_delivery_date).trim());
  }
  setBinds.push(orderId);
  await dbRun(env, "UPDATE supplier_orders SET " + setParts.join(", ") + " WHERE id = ?", setBinds);

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_ORDER_CONFIRM", "supplier_orders", String(orderId), { status: newStatus }, authUser.location_id);

  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

