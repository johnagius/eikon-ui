// TODAY'S SERVICES  (svc-hub, contract V-C1)
// What the Services page needs, in ONE read: GET /services/today, asked when the Services hub opens (not by Today, which
// is re-read every minute: nothing here is added to /today). Read only, this pharmacy only, admin and staff (the roles
// that open POCT, Vaccines, Screening, Pharmacovigilance and Bookings). Plain facts; the words and colours are the
// screen's (ui/eikon.svctoday.js). Each statement bounded by the pharmacy and a date, a short range or a LIMIT:
//  - reaction reports not yet sent (status not "Submitted…" or "Closed"), oldest first (JSON parsed here, never shipped);
//  - screening campaigns (JSON, people inside): the ones running today, and follow-ups due today or earlier;
//  - point-of-care tests done today (three-day index range on performed_at_iso, counted by the Malta day);
//  - vaccine stock rows (expired, expiring within 30 days, out of stock), vaccine orders taken today (index range), and
//    doses due from the vaccinations record when that table exists (vax; absent → null, nothing created here);
//  - today's bookings (the Bookings screen's own rows), no cancelled ones.
// Nothing is written. No new table, column or index.
// ═══════════════════════════════════════════════════════════════════════════
const SVC_SOON_DAYS = 30;     // a vaccine batch "expires soon" within this many days
const SVC_MAX_DOCS = 300;     // reaction reports / screening campaigns looked at, newest first
function svcStr(v, n) { return String(v == null ? "" : v).slice(0, n || 120); }
async function handleServicesToday(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  const today = tzYmd(), nowHm = tzHm(), soonBy = ymdPlusDays(today, SVC_SOON_DAYS);
  const all = async (sql, bind) => { try { return await dbAll(env, sql, bind); } catch (e) { return null; } };
  await Promise.all([ensurePvSchema, ensureScreeningSchema, ensurePoctSchema, ensureVaccinesSchema, ensureBookingsSchema]
    .map((fn) => Promise.resolve().then(() => fn(env)).catch(() => {})));
  const [pvs, scs, pocs, stock, vord, vdue, bks] = await Promise.all([
    all(`SELECT report_id, report_json FROM pv_reports WHERE org_id = ? AND location_id = ?
          AND LOWER(COALESCE(json_extract(report_json, '$.status'), '')) NOT LIKE 'submitted%'
          AND LOWER(COALESCE(json_extract(report_json, '$.status'), '')) <> 'closed'
        ORDER BY id DESC LIMIT ${SVC_MAX_DOCS}`, [org, loc]),
    all(`SELECT campaign_id, campaign_json FROM screening_campaigns WHERE org_id = ? AND location_id = ? ORDER BY updated_at DESC, id DESC LIMIT ${SVC_MAX_DOCS}`, [org, loc]),
    all(`SELECT performed_at_iso, performed_at_local FROM poct_records WHERE org_id = ? AND location_id = ? AND performed_at_iso >= ? AND performed_at_iso < ?`,
      [org, loc, ymdPlusDays(today, -1), ymdPlusDays(today, 2)]),
    all(`SELECT vaccine_name, qty, batch, expiry_date FROM vaccines_stock WHERE org_id = ? AND location_id = ? ORDER BY vaccine_name LIMIT 500`, [org, loc]),
    all(`SELECT created_at FROM vaccines_orders WHERE org_id = ? AND location_id = ? AND created_at >= ? AND created_at < ?`,
      [org, loc, ymdPlusDays(today, -1), ymdPlusDays(today, 2)]),
    // vax's record of vaccinations given (merged before svc-hub): an open next dose due today or earlier. No table yet → null.
    all(`SELECT id, client_first, client_last, vaccine_name, dose, next_due FROM vaccinations
          WHERE org_id = ? AND location_id = ? AND next_state = 0 AND next_due >= ? AND next_due <= ?
          ORDER BY next_due ASC, id ASC LIMIT 100`, [org, loc, ymdPlusDays(today, -366), today]), // vax's own bound: open recalls, at most a year overdue
    all(`SELECT b.id, b.start_time, b.person_name, b.status, s.name AS service
           FROM bk_bookings b LEFT JOIN bk_services s ON s.id = b.service_id
          WHERE b.org_id = ? AND b.location_id = ? AND b.date = ? AND b.status <> 'cancelled'
          ORDER BY b.start_time ASC, b.id ASC LIMIT 200`, [org, loc, today])
  ]);

  let pv = null;
  if (pvs != null) {
    const list = [];
    for (const r of pvs) {
      let v = null; try { v = JSON.parse(String(r.report_json)); } catch (e) { v = null; }
      if (!v || typeof v !== "object") continue;
      const drugs = Array.isArray(v.drugs) ? v.drugs : [];
      const made = /^\d{4}-\d{2}-\d{2}/.test(String(v.report_date || "")) ? String(v.report_date).slice(0, 10) : ownerMaltaDay(v.created_at) || "";
      list.push({ id: svcStr(r.report_id, 80), date: made, status: svcStr(v.status || "Draft", 60), serious: /^serious|^fatal/i.test(String(v.reaction_seriousness || "")),
        reaction: svcStr(v.reaction_meddra || v.reaction_description, 80), medicine: svcStr(drugs[0] && drugs[0].name, 80) });
    }
    list.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
    pv = { drafts: list.length, serious: list.filter((x) => x.serious).length, oldest_draft_date: list.length ? list[0].date || null : null, reports: list.slice(0, 5) };
  }

  let screening = null, followups = null;
  if (scs != null) {
    const running = [], due = [];
    for (const r of scs) {
      let c = null; try { c = JSON.parse(String(r.campaign_json)); } catch (e) { c = null; }
      if (!c || typeof c !== "object") continue;
      const cid = svcStr(c.id || r.campaign_id, 80), people = Array.isArray(c.participants) ? c.participants : [];
      // the classic screen's own rule: cancelled, ended (end date past), running (started, not ended), else planned
      if (c.status !== "Cancelled" && c.startDate && String(c.startDate) <= today && (!c.endDate || String(c.endDate) >= today))
        running.push({ id: cid, name: svcStr(c.name, 80), type: svcStr(c.type, 60), end: c.endDate ? String(c.endDate).slice(0, 10) : null,
          screened: people.length, today: people.filter((p) => p && String(p.date || "") === today).length, target: Number(c.targetScreenings) || 0 });
      for (const p of people) {
        for (const f of (p && Array.isArray(p.followUps) ? p.followUps : [])) {
          // as the classic follow-ups list: due by its date until it is Completed or Cancelled
          if (!f || !f.scheduledDate || f.status === "Completed" || f.status === "Cancelled") continue;
          const d = String(f.scheduledDate).slice(0, 10);
          if (d > today) continue;
          due.push({ campaign_id: cid, campaign: svcStr(c.name, 80), participant_id: svcStr(p.id, 80), name: svcStr(p.name, 80), date: d, reason: svcStr(f.reason, 80), status: svcStr(f.status || "Pending", 20) });
        }
      }
    }
    running.sort((a, b) => (String(a.end || "9") < String(b.end || "9") ? -1 : 1));
    due.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
    screening = { running: running.slice(0, 10) };
    followups = { count: due.length, overdue: due.filter((x) => x.date < today).length, due: due.slice(0, 20) };
  }

  const poct = pocs == null ? null : { today: pocs.filter((r) => (String(r.performed_at_local || "").slice(0, 10) || ownerMaltaDay(r.performed_at_iso)) === today).length };

  let vaccines = null;
  if (stock != null) {
    const held = stock.filter((v) => (Number(v.qty) || 0) > 0 && v.expiry_date);
    const expired = held.filter((v) => String(v.expiry_date) < today), soon = held.filter((v) => String(v.expiry_date) >= today && String(v.expiry_date) <= soonBy);
    const sum = {}; for (const v of stock) { const k = String(v.vaccine_name || "").trim(); if (k) sum[k] = (sum[k] || 0) + (Number(v.qty) || 0); }
    const pick = (v) => ({ name: svcStr(v.vaccine_name, 80), batch: svcStr(v.batch, 40), expiry: String(v.expiry_date).slice(0, 10), qty: Number(v.qty) || 0 });
    const by = (a, b) => (a.expiry < b.expiry ? -1 : a.expiry > b.expiry ? 1 : 0);
    vaccines = { orders_today: vord == null ? null : vord.filter((o) => ownerMaltaDay(o.created_at) === today).length,
      expired: expired.length, expiring30: soon.length, soon_days: SVC_SOON_DAYS, out_of_stock: Object.keys(sum).filter((k) => sum[k] <= 0).length,
      batches: expired.map(pick).sort(by).concat(soon.map(pick).sort(by)).slice(0, 5),
      due: vdue == null ? null : { count: vdue.length, overdue: vdue.filter((x) => String(x.next_due) < today).length,
        first: vdue.slice(0, 5).map((x) => ({ id: x.id, name: svcStr((String(x.client_first || "") + " " + String(x.client_last || "")).trim(), 80), vaccine: svcStr(x.vaccine_name, 80), dose: svcStr(x.dose, 30), next_due: String(x.next_due).slice(0, 10) })) } };
  }

  let bookings = null, bookings_summary = null;
  if (bks != null) {
    const st = (b) => String(b.status || "");
    const open = bks.filter((b) => st(b) === "booked" || st(b) === "confirmed");
    const late = open.filter((b) => String(b.start_time) < nowHm).length; // started and not marked arrived, done or no-show
    // the ones still to see first (late, then to come), then arrived, then the finished ones, at most 20
    const rank = (b) => (st(b) === "booked" || st(b) === "confirmed" ? 0 : st(b) === "arrived" ? 1 : 2);
    bookings = bks.slice().sort((a, b) => rank(a) - rank(b) || (a.start_time < b.start_time ? -1 : a.start_time > b.start_time ? 1 : a.id - b.id)).slice(0, 20)
      .map((b) => ({ id: b.id, start_time: svcStr(b.start_time, 5), person_name: svcStr(b.person_name, 80), service: svcStr(b.service, 80), status: st(b) }));
    bookings_summary = { total: bks.length, done: bks.filter((b) => st(b) === "done").length, arrived: bks.filter((b) => st(b) === "arrived").length,
      no_show: bks.filter((b) => st(b) === "no_show").length, late, to_come: open.length - late };
  }

  return jsonResponse({ ok: true, date: today, time: nowHm, timezone: PHARMACY_TZ, bookings, bookings_summary, followups, pv, screening, poct, vaccines },
    200, { ...corsOkHeaders, "Cache-Control": "private, max-age=10", "Vary": "Origin, Authorization" });
}

