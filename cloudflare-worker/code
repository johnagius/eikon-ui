async function handleScarceNeedOfferConfirm(request, env, corsOkHeaders, authUser, offerId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureScarceStockSchema(env);

  const id = Number(offerId);
  if (!Number.isFinite(id) || id <= 0) return jsonResponse({ ok: false, error: "Invalid offer id" }, 400, corsOkHeaders);

  const existing = await dbFirst(env, `SELECT o.id, o.need_id, o.offerer_org_id, o.offerer_location_id, o.quantity_offered, COALESCE(o.confirmed, 0) AS confirmed FROM scarce_stock_need_offers o WHERE o.id = ?`, [id]);
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

  // Only the offerer can confirm
  if (!(existing.offerer_org_id === authUser.org_id && existing.offerer_location_id === authUser.location_id)) {
    return jsonResponse({ ok: false, error: "Forbidden: only the offering location can confirm" }, 403, corsOkHeaders);
  }

  await dbRun(env, `UPDATE scarce_stock_need_offers SET confirmed = 1, updated_at = datetime('now'), updated_by = ? WHERE id = ?`, [authUser.user_id, id]);

  // Deduct from the need's quantity or close the need if fully fulfilled
  const need = await dbFirst(env, `SELECT id, quantity_needed, is_closed FROM scarce_stock_needs WHERE id = ?`, [existing.need_id]);
  if (need) {
    const confirmedTotal = await dbFirst(env, `SELECT COALESCE(SUM(quantity_offered), 0) AS total FROM scarce_stock_need_offers WHERE need_id = ? AND confirmed = 1`, [existing.need_id]);
    const totalConfirmed = Number((confirmedTotal && confirmedTotal.total) || 0);
    const qtyNeeded = Number(need.quantity_needed || 0);

    if (totalConfirmed >= qtyNeeded) {
      // Fully fulfilled — close the need and set remaining to 0
      await dbRun(env, `UPDATE scarce_stock_needs SET quantity_needed = ?, is_closed = 1, updated_at = datetime('now'), updated_by = ? WHERE id = ?`, [totalConfirmed, authUser.user_id, existing.need_id]);
    } else {
      // Partially fulfilled — deduct from remaining (keep quantity_needed as-is; remaining is computed)
      // No change needed — remaining_quantity is computed as quantity_needed - total_offered in the GET
    }
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "SCARCE_NEED_OFFER_CONFIRM", "scarce_stock_need_offers", String(id), { need_id: existing.need_id, quantity_offered: existing.quantity_offered }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

