// POST /people/:id/profile { prefers, email_ok, sms_ok, whatsapp_ok, lang, allergies, version }
async function handleCustProfile(request, env, cors, authUser, id) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, cors);
  const org = authUser.org_id, loc = authUser.location_id;
  await ensurePeopleSchema(env); await ensureCustMsgSchema(env);
  const person = await peopleLoad(env, org, loc, id);
  if (!person || person.merged_into) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  const b = (await readJson(request)) || {};
  const beforeRow = await dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, id]);
  const before = cmProfileOut(beforeRow);
  const sent = b.version === undefined || b.version === null ? null : Number(b.version);
  if (sent !== null && sent !== before.version) return jsonResponse({ ok: false, error: "Changed elsewhere", current: before }, 409, cors);
  const yn = (v, cur) => (v === undefined ? cur : v === null || v === "" ? null : (v === true || v === 1 || v === "1" || v === "yes") ? 1 : 0);
  const prefers = b.prefers === undefined ? before.prefers : String(b.prefers || "").toLowerCase();
  if (!CM_PREFERS.includes(prefers)) return jsonResponse({ ok: false, error: "Choose WhatsApp, SMS, e-mail or a call" }, 400, cors);
  const lang = b.lang === undefined ? before.lang : String(b.lang || "").toLowerCase();
  if (!["", "en", "mt"].includes(lang)) return jsonResponse({ ok: false, error: "Language is English or Maltese" }, 400, cors);
  const cur = (k) => (beforeRow ? beforeRow[k] : null);
  const next = { prefers, lang, email_ok: yn(b.email_ok, cur("email_ok")), sms_ok: yn(b.sms_ok, cur("sms_ok")), whatsapp_ok: yn(b.whatsapp_ok, cur("whatsapp_ok")),
    allergies: b.allergies === undefined ? before.allergies : String(b.allergies || "").trim().slice(0, 500) };
  if (beforeRow) {
    const r = await dbRun(env, `UPDATE cust_profile SET prefers=?, email_ok=?, sms_ok=?, whatsapp_ok=?, lang=?, allergies=?, version=version+1, updated_at=datetime('now'), updated_by=? WHERE org_id=? AND location_id=? AND person_id=? AND version=?`,
      [next.prefers, next.email_ok, next.sms_ok, next.whatsapp_ok, next.lang, next.allergies, authUser.user_id, org, loc, id, before.version]);
    if (r && r.meta && !r.meta.changes) return jsonResponse({ ok: false, error: "Changed elsewhere", current: cmProfileOut(await dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, id])) }, 409, cors);
  } else {
    try {
      await dbRun(env, `INSERT INTO cust_profile (org_id, location_id, person_id, prefers, email_ok, sms_ok, whatsapp_ok, lang, allergies, updated_by) VALUES (?,?,?,?,?,?,?,?,?,?)`,
        [org, loc, id, next.prefers, next.email_ok, next.sms_ok, next.whatsapp_ok, next.lang, next.allergies, authUser.user_id]);
    } catch (e) { return jsonResponse({ ok: false, error: "Changed elsewhere", current: cmProfileOut(await dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, id])) }, 409, cors); }
  }
  const after = cmProfileOut(await dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, id]));
  await writeAudit(env, org, authUser.user_id, "CUST_PROFILE", "people", String(id), { location_id: loc, before, after }, loc);
  return jsonResponse({ ok: true, profile: after }, 200, cors);
}

