    cn: q("credit_notes", (ph) => `SELECT c.id, c.location_id, c.issue_date, c.amount, c.expiry_date, c.no_expiry, COALESCE((SELECT SUM(p.amount) FROM credit_note_purchases p WHERE p.credit_note_id = c.id AND p.org_id = c.org_id), 0) AS used FROM credit_notes c WHERE c.org_id = ? AND c.location_id IN (${ph})`),
    cnUse: q("credit_notes", (ph) => `SELECT c.location_id, p.amount, p.timestamp FROM credit_note_purchases p JOIN credit_notes c ON c.id = p.credit_note_id AND c.org_id = p.org_id WHERE c.org_id = ? AND c.location_id IN (${ph}) AND p.timestamp >= ? AND p.timestamp < ?`, [ymdPlusDays(wideFrom, -1), ymdPlusDays(wideTo, 2)]),
    lrc: q("locum_receipts", (ph) => `SELECT location_id, receipt_date, hours, total_fee FROM locum_receipts WHERE org_id = ? AND location_id IN (${ph}) AND receipt_date >= ? AND receipt_date <= ?`, [wideFrom, wideTo]),
    ordDone: q("orders", (ph) => `SELECT location_id, fulfilled_at FROM client_orders_entries WHERE org_id = ? AND location_id IN (${ph}) AND fulfilled = 1 AND fulfilled_at >= ? AND fulfilled_at < ?`, [ymdPlusDays(from, -1), ymdPlusDays(to, 2)]),
    tkt: q("questions", (ph) => `SELECT location_id, open_date, followup_date, resolved, status, resolved_at FROM client_tickets_entries WHERE org_id = ? AND location_id IN (${ph}) AND ((resolved = 0 AND status NOT IN ('Resolved', 'Closed')) OR open_date >= ? OR resolved_at >= ?)`, [from, ymdPlusDays(from, -1)]),
    dlv: q("deliveries", (ph) => `SELECT location_id, order_date, scheduled_date, actual_delivery_date, status FROM client_deliveries WHERE org_id = ? AND location_id IN (${ph}) AND (status IN ('Scheduled', 'Dispatched', 'Out for Delivery') OR order_date >= ? OR actual_delivery_date >= ?)`, [from, from]),
    rep: q("repeats", (ph) => `SELECT location_id, COUNT(*) AS n, COUNT(DISTINCT lower(replace(client_id, ' ', ''))) AS people FROM repeat_prescription_entries WHERE org_id = ? AND location_id IN (${ph}) AND expires_date >= ? AND expires_date <= ? GROUP BY location_id`, [today, ymdPlusDays(today, 14)]),
    dev: q("temperature", (ph) => `SELECT id, location_id, name, created_at FROM temperature_devices WHERE org_id = ? AND location_id IN (${ph}) AND active = 1 ORDER BY id`),
