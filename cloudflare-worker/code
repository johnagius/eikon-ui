  await ensureSupplierProductsSchema(env);
  const status = (url.searchParams.get("status") || "").trim();
  const q = (url.searchParams.get("q") || "").trim().toLowerCase();

  let sql = `SELECT o.*,
             (SELECT COUNT(*) FROM supplier_order_items WHERE order_id = o.id) AS item_count,
             (SELECT GROUP_CONCAT(description, ', ') FROM (SELECT description FROM supplier_order_items WHERE order_id = o.id ORDER BY id LIMIT 5)) AS items_summary
             FROM supplier_orders o
             WHERE o.org_id = ? AND o.pharmacy_location_id = ?`;
  const bind = [authUser.org_id, authUser.location_id];

  if (status) {
    const statuses = status.split(",").map(s => s.trim()).filter(Boolean);
    if (statuses.length) {
      sql += " AND o.status IN (" + statuses.map(() => "?").join(",") + ")";
      bind.push(...statuses);
    }
  }

  if (q) {
    sql += ` AND (LOWER(o.supplier_name) LIKE ? OR CAST(o.id AS TEXT) LIKE ? OR EXISTS (
      SELECT 1 FROM supplier_order_items si WHERE si.order_id = o.id AND LOWER(si.description) LIKE ?
    ))`;
    const like = "%" + q + "%";
    bind.push(like, like, like);
  }

  sql += " ORDER BY o.created_at DESC";
  const entries = await dbAll(env, sql, bind);

  return jsonResponse({ ok: true, entries }, 200, corsOkHeaders);
}

