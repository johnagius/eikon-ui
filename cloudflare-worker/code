  people:           { table: "people",                      key: "id",         card: "id_card",         name: "name",         date: "updated_at",     label: "Customer card" },
  order:            { table: "client_orders_entries",       key: "id",         card: null,              name: "client_name",  date: "order_date",     label: "Order",               title: "items_text", ref: "order_code" },
