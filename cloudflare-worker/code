async function handlePosCatalogList(request, env, corsOkHeaders, authUser, url) {
  await ensurePosSchema(env);
  const q = (url.searchParams.get("q") || "").toLowerCase().trim();
  const category = (url.searchParams.get("category") || "").trim();
  const allOrg = url.searchParams.get("all_org") === "1";
  const fallbackOrg = parseInt(url.searchParams.get("fallback_org")) || 0;
  const fallbackLoc = parseInt(url.searchParams.get("fallback_location")) || 0;
  const limit = Math.min(Math.max(1, parseInt(url.searchParams.get("limit")) || 2000), 5000);
  const offset = Math.max(0, parseInt(url.searchParams.get("offset")) || 0);

  // Determine which org/location to query
  let queryOrgId = authUser.org_id;
  let queryLocId = authUser.location_id;
  let usedFallback = false;

  if (allOrg) {
    // Check if own org has any products; if not and fallback is specified, use fallback
    if (fallbackOrg && fallbackLoc) {
      const ownCount = await dbFirst(env, `SELECT COUNT(*) as cnt FROM pos_products WHERE org_id=? AND is_active=1`, [authUser.org_id]);
      if (!ownCount || ownCount.cnt === 0) {
        queryOrgId = fallbackOrg;
        queryLocId = fallbackLoc;
        usedFallback = true;
      }
    }
  }

  let sql, bind;
  if (allOrg && !usedFallback) {
    sql = `SELECT id, barcode, name, price, vat_rate, category, unit, is_active, updated_at
               FROM pos_products WHERE org_id=? AND is_active=1`;
    bind = [queryOrgId];
  } else {
    sql = `SELECT id, barcode, name, price, vat_rate, category, unit, is_active, updated_at
               FROM pos_products WHERE org_id=? AND location_id=? AND is_active=1`;
    bind = [queryOrgId, queryLocId];
  }
  if (q) { sql += ` AND (lower(barcode) LIKE ? OR lower(name) LIKE ? OR lower(category) LIKE ?)`; const like = `%${q}%`; bind.push(like, like, like); }
  if (category) { sql += ` AND category=?`; bind.push(category); }

  // Count total matching rows
  const countBind = bind.slice();
  const countSql = sql.replace(/SELECT[\s\S]+?FROM/, "SELECT COUNT(*) as cnt FROM");
  const countRow = await dbFirst(env, countSql, countBind);
  const total = countRow ? countRow.cnt : 0;

  sql += ` ORDER BY name LIMIT ? OFFSET ?`;
  bind.push(limit, offset);
  const rows = await dbAll(env, sql, bind);
  const meta = await dbFirst(env, `SELECT last_upload_at, file_name, total_rows FROM pos_catalog_meta WHERE org_id=? AND location_id=?`,
    [authUser.org_id, authUser.location_id]);
  const nextOffset = offset + rows.length < total ? offset + rows.length : null;
  return jsonResponse({ ok: true, total, limit, offset, next_offset: nextOffset, last_upload_at: meta ? meta.last_upload_at : null, products: rows }, 200, corsOkHeaders);
}

async function handlePosCatalogBatch(request, env, corsOkHeaders, authUser) {
  await ensurePosSchema(env);
  const body = await readJson(request);
  const products = Array.isArray(body.products) ? body.products : [];
  if (!products.length) return jsonResponse({ ok: false, error: "No products provided" }, 400, corsOkHeaders);
  if (products.length > 500) return jsonResponse({ ok: false, error: "Max 500 products per batch" }, 400, corsOkHeaders);

  // On first chunk of a new upload, wipe existing catalog
  if (body.wipe) {
    await dbRun(env, `DELETE FROM pos_products WHERE org_id=? AND location_id=?`,
      [authUser.org_id, authUser.location_id]);
  }

  let upserted = 0;
  const upsertRows = [];
  for (const p of products) {
    const barcodeRaw = String(p.barcode || "").trim();
    const barcode = barcodeRaw || null;               // NULL = no barcode (SQLite UNIQUE allows multiple NULLs)
    const name = String(p.name || "").trim();
    if (!name) continue;                              // only name is required
    const price = Math.max(0, parseFloat(p.price) || 0);
    const vatRate = parseFloat(p.vat_rate) || 0;
    const category = String(p.category || "").trim().slice(0, 80);
    const unit = String(p.unit || "").trim().slice(0, 40);
    upsertRows.push([authUser.org_id, authUser.location_id, barcode, name, price, vatRate, category, unit]);
    upserted++;
  }
  // Upsert by name (idx_pos_products_name); preserve existing barcode when new row has none. Many rows per
  // statement, in order (a name repeated in the upload is upserted again by its later row, as before).
  await wsaveRun(env, wsaveStatements(env, `INSERT INTO pos_products (org_id, location_id, barcode, name, price, vat_rate, category, unit, is_active, created_at, updated_at)
      VALUES `, ["?", "?", "?", "?", "?", "?", "?", "?", "1", "datetime('now')", "datetime('now')"], `
      ON CONFLICT(org_id, location_id, name) DO UPDATE SET
        barcode   = CASE WHEN excluded.barcode IS NOT NULL THEN excluded.barcode ELSE barcode END,
        price     = excluded.price,
        vat_rate  = excluded.vat_rate,
        category  = excluded.category,
        unit      = excluded.unit,
        is_active = 1,
        updated_at = datetime('now')`, upsertRows));
  // Update catalog metadata
  const fileName = String(body.file_name || "").trim();
  const totalRows = parseInt(body.total_rows) || 0;
  await dbRun(env, `INSERT INTO pos_catalog_meta (org_id, location_id, last_upload_at, file_name, total_rows)
    VALUES (?,?,datetime('now'),?,?)
    ON CONFLICT(org_id, location_id) DO UPDATE SET
      last_upload_at = datetime('now'),
      file_name = excluded.file_name,
      total_rows = excluded.total_rows`,
    [authUser.org_id, authUser.location_id, fileName, totalRows]);

  await writeAudit(env, authUser.org_id, authUser.user_id, "EPOS_CATALOG_BATCH", "pos_products", "", { count: upserted }, authUser.location_id);
  return jsonResponse({ ok: true, upserted }, 200, corsOkHeaders);
}

