const DEMO_BULK_PATHS = ["/supplier-products/bulk-import", "/cherubino/short-expiry/upload", "/emergency-pos/catalog", "/emergency-pos/sales/sync", "/bookings/import-legacy", "/people/backfill"];
// Returns null (go on), { response } (answer this), or { request } (go on with this request instead).
async function demoGuard(request, env, url, authUser, cors) {
  if (!authUser || !authUser.demo) return null;
  const p = url.pathname, m = request.method, write = m !== "GET" && m !== "HEAD" && m !== "OPTIONS";
  // Accounts, passwords, roles: never in the demo. The sign-ins list shows the demo's own visitors only.
  if (p === "/team/users" || p.startsWith("/team/users/")) {
    if (write) return { response: demoNo(cors, "Sign-ins cannot be added or changed in the demo") };
    const r = await handleTeam(request, env, cors, authUser, url);
    let j = null; try { j = await r.clone().json(); } catch (e) {}
    if (!j || !Array.isArray(j.users)) return { response: r };
    j.users = j.users.filter((x) => DEMO_EMAILS.includes(String(x.email || x.login || "").toLowerCase()));
    return { response: jsonResponse(j, r.status, cors) };
  }
  // Roles (finish round): who is the pharmacist, who plans the rota and which rota row is which sign-in are account
  // rights too. /team/users/:id/rights and /role are refused above; the rota link is refused here (a read stays open).
  if (/^\/shifts\/staff\/\d+\/link$/.test(p) && write) return { response: demoNo(cors, "Linking the rota to sign-ins is not available in the demo") };
  if (p === "/auth/change-password") return { response: demoNo(cors, "The demo has no password to change") };
  if (p === "/auth/unlock" && m === "POST") return { response: jsonResponse({ ok: true, demo: true }, 200, cors) }; // nothing to type: the visitor has no password
  if (p.startsWith("/admin/names/") || p.startsWith("/su/")) return { response: demoNo(cors) };
  if (p === "/board/suggestions/export") return { response: demoNo(cors) };
  // Privacy (gdpr block): a demo session never exports or erases a person, never undoes an erase and never downloads
  // Settings › Download our records (customers, bookings, messages, money, team). "What we hold" stays readable.
  if (/^\/people\/\d+\/(export|erase)$/.test(p) || p.startsWith("/people/erasures/") || p === "/export/records") return { response: demoNo(cors, "Exporting or erasing a person is not available in the demo") };
  // Anything that would leave the sandbox: e-mail, text, WhatsApp, push, calendar feeds, sender keys, public pages.
  if (p === "/messages" && write) return { response: demoNotSent(cors) };
  if (p.startsWith("/bookings/senders")) {
    if (/\/test$/.test(p)) return { response: demoNotSent(cors) };
    if (write) return { response: demoNo(cors, "E-mail senders cannot be set up in the demo") };
  }
  if (p.startsWith("/bookings/") && /test/.test(p) && write) return { response: demoNotSent(cors) };
  if (p.startsWith("/rota/push/") && p !== "/rota/push/key" && write) return { response: jsonResponse({ ok: true, push: false, demo: true, error: "Not sent — this is the demo" }, 200, cors) };
  let text = null;
  if (write) {
    text = await request.clone().text();
    if (text.length > DEMO_BODY_MAX) return { response: demoNo(cors, "That is too big for the demo", 413) };
  }
  const json = () => { try { return JSON.parse(text || "{}") || {}; } catch (e) { return null; } };
  if (write && DEMO_BULK_PATHS.includes(p)) {
    const b = json();
    const biggest = Array.isArray(b) ? b.length : b && typeof b === "object" ? Math.max(0, ...Object.values(b).map((v) => (Array.isArray(v) ? v.length : 0))) : 0;
    if (biggest > DEMO_BULK_MAX) return { response: demoNo(cors, "The demo takes at most " + DEMO_BULK_MAX + " lines at a time") };
  }
  if (p === "/bookings/settings" && write) {
    const b = json(); if (!b) return null;
    for (const k of ["apiKey", "provider", "fromEmail", "replyTo", "smtpHost", "smtpPort", "smtpUser", "smtpSecure", "smtpPass", "smtpPassword", "publicSlug", "publicEnabled"]) delete b[k];
    return { request: demoRebuild(request, url, b) };
  }
  if (p === "/shifts/settings" && write) { // the calendar feed's secret stays as it is (nothing to regenerate in the demo)
    const b = json(); if (!b) return null;
    const strip = (o) => { if (o && typeof o === "object") { delete o.calendarToken; delete o.calendar_token; } };
    strip(b); strip(b.integration); strip(b.shifts); strip(b.settings);
    return { request: demoRebuild(request, url, b) };
  }
  // The board: the demo group's own messages only, in both directions.
  if (p === "/board/messages" && m === "POST") { const b = json(); if (!b) return null; b.scope = "org"; return { request: demoRebuild(request, url, b) }; }
  if ((p === "/board/messages" || p === "/board/users/search") && m === "GET") url.searchParams.set("scope", "org");
  return null;
}

