// GET /export/records?part=&from=&to=&after= — Settings › Download our records. Read only, own pharmacy, paged by id
// (GDPR_EXPORT_PAGE rows; `next` is the id to pass as after). Dated parts read through their (org, location, date) index.
const GDPR_EXPORT_PAGE = 1000;
const GDPR_EXPORT_PARTS = {
  customers:    { setup: true, sql: "SELECT p.id, p.name, p.id_card, p.phone, p.alt_phone, p.email, p.address, p.doctor_name, p.date_of_birth, p.notes, p.created_at, p.updated_at, c.prefers, c.email_ok, c.sms_ok, c.whatsapp_ok, c.lang, c.allergies FROM people p LEFT JOIN cust_profile c ON c.org_id = p.org_id AND c.location_id = p.location_id AND c.person_id = p.id WHERE p.org_id = ? AND p.location_id = ? AND p.merged_into IS NULL AND p.id > ? ORDER BY p.id LIMIT ?" },
  bookings:     { sql: "SELECT b.id, b.ref, b.date, b.start_time, b.end_time, b.status, b.person_name, b.person_phone, b.person_email, b.person_id_card, b.price_cents, b.notes, b.cancel_reason, b.walk_in, b.confirmed_at, b.created_at, s.name AS service, v.name AS provider FROM bk_bookings b LEFT JOIN bk_services s ON s.id = b.service_id AND s.org_id = b.org_id AND s.location_id = b.location_id LEFT JOIN bk_providers v ON v.id = b.provider_id AND v.org_id = b.org_id AND v.location_id = b.location_id WHERE b.org_id = ? AND b.location_id = ? AND b.date >= ? AND b.date <= ? AND b.id > ? ORDER BY b.id LIMIT ?", dated: true },
  appointments: { sql: "SELECT a.id, a.appt_ref, a.date, a.time, a.duration_mins, a.status, a.patient_name, a.patient_id_card, a.patient_phone, a.patient_email, a.doctor_fee, a.clinic_fee, a.notes, a.cancellation_reason, a.created_at, d.name AS doctor, c.name AS clinic FROM appt_appointments a LEFT JOIN appt_doctors d ON d.id = a.doctor_id AND d.org_id = a.org_id LEFT JOIN appt_clinics c ON c.id = a.clinic_id AND c.org_id = a.org_id WHERE a.org_id = ? AND a.location_id = ? AND a.date >= ? AND a.date <= ? AND a.id > ? ORDER BY a.id LIMIT ?", dated: true },
  messages:     { sql: "SELECT id, created_at, person_id, person_name, channel, purpose, to_addr, subject, body, status, error, created_by_name FROM cust_messages WHERE org_id = ? AND location_id = ? AND created_at >= ? AND created_at < date(?, '+1 day') AND id > ? ORDER BY id LIMIT ?", dated: true },
  tills:        { sql: "SELECT id, sale_date, receipt_no, total, subtotal, vat_total, discount_pct, payment_method, client_name, client_id, items_json, voided, voided_reason, notes, created_at FROM pos_sales WHERE org_id = ? AND location_id = ? AND sale_date >= ? AND sale_date <= ? AND id > ? ORDER BY id LIMIT ?", dated: true },
  loyalty:      { sql: "SELECT t.id, t.txn_date, t.client_name, t.client_id_card, t.receipt_no, t.total, t.stamps_awarded, t.points_awarded, t.action_label, t.notes, c.name AS campaign FROM loyalty_transactions t LEFT JOIN loyalty_campaigns c ON c.id = t.campaign_id AND c.org_id = t.org_id WHERE t.org_id = ? AND t.location_id = ? AND t.txn_date >= ? AND t.txn_date <= ? AND t.id > ? ORDER BY t.id LIMIT ?", dated: true },
  staff:        { sql: "SELECT id, full_name, designation, employment_type, contracted_hours, email, phone, registration_number, is_active, created_at, updated_at FROM shift_staff WHERE org_id = ? AND location_id = ? AND id > ? ORDER BY id LIMIT ?" },
  shifts:       { sql: "SELECT a.id, a.shift_date, a.start_time, a.end_time, a.role_override, a.notes, s.full_name, s.designation FROM shift_assignments a LEFT JOIN shift_staff s ON s.id = a.staff_id WHERE a.org_id = ? AND a.location_id = ? AND a.shift_date >= ? AND a.shift_date <= ? AND a.id > ? ORDER BY a.id LIMIT ?", dated: true },
  leave:        { sql: "SELECT l.id, l.leave_type, l.start_date, l.start_time, l.end_date, l.end_time, l.hours_requested, l.reason, l.status, l.reviewed_at, s.full_name FROM shift_leaves l LEFT JOIN shift_staff s ON s.id = l.staff_id WHERE l.org_id = ? AND l.location_id = ? AND l.end_date >= ? AND l.start_date <= ? AND l.id > ? ORDER BY l.id LIMIT ?", dated: true },
  accounts:     { sql: "SELECT id, full_name, email, role, is_active, created_at FROM users WHERE org_id = ? AND default_location_id = ? AND id > ? ORDER BY id LIMIT ?" }
};
async function handleExportRecords(request, env, cors, authUser, url) {
  if (!requireRole(authUser, GDPR_ROLES)) return jsonResponse({ ok: false, error: "Forbidden" }, 403, cors);
  const part = String(url.searchParams.get("part") || "");
  const def = GDPR_EXPORT_PARTS[part];
  if (!def) return jsonResponse({ ok: false, error: "Unknown part" }, 400, cors);
  const ymd = (v) => /^\d{4}-\d{2}-\d{2}$/.test(String(v || "")) ? String(v) : "";
  const from = ymd(url.searchParams.get("from")), to = ymd(url.searchParams.get("to"));
  if (def.dated && (!from || !to || to < from)) return jsonResponse({ ok: false, error: "Choose the first and the last day" }, 400, cors);
  const after = Math.max(0, Number(url.searchParams.get("after") || 0) || 0);
  const org = authUser.org_id, loc = authUser.location_id;
  const b = def.dated ? [org, loc, from, to, after, GDPR_EXPORT_PAGE + 1] : [org, loc, after, GDPR_EXPORT_PAGE + 1];
  let rows;
  if (def.setup) { try { await ensurePeopleSchema(env); await ensureCustMsgSchema(env); } catch (e) {} } // the tables Customers makes on first use
  try { rows = await dbAll(env, def.sql, b); } catch (e) { rows = []; } // the part was never used here: no table yet
  const more = rows.length > GDPR_EXPORT_PAGE;
  if (more) rows = rows.slice(0, GDPR_EXPORT_PAGE);
  return jsonResponse({ ok: true, part, rows, next: more ? rows[rows.length - 1].id : null }, 200, { ...cors, "Cache-Control": "no-store" });
}
