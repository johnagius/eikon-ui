    await writeAudit(env, authUser.org_id, authUser.user_id, "TEAM_PASSWORD_RESET", "user", String(target.id), { before, after: { ...before, must_change_password: 1 }, sessions_ended: true }, authUser.location_id);
    return jsonResponse({ ok: true, temporary_password: temp }, 200, { ...cors, "Cache-Control": "no-store" });
