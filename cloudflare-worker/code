// --- Update suggestion ---
async function handleBoardSuggestionUpdate(request, env, corsOkHeaders, authUser, sugId) {
  await ensureBoardSchema(env);
  const existing = await dbFirst(env, `SELECT id, created_by FROM board_suggestions WHERE id = ?`, [sugId]);
  if (!existing) return jsonResponse({ ok: false, error: "Suggestion not found" }, 404, corsOkHeaders);

  // Ownership: creator can edit title/priority; superadmin can edit anything
  const isOwner = existing.created_by === authUser.user_id;
  const isSuper = isSuperuser(authUser, env);
  if (!isOwner && !isSuper) return jsonResponse({ ok: false, error: "You can only edit your own suggestions" }, 403, corsOkHeaders);
  const __before = await auditSnap(env, "board_suggestions", sugId, null);

  const body = await readJson(request);
  const sets = [];
  const bind = [];

  if (body.priority !== undefined) {
    const p = ["low", "medium", "high"].includes(String(body.priority).toLowerCase()) ? String(body.priority).toLowerCase() : "medium";
    sets.push("priority = ?"); bind.push(p);
  }
  if (body.status !== undefined && isSuper) {
    const s = ["open", "in_progress", "resolved"].includes(String(body.status).toLowerCase()) ? String(body.status).toLowerCase() : "open";
    sets.push("status = ?"); bind.push(s);
  }
  if (body.title !== undefined) {
    const t = String(body.title || "").trim().slice(0, 500);
    if (t) { sets.push("title = ?"); bind.push(t); }
  }

  if (!sets.length) return jsonResponse({ ok: true }, 200, corsOkHeaders);

  sets.push("updated_at = datetime('now')");
  bind.push(sugId);
  await dbRun(env, `UPDATE board_suggestions SET ${sets.join(", ")} WHERE id = ?`, bind);
  await writeAudit(env, authUser.org_id, authUser.user_id, "BOARD_SUGGESTION_UPDATE", "board_suggestions", String(sugId), { before: __before, after: await auditSnap(env, "board_suggestions", sugId, null) }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

