    };
    const money = moneyOf(from, to, days);
    const paidByDay = {}; poIn(from, to).forEach((r) => { paidByDay[r.entry_date] = ownerR2(r.total); });
    const lrc = mine(R.lrc);
    const lrcIn = (a, b) => lrc.filter((r) => inR(r.receipt_date, a, b));
    money.locum_cost = ownerR2(lrcIn(from, to).reduce((t, r) => t + Number(r.total_fee || 0), 0));
    money.locum_hours = ownerR2(lrcIn(from, to).reduce((t, r) => t + Number(r.hours || 0), 0));
    money.locum_receipts = lrcIn(from, to).length;
    let prev = null;
    if (cmp) {
      prev = moneyOf(cmp.from, cmp.to, eodAll.filter((d) => inR(d.date, cmp.from, cmp.to)));
      prev.locum_cost = ownerR2(lrcIn(cmp.from, cmp.to).reduce((t, r) => t + Number(r.total_fee || 0), 0));
    }
    // Days not closed: Monday to Saturday up to yesterday with no end of day saved (a pharmacy open on Sunday sees its Sundays counted only when saved)
    const closed = {}; days.forEach((d) => { closed[d.date] = 1; });
    const notClosed = [];
    for (let d = from; d <= to && d <= yest && notClosed.length < 400; d = ymdPlusDays(d, 1)) if (!closed[d] && new Date(d + "T12:00:00Z").getUTCDay() !== 0) notClosed.push(d);
    const notLocked = days.filter((d) => !d.locked && d.date < today).map((d) => d.date);
    // Credit notes
    const cnRows = mine(R.cn);
    const cnLeft = (c) => ownerR2(Number(c.amount || 0) - Number(c.used || 0));
    const live = cnRows.filter((c) => cnLeft(c) > 0.005 && (Number(c.no_expiry) === 1 || !c.expiry_date || String(c.expiry_date) >= today));
    const soon = live.filter((c) => Number(c.no_expiry) !== 1 && c.expiry_date && String(c.expiry_date) <= ymdPlusDays(today, 30));
    const issued = cnRows.filter((c) => inR(c.issue_date, from, to));
    const uses = mine(R.cnUse).filter((u) => inR(ownerMaltaDay(u.timestamp), from, to));
    const credit = { open: live.length, open_total: ownerR2(live.reduce((t, c) => t + cnLeft(c), 0)), expiring_30: soon.length, expiring_30_total: ownerR2(soon.reduce((t, c) => t + cnLeft(c), 0)),
      issued: issued.length, issued_total: ownerR2(issued.reduce((t, c) => t + Number(c.amount || 0), 0)), used_total: ownerR2(uses.reduce((t, u) => t + Number(u.amount || 0), 0)) };
    // Customers waiting
    const o = mine(R.ord)[0] || {};
    const orders = { new: Number(o.new_n || 0), done: mine(R.ordDone).filter((r) => inR(ownerMaltaDay(r.fulfilled_at), from, to)).length, open: Number(o.open_n || 0), overdue: Number(o.overdue_n || 0), waiting_30: Number(o.old_n || 0) };
    const tk = mine(R.tkt), tkOpen = tk.filter((t) => Number(t.resolved) === 0 && t.status !== "Resolved" && t.status !== "Closed");
    const questions = { new: tk.filter((t) => inR(t.open_date, from, to)).length, done: tk.filter((t) => inR(ownerMaltaDay(t.resolved_at), from, to)).length, open: tkOpen.length,
      overdue: tkOpen.filter((t) => t.followup_date && String(t.followup_date) < today).length, waiting_7: tkOpen.filter((t) => t.open_date && String(t.open_date) < ymdPlusDays(today, -7)).length };
    const dv = mine(R.dlv), dvOpen = dv.filter((d) => ["Scheduled", "Dispatched", "Out for Delivery"].indexOf(d.status) >= 0);
    const deliveries = { new: dv.filter((d) => inR(d.order_date, from, to)).length, done: dv.filter((d) => d.status === "Delivered" && inR(String(d.actual_delivery_date || ""), from, to)).length,
      open: dvOpen.length, late: dvOpen.filter((d) => String(d.scheduled_date || d.order_date || "") < today).length };
    const rp = mine(R.rep)[0] || {};
    const repeats = { running_out_14: Number(rp.n || 0), people_14: Number(rp.people || 0) };
    // Registers in order
    const tempEnd = to < yest ? to : yest;
    const devs = mine(R.dev), tmp = mine(R.temp);
    const gaps = devs.map((dv0) => {
      let start = from; const made = ownerMaltaDay(dv0.created_at); if (made && made > start) start = made;
      const at = {}; tmp.forEach((e) => { if (Number(e.device_id) === Number(dv0.id)) at[e.entry_date] = 1; });
      const miss = []; for (let d = start; d <= tempEnd && miss.length < 400; d = ymdPlusDays(d, 1)) if (!at[d]) miss.push(d);
      return { device_id: dv0.id, name: String(dv0.name || ""), missing: miss.length, first: miss[0] || "", days: miss.slice(0, 31) };
    }).filter((g) => g.missing);
    const nz = (v) => (v == null || v === "" ? null : Number(v));
    const outNoNote = tmp.filter((e) => { const lo = nz(e.min_limit), hi = nz(e.max_limit), a = nz(e.min_temp), b = nz(e.max_temp);
      return ((lo != null && a != null && a < lo) || (hi != null && b != null && b > hi)) && !String(e.notes || "").trim(); }).length;
    const cl = {}; mine(R.clean).forEach((c) => { cl[c.entry_date] = 1; });
    let mon = from; while (new Date(mon + "T12:00:00Z").getUTCDay() !== 1) mon = ymdPlusDays(mon, 1);
    const emptyWeeks = [];
    for (; ymdPlusDays(mon, 6) <= to && ymdPlusDays(mon, 6) < today; mon = ymdPlusDays(mon, 7)) { let any = false; for (let i = 0; i < 7; i++) if (cl[ymdPlusDays(mon, i)]) { any = true; break; } if (!any) emptyWeeks.push(mon); }
    const lastClean = (mine(R.cleanLast)[0] || {}).last || "";
    const certs = mine(R.cert).map((c) => { const ld = String(c.last_date || "").slice(0, 10); if (!ownerIsYmd(ld)) return { title: c.title, due: "" };
      const p = ld.split("-").map(Number), dt = new Date(Date.UTC(p[0], p[1] - 1 + Number(c.interval_months || 12), p[2])); return { title: String(c.title || ""), due: dt.toISOString().slice(0, 10) }; });
    const lastTake = ownerMaltaDay((mine(R.take)[0] || {}).last || "");
    const registers = { temperature_devices: devs.length, temperature_gaps: gaps, temperature_missing: gaps.reduce((t, g) => t + g.missing, 0), temperature_out_no_note: outNoNote,
      cleaning_last: lastClean, cleaning_days_since: lastClean ? ymdDiffDays(lastClean, today) : null, cleaning_empty_weeks: emptyWeeks,
      certificates_overdue: certs.filter((c) => c.due && c.due < today).map((c) => c.title), certificates_due_30: certs.filter((c) => c.due && c.due >= today && c.due <= ymdPlusDays(today, 30)).map((c) => c.title),
      dda_last_stocktake: lastTake, dda_days_since_stocktake: lastTake ? ymdDiffDays(lastTake, today) : null,
      eod_not_closed: notClosed, eod_not_locked: notLocked, daily_register_lines: Number((mine(R.dr)[0] || {}).n || 0) };
    // Controlled drugs: totals per medicine for the days chosen
    const ddaList = (rows) => mine(rows).map((r) => ({ name: String(r.name || ""), lines: Number(r.n || 0), qty: Number(r.qty || 0) })).sort((a, b) => a.name.localeCompare(b.name));
    const dda = { supplied: ddaList(R.dds), poyc: ddaList(R.ddp), received: ddaList(R.ddr) };
    // Staff hours from the rota, and pharmacists in charge from the locum register
    const people = {};
    mine(R.shf).forEach((a) => { const k = String(a.staff_id); const p = people[k] || (people[k] = { staff_id: Number(a.staff_id), name: String(a.full_name || ""), role: String(a.designation || ""), contracted_week: Number(a.contracted_hours || 0), shifts: 0, hours: 0, leave_hours: 0, leave_days: 0 });
      p.shifts++; p.hours = ownerR2(p.hours + ownerHours(a.start_time, a.end_time)); });
    mine(R.leave).forEach((v) => { const k = String(v.staff_id); const p = people[k] || (people[k] = { staff_id: Number(v.staff_id), name: String(v.full_name || ""), role: "", contracted_week: 0, shifts: 0, hours: 0, leave_hours: 0, leave_days: 0 });
      const s = v.start_date > from ? v.start_date : from, e = v.end_date < to ? v.end_date : to, n = Math.max(0, (ymdDiffDays(s, e) || 0) + 1), all = Math.max(1, (ymdDiffDays(v.start_date, v.end_date) || 0) + 1);
      p.leave_days += n; p.leave_hours = ownerR2(p.leave_hours + Number(v.hours_requested || 0) * n / all); });
    const staff = Object.keys(people).map((k) => people[k]).sort((a, b) => a.name.localeCompare(b.name));
    const locums = {}; mine(R.loc).forEach((r) => { const k = String(r.locum_full_name || "").trim(); const p = locums[k] || (locums[k] = { name: k, days: 0, hours: 0 }); p.days++; p.hours = ownerR2(p.hours + ownerHours(r.time_in, r.time_out)); });
    // Services
    const bk = {}; mine(R.bk).forEach((r) => { bk[String(r.status || "")] = Number(r.n || 0); });
    const poctIn = mine(R.poct).filter((r) => inR(ownerMaltaDay(r.performed_at_iso), from, to));
    const services = { bookings: Object.keys(bk).reduce((t, k) => t + (k === "cancelled" ? 0 : bk[k]), 0), bookings_cancelled: bk.cancelled || 0, bookings_no_show: bk.no_show || bk.noshow || 0,
      tests: poctIn.length, tests_fees: ownerR2(poctIn.reduce((t, r) => t + Number(r.fee_due || 0), 0)) };
    return { id, name: l.name, money, prev, days: days.map((d) => Object.assign({}, d, { paid_out_register: paidByDay[d.date] || 0 })), paid_by_day: paidByDay,
      credit, orders, questions, deliveries, repeats, registers, dda, staff, locums: Object.keys(locums).map((k) => locums[k]).sort((a, b) => a.name.localeCompare(b.name)), services };
  });
  return jsonResponse({ ok: true, today, from, to, cmp, group: sc.group, scope: sc.group ? (sc.locs.length === (sc.all || []).length ? "all" : "one") : "own",
    pharmacies_allowed: (sc.group ? sc.all : sc.locs).map((l) => ({ id: l.id, name: l.name })), pharmacies: out, unread: Object.keys(unread) }, 200, cors);
}

