async function ensureLastInspectionSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS register_last_inspection (org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
    last_date TEXT NOT NULL DEFAULT '', set_by INTEGER, set_name TEXT NOT NULL DEFAULT '', updated_at TEXT NOT NULL DEFAULT (datetime('now')),
    PRIMARY KEY (org_id, location_id))`, []);
}
const ensureLastInspectionSchema = schemaOnce("ensureLastInspectionSchema", ensureLastInspectionSchema__impl);
