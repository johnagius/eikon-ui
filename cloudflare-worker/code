  if (!(existing.org_id === authUser.org_id && existing.location_id === authUser.location_id)) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await dbRun(env, `DELETE FROM scarce_stock_offer_requests WHERE offer_id = ?`, [id]);
  await dbRun(env, `DELETE FROM scarce_stock_offers WHERE id = ?`, [id]);

  // Clear backlink on near expiry entry
  if (existing.near_expiry_id) {
    await ensureNearExpirySchema(env);
    await dbRun(env,
      "UPDATE near_expiry_entries SET scarce_stock_offer_id=NULL, updated_at=datetime('now'), updated_by=? WHERE id=? AND org_id=? AND location_id=?",
      [authUser.user_id, existing.near_expiry_id, existing.org_id, existing.location_id]
    );
  }

  // Remove from Stock Transfer if linked (via transfer_item_id on the offer)
  if (existing.transfer_item_id) {
    await ensureStockTransfersSchema(env);
    await dbRun(env, "DELETE FROM stock_transfer_requests WHERE item_id = ?", [existing.transfer_item_id]);
    await dbRun(env, "DELETE FROM stock_transfer_items WHERE id = ?", [existing.transfer_item_id]);
