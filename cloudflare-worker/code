  return jsonResponse({ ok: true, erasures: rows.map((r) => { let s = {}; try { s = JSON.parse(r.summary_json || "{}"); } catch (e) {} return { erasure_id: r.erasure_id, status: r.status, rows: r.rows_changed, changed: s.changed || {}, kept: s.kept || {}, reason: r.reason, at: r.created_at, by: r.created_by, undo_until: r.undo_until, undone_at: r.undone_at, can_undo: !!Number(r.can_undo) }; }) }, 200, cors);
