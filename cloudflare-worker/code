    poct: q("poct", (ph) => `SELECT location_id, performed_at_iso, fee_due FROM poct_records WHERE org_id = ? AND location_id IN (${ph}) AND performed_at_iso >= ? AND performed_at_iso < ?`, [ymdPlusDays(from, -1), ymdPlusDays(to, 2)]),
