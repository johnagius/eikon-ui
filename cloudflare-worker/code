      await dbRun(env, "INSERT INTO dda_partial_parts (partial_id, org_id, location_id, entry_id, created_by, created_name) VALUES (?,?,?,?,?,?)", [id, authUser.org_id, authUser.location_id, entryId, authUser.user_id, name]);
      const left = cur.left - (Number(e.quantity) || 0);
      if (left <= 0) await dbRun(env, "UPDATE dda_partials SET status = 'done', updated_at = datetime('now') WHERE id = ? AND org_id = ? AND location_id = ?", [id, authUser.org_id, authUser.location_id]);
      else await dbRun(env, "UPDATE dda_partials SET updated_at = datetime('now') WHERE id = ? AND org_id = ? AND location_id = ?", [id, authUser.org_id, authUser.location_id]);
      await writeAudit(env, authUser.org_id, authUser.user_id, "DDA_PARTIAL_GIVE", "dda_partials", String(id), { entry_id: entryId, quantity: Number(e.quantity), left: Math.max(0, left) }, authUser.location_id);
    }
    return jsonResponse({ ok: true, partial: (await ddaPartialRead(env, authUser, "id = ?", [id]))[0] }, 200, corsOkHeaders);
  }
  return bad("Not found", 404);
}
