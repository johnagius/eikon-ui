  for (const col of ["series_id TEXT NOT NULL DEFAULT ''", "confirmed_at TEXT NOT NULL DEFAULT ''", "confirmed_via TEXT NOT NULL DEFAULT ''", "walk_in INTEGER NOT NULL DEFAULT 0"]) {
    try { await dbRun(env, `ALTER TABLE bk_bookings ADD COLUMN ${col}`, []); } catch (e) {}
  }
}
