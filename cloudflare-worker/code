/* ---------- small helpers ---------- */
function bkMin(t) { const m = /^(\d{2}):(\d{2})$/.exec(String(t || "")); return m ? Number(m[1]) * 60 + Number(m[2]) : NaN; }
function bkTime(min) { const h = Math.floor(min / 60), m = min % 60; return String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0"); }
function bkWeekday(ymd) { const [y, m, d] = ymd.split("-").map(Number); return new Date(Date.UTC(y, m - 1, d)).getUTCDay(); }
function bkAddDays(ymd, n) { const [y, m, d] = ymd.split("-").map(Number); const t = new Date(Date.UTC(y, m - 1, d + n)); return t.toISOString().slice(0, 10); }
function bkDaysBetween(a, b) { return Math.round((Date.parse(b + "T00:00:00Z") - Date.parse(a + "T00:00:00Z")) / 86400000); }
function bkNowLocal(env) {
  // Local wall-clock date/time of the pharmacy (default Europe/Malta), DST-correct.
  // Tests can fix the clock: BK_TEST_NOW = 'YYYY-MM-DD HH:MM' (never set in production).
  const tn = /^(\d{4}-\d{2}-\d{2}) (\d{2}):(\d{2})$/.exec(String((env && env.BK_TEST_NOW) || ""));
  if (tn) return { date: tn[1], min: Number(tn[2]) * 60 + Number(tn[3]) };
  const tz = (env && env.BOOKINGS_TIMEZONE) || "Europe/Malta";
  const parts = new Intl.DateTimeFormat("en-GB", { timeZone: tz, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
  const g = (t) => (parts.find((p) => p.type === t) || {}).value;
  const hh = g("hour") === "24" ? "00" : g("hour");
  return { date: `${g("year")}-${g("month")}-${g("day")}`, min: Number(hh) * 60 + Number(g("minute")) };
