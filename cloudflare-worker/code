async function gdprBody(request) {
  if (request.method === "GET") { const r = new URL(request.url).searchParams.get("rows"); return { rows: r ? r.split(",").filter(Boolean) : [] }; }
  try { return (await readJson(request)) || {}; } catch (e) { return {}; }
}

function gdprPreviewJson(ctx, plan, open, pol) {
  return { ok: true, preview: true, person: { id: ctx.person.id, name: ctx.person.name, id_card: ctx.person.id_card, erased: ctx.erased },
    sections: plan.sections, total_change: plan.total, total_keep: plan.kept.length, plan: plan.fingerprint,
    undo_hours: GDPR_UNDO_HOURS, open_erasure: open || null, policy: pol, overridden: gdprOverridden(pol),
    also_kept: [{ label: "Audit trail", why: GDPR_WHY.trail }, { label: "ID card change log", why: GDPR_WHY.trail }] };
}
async function gdprOpenErasure(env, org, loc, pid) {
  const r = await dbFirst(env, "SELECT erasure_id, created_at, undo_until, rows_changed FROM gdpr_erasures WHERE org_id = ? AND location_id = ? AND person_id = ? AND status = 'done' AND purged_at IS NULL ORDER BY created_at DESC LIMIT 1", [org, loc, pid]);
  return r ? { erasure_id: r.erasure_id, at: r.created_at, undo_until: r.undo_until, rows: r.rows_changed } : null;
}

// POST /people/:id/privacy — the summary the privacy panel opens with (same as the erase preview).
async function handlePersonPrivacy(request, env, cors, authUser, id) {
  const g = await gdprGuard(request, env, cors, authUser); if (g) return g;
  const org = authUser.org_id, loc = authUser.location_id;
  const ctx = await gdprContext(env, org, loc, id);
