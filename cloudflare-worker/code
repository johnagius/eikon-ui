// Is this row theirs? "sure", "maybe" (same name only, or their phone/e-mail under another name: ticked by hand), "other", or null.
function gdprClassify(ctx, f) {
  if (f.person) return { cls: "sure", why: "their customer record" };
  if (f.linked) return { cls: "sure", why: "linked to them by hand" };
  const nm = String(f.name || "").trim().replace(/\s+/g, " ");
  const nameHit = !!nm && ctx.names.includes(nm.toLowerCase());
  const nameOk = !nm || ctx.nameList.some((m) => personNamesCompatible(m, nm));
  const card = gdprCardKey(f.card);
  const cardHit = !!card && ctx.idKeys.includes(card);
  if (cardHit) return nameOk ? { cls: "sure", why: "same ID card" } : { cls: "other", why: "their ID card under another name" };
  if (card && ctx.idKeys.length && nameHit) return { cls: "other", why: "same name, another ID card" };
  const ph = (f.phones || []).map(peoplePhoneDigits).filter((d) => d.length >= 6);
  const contactHit = ph.some((d) => ctx.phones.includes(d)) || (!!f.email && ctx.emails.includes(String(f.email).trim().toLowerCase()));
  if (nameHit && contactHit) return { cls: "sure", why: "same name and phone or e-mail" };
  if (f.emailOnly && contactHit) return { cls: "sure", why: "their e-mail address" };
  if (nameHit) return { cls: "maybe", why: "same name only" };
  if (contactHit && f.allowContactOnly) return { cls: "maybe", why: "their phone or e-mail, another name" };
  return null;
}

// Applies a { key: kind } map to one object, shallow. Returns how many values it changed.
function gdprScrubObj(o, map, val) {
  let n = 0;
  if (!o || typeof o !== "object") return 0;
  for (const k of Object.keys(map)) {
    if (!(k in o) || typeof o[k] !== "string" || !o[k]) continue;
    const nv = val(map[k]);
    if (o[k] !== nv) { o[k] = nv; n++; }
  }
  return n;
}

