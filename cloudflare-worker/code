// ═══════════════════════════════════════════════════════════════════════════
// ONE-CLICK PUBLIC DEMO (owner, 2026-11-11)
//   A visitor presses "Try the demo" on the sign-in screen and is signed in, with no e-mail or password, to a sandbox
//   that lives inside one demo group (DEMO_ORG_ID) of the live database:
//     - the demo pharmacy  DEMO_LOCATION_ID           (a real location; its own real sign-ins stay exactly as they are)
//     - a second pharmacy  DEMO_PHARMACY2_LOCATION_ID (0-399; so head office has two pharmacies to compare)
//     - a distributor      DEMO_SUPPLIER_LOCATION_ID  (400-599; the supplier portal)
//     - a head office      DEMO_HQ_LOCATION_ID        (600-900; the company-admin portal)
//   With DEMO_ORG_ID or DEMO_LOCATION_ID unset the whole feature is off: /auth/demo answers 404, no door is shown, no
//   guard runs, every SQL statement below is the one the worker ran before. The three optional ids only add doors.
//   Routes:
//     GET  /auth/demo                  which doors are open (public): { ok, doors: ["pharmacy","supplier","hq"], ready }
//     POST /auth/demo { door }         a 2-hour session as that door's demo visitor (public, rate-limited per address)
//     POST /su/api/demo/reset          superuser: wipe and seed again now (bounded; call again until done:true)
//     POST /su/api/demo/wipe           superuser: empty the demo group, seed nothing (before switching it off)
//     GET  /su/api/demo/status         superuser: where the last reset got to
//   Every session of the demo group (the visitors' and any real sign-in of it) is guarded (demoGuard): nothing leaves the
//   sandbox (no e-mail, push or account change), and the board, supplier marketplace and scarce-stock lists keep the demo
//   group and the live groups apart in both directions (demoCrossCheck, demoOrgSql, boardAllLit).
//   resetDemo wipes every row of the demo group (tables discovered at run time) and seeds 2-3 believable items in every
//   section through the worker's own routes, so screens read them exactly as real data. It runs once per Malta day
//   between 03:00 and 06:00 from the existing 10-minute cron, a bounded number of steps per run.
// ═══════════════════════════════════════════════════════════════════════════
const DEMO_DOORS = ["pharmacy", "supplier", "hq"];
const DEMO_USERS = {
  pharmacy: { email: "visitor.pharmacy@demo.eikon.invalid", name: "Demo visitor" },
  branch: { email: "visitor.branch@demo.eikon.invalid", name: "Sarah Vella" },
  supplier: { email: "visitor.supplier@demo.eikon.invalid", name: "Demo visitor" },
  hq: { email: "visitor.hq@demo.eikon.invalid", name: "Demo visitor" }
};
const DEMO_EMAILS = Object.values(DEMO_USERS).map((u) => u.email);
const DEMO_LOC_NAMES = { branch: "Demo Pharmacy Sliema", supplier: "Demo Distributor", hq: "Demo Head Office" };
const DEMO_SESSION_SECONDS = 2 * 3600;
const DEMO_PER_IP_HOUR = 12, DEMO_ALL_HOUR = 400;
const DEMO_BODY_MAX = 256 * 1024, DEMO_BULK_MAX = 50;
const DEMO_SEED_ORIGIN = "https://demo-seed.invalid";

function demoCfg(env) {
  const n = (v) => { const s = String(v == null ? "" : v).trim(); if (!/^\d+$/.test(s)) return null; const x = Number(s); return x > 0 ? x : null; };
  const org = n(env && env.DEMO_ORG_ID), loc = n(env && env.DEMO_LOCATION_ID);
  if (!org || !loc || loc > 399) return null;
  const sup = n(env.DEMO_SUPPLIER_LOCATION_ID), hq = n(env.DEMO_HQ_LOCATION_ID), br = n(env.DEMO_PHARMACY2_LOCATION_ID);
  const c = { org, pharmacy: loc,
    supplier: sup && sup >= 400 && sup <= 599 ? sup : null,
    hq: hq && hq >= 600 && hq <= 900 ? hq : null,
    branch: br && br <= 399 && br !== loc ? br : null };
  c.locs = [c.pharmacy, c.branch, c.supplier, c.hq].filter(Boolean);
  return c;
}
function demoIsOrg(env, orgId) { const c = demoCfg(env); return !!c && Number(orgId) === c.org; }
function demoIsLoc(env, locId) { const c = demoCfg(env); return !!c && c.locs.includes(Number(locId)); }
// The board's "everyone" scope as SQL: a demo session sees its own group only (the live groups' messages are not shown
// to the public); everyone else gets the literal it always had.
function boardAllLit(authUser) { return authUser && authUser.demo ? "'demo:none'" : "'all'"; }
// For the few lists that read across every group (supplier marketplace, scarce-stock needs, board suggestions): a demo
// session sees only its group's rows, every other session sees everything but them. Feature off: "" (nothing added).
function demoOrgSql(env, authUser, col) {
  const c = demoCfg(env);
  if (!c) return "";
  return authUser && authUser.demo ? ` AND ${col} = ${c.org}` : ` AND (${col} IS NULL OR ${col} != ${c.org})`;
}

async function ensureDemoSchema__impl(env) {
  await dbRun(env, "CREATE TABLE IF NOT EXISTS demo_state (k TEXT PRIMARY KEY, v TEXT NOT NULL DEFAULT '{}', at TEXT NOT NULL DEFAULT (datetime('now')))", []);
  await dbRun(env, "CREATE TABLE IF NOT EXISTS demo_signins (id INTEGER PRIMARY KEY AUTOINCREMENT, ip TEXT NOT NULL DEFAULT '', door TEXT NOT NULL DEFAULT '', at TEXT NOT NULL DEFAULT (datetime('now')))", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_demo_signins_ip_at ON demo_signins (ip, at)", []);
}
const ensureDemoSchema = schemaOnce("ensureDemoSchema", ensureDemoSchema__impl);
async function demoStateGet(env) { await ensureDemoSchema(env); const r = await dbFirst(env, "SELECT v FROM demo_state WHERE k = 'reset'", []); try { return r ? JSON.parse(r.v) || {} : {}; } catch (e) { return {}; } }
async function demoStateSet(env, st) { await dbRun(env, "INSERT INTO demo_state (k, v, at) VALUES ('reset', ?, datetime('now')) ON CONFLICT(k) DO UPDATE SET v = excluded.v, at = datetime('now')", [JSON.stringify(st)]); }

// Which door a session belongs to (its location), and the doors that are open.
function demoDoorOf(c, locId) { const l = Number(locId); return l === c.pharmacy ? "pharmacy" : l === c.supplier ? "supplier" : l === c.hq ? "hq" : l === c.branch ? "branch" : null; }
function demoLocOf(c, door) { return door === "pharmacy" ? c.pharmacy : door === "supplier" ? c.supplier : door === "hq" ? c.hq : door === "branch" ? c.branch : null; }
function demoDoorsOpen(c) { return DEMO_DOORS.filter((d) => !!demoLocOf(c, d)); }

// Locations and visitor accounts, made when missing (idempotent). A configured id that belongs to another group, or a
// demo e-mail held by an account of another group, is never touched: that door stays shut and the problem is reported.
async function demoPrepare(env, c) {
  const problems = [];
  const main = await dbFirst(env, "SELECT id, org_id FROM locations WHERE id = ?", [c.pharmacy]);
  if (!main || Number(main.org_id) !== c.org) return { fatal: "DEMO_LOCATION_ID " + c.pharmacy + " is not a location of DEMO_ORG_ID " + c.org, problems };
  const other = await dbAll(env, `SELECT id FROM locations WHERE org_id = ? AND id NOT IN (${c.locs.map(() => "?").join(",")})`, [c.org, ...c.locs]);
  if (other.length) return { fatal: "The demo group " + c.org + " has other locations (" + other.map((r) => r.id).join(", ") + "): nothing is wiped", problems };
  const shut = [];
  for (const door of ["branch", "supplier", "hq"]) {
    const id = demoLocOf(c, door);
    if (!id) continue;
    const row = await dbFirst(env, "SELECT id, org_id FROM locations WHERE id = ?", [id]);
    if (row && Number(row.org_id) !== c.org) { problems.push(door + ": location " + id + " belongs to group " + row.org_id); shut.push(door); continue; }
    if (!row) await dbRun(env, "INSERT INTO locations (id, org_id, name, created_at) VALUES (?, ?, ?, datetime('now'))", [id, c.org, DEMO_LOC_NAMES[door]]);
  }
  for (const door of ["pharmacy", "branch", "supplier", "hq"]) {
    const loc = demoLocOf(c, door);
    if (!loc || shut.includes(door)) continue;
    const u = DEMO_USERS[door];
    const row = await dbFirst(env, "SELECT id, org_id, default_location_id FROM users WHERE lower(email) = ?", [u.email]);
    if (row && Number(row.org_id) !== c.org) { problems.push(door + ": " + u.email + " belongs to group " + row.org_id); shut.push(door); continue; }
    if (row) { if (Number(row.default_location_id) !== loc) await dbRun(env, "UPDATE users SET default_location_id = ? WHERE id = ?", [loc, row.id]); continue; }
    // A password nobody knows (random, thrown away): this account is only ever entered through POST /auth/demo.
    const salt = crypto.getRandomValues(new Uint8Array(16)), hash = crypto.getRandomValues(new Uint8Array(32));
    await dbRun(env, `INSERT INTO users (org_id, email, full_name, role, pass_salt_b64, pass_hash_b64, pass_iters, is_active, default_location_id, created_at)
      VALUES (?, ?, ?, 'admin', ?, ?, 100000, 1, ?, datetime('now'))`, [c.org, u.email, u.name, base64FromBytes(salt), base64FromBytes(hash), loc]);
  }
  return { fatal: "", problems, shut };
}
async function demoUserId(env, c, door) {
  const r = await dbFirst(env, "SELECT id, org_id FROM users WHERE lower(email) = ?", [DEMO_USERS[door].email]);
  return r && Number(r.org_id) === c.org ? Number(r.id) : null;
}
async function demoNewSession(env, userId, seconds) {
  const token = base64UrlFromBytes(crypto.getRandomValues(new Uint8Array(32)));
  const exp = new Date(Date.now() + seconds * 1000).toISOString();
  await dbRun(env, "INSERT INTO sessions (user_id, token_hash_b64, expires_at, created_at) VALUES (?, ?, ?, datetime('now'))", [userId, await sha256B64FromString(token), exp]);
  return { token, exp };
}

// GET/POST /auth/demo
async function handleDemoDoor(request, env, cors) {
  const c = demoCfg(env);
  if (!c) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  await ensureDemoSchema(env);
  const st = await demoStateGet(env);
  const busy = !!(st.running && st.phase !== "seed"); // wiping: the sandbox is empty for a few minutes
  // No door before the first reset has finished (until then location 2 still holds what it had) or after a wipe.
  const never = !st.last_day || !!st.wiped;
  const doors = never ? [] : demoDoorsOpen(c).filter((d) => !(st.shut || []).includes(d));
  if (request.method === "GET") return jsonResponse({ ok: true, doors, ready: !busy && !never }, 200, cors);
  if (request.method !== "POST") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, cors);
  let body = {}; try { body = JSON.parse(await request.text() || "{}") || {}; } catch (e) { body = {}; }
  const door = String(body.door || "pharmacy");
  if (never) return jsonResponse({ ok: false, error: "The demo is being prepared. Try again in a few minutes." }, 503, { ...cors, "Retry-After": "600" });
  if (!doors.includes(door)) return jsonResponse({ ok: false, error: "That part of the demo is not open" }, 404, cors);
  if (busy) return jsonResponse({ ok: false, error: "The demo is being refreshed. Try again in a few minutes." }, 503, { ...cors, "Retry-After": "300" });
  const ip = clientIp(request);
  const mine = await dbFirst(env, "SELECT COUNT(*) AS c FROM demo_signins WHERE ip = ? AND at > datetime('now', '-60 minutes')", [ip]);
  const all = await dbFirst(env, "SELECT COUNT(*) AS c FROM demo_signins WHERE at > datetime('now', '-60 minutes')", []);
  if (Number(mine && mine.c) >= DEMO_PER_IP_HOUR || Number(all && all.c) >= DEMO_ALL_HOUR)
    return jsonResponse({ ok: false, error: "Too many demo visits from here. Try again in an hour." }, 429, { ...cors, "Retry-After": "3600" });
  let uid = await demoUserId(env, c, door);
  if (!uid) { const p = await demoPrepare(env, c); if (p.fatal) return jsonResponse({ ok: false, error: "The demo is not available" }, 503, cors); uid = await demoUserId(env, c, door); }
  if (!uid) return jsonResponse({ ok: false, error: "The demo is not available" }, 503, cors);
  await dbRun(env, "INSERT INTO demo_signins (ip, door) VALUES (?, ?)", [ip, door]);
  try { await dbRun(env, "DELETE FROM demo_signins WHERE at < datetime('now', '-2 days')", []); } catch (e) {}
  // The visitors' own expired sessions go (only theirs: a real sign-in of the demo group is never touched here).
  try { await dbRun(env, `DELETE FROM sessions WHERE expires_at < ? AND user_id IN (SELECT id FROM users WHERE org_id = ? AND lower(email) IN (${DEMO_EMAILS.map(() => "?").join(",")}))`, [new Date().toISOString(), c.org, ...DEMO_EMAILS]); } catch (e) {}
  const s = await demoNewSession(env, uid, DEMO_SESSION_SECONDS);
  const u = await dbFirst(env, "SELECT u.id, u.org_id, u.email, u.full_name, u.role, u.default_location_id, l.name AS location_name, o.name AS org_name FROM users u JOIN locations l ON l.id = u.default_location_id LEFT JOIN orgs o ON o.id = u.org_id WHERE u.id = ?", [uid]);
  await writeAudit(env, c.org, uid, "DEMO_SIGNIN", "user", String(uid), { door }, Number(u.default_location_id));
  return jsonResponse({ ok: true, token: s.token, demo: true, expires_at: s.exp,
    user: { id: u.id, org_id: u.org_id, email: u.email, full_name: u.full_name, role: u.role, location_id: Number(u.default_location_id), location_name: u.location_name, org_name: u.org_name || "", demo: true, demo_door: door } }, 200, cors);
}

