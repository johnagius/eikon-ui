    [orderId]);
  if (!order) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

  // Pharmacy can mark as received; supplier can mark as shipped
  if (order.pharmacy_location_id !== authUser.location_id && order.supplier_location_id !== authUser.location_id) {
    return jsonResponse({ ok: false, error: "Access denied" }, 403, corsOkHeaders);
