}
async function rpnRows(env, org, loc, sc) {
  const sel = `SELECT id, shift_date, start_time, end_time, role_override, notes FROM shift_assignments WHERE org_id=? AND location_id=? AND staff_id=? AND `;
  if (sc.dates) return dbAll(env, sel + `shift_date IN (${sc.dates.map(() => "?").join(",")}) LIMIT ${RPN_ROWS_MAX}`, [org, loc, sc.staff, ...sc.dates]);
  return dbAll(env, sel + `shift_date>=? AND shift_date<=? LIMIT ${RPN_ROWS_MAX}`, [org, loc, sc.staff, sc.from, sc.to]);
}
// Before the write: which subscribed people it touches and their rows there now. null = no one to tell.
async function rpnBefore(request, env, kind, id, authUser) {
  const org = authUser.org_id, loc = authUser.location_id;
  const subs = await rpnSubscribed(env, org, loc);
  if (!subs.size) return null;
  await ensureShiftsSchema(env);
  let body = {};
  if (kind === "create" || kind === "update" || kind === "pattern" || kind === "plan" || kind === "leave") { try { body = JSON.parse(await request.clone().text() || "{}") || {}; } catch (e) { return null; } }
  const ymd = (s) => { s = String(s || "").trim(); return isValidYmd(s) ? s : ""; };
  const scopes = [];
  const add = (staff, sc) => { staff = Number(staff); if (staff && subs.has(staff) && !scopes.some((x) => x.staff === staff)) scopes.push(Object.assign({ staff }, sc)); };
  if (kind === "approve" || kind === "reject") {
    const l = await dbFirst(env, `SELECT id, staff_id, status, start_date, start_time, end_date, end_time FROM shift_leaves WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
    const to = kind === "approve" ? "approved" : "rejected";
    if (!l || !subs.has(Number(l.staff_id)) || String(l.status) === to) return null;
    return { org, loc, kind, leave: l, status: to };
  }
  if (kind === "leave") { // a new request (always pending): tell the person it is waiting
    const staff = Number(body.staff_id), sd = ymd(body.start_date), ed = ymd(body.end_date) || sd;
    if (!staff || !subs.has(staff) || !sd) return null;
    const mx = await dbFirst(env, `SELECT COALESCE(MAX(id), 0) AS m FROM shift_leaves WHERE org_id=? AND location_id=?`, [org, loc]);
    return { org, loc, kind, after: Number(mx && mx.m) || 0, leave: { staff_id: staff, start_date: sd, end_date: ed, start_time: body.start_time || null, end_time: body.end_time || null }, status: "pending" };
  }
  if (kind === "create") { const d = ymd(body.shift_date); if (!d) return null; add(body.staff_id, { dates: [d] }); }
  if (kind === "update" || kind === "delete") { // PUT changes only the times, role and note of that shift
    const r = await dbFirst(env, `SELECT staff_id, shift_date FROM shift_assignments WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
    if (!r) return null;
    add(r.staff_id, { dates: [r.shift_date] });
  }
  if (kind === "pattern") { const f = ymd(body.start_date || body.startDate), t = ymd(body.end_date || body.endDate); if (!f || !t || t < f) return null; add(body.staff_id || body.staffId, { from: f, to: t }); }
  if (kind === "plan") for (const it of (Array.isArray(body.items) ? body.items.slice(0, 50) : [])) { const f = ymd(it && it.from), t = ymd(it && it.to); if (f && t && t >= f) add(it.staff_id, { from: f, to: t }); }
  if (!scopes.length) return null;
  for (const sc of scopes) sc.before = await rpnRows(env, org, loc, sc);
  return { org, loc, kind, scopes };
}
// After a 2xx (inside ctx.waitUntil): the words per person, one notice each, one push per device.
async function rpnAfter(env, cap) {
  const texts = [];
  if (cap.leave) {
    const l = cap.kind === "leave"
      ? await dbFirst(env, `SELECT status FROM shift_leaves WHERE org_id=? AND location_id=? AND staff_id=? AND id>? ORDER BY id DESC LIMIT 1`, [cap.org, cap.loc, cap.leave.staff_id, cap.after])
      : await dbFirst(env, `SELECT status FROM shift_leaves WHERE id=? AND org_id=? AND location_id=?`, [cap.leave.id, cap.org, cap.loc]);
    if (l && String(l.status) === cap.status) texts.push({ staff: Number(cap.leave.staff_id), kind: "leave", text: rpnLeaveWords(cap.leave, cap.status) });
  } else {
    for (const sc of cap.scopes) {
      const w = rpnShiftWords(sc.before, await rpnRows(env, cap.org, cap.loc, sc));
      if (w) texts.push({ staff: sc.staff, kind: "shift", text: w });
    }
  }
  if (texts.length) await rpnNotify(env, cap.org, cap.loc, texts);
  return texts;
}
async function rpnNotify(env, org, loc, texts) {
  if (demoIsOrg(env, org)) return; // the one-click demo never pushes to a device
  const keys = await rpnKeys(env);
  if (!keys) return;
  await ensureRotaPushSchema(env);
  const staffIds = [];
  for (const t of texts) {
    await dbRun(env, `INSERT INTO rota_notices (org_id, location_id, staff_id, kind, text) VALUES (?, ?, ?, ?, ?)`, [org, loc, t.staff, t.kind, t.text.slice(0, 300)]);
    staffIds.push(t.staff);
  }
  // Old lines go (30 days), on the same index.
  try { await dbRun(env, `DELETE FROM rota_notices WHERE org_id=? AND location_id=? AND staff_id IN (${staffIds.map(() => "?").join(",")}) AND created_at < datetime('now', '-30 days')`, [org, loc, ...staffIds]); } catch (e) {}
  const subs = await dbAll(env, `SELECT id, endpoint FROM push_subscriptions WHERE org_id=? AND location_id=? AND staff_id IN (${staffIds.map(() => "?").join(",")}) LIMIT ${RPN_SUB_MAX_PER_LOC}`, [org, loc, ...staffIds]);
  const gone = [];
  await Promise.all(subs.map(async (s) => {
    if (!rpnEndpointOk(s.endpoint)) { gone.push(s.id); return; }
    try {
      const jwt = await rpnJwt(env, keys, s.endpoint);
      const r = await fetch(s.endpoint, { method: "POST", headers: { "Authorization": "vapid t=" + jwt + ", k=" + keys.pub, "TTL": "172800", "Urgency": "normal", "Topic": "eikon-rota", "Content-Length": "0" } });
      if (r.status === 404 || r.status === 410) gone.push(s.id);
      else if (r.status >= 400) console.log("[rota push] push service answered", r.status, "for device", s.id);
    } catch (e) { console.log("[rota push] push failed for device", s.id, e && e.message); }
  }));
  if (gone.length) await dbRun(env, `DELETE FROM push_subscriptions WHERE id IN (${gone.map(() => "?").join(",")})`, gone);
}

// Public: /sw.js and the notice feed the service worker reads. null = not ours.
async function rotaPushPublic(request, env, url) {
  if (request.method !== "GET" && request.method !== "HEAD") return null;
  if (url.pathname === "/sw.js") {
    return new Response(request.method === "HEAD" ? null : RPN_SW, { status: 200, headers: { "Content-Type": "application/javascript; charset=utf-8", "Cache-Control": "no-cache", "Service-Worker-Allowed": "/", "X-Content-Type-Options": "nosniff" } });
  }
  if (url.pathname !== "/rota/notices") return null;
  const no = (s) => jsonResponse({ ok: false, error: "Not found" }, s || 404);
  const id = parseInt(url.searchParams.get("sub") || "", 10), k = String(url.searchParams.get("k") || "");
  if (!id || id < 1 || !/^[A-Za-z0-9_-]{20,100}$/.test(k)) return no();
  await ensureRotaPushSchema(env);
  const s = await dbFirst(env, `SELECT id, org_id, location_id, staff_id, secret_hash, seen_notice_id FROM push_subscriptions WHERE id=?`, [id]);
  if (!s || s.secret_hash !== await rpnSha(k)) return no();
  const rows = await dbAll(env, `SELECT id, text FROM rota_notices WHERE org_id=? AND location_id=? AND staff_id=? AND id>? AND created_at >= datetime('now', '-7 days') ORDER BY id DESC LIMIT 5`,
    [s.org_id, s.location_id, s.staff_id, Number(s.seen_notice_id) || 0]);
  const url2 = "/ui/index.html#rotreg";
  if (!rows.length) return jsonResponse({ ok: true, count: 0, title: "Your shifts", body: "Open Eikon to see your shifts.", url: url2 });
  await dbRun(env, `UPDATE push_subscriptions SET seen_notice_id=?, last_push_at=datetime('now') WHERE id=?`, [Number(rows[0].id), s.id]);
  const body = rows.length === 1 ? rows[0].text : rows.slice(0, 3).map((r) => r.text).join("\n") + (rows.length > 3 ? "\nand more" : "");
  return jsonResponse({ ok: true, count: rows.length, title: rows.length === 1 ? "Your shifts" : rows.length + " changes to your shifts", body, url: url2 });
}

// Signed in: the device routes, and the shift/leave writes (each runs its own handler unchanged). null = not ours, or
// nothing to tell: the dispatch below runs as before.
async function rotaNotifyRoute(request, env, ctx, url, authUser, cors) {
  const p = url.pathname, m = request.method;
  if (p.startsWith("/rota/push/")) return await rpnDeviceRoute(request, env, url, authUser, cors);
  if (m === "GET" || !p.startsWith("/shifts/")) return null;
  let kind = null, id = 0, call = null;
  if (p === "/shifts/assignments" && m === "POST") { kind = "create"; call = () => handleShiftAssignmentCreate(request, env, cors, authUser); }
  else if (p === "/shifts/apply-pattern" && m === "POST") { kind = "pattern"; call = () => handleShiftApplyPattern(request, env, cors, authUser); }
  else if (p === "/shifts/apply-plan" && m === "POST") { kind = "plan"; call = () => handleShiftApplyPlan(request, env, cors, authUser); }
  else if (p.startsWith("/shifts/assignments/") && (m === "PUT" || m === "DELETE")) {
    id = parseInt(p.split("/")[3]); if (!id) return null;
    kind = m === "PUT" ? "update" : "delete";
    call = m === "PUT" ? () => handleShiftAssignmentUpdate(request, env, cors, authUser, id) : () => handleShiftAssignmentDelete(request, env, cors, authUser, id);
  } else if (p === "/shifts/leaves" && m === "POST") { kind = "leave"; call = () => handleShiftLeaveCreate(request, env, cors, authUser); }
  else if (p.startsWith("/shifts/leaves/") && m === "POST") {
    const parts = p.split("/"); id = parseInt(parts[3]);
    if (!id || (parts[4] !== "approve" && parts[4] !== "reject")) return null;
    kind = parts[4];
    call = kind === "approve" ? () => handleShiftLeaveApprove(request, env, cors, authUser, id) : () => handleShiftLeaveReject(request, env, cors, authUser, id);
  } else return null;
  let cap = null;
  try { if (!(await rpnKeys(env))) return null; cap = await rpnBefore(request, env, kind, id, authUser); }
  catch (e) { console.log("[rota push] skipped", e && e.message); return null; } // never in the way of a save
  if (!cap) return null;
  const res = await call();
  if (res && res.status >= 200 && res.status < 300) {
    const job = rpnAfter(env, cap).catch((e) => console.log("[rota push] notice failed", e && (e.stack || e)));
    if (ctx && typeof ctx.waitUntil === "function") ctx.waitUntil(job);
  }
  return res;
}
async function rpnDeviceRoute(request, env, url, authUser, cors) {
  const p = url.pathname, m = request.method, org = authUser.org_id, loc = authUser.location_id;
  const keys = await rpnKeys(env);
  if (p === "/rota/push/key" && m === "GET") return jsonResponse({ ok: true, push: !!keys, publicKey: keys ? keys.pub : null }, 200, cors);
  if (p !== "/rota/push/subscribe" && p !== "/rota/push/unsubscribe") return null;
  if (m !== "POST") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, cors);
  await ensureRotaPushSchema(env);
  let body = {}; try { body = JSON.parse(await request.text() || "{}") || {}; } catch (e) { return jsonResponse({ ok: false, error: "Bad JSON" }, 400, cors); }
  const sub = body.subscription || {}, endpoint = String(sub.endpoint || body.endpoint || "");
  if (p === "/rota/push/unsubscribe") {
    if (!endpoint) return jsonResponse({ ok: false, error: "endpoint required" }, 400, cors);
    const r = await dbRun(env, `DELETE FROM push_subscriptions WHERE endpoint=? AND org_id=? AND location_id=?`, [endpoint, org, loc]);
    return jsonResponse({ ok: true, removed: Number((r && r.meta && r.meta.changes) || 0) }, 200, cors);
  }
  if (!keys) return jsonResponse({ ok: true, push: false }, 200, cors); // not set up here: nothing stored, the screen says so
  if (!rpnEndpointOk(endpoint)) return jsonResponse({ ok: false, error: "This browser's push address is not one we can use" }, 400, cors);
  const staffId = parseInt(body.staff_id, 10);
  if (!staffId) return jsonResponse({ ok: false, error: "staff_id required" }, 400, cors);
  await ensureShiftsSchema(env);
  const st = await dbFirst(env, `SELECT id FROM shift_staff WHERE id=? AND org_id=? AND location_id=?`, [staffId, org, loc]);
  if (!st) return jsonResponse({ ok: false, error: "Staff not found" }, 404, cors);
  const n = await dbFirst(env, `SELECT COUNT(*) AS n FROM push_subscriptions WHERE org_id=? AND location_id=?`, [org, loc]);
  if (Number(n && n.n) >= RPN_SUB_MAX_PER_LOC) return jsonResponse({ ok: false, error: "Too many devices for this pharmacy" }, 400, cors);
  const keysIn = sub.keys || {}, p256 = String(keysIn.p256dh || "").slice(0, 200), auth = String(keysIn.auth || "").slice(0, 100);
  const k = rpnB64u(crypto.getRandomValues(new Uint8Array(32)));
  const last = await dbFirst(env, `SELECT COALESCE(MAX(id), 0) AS m FROM rota_notices WHERE org_id=? AND location_id=? AND staff_id=?`, [org, loc, staffId]);
  // One row per device: the same browser signing up again (another person, another pharmacy) replaces its row.
  await env.DB.batch([
    env.DB.prepare(`DELETE FROM push_subscriptions WHERE endpoint=?`).bind(endpoint),
    env.DB.prepare(`INSERT INTO push_subscriptions (org_id, location_id, staff_id, user_id, endpoint, p256dh, auth, secret_hash, seen_notice_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`)
      .bind(org, loc, staffId, authUser.user_id || null, endpoint, p256, auth, await rpnSha(k), Number(last && last.m) || 0)
  ]);
  const row = await dbFirst(env, `SELECT id FROM push_subscriptions WHERE endpoint=?`, [endpoint]);
  return jsonResponse({ ok: true, push: true, id: row && row.id, k, staff_id: staffId }, 200, cors);
}
