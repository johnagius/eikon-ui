  for (let wd = 0; wd <= 6; wd++) {
    const arr = Array.isArray(h[wd]) ? h[wd] : Array.isArray(h[String(wd)]) ? h[String(wd)] : [];
    const wins = [];
    for (const w of arr) {
      if (!Array.isArray(w) || w.length < 2) continue;
      const a = bkMin(w[0]), b = bkMin(w[1]);
      const room = Number(w[2]) > 0 ? Math.round(Number(w[2])) : 0; // optional third item: the room
      if (Number.isFinite(a) && Number.isFinite(b) && b > a) wins.push(room ? [bkTime(a), bkTime(b), room] : [bkTime(a), bkTime(b)]);
    }
    if (wins.length) out[wd] = wins;
  }
  return out;
}
function bkServiceRow(r) {
  return { id: r.id, name: r.name, durationMin: r.duration_min, bufferMin: r.buffer_min, priceCents: r.price_cents,
    color: r.color, providerIds: bkJson(r.provider_ids_json, []), online: !!r.online, active: !!r.active, sort: r.sort };
}
function bkProviderRow(r) { return { id: r.id, name: r.name, kind: r.kind, title: r.title || "", speciality: r.speciality || "", hours: bkJson(r.hours_json, {}), active: !!r.active }; }
