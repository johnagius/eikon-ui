// Opening times for the booking page: every active person's hours merged per weekday, then like weekdays grouped.
function bkHoursSummary(providers) {
  const names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"], text = {};
  for (let d = 0; d < 7; d++) {
    const iv = [];
    for (const p of providers) for (const r of ((p.hours || {})[d] || [])) if (r && r[0] && r[1] && r[0] < r[1]) iv.push([r[0], r[1]]);
    iv.sort((a, b) => (a[0] < b[0] ? -1 : 1));
    const merged = [];
    for (const r of iv) { const last = merged[merged.length - 1]; if (last && r[0] <= last[1]) { if (r[1] > last[1]) last[1] = r[1]; } else merged.push([r[0], r[1]]); }
    text[d] = merged.map((r) => r[0] + "–" + r[1]).join(", ");
  }
  const order = [1, 2, 3, 4, 5, 6, 0], out = [];
  for (let i = 0; i < order.length; i++) {
    const d = order[i]; if (!text[d]) continue;
    let j = i; while (j + 1 < order.length && text[order[j + 1]] === text[d]) j++;
    out.push({ days: i === j ? names[d] : names[d] + "–" + names[order[j]], time: text[d] }); i = j;
  }
  return out;
}

