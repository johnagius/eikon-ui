/* =========================
   STOCK FLOW (d-stock, additive)
   One ordering flow over the order diary: what is still to order across days (not one day at a time), which lines
   were ordered from the supplier and when, and which diary line is for which customer order / recall / shortage.
   Two new tables only; existing tables are read, never altered. Every read and write is fenced to the signed-in
   pharmacy (org_id AND location_id), so a chain's pharmacies never see each other's ordering.
   ========================= */
async function ensureStockFlowSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS stock_flow_ordered (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id      INTEGER NOT NULL,
