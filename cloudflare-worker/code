/* ---------- SMTP (port 465 TLS or 587 STARTTLS), over Cloudflare TCP sockets ----------
   The SMTP conversation runs against a small transport { read(), write(), startTls() } so it can
   be tested against a scripted server; in the Worker it uses cloudflare:sockets. Port 25 is blocked. */
async function bkSmtpTransport(env, host, port, secure) {
  if (env && env.__SMTP_TRANSPORT) return env.__SMTP_TRANSPORT(host, port, secure); // tests
  const { connect } = await import("cloudflare:sockets");
  let sock = connect({ hostname: host, port }, { secureTransport: secure === "starttls" ? "starttls" : "on", allowHalfOpen: false });
  const enc = new TextEncoder(), dec = new TextDecoder();
  let reader = sock.readable.getReader(), writer = sock.writable.getWriter(), buf = "";
  return {
    async read() { while (true) { const i = buf.indexOf("\r\n"); if (i >= 0) { const line = buf.slice(0, i); buf = buf.slice(i + 2); return line; }
      const { value, done } = await reader.read(); if (done) throw new Error("SMTP connection closed"); buf += dec.decode(value, { stream: true }); } },
    async write(s) { await writer.write(enc.encode(s)); },
    async startTls() { reader.releaseLock(); writer.releaseLock(); sock = sock.startTls(); reader = sock.readable.getReader(); writer = sock.writable.getWriter(); buf = ""; },
    async close() { try { await sock.close(); } catch (e) {} }
  };
}
async function bkSmtpSend(env, s, password, { from, fromEmail, to, subject, html, ics }) {
  const t = await bkSmtpTransport(env, s.smtp_host, Number(s.smtp_port) || 465, s.smtp_secure || "tls");
  const reply = async () => { let line, all = []; do { line = await t.read(); all.push(line); } while (/^\d{3}-/.test(line)); return { code: Number(line.slice(0, 3)), text: all.join(" ") }; };
  const expect = async (want, what) => { const r = await reply(); if (r.code !== want) throw new Error(`SMTP ${what}: ${r.text.slice(0, 160)}`); return r; };
  const cmd = async (line, want, what) => { await t.write(line + "\r\n"); return expect(want, what); };
  const b64 = (x) => base64FromBytes(new TextEncoder().encode(x));
  try {
    await expect(220, "greeting");
    let ehlo = await cmd("EHLO eikon.local", 250, "EHLO");
    if ((s.smtp_secure || "tls") === "starttls") {
      if (!/STARTTLS/i.test(ehlo.text)) throw new Error("SMTP server does not offer STARTTLS");
      await cmd("STARTTLS", 220, "STARTTLS"); await t.startTls(); ehlo = await cmd("EHLO eikon.local", 250, "EHLO after TLS");
    }
    if (s.smtp_user) { await cmd("AUTH LOGIN", 334, "AUTH"); await cmd(b64(s.smtp_user), 334, "user"); await cmd(b64(password), 235, "login (check user and password)"); }
    await cmd(`MAIL FROM:<${fromEmail}>`, 250, "MAIL FROM");
    await cmd(`RCPT TO:<${to}>`, 250, "RCPT TO");
    await cmd("DATA", 354, "DATA");
    const boundary = "eikon-" + bkRandomHex(8);
    const encWord = (x) => /^[\x20-\x7e]*$/.test(x) ? x : "=?UTF-8?B?" + b64(x) + "?=";
    const wrap = (x) => x.replace(/.{1,76}/g, "$&\r\n");
    let msg = [`From: ${encWord(from)}`, `To: <${to}>`, `Subject: ${encWord(subject)}`, `Date: ${new Date().toUTCString()}`, `Message-ID: <${bkRandomHex(12)}@eikon>`,
      "MIME-Version: 1.0", `Content-Type: multipart/mixed; boundary="${boundary}"`, "", `--${boundary}`, "Content-Type: text/html; charset=UTF-8", "Content-Transfer-Encoding: base64", "", wrap(b64(html))].join("\r\n");
    if (ics) msg += [`--${boundary}`, 'Content-Type: text/calendar; charset=UTF-8; method=PUBLISH; name="booking.ics"', "Content-Transfer-Encoding: base64",
      'Content-Disposition: attachment; filename="booking.ics"', "", wrap(b64(ics))].join("\r\n");
    msg += `--${boundary}--\r\n`;
    // Dot-stuffing: a line that starts with "." gets another "." (RFC 5321 4.5.2).
    msg = msg.replace(/\r\n\./g, "\r\n..");
    await t.write(msg + "\r\n.\r\n"); await expect(250, "message");
    await t.write("QUIT\r\n");
  } finally { await t.close(); }
}

// EIKON_NAME_CASE (the same text is in ui/eikon.people.js; a UI test compares the two).
// "carmel zammit" / "CARMEL ZAMMIT" -> "Carmel Zammit". A name typed in mixed case ("de Gabriele", "McDonald",
// "Anne-marie") is the user's own choice and comes back exactly as typed; so does anything with a digit or an @.
function eikonNameCase(value) {
  if (typeof value !== "string") return value;
  if (/[0-9@]/.test(value) || !/\p{L}/u.test(value)) return value;
  var letters = value.match(/\p{L}/gu) || [];
  if (!/\p{Ll}/u.test(value) && !/\s/.test(value.trim()) && (letters.length <= 2 || (letters.length === 3 && !/[AEIOUY]/.test(value)))) return value;
  var first = true;
  var out = value.replace(/[^\s\-‐‑–—]+/g, function (seg, at, all) {
    var wasFirst = first; first = false;
    var lo = /\p{Ll}/u.test(seg), up = /\p{Lu}/u.test(seg);
    if (!lo && !up) return seg;
    if (lo && up && !/^\p{Lu}[^\p{Lu}]*$/u.test(seg)) return seg; // inner capitals typed on purpose (McDonald, DeBono)
    var o = seg.toLowerCase().replace(/(^|[.(\/"“])(\p{Ll})/gu, function (m, pre, ch) { return pre + ch.toUpperCase(); });
    o = o.replace(/(^|[^\p{L}])(\p{Lu})(['’ʼ])(\p{Ll})/gu, function (m, pre, a, ap, b) { return pre + a + ap + b.toUpperCase(); });
    o = o.replace(/^Mc(\p{Ll})(?=\p{Ll})/u, function (m, a) { return "Mc" + a.toUpperCase(); });
    if (!wasFirst && /^(Ii|Iii|Iv|Vi|Vii|Viii|Ix)[,.]?$/.test(o)) o = o.toUpperCase();
    // Particles inside a name stay small (never the first word, and only with more of the name after them): the Maltese
    // "tal-", "tad-", "taż-"… and "ta'" always ("Borg tal-Ħamrun", "Zammit ta' Xbiex"); "de", "di", "von"… unless typed
    // with a capital on purpose ("Joseph De Gabriele" is kept).
    var next = all.charAt(at + seg.length), more = /\p{L}/u.test(all.slice(at + seg.length));
    if (!wasFirst && more) {
      if (/^ta[lċdnrstxzż]$/u.test(o.toLowerCase()) && /[\-‐‑]/.test(next)) o = o.toLowerCase();
      else if (/^Ta['’ʼ]/u.test(o)) o = "t" + o.slice(1);
      else if (!(lo && up) && /\s/.test(next) && /^(de|di|da|del|della|von|van|der|den|du)$/.test(o.toLowerCase())) o = o.toLowerCase();
    }
    return o;
  });
  if (out.toLowerCase() !== value.toLowerCase()) return value;
  return out;
}

