function ssIntNonNeg(v) {
  const n = Number(v);
  if (!Number.isFinite(n)) return null;
  const i = Math.floor(n);
  return i < 0 ? null : i;
}
function ssText(v, max) {
  let s = String(v ?? "").trim();
  if (max && s.length > max) s = s.slice(0, max);
  return s;
}
function ssBool01(v) { return (v === 1 || v === "1" || v === true) ? 1 : 0; }

// W4: scarce stock offers are shared inside a group only. A group (a chain) is one org: orgs.id, the org_id every
// location and sign-in belongs to (the same rule Stock transfers use). A pharmacy alone in its org sees only its own.
// Location numbers (the 400-599 supplier and 600-900 company-admin ranges) and group data are not touched or read.
function ssSameGroup(authUser, orgId) { return Number(authUser.org_id) === Number(orgId); }

function ssCanSeeSensitive(authUser, aOrg, aLoc, bOrg, bLoc) {
  const uOrg = authUser.org_id, uLoc = authUser.location_id;
  const isA = (uOrg === aOrg && uLoc === aLoc);
  const isB = (uOrg === bOrg && uLoc === bLoc);
  return isA || isB;
}

// ----- Scarce stock depletion → auto-delete linked near expiry, remove from transfer, remove from returns
async function checkScarceStockDepletion(env, offerId, authUser) {
  // When an offer is fully requested it is CLOSED. Nothing is deleted: the near-expiry
  // entry, the returns entry and any transfer item stay on record (the transfer item is
  // closed, not removed). Deleting them here destroyed other modules' work from a mere
  // request by another pharmacy.
  const offer = await dbFirst(env,
    "SELECT id, org_id, location_id, quantity_available, is_closed, near_expiry_id, transfer_item_id FROM scarce_stock_offers WHERE id=?",
    [offerId]
  );
  if (!offer) return;

  const totalReq = await dbFirst(env,
    "SELECT COALESCE(SUM(quantity_requested), 0) AS total FROM scarce_stock_offer_requests WHERE offer_id=?",
    [offerId]
  );
  const remaining = Number(offer.quantity_available || 0) - Number(totalReq?.total || 0);
  if (remaining > 0) return;

  if (Number(offer.is_closed || 0) !== 1) {
    await dbRun(env, "UPDATE scarce_stock_offers SET is_closed=1, updated_at=datetime('now') WHERE id=?", [offerId]);
    await writeAudit(env, offer.org_id, authUser.user_id, "SCARCE_OFFER_DEPLETED", "scarce_stock_offers", String(offerId), { quantity_available: offer.quantity_available, requested: Number(totalReq?.total || 0) }, authUser.location_id);
  }

  await ensureStockTransfersSchema(env);
  const linked = await dbAll(env,
    "SELECT id FROM stock_transfer_items WHERE (id = ? OR placed_on_scarce_stock_id = ?) AND org_id = ? AND location_id = ? AND is_closed = 0",
    [offer.transfer_item_id || 0, offerId, offer.org_id, offer.location_id]
  );
  for (const t of linked) {
    await dbRun(env, "UPDATE stock_transfer_items SET is_closed = 1, close_reason = 'Scarce stock fully requested', updated_at = datetime('now'), updated_by = ? WHERE id = ?", [authUser.user_id, t.id]);
    await writeAudit(env, offer.org_id, authUser.user_id, "STOCK_TRANSFER_AUTO_CLOSE", "stock_transfer_items", String(t.id), { reason: "scarce_stock_depleted", offer_id: offerId }, authUser.location_id);
  }
}

// ----- Offers list
async function handleScarceOffersList(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureScarceStockSchema(env);
  const openOnly = !!(url && url.searchParams.get("open") === "1");

  // Auto-migrate expired offers owned by this location into Near Expiry
  await ensureNearExpirySchema(env);
  const todayYmd = tzYmd();
  const expiredOwn = await dbAll(env, `
    SELECT id, item_name, expiry_date, batch, near_expiry_id
    FROM scarce_stock_offers
    WHERE org_id=? AND location_id=? AND expiry_date IS NOT NULL AND expiry_date < ? AND is_closed=0
  `, [authUser.org_id, authUser.location_id, todayYmd]);

  for (const exp of expiredOwn) {
    // Close the expired offer
    await dbRun(env, "UPDATE scarce_stock_offers SET is_closed=1, updated_at=datetime('now'), updated_by=? WHERE id=?", [authUser.user_id, exp.id]);

    // Remove from stock transfer if linked (expired items cannot be transferred)
    await ensureStockTransfersSchema(env);
    // Check transfer_item_id on the offer itself
    const expOffer = await dbFirst(env, "SELECT transfer_item_id FROM scarce_stock_offers WHERE id=?", [exp.id]);
    if (expOffer && expOffer.transfer_item_id) {
      await dbRun(env, "DELETE FROM stock_transfer_requests WHERE item_id = ?", [expOffer.transfer_item_id]);
      await dbRun(env, "DELETE FROM stock_transfer_items WHERE id = ?", [expOffer.transfer_item_id]);
      await dbRun(env, "UPDATE scarce_stock_offers SET transfer_item_id=NULL, updated_at=datetime('now') WHERE id=?", [exp.id]);
      await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_AUTO_DELETE", "stock_transfer_items", String(expOffer.transfer_item_id), { reason: "scarce_stock_expired", offer_id: exp.id }, authUser.location_id);
    }
    // Also check if a transfer item links back via placed_on_scarce_stock_id
    const linkedTransfer = await dbFirst(env,
      "SELECT id FROM stock_transfer_items WHERE placed_on_scarce_stock_id = ? AND org_id = ? AND location_id = ? AND is_closed = 0",
      [exp.id, authUser.org_id, authUser.location_id]
    );
    if (linkedTransfer) {
      await dbRun(env, "UPDATE stock_transfer_items SET is_closed = 1, close_reason = 'Scarce stock expired', updated_at = datetime('now'), updated_by = ? WHERE id = ?", [authUser.user_id, linkedTransfer.id]);
    }
    // Also check if a transfer item placed this as source_module='scarcestock'
    const linkedTransfer2 = await dbFirst(env,
      "SELECT id FROM stock_transfer_items WHERE source_module = 'scarcestock' AND source_id = ? AND org_id = ? AND location_id = ? AND is_closed = 0",
      [exp.id, authUser.org_id, authUser.location_id]
    );
    if (linkedTransfer2) {
      await dbRun(env, "UPDATE stock_transfer_items SET is_closed = 1, close_reason = 'Scarce stock expired', updated_at = datetime('now'), updated_by = ? WHERE id = ?", [authUser.user_id, linkedTransfer2.id]);
    }

    // Only create near expiry entry if not already linked
    if (!exp.near_expiry_id) {
      // Check if a matching near expiry entry already exists
      const existing = await dbFirst(env,
        "SELECT id FROM near_expiry_entries WHERE product_name=? AND expiry_date=? AND org_id=? AND location_id=?",
        [exp.item_name, exp.expiry_date, authUser.org_id, authUser.location_id]
      );
      if (!existing) {
        const neRes = await dbRun(env, `
          INSERT INTO near_expiry_entries (org_id, location_id, product_name, expiry_date, location, notes, scarce_stock_offer_id, created_by, updated_by, created_at, updated_at)
          VALUES (?, ?, ?, ?, '', 'Auto-added from expired Scarce Stock offer', ?, ?, ?, datetime('now'), datetime('now'))
        `, [authUser.org_id, authUser.location_id, exp.item_name, exp.expiry_date, exp.id, authUser.user_id, authUser.user_id]);
        const neId = neRes?.meta?.last_row_id || null;
        if (neId) {
          await dbRun(env, "UPDATE scarce_stock_offers SET near_expiry_id=?, updated_at=datetime('now') WHERE id=?", [neId, exp.id]);
        }
        await writeAudit(env, authUser.org_id, authUser.user_id, "NEAR_EXPIRY_AUTO_CREATE", "near_expiry_entries", String(neId || ""), { source: "expired_scarce_stock", offer_id: exp.id, item_name: exp.item_name }, authUser.location_id);
      } else {
        // Link existing near expiry entry to this offer
        await dbRun(env, "UPDATE scarce_stock_offers SET near_expiry_id=?, updated_at=datetime('now') WHERE id=?", [existing.id, exp.id]);
        await dbRun(env, "UPDATE near_expiry_entries SET scarce_stock_offer_id=?, updated_at=datetime('now') WHERE id=?", [exp.id, existing.id]);
      }
    }
  }

  const offersBase = await dbAll(env, `
    SELECT
      o.id, o.org_id, o.location_id, o.entry_date, o.item_name, o.description, o.batch, o.expiry_date,
      o.quantity_available, o.is_closed, o.near_expiry_id,
      o.placed_on_returns, o.placed_on_returns_id, o.transfer_item_id,
      org.name AS org_name,
      loc.name AS location_name,
      COALESCE(SUM(r.quantity_requested), 0) AS total_requested
    FROM scarce_stock_offers o
    JOIN orgs org ON org.id = o.org_id
    JOIN locations loc ON loc.id = o.location_id
    LEFT JOIN scarce_stock_offer_requests r ON r.offer_id = o.id
    WHERE o.org_id = ?${openOnly ? " AND o.is_closed = 0" : ""}
    GROUP BY o.id
    ORDER BY o.is_closed ASC, o.entry_date DESC, o.id DESC
  `, [authUser.org_id]); // W4: this pharmacy's group only

  const offerIds = offersBase.map(x => Number(x.id)).filter(n => Number.isFinite(n) && n > 0);
  let reqRows = [];
  if (offerIds.length) {
    reqRows = await dbAll(env, `
      SELECT
        r.id, r.offer_id, r.requester_org_id, r.requester_location_id, r.quantity_requested, r.note,
        org.name AS requester_org_name,
        loc.name AS requester_location_name
      FROM scarce_stock_offer_requests r
      JOIN orgs org ON org.id = r.requester_org_id
      JOIN locations loc ON loc.id = r.requester_location_id
      WHERE r.offer_id IN (SELECT id FROM scarce_stock_offers WHERE org_id = ?${openOnly ? " AND is_closed = 0" : ""})
      ORDER BY r.created_at ASC, r.id ASC
    `, [authUser.org_id]); // a subquery, not one bound parameter per offer (D1 allows at most 100)
  }

  const reqByOffer = new Map();
  for (const rr of reqRows) {
    const oid = Number(rr.offer_id);
    if (!reqByOffer.has(oid)) reqByOffer.set(oid, []);
    reqByOffer.get(oid).push(rr);
  }

  const offers = [];
  for (const o of offersBase) {
    const mineOwner = (authUser.org_id === o.org_id && authUser.location_id === o.location_id);
    const requestsIn = reqByOffer.get(Number(o.id)) || [];
    const requestsOut = [];

    for (const rr of requestsIn) {
      const canSee = ssCanSeeSensitive(
        authUser,
        Number(o.org_id), Number(o.location_id),
        Number(rr.requester_org_id), Number(rr.requester_location_id)
      );
      const mine = (authUser.org_id === rr.requester_org_id && authUser.location_id === rr.requester_location_id);

      requestsOut.push({
        id: rr.id,
        offer_id: rr.offer_id,
        quantity_requested: Number(rr.quantity_requested || 0),
        is_private: canSee ? 0 : 1,
        requester_display: canSee ? ((rr.requester_org_name || "") + " — " + (rr.requester_location_name || "")) : "",
        note: canSee ? (rr.note || "") : "",
        mine: mine ? 1 : 0
      });
    }

    offers.push({
      id: o.id,
      org_id: o.org_id,
      org_name: o.org_name || "",
      location_id: o.location_id,
      location_name: o.location_name || "",
      entry_date: o.entry_date,
      item_name: o.item_name,
      description: o.description || "",
      batch: o.batch || "",
      expiry_date: o.expiry_date || null,
      quantity_available: Number(o.quantity_available || 0),
      is_closed: Number(o.is_closed || 0),
      total_requested: Number(o.total_requested || 0),
      remaining_quantity: Number(o.quantity_available || 0) - Number(o.total_requested || 0),
      near_expiry_id: o.near_expiry_id || null,
      placed_on_returns: Number(o.placed_on_returns || 0),
      placed_on_returns_id: o.placed_on_returns_id || null,
      transfer_item_id: o.transfer_item_id || null,
      mine_owner: mineOwner ? 1 : 0,
      requests: requestsOut
    });
  }

  return jsonResponse({ ok: true, offers }, 200, corsOkHeaders);
}

// ----- Offers create/update/delete
async function handleScarceOfferCreate(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureScarceStockSchema(env);

  const body = await readJson(request);
  const entry_date = ssText(body.entry_date, 40);
  const item_name = ssText(body.item_name, 220);
  const description = ssText(body.description, 2000);
  const batch = ssText(body.batch, 120);
  const expiry_date = ssText(body.expiry_date, 40);
  const qty = ssIntNonNeg(body.quantity_available);
  const is_closed = ssBool01(body.is_closed);

  if (!isValidYmd(entry_date)) return jsonResponse({ ok: false, error: "Invalid entry_date (YYYY-MM-DD)" }, 400, corsOkHeaders);
  if (!item_name) return jsonResponse({ ok: false, error: "Missing item_name" }, 400, corsOkHeaders);
  if (expiry_date && !isValidYmd(expiry_date)) return jsonResponse({ ok: false, error: "Invalid expiry_date (YYYY-MM-DD or empty)" }, 400, corsOkHeaders);
  if (qty === null) return jsonResponse({ ok: false, error: "Invalid quantity_available (>= 0)" }, 400, corsOkHeaders);

  // Optional near_expiry_id linkage
  const near_expiry_id = body.near_expiry_id ? Number(body.near_expiry_id) : null;
  if (near_expiry_id) {
    await ensureNearExpirySchema(env);
    const neRow = await dbFirst(env,
      "SELECT id, scarce_stock_offer_id, expiry_date FROM near_expiry_entries WHERE id=? AND org_id=? AND location_id=?",
      [near_expiry_id, authUser.org_id, authUser.location_id]
    );
    if (!neRow) return jsonResponse({ ok: false, error: "Near expiry item not found" }, 404, corsOkHeaders);
    if (neRow.scarce_stock_offer_id) return jsonResponse({ ok: false, error: "This item is already in Scarce Stock" }, 409, corsOkHeaders);
    if (neRow.expiry_date) {
      const today = tzYmd();
      if (neRow.expiry_date <= today) return jsonResponse({ ok: false, error: "Cannot add expired item to Scarce Stock" }, 400, corsOkHeaders);
    }
  }

