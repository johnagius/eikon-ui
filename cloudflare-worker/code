// "Collected today": sets last_collected_date on one line of this pharmacy (Malta date unless a date is sent).
// Body: {} -> today; { date: "YYYY-MM-DD" } -> that day (not in the future, not before the line was written), used
// by Undo to put the previous day back; { date: "" } or { date: null } -> clear it. Audited like every write.
async function handleRepeatPrescriptionsEntryCollected(request, env, corsOkHeaders, authUser, entryId) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }
  await ensureRepeatPrescriptionsSchema(env);
  const existing = await dbFirst(
    env,
    `SELECT id, entry_date, client_id, medicine_name_dose, last_collected_date FROM repeat_prescription_entries
     WHERE id = ? AND org_id = ? AND location_id = ?`,
    [entryId, authUser.org_id, authUser.location_id]
  );
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  let body = {};
  try { body = (await readJson(request)) || {}; } catch (e) { body = {}; }
  const today = tzYmd();
  let date = today;
  if (Object.prototype.hasOwnProperty.call(body, "date")) {
    const d = body.date == null ? "" : String(body.date).trim();
    if (d === "") date = null;
    else if (!isValidYmd(d)) return jsonResponse({ ok: false, error: "Invalid date (YYYY-MM-DD)" }, 400, corsOkHeaders);
    else if (d > today) return jsonResponse({ ok: false, error: "The collection date cannot be in the future" }, 400, corsOkHeaders);
    else if (d < String(existing.entry_date || "")) return jsonResponse({ ok: false, error: "The collection date cannot be before the prescription was written" }, 400, corsOkHeaders);
    else date = d;
  }
  const __before = await auditSnap(env, "repeat_prescription_entries", entryId, authUser);
  await dbRun(
    env,
    `UPDATE repeat_prescription_entries SET last_collected_date = ?, updated_at = datetime('now')
     WHERE id = ? AND org_id = ? AND location_id = ?`,
    [date, entryId, authUser.org_id, authUser.location_id]
  );
  await writeAudit(env, authUser.org_id, authUser.user_id, "REPEAT_RX_ENTRY_COLLECTED", "repeat_prescription_entries", String(entryId), auditWith({
    client_id: existing.client_id,
    medicine_name_dose: existing.medicine_name_dose,
    last_collected_date: date,
    previous: existing.last_collected_date || null
  }, __before, await auditSnap(env, "repeat_prescription_entries", entryId, authUser)), authUser.location_id);
  return jsonResponse({ ok: true, entry_id: entryId, last_collected_date: date, previous: existing.last_collected_date || null }, 200, corsOkHeaders);
}

