async function handleContactsSave(request, env, corsOkHeaders, authUser, tableKey) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }
  await ensureContactsSchema(env);
  const def = CONTACTS_TABLES[tableKey];
  if (!def) return jsonResponse({ ok: false, error: "Unknown table" }, 400, corsOkHeaders);

  const body = await request.json();
  const id = body.id ? parseInt(body.id, 10) : null;

  if (id) {
    // Update existing
    const whereClause = def.locScoped
      ? `id = ? AND org_id = ? AND location_id = ?`
      : `id = ? AND org_id = ?`;
    const whereVals = def.locScoped
      ? [id, authUser.org_id, authUser.location_id]
      : [id, authUser.org_id];

    const existing = await dbFirst(env, `SELECT id FROM ${def.db} WHERE ${whereClause}`, whereVals);
    if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

    const sets = def.cols.map(c => `${c} = ?`).concat(["updated_at = datetime('now')", "updated_by = ?"]);
    const vals = def.cols.map(c => String(body[c] || "").trim());
    vals.push(authUser.user_id);
    vals.push(...whereVals);

    await dbRun(env, `UPDATE ${def.db} SET ${sets.join(", ")} WHERE ${whereClause}`, vals);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CONTACT_UPDATE", def.db, String(id), body, authUser.location_id);
    return jsonResponse({ ok: true, id: id }, 200, corsOkHeaders);
  } else {
    // Insert new
    const colNames = def.locScoped
      ? ["org_id", "location_id"].concat(def.cols).concat(["created_by", "updated_by"])
      : ["org_id"].concat(def.cols).concat(["created_by", "updated_by"]);
    const placeholders = colNames.map(() => "?").join(", ");
    const vals = def.locScoped
      ? [authUser.org_id, authUser.location_id].concat(def.cols.map(c => String(body[c] || "").trim())).concat([authUser.user_id, authUser.user_id])
      : [authUser.org_id].concat(def.cols.map(c => String(body[c] || "").trim())).concat([authUser.user_id, authUser.user_id]);

    const res = await dbRun(env,
      `INSERT INTO ${def.db} (${colNames.join(", ")}) VALUES (${placeholders})`,
      vals);
    const newId = res && res.meta ? res.meta.last_row_id : null;
    await writeAudit(env, authUser.org_id, authUser.user_id, "CONTACT_CREATE", def.db, String(newId || ""), body, authUser.location_id);
    return jsonResponse({ ok: true, id: newId }, 200, corsOkHeaders);
  }
}

