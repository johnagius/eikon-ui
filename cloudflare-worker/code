      lines.push("DTSTART;VALUE=DATE:" + sd.replace(/-/g, ""));
      lines.push("DTEND;VALUE=DATE:" + shpAddDays(ed, 1).replace(/-/g, ""));
      lines.push("SUMMARY:" + icsEscape((l.staff_name || ("Staff #" + l.staff_id)) + " — " + kind + part));
