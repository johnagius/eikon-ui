// "Not the same person", kept for the pharmacy (the view's own hash: no names or ID cards).
function peopleFingerprint(raw) { const s = String(raw || "").trim(); return /^[a-z0-9.]{4,64}$/.test(s) ? s : ""; }
async function handlePeopleNotSame(request, env, corsOkHeaders, authUser, undo) {
  if (!requireRole(authUser, PEOPLE_LINK_ROLES)) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  if (request.method === "GET") {
    let rows = [];
    try { rows = await dbAll(env, "SELECT fingerprint FROM people_not_same WHERE org_id = ? AND location_id = ? AND undone_at IS NULL ORDER BY id LIMIT 5000", [org, loc]); } catch (e) { rows = []; }
    return jsonResponse({ ok: true, fingerprints: rows.map((r) => r.fingerprint) }, 200, corsOkHeaders);
  }
  const body = (await readJson(request)) || {};
  const fp = peopleFingerprint(body.fingerprint);
  if (!fp) return jsonResponse({ ok: false, error: "Missing fingerprint" }, 400, corsOkHeaders);
  await ensurePeopleLinksSchema(env);
  const before = await dbFirst(env, "SELECT * FROM people_not_same WHERE org_id = ? AND location_id = ? AND fingerprint = ?", [org, loc, fp]);
  if (undo) {
    if (!before) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
    if (before.undone_at) return jsonResponse({ ok: true, already: true }, 200, corsOkHeaders);
    await dbRun(env, "UPDATE people_not_same SET undone_at = datetime('now'), undone_by = ? WHERE id = ? AND org_id = ? AND location_id = ? AND undone_at IS NULL", [authUser.user_id, before.id, org, loc]);
  } else {
    if (before && !before.undone_at) return jsonResponse({ ok: true, already: true }, 200, corsOkHeaders);
    if (before) await dbRun(env, "UPDATE people_not_same SET undone_at = NULL, undone_by = NULL, created_by = ? WHERE id = ? AND org_id = ? AND location_id = ?", [authUser.user_id, before.id, org, loc]);
    else await dbRun(env, "INSERT INTO people_not_same (org_id, location_id, fingerprint, created_by) VALUES (?, ?, ?, ?) ON CONFLICT DO NOTHING", [org, loc, fp, authUser.user_id]);
  }
  const after = await dbFirst(env, "SELECT * FROM people_not_same WHERE org_id = ? AND location_id = ? AND fingerprint = ?", [org, loc, fp]);
  await writeAudit(env, org, authUser.user_id, undo ? "PERSON_NOT_SAME_UNDO" : "PERSON_NOT_SAME", "people_not_same", fp, auditWith({ location_id: loc }, before, after), loc);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

// Read side, GET /people/:id: every live link group that holds the person (or one of the records already on their
// timeline) adds its other records to the timeline. Records already there are marked with their group.
async function peopleLinksAddToActivity(env, org, loc, personIds, activity) {
  try { // reads only: no table is created here (before the first link the query fails and the timeline is as before)
    const pairs = personIds.map((id) => ({ table: "people", source_id: String(id) }));
    const poctRowIds = [];
    for (const a of activity) { if (a.table === "poct_patients") poctRowIds.push(a.id); else pairs.push({ table: a.table, source_id: String(a.id) }); }
    const poctKey = {};
    if (poctRowIds.length) {
      const pr = await dbAllChunked(env, (ph) => "SELECT id, patient_id FROM poct_patients WHERE org_id = ? AND location_id = ? AND id IN (" + ph + ")", poctRowIds, [org, loc]);
      for (const r of pr) { poctKey[r.id] = String(r.patient_id); pairs.push({ table: "poct_patients", source_id: String(r.patient_id) }); }
    }
    const hits = await peopleLinksOfSources(env, org, loc, pairs);
    const groups = Array.from(new Set(hits.map((l) => l.link_group)));
    if (!groups.length) return [];
    const members = await peopleLinksLive(env, org, loc, groups);
    const groupOf = {};
    for (const m of members) groupOf[m.source_table + ":" + m.source_id] = m.link_group;
    const have = new Set();
    for (const a of activity) {
      const sid = a.table === "poct_patients" ? poctKey[a.id] : String(a.id);
      const g = groupOf[a.table + ":" + sid];
      if (g) a.link_group = g;
      have.add(a.table + ":" + sid);
    }
    for (const m of members) {
      if (m.source_kind === "people" || have.has(m.source_table + ":" + m.source_id)) continue;
      const r = await peopleLinkRecord(env, org, loc, m.source_kind, m.source_id);
      if (!r) continue; // the record is gone: the link stays, the timeline skips it
      const d = PEOPLE_LINK_KINDS[m.source_kind];
      activity.push({ kind: m.source_kind, label: d.label, table: m.source_table, id: /^\d+$/.test(r.source_id) && d.key === "id" ? Number(r.source_id) : r.source_id,
        date: String(r.date || "").slice(0, 10), title: String(r.title || "").slice(0, 200), ref: r.ref || "", doctor: "", linked: true, link_group: m.link_group });
    }
    return groups;
  } catch (e) { return []; } // the timeline never fails over links
}

// Read side, GET /people?q=: a history candidate whose rows are all linked into groups that hold a person is that
// person: the candidate is left out and the person is listed (once) instead.
async function peopleLinksHideHistory(env, org, loc, rowsByKind, history, people) {
  try {
    if (!history.length) return history; // reads only: no table is created here
    const srcOf = {};
    for (const s of PEOPLE_SOURCES) srcOf[s.kind] = s;
    const rowsOfKey = {};
    const pairs = [];
    for (const { kind, rows } of rowsByKind) {
      const s = srcOf[kind];
      if (!s) continue;
      for (const r of rows) {
        const key = personKey(r.id_card, r.name);
        if (!key) continue;
        const sid = s.table === "poct_patients" ? String(r.id_card) : String(r.id);
        const p = { table: s.table, source_id: sid };
        (rowsOfKey[key] = rowsOfKey[key] || []).push(p);
        pairs.push(p);
      }
    }
    if (!pairs.length) return history;
    const hits = await peopleLinksOfSources(env, org, loc, pairs);
    if (!hits.length) return history;
    const groupOf = {};
    for (const h of hits) groupOf[h.source_table + ":" + h.source_id] = h.link_group;
    const groups = Array.from(new Set(hits.map((h) => h.link_group)));
    const personLinks = await dbAllChunked(env, (ph) => "SELECT link_group, source_id FROM people_links WHERE org_id = ? AND location_id = ? AND undone_at IS NULL AND source_kind = 'people' AND link_group IN (" + ph + ")", groups, [org, loc]);
    const personOf = {};
    for (const l of personLinks) if (!personOf[l.link_group]) personOf[l.link_group] = Number(l.source_id);
    const listed = new Set(people.map((p) => p.id));
    const out = [];
    for (const g of history) {
      const rows = rowsOfKey[g.key] || [];
      const pids = rows.map((p) => personOf[groupOf[p.table + ":" + p.source_id]]);
      if (!rows.length || pids.some((x) => !x)) { out.push(g); continue; }
      for (const pid of new Set(pids)) {
        if (listed.has(pid)) continue;
        let person = await peopleLoad(env, org, loc, pid);
        if (person && person.merged_into) person = await peopleLoad(env, org, loc, person.merged_into);
        if (person && !listed.has(person.id)) { listed.add(person.id); people.push(Object.assign({}, person, { via_link: true })); }
      }
    }
    return out;
  } catch (e) { return history; } // search never fails over links
}
