      person_name TEXT NOT NULL, person_phone TEXT NOT NULL DEFAULT '', person_email TEXT NOT NULL DEFAULT '', note TEXT NOT NULL DEFAULT '',
      status TEXT NOT NULL DEFAULT 'waiting', booking_id INTEGER, created_by INTEGER,
      created_at TEXT NOT NULL DEFAULT (datetime('now')), updated_at TEXT NOT NULL DEFAULT (datetime('now')))`,
    `CREATE INDEX IF NOT EXISTS idx_bk_waitlist ON bk_waitlist (org_id, location_id, status, service_id, id)`
  ];
  for (const s of stmts) await dbRun(env, s, []);
  // Added later: a practitioner's title and speciality, shown to staff and on the booking page.
  for (const col of ["title TEXT NOT NULL DEFAULT ''", "speciality TEXT NOT NULL DEFAULT ''"]) {
    try { await dbRun(env, `ALTER TABLE bk_providers ADD COLUMN ${col}`, []); } catch (e) {}
  }
  // Clinic rooms, set up by the pharmacy; a practitioner's weekly session may name one ([from, to, roomId]).
  await dbRun(env, `CREATE TABLE IF NOT EXISTS bk_rooms (id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
    name TEXT NOT NULL, active INTEGER NOT NULL DEFAULT 1, created_at TEXT NOT NULL DEFAULT (datetime('now')))`, []);
  // The day calendar (2026-11): repeat bookings share a series id; who confirmed and when; walk-ins. Added if missing,
