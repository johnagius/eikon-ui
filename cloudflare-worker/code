      String(body.stock_code !== undefined ? (body.stock_code ?? "") : (existing.stock_code ?? "")).trim(),
      String(body.barcode !== undefined ? (body.barcode ?? "") : (existing.barcode ?? "")).trim(),
      description,
      computed.cost_excl_vat, computed.cost_incl_vat, vatRate,
      computed.discount_pct, computed.discount_euro, qtyPurchased, qtyFree,
      String(body.batch !== undefined ? (body.batch ?? "") : (existing.batch ?? "")).trim(),
      String(body.expiry_date !== undefined ? (body.expiry_date ?? "") : (existing.expiry_date ?? "")).trim(),
      computed.retail_price, computed.profit, computed.profit_margin, computed.total_incl_vat,
      body.out_of_stock !== undefined ? (body.out_of_stock ? 1 : 0) : existing.out_of_stock,
      authUser.org_id, authUser.location_id, entryId
    ]
  );

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_PRODUCT_UPDATE", "supplier_products", String(entryId), { description, before: existing, after: await auditSnap(env, "supplier_products", entryId, authUser) }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

