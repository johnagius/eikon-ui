    take: q("dda", (ph) => `SELECT location_id, MAX(created_at) AS last FROM dda_stocktakes WHERE org_id = ? AND location_id IN (${ph}) GROUP BY location_id`),
    dds: q("dda", (ph) => `SELECT location_id, medicine_name_dose AS name, COUNT(*) AS n, COALESCE(SUM(quantity), 0) AS qty FROM dda_sales_entries WHERE org_id = ? AND location_id IN (${ph}) AND entry_date >= ? AND entry_date <= ? GROUP BY location_id, medicine_name_dose`, [from, to]),
    ddp: q("dda", (ph) => `SELECT location_id, medicine_name_dose AS name, COUNT(*) AS n, COALESCE(SUM(quantity), 0) AS qty FROM dda_poyc_entries WHERE org_id = ? AND location_id IN (${ph}) AND entry_date >= ? AND entry_date <= ? GROUP BY location_id, medicine_name_dose`, [from, to]),
    ddr: q("dda", (ph) => `SELECT location_id, dda_name_dose AS name, COUNT(*) AS n, COALESCE(SUM(quantity), 0) AS qty FROM dda_purchases_entries WHERE org_id = ? AND location_id IN (${ph}) AND entry_date >= ? AND entry_date <= ? GROUP BY location_id, dda_name_dose`, [from, to]),
    shf: q("staff", (ph) => `SELECT a.location_id, a.staff_id, s.full_name, s.designation, s.contracted_hours, a.shift_date, a.start_time, a.end_time FROM shift_assignments a JOIN shift_staff s ON s.id = a.staff_id WHERE a.org_id = ? AND a.location_id IN (${ph}) AND a.shift_date >= ? AND a.shift_date <= ?`, [from, to]),
