  }
  // Also check if a transfer item links via placed_on_scarce_stock_id or source_module
  await ensureStockTransfersSchema(env);
  const linkedTransfer = await dbFirst(env,
    "SELECT id FROM stock_transfer_items WHERE (placed_on_scarce_stock_id = ? OR (source_module = 'scarcestock' AND source_id = ?)) AND org_id = ? AND location_id = ? AND is_closed = 0",
