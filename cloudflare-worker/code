    `INSERT INTO supplier_stock_changes (org_id, supplier_location_id, supplier_name, product_description, barcode, change_type, created_at)
     VALUES (?,?,?,?,?,?,datetime('now'))`,
    [authUser.org_id, authUser.location_id, existing.supplier_name, existing.description, existing.barcode || "", changeType]
  );

  // Propagate out_of_stock to matching products from same supplier
  // Match by barcode/stock_code (preferential) OR description (fallback)
  const matchConditions = [];
  const matchBinds = [];
  matchConditions.push("LOWER(TRIM(description)) = LOWER(TRIM(?))");
  matchBinds.push(existing.description);
  if (existing.barcode && existing.barcode.trim()) {
    matchConditions.push("(barcode != '' AND barcode = ?)");
    matchBinds.push(existing.barcode.trim());
  }
  if (existing.stock_code && existing.stock_code.trim()) {
    matchConditions.push("(stock_code != '' AND stock_code = ?)");
    matchBinds.push(existing.stock_code.trim());
  }
  const whereClause = matchConditions.join(" OR ");

  // Find products that will be propagated (before update) for notifications
  const propagated = await dbAll(env,
    `SELECT id, description, barcode FROM supplier_products
     WHERE org_id = ? AND location_id = ? AND id != ? AND out_of_stock != ? AND (${whereClause})`,
    [authUser.org_id, authUser.location_id, entryId, newStatus, ...matchBinds]
  );

  if (propagated.length > 0) {
    await dbRun(env,
      `UPDATE supplier_products SET out_of_stock = ?, updated_at = datetime('now')
       WHERE org_id = ? AND location_id = ? AND id != ? AND (${whereClause})`,
      [newStatus, authUser.org_id, authUser.location_id, entryId, ...matchBinds]
    );
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_PRODUCT_STOCK_STATUS", "supplier_products", String(entryId), { out_of_stock: newStatus, propagated: propagated.length, propagated_ids: propagated.map((p) => p.id).slice(0, 200), before: existing, after: await auditSnap(env, "supplier_products", entryId, authUser) }, authUser.location_id);
  return jsonResponse({ ok: true, changed: true, propagated: propagated.length }, 200, corsOkHeaders);
}

// ── Bulk writes, many rows per statement ────────────────────────────────────────────────────────────────
// The bulk routes (supplier catalogue import, contacts import, emergency-POS catalogue, warehouse short expiry,
// shift patterns, end-of-day contacts) wrote one statement per row: a 5,000-row supplier import was one
// env.DB.batch of 5,001 statements followed by one INSERT per stock change (up to 10,000), far past what D1 runs
// for one request (100 bound parameters per statement, a capped number of queries per invocation). They now put
// many rows in each statement (wsaveStatements / wsaveRun above, or bimpStatements below), binding the same
// values in the same order, so every row is stored as before.

// Like wsaveStatements, plus: consts are bound once per statement as ?1..?n and a tuple slot "?1".."?n" uses one;
// a "#" slot is a number column (INTEGER or REAL only) whose value is written as SQL when that stores the same
// value -- a safe integer as its digits, a cents amount k/100 as (k/100.0), which SQLite divides to the same
// double as JavaScript's k / 100 -- and bound otherwise. Never "#" for a TEXT column (it would store '5' where a
// bound 5.0 stores '5.0'). Rows are value arrays indexed like the tuple; a statement stays <= 100 bound
// parameters, <= 512 KB of bound text and <= 90 KB of SQL.
const BIMP_SQL_BYTES = 90 * 1024;
function bimpNumberSql(v) {
  if (typeof v !== "number" || Object.is(v, -0)) return null;
  if (Number.isSafeInteger(v)) return String(v);
  const k = Math.round(v * 100);
  return Number.isSafeInteger(k) && k / 100 === v ? "(" + k + "/100.0)" : null;
}
function bimpStatements(env, head, consts, tuple, tail, rows) {
  const stmts = [], base = consts.length, fixed = head.length + tail.length;
  let sqlParts = [], params = [], bytes = 0, sqlLen = 0;
  const flush = () => {
    if (!sqlParts.length) return;
    stmts.push({ stmt: env.DB.prepare(head + sqlParts.join(", ") + tail).bind(...consts, ...params), bytes: bytes + wsaveBytes(consts) });
    sqlParts = []; params = []; bytes = 0; sqlLen = 0;
  };
  for (const r of rows) {
    const slots = [], vals = [];
    for (let i = 0; i < tuple.length; i++) {
      const t = tuple[i], v = r[i];
      if (t !== "?" && t !== "#") { slots.push(t); continue; }
      if (v === null || v === undefined) { slots.push("NULL"); continue; }
      if (v === "") { slots.push("''"); continue; }
      const lit = t === "#" ? bimpNumberSql(v) : null;
      if (lit !== null) { slots.push(lit); continue; }
      slots.push(null); vals.push(v);
    }
    const render = (n) => "(" + slots.map((s) => (s === null ? "?" + (++n) : s)).join(",") + ")";
    const b = wsaveBytes(vals);
    let part = render(base + params.length);
    if (sqlParts.length && (base + params.length + vals.length > WSAVE_MAX_PARAMS || bytes + b > WSAVE_STMT_BYTES || fixed + sqlLen + part.length + 2 > BIMP_SQL_BYTES)) {
      flush();
      part = render(base);
    }
    sqlParts.push(part);
    for (const v of vals) params.push(v);
    bytes += b; sqlLen += part.length + 2;
  }
  flush();
  return stmts;
}
// Request-size caps for the two bulk routes that had none (each is far beyond what the screens send).
const BIMP_SHIFT_MAX_DAYS = 3660, BIMP_SHIFT_MAX_ROWS = 3660, BIMP_EOD_CONTACTS_MAX = 1000;
// ── End bulk writes ────────────────────────────────────────────────────────────────────────────────────

// ─── Bulk Import (Full Replace) ───────────────────────────────────────────

async function handleSupplierProductsBulkImport(request, env, corsOkHeaders, authUser) {
  await ensureSupplierProductsSchema(env);
  const body = await readJson(request);
  const rows = Array.isArray(body.rows) ? body.rows : [];
  const supplierName = String(authUser.location_name || "").trim();

  if (rows.length === 0) return jsonResponse({ ok: false, error: "No rows provided" }, 400, corsOkHeaders);
  if (rows.length > 5000) return jsonResponse({ ok: false, error: "Maximum 5000 rows per import" }, 400, corsOkHeaders);

  // Fetch existing products for comparison
  const oldProducts = await dbAll(env,
    "SELECT * FROM supplier_products WHERE org_id = ? AND location_id = ?",
    [authUser.org_id, authUser.location_id]);

  // Build lookup map by description (lowercased) for comparison
  const oldByDesc = {};
  for (const p of oldProducts) {
    const key = (p.description || "").toLowerCase().trim();
    if (key) oldByDesc[key] = p;
  }

  // Validate and prepare every row first; then replace the catalogue in ONE atomic batch
  // (delete + inserts). A failure half-way can no longer leave the supplier with an empty
  // or partial list. Out-of-stock flags survive by description, so an import does not put
  // everything back "in stock".
  let imported = 0;
  const errors = [];
  const newDescKeys = new Set();
  const stmts = [];
  stmts.push(env.DB.prepare("DELETE FROM supplier_products WHERE org_id = ? AND location_id = ?").bind(authUser.org_id, authUser.location_id));

  const insertSql = `INSERT INTO supplier_products
       (org_id, location_id, supplier_name, stock_code, barcode, description,
        cost_excl_vat, cost_incl_vat, vat_rate, discount_pct, discount_euro,
        qty_purchased, qty_free, batch, expiry_date, retail_price,
        profit, profit_margin, total_incl_vat, out_of_stock, created_by,
        created_at, updated_at)
       VALUES `;
  const insertRows = []; // many rows per INSERT (bimpStatements), still in the one atomic batch

  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];
    const desc = String(r.description || "").trim();
    if (!desc) { errors.push({ row: i + 1, error: "Description is required" }); continue; }

    const vatRate = normalizeVatRate(r.vat_rate);
    const qtyPurchased = Math.max(1, Math.round(Number(r.qty_purchased) || 1));
    const qtyFree = Math.max(0, Math.round(Number(r.qty_free) || 0));
    const computed = computeItemProfitFields(r);
    const key = desc.toLowerCase();
    const prev = oldByDesc[key];
    const keepOos = prev && Number(prev.out_of_stock || 0) === 1 ? 1 : 0;

    insertRows.push([
        authUser.org_id, authUser.location_id, supplierName,
        String(r.stock_code || "").trim(), String(r.barcode || "").trim(), desc,
        computed.cost_excl_vat, computed.cost_incl_vat, vatRate,
        computed.discount_pct, computed.discount_euro,
        qtyPurchased, qtyFree,
        String(r.batch || "").trim(), String(r.expiry_date || "").trim(),
        computed.retail_price, computed.profit, computed.profit_margin, computed.total_incl_vat,
        keepOos, authUser.user_id
    ]);
    imported++;
    newDescKeys.add(key);
  }

  if (imported === 0) return jsonResponse({ ok: false, error: "No valid rows (every row needs a description)", errors }, 400, corsOkHeaders);

  for (const x of bimpStatements(env, insertSql, [authUser.org_id, authUser.location_id, supplierName, authUser.user_id],
    ["?1", "?2", "?3", "?", "?", "?", "#", "#", "#", "#", "#", "#", "#", "?", "?", "#", "#", "#", "#", "#", "?4", "datetime('now')", "datetime('now')"],
    "", insertRows)) stmts.push(x.stmt);
  await env.DB.batch(stmts);

  // Generate stock change notifications by comparing old vs new
  const changes = [];
  // Out-of-stock flags survive an import (keepOos above), so an import never puts an
  // item back in stock; that only happens through the stock-status route.
  for (const key of Object.keys(oldByDesc)) {
    const oldP = oldByDesc[key];
    // Items in old that don't appear in new → removed
    if (!newDescKeys.has(key)) {
      changes.push({ type: "removed", description: oldP.description, barcode: oldP.barcode || "" });
    }
  }
  // New items not in old → added
  for (const key of newDescKeys) {
    if (!oldByDesc[key]) {
      const newRow = rows.find(r => (r.description || "").toLowerCase().trim() === key);
      changes.push({ type: "added", description: newRow ? newRow.description : key, barcode: newRow ? (newRow.barcode || "") : "" });
    }
  }

  // Write stock changes to notification log, in order (all "removed", then all "added"), many per INSERT
  const changeStmts = [];
  for (const type of ["removed", "added"]) {
    changeStmts.push(...bimpStatements(env,
      `INSERT INTO supplier_stock_changes (org_id, supplier_location_id, supplier_name, product_description, barcode, change_type, created_at)
       VALUES `, [authUser.org_id, authUser.location_id, supplierName], ["?1", "?2", "?3", "?", "?", "'" + type + "'", "datetime('now')"], "",
      changes.filter((ch) => ch.type === type).map((ch) => [null, null, null, ch.description, ch.barcode])));
  }
  await wsaveRun(env, changeStmts);

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_BULK_IMPORT", "supplier_products", "", { imported, changes: changes.length }, authUser.location_id);

  return jsonResponse({ ok: true, imported, errors, changes: changes.length }, 200, corsOkHeaders);
}

