// Applies f to the string at a key path ("a.b", "list[].name") inside obj. Returns true if a value changed.
function nameCaseAtPath(obj, path, f) {
  const segs = String(path).split(".");
  let changed = false;
  const walk = (o, i) => {
    if (!o || typeof o !== "object") return;
    let k = segs[i];
    const arr = k.endsWith("[]");
    if (arr) k = k.slice(0, -2);
    const last = i === segs.length - 1;
    if (arr) { const list = o[k]; if (!Array.isArray(list)) return; for (const it of list) walk(it, i + 1); return; }
    if (!last) return walk(o[k], i + 1);
    if (typeof o[k] !== "string") return;
    const nv = f(o[k]);
    if (typeof nv === "string" && nv !== o[k]) { o[k] = nv; changed = true; }
  };
  walk(obj, 0);
  return changed;
}

