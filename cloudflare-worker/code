  if (q.email && String(r.person_email || "").trim().toLowerCase() === q.email) return true;
  if (q.phone && bkPhoneKey(r.person_phone) === q.phone) return true;
  if (!q.card && !q.email && !q.phone && q.name && String(r.person_name || "").trim().toLowerCase() === q.name) return true;
