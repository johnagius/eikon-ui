    await writeAudit(env, msg.org_id, null, "CUST_MSG_OPTOUT", "cust_messages", String(id), { location_id: msg.location_id }, msg.location_id);
    return bkPage("Done", `<div class="c"><h1>Done</h1><div class="s">${e(pharmacy)} won't e-mail you any more.</div></div>`);
  }
  return bkPage("Stop e-mails", `<div class="c"><h1>Stop e-mails?</h1><div class="s">From ${e(pharmacy)} only.</div><form method="post"><button class="b r">Stop e-mails</button></form></div>`);
