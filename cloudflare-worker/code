// One reset, a bounded number of steps per call. The state row says where it is, so the next call (the next cron run, or
// the next reset-now) carries on from there. Steps are counted before they run: a step that throws is never retried.
// D1 answers at most 1,000 queries in one invocation (Workers Paid). Every query a reset makes goes through this count,
// and a run stops between steps once it passes the budget (default 450; the largest step is about 160).
function demoCountingDb(db, box) {
  return { prepare(sql) { box.n++; return db.prepare(sql); }, batch(stmts) { box.n += (stmts && stmts.length) || 1; return db.batch(stmts); },
    exec(sql) { box.n++; return db.exec(sql); } };
}
async function resetDemo(envIn, ctx, opts = {}) {
  const box = { n: 0 }, env = { ...envIn, DB: demoCountingDb(envIn.DB, box) };
  const qmax = Math.max(50, Number(opts.queries) || Number(env.DEMO_QUERY_BUDGET) || 450);
  const c = demoCfg(env);
  if (!c) return { ok: false, error: "The demo is off" };
  await ensureDemoSchema(env);
  const budget = Math.max(1, Number(opts.budget) || Number(env.DEMO_RESET_STEPS) || 60);
  let st = await demoStateGet(env);
  if (!st.running || opts.restart) {
    const prep = await demoPrepare(env, c);
    if (prep.fatal) { st = { ...st, running: false, error: prep.fatal, at: nowIso() }; await demoStateSet(env, st); return { ok: false, error: prep.fatal }; }
    const { plan, skipped } = await demoWipePlan(env, c);
    if (plan.length < 10) { st = { ...st, running: false, error: "Could not list the tables: nothing wiped or seeded", at: nowIso() }; await demoStateSet(env, st); return { ok: false, error: st.error }; }
    st = { running: true, day: opts.day || tzYmd(), today: tzYmd(), phase: "wipe", i: 0, tables: plan, skipped, problems: prep.problems, shut: prep.shut || [], vars: {}, started_at: nowIso(), wipe_only: !!opts.wipeOnly,
      last_day: st.last_day || "", wiped: !!opts.wipeOnly || !!st.wiped };
    // Visitors' sessions end now (the data under them is about to go). Real sign-ins of the demo group are kept.
    await dbRun(env, `DELETE FROM sessions WHERE user_id IN (SELECT id FROM users WHERE org_id = ? AND lower(email) IN (${DEMO_EMAILS.map(() => "?").join(",")}))`, [c.org, ...DEMO_EMAILS]);
    await demoStateSet(env, st);
  }
  const steps = demoSeedSteps({ ...c, name: (await dbFirst(env, "SELECT name FROM locations WHERE id = ?", [c.pharmacy]) || {}).name });
  const tokens = {};
  const caller = (door) => async (method, path, body) => {
    if (!tokens[door]) {
      const uid = await demoUserId(env, c, door);
      if (!uid) throw new Error("no demo account for " + door);
      tokens[door] = (await demoNewSession(env, uid, 900)).token;
    }
    const h = new Headers({ Authorization: "Bearer " + tokens[door] });
    if (body !== undefined) h.set("Content-Type", "application/json");
    const res = await EIKON_WORKER.fetch(new Request(DEMO_SEED_ORIGIN + path, { method, headers: h, body: body === undefined ? undefined : JSON.stringify(body) }), env, ctx || { waitUntil() {}, passThroughOnException() {} });
    const text = await res.text();
    let j = null; try { j = JSON.parse(text); } catch (e) {}
    if (res.status >= 400) { st.problems = st.problems || []; if (st.problems.length < 30) st.problems.push(method + " " + path.replace(/\d+/g, ":id") + " " + res.status + " " + String((j && (j.message || j.error)) || text).slice(0, 120)); }
    return j;
  };
  const cx = { p: caller("pharmacy"), b: caller("branch"), s: caller("supplier"), h: caller("hq"), v: st.vars || (st.vars = {}), d: (n) => ymdPlusDays(st.today, n) };
  let used = 0;
  try {
    while (used < budget && box.n < qmax && st.running) {
      if (st.phase === "wipe") {
        if (st.i >= st.tables.length) {
          if (st.wipe_only) { st.running = false; st.done_at = nowIso(); st.last_day = st.day; st.wiped = true; break; } // switching off: empty, nothing seeded
          st.phase = "seed"; st.i = 0; continue;
        }
        const step = st.tables[st.i++];
        try { await demoWipeOne(env, c, step, st.tables); } catch (e) { st.problems.push("wipe " + step.t + ": " + String(e && e.message || e).slice(0, 120)); }
        used += 0.34; // a wipe is one statement
        continue;
      }
      if (st.i >= steps.length) { st.running = false; st.done_at = nowIso(); st.last_day = st.day; st.wiped = false; break; }
      const step = steps[st.i++];
      await demoStateSet(env, st);
      try { await step.fn(cx); } catch (e) { st.problems.push("seed " + step.name + ": " + String(e && e.message || e).slice(0, 120)); }
      used += 1;
    }
  } finally {
    for (const t of Object.values(tokens)) { try { await dbRun(env, "DELETE FROM sessions WHERE token_hash_b64 = ?", [await sha256B64FromString(t)]); } catch (e) {} }
    st.at = nowIso();
    await demoStateSet(env, st);
  }
  return { ok: true, queries: box.n, done: !st.running, phase: st.running ? st.phase : (st.wipe_only ? "wiped" : "done"), step: st.i, of: st.running ? (st.phase === "wipe" ? st.tables.length : steps.length) : steps.length, problems: st.problems || [], skipped: st.skipped || [] };
}

// From the 10-minute cron: once per Malta day, starting between 03:00 and 06:00, carried on by the next runs until done.
async function demoNightly(env, ctx) {
  const c = demoCfg(env);
  if (!c) return null;
  await ensureDemoSchema(env);
  const tn = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$/.test(String(env.DEMO_TEST_NOW || "")) ? String(env.DEMO_TEST_NOW) : ""; // tests only: "YYYY-MM-DD HH:MM", Malta
  const st = await demoStateGet(env), today = tn ? tn.slice(0, 10) : tzYmd(), hm = tn ? tn.slice(11) : tzHm();
  if (st.running) return await resetDemo(env, ctx, {});
  if (st.last_day === today || hm < "03:00" || hm >= "06:00") return null;
  return await resetDemo(env, ctx, { restart: true, day: today });
}

// /su/api/demo/reset (POST) and /su/api/demo/status (GET): superusers only (the caller checked).
async function handleSuDemo(request, env, cors, parts, ctx) {
  const c = demoCfg(env);
  if (!c) return jsonResponse({ ok: false, error: "The demo is off (DEMO_ORG_ID and DEMO_LOCATION_ID are not set)" }, 404, cors);
  if (parts[1] === "status" && request.method === "GET") { const st = await demoStateGet(env); delete st.tables; return jsonResponse({ ok: true, config: c, state: st }, 200, cors); }
  if (parts[1] === "reset" && request.method === "POST") {
    const st = await demoStateGet(env);
    const r = await resetDemo(env, ctx, { restart: !st.running || !!st.wipe_only, budget: 200 });
    return jsonResponse(r, r.ok ? 200 : 409, cors);
  }
  // Before switching the demo off (or rolling back): empty the demo group, so nothing of it is left in the lists that
  // read across groups (supplier products, scarce-stock needs, suggestions) once the filters are gone.
  if (parts[1] === "wipe" && request.method === "POST") {
    const st = await demoStateGet(env);
    const r = await resetDemo(env, ctx, { restart: !(st.running && st.wipe_only), wipeOnly: true, budget: 400 });
    return jsonResponse(r, r.ok ? 200 : 409, cors);
  }
  return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
}
