async function nameStateStored(env, authUser, kind, ids) {
  const out = new Map();
  if (!ids.length || !authUser) return out;
  const org = authUser.org_id, loc = authUser.location_id;
  const q = async (sql) => { try { return await dbAllChunked(env, (ph) => sql.replace("%IDS%", ph), ids, [org, loc]); } catch (e) { return []; } };
  const parse = (s) => { try { return JSON.parse(String(s)); } catch (e) { return null; } };
  if (kind === "poct-p") for (const r of await q("SELECT patient_id AS k, name AS v FROM poct_patients WHERE org_id = ? AND location_id = ? AND patient_id IN (%IDS%)")) out.set(String(r.k), r.v);
  if (kind === "poct-r") for (const r of await q("SELECT record_id AS k, patient_name AS v FROM poct_records WHERE org_id = ? AND location_id = ? AND record_id IN (%IDS%)")) out.set(String(r.k), r.v);
  if (kind === "screening") for (const r of await q("SELECT campaign_id AS k, campaign_json AS j FROM screening_campaigns WHERE org_id = ? AND location_id = ? AND campaign_id IN (%IDS%)")) {
    const c = parse(r.j); for (const p of (c && Array.isArray(c.participants) ? c.participants : [])) if (p && p.id != null) out.set(String(r.k) + "|" + String(p.id), p.name);
  }
  if (kind === "labels") for (const r of await q("SELECT label_id AS k, label_json AS j FROM label_history WHERE org_id = ? AND location_id = ? AND label_id IN (%IDS%)")) { const l = parse(r.j); if (l) out.set(String(r.k), l.patientName); }
  if (kind === "pv") for (const r of await q("SELECT report_id AS k, report_json AS j FROM pv_reports WHERE org_id = ? AND location_id = ? AND report_id IN (%IDS%)")) { const p = parse(r.j); if (p) out.set(String(r.k), p.reporter_name); }
  return out;
}

// Cases the names in one whole-state body (POCT, screening, labels, pharmacovigilance). Returns true if any changed.
async function nameCaseState(env, authUser, kind, body) {
  const st = body && (body.state || body.data) ? (body.state || body.data) : body;
  if (!st || typeof st !== "object") return false;
  const items = []; // { obj, key, kind, id }
  const list = (v) => (Array.isArray(v) ? v : []);
  if (kind === "poct") {
    for (const p of list(st.patients)) if (p && p.patientId) items.push({ obj: p, key: "name", kind: "poct-p", id: String(p.patientId).trim() });
    for (const r of list(st.records || st.entries)) if (r && r.id && r.patient && typeof r.patient === "object") items.push({ obj: r.patient, key: "name", kind: "poct-r", id: String(r.id).trim() });
  } else if (kind === "screening") {
    for (const c of list(st.campaigns)) if (c && c.id) for (const p of list(c.participants)) if (p && typeof p === "object") items.push({ obj: p, key: "name", kind: "screening", id: String(c.id).trim(), sub: p.id == null ? null : String(p.id) });
  } else if (kind === "labels") {
    for (const l of list(st.labelHistory)) if (l && l.id) items.push({ obj: l, key: "patientName", kind: "labels", id: String(l.id).trim() });
  } else if (kind === "pv") {
    for (const r of list(st.reports)) if (r && r.id) items.push({ obj: r, key: "reporter_name", kind: "pv", id: String(r.id).trim() });
  }
  const todo = items.filter((it) => typeof it.obj[it.key] === "string" && eikonNameCase(it.obj[it.key]) !== it.obj[it.key]);
  if (!todo.length) return false;
  const stored = {};
  for (const k of [...new Set(todo.map((it) => it.kind))]) stored[k] = await nameStateStored(env, authUser, k, [...new Set(todo.filter((it) => it.kind === k).map((it) => it.id))]);
  let changed = false;
  for (const it of todo) {
    const sk = it.kind === "screening" ? (it.sub == null ? null : it.id + "|" + it.sub) : it.id;
    const m = stored[it.kind];
    if (sk != null && m.has(sk) && m.get(sk) === it.obj[it.key]) continue; // untouched since it was stored
    it.obj[it.key] = eikonNameCase(it.obj[it.key]);
    changed = true;
  }
  return changed;
}

// Returns the request with the person-name fields of its JSON body in Title Case, or the same request.
// Never blocks a save: anything unexpected returns the request exactly as it came.
async function nameCaseRequest(request, env, url, authUser) {
  try {
    const m = request.method;
    if (m !== "POST" && m !== "PUT" && m !== "PATCH") return request;
    const rule = NAME_SAVE_RULES.find((r) => r.re.test(url.pathname) && (authUser ? !r.pub : r.pub));
    if (!rule) return request;
    const ct = String(request.headers.get("Content-Type") || "").toLowerCase();
    if (/multipart|form-urlencoded/.test(ct)) return request;
    const text = await request.clone().text();
    if (!text) return request;
    let body;
    try { body = JSON.parse(text); } catch (e) { return request; }
    if (!body || typeof body !== "object") return request;
    let changed = false;
    if (rule.state) changed = await nameCaseState(env, authUser, rule.state, body);
    else for (const k of rule.keys) if (nameCaseAtPath(body, k, eikonNameCase)) changed = true;
    if (!changed) return request;
    return new Request(request, { body: JSON.stringify(body) });
  } catch (e) {
    console.log("[names] left as typed:", e && e.message);
    return request;
  }
}

// ── The one-off fix: POST /admin/names/titlecase (dry run unless dry_run=0), POST /admin/names/titlecase/undo,
//    GET /admin/names/titlecase/runs. Admins of the caller's own pharmacy group; all groups (all_orgs=1) for a superuser.
async function ensureNameCaseSchema(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS name_case_undo (
    id INTEGER PRIMARY KEY AUTOINCREMENT, run_id TEXT NOT NULL, org_id INTEGER NOT NULL, table_name TEXT NOT NULL,
    row_id INTEGER NOT NULL, column_name TEXT NOT NULL, old_value TEXT, new_value TEXT, created_at TEXT NOT NULL DEFAULT (datetime('now')))`);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_name_case_undo_run ON name_case_undo (run_id, org_id)`);
  await dbRun(env, `CREATE TABLE IF NOT EXISTS name_case_runs (
    id INTEGER PRIMARY KEY AUTOINCREMENT, run_id TEXT NOT NULL, kind TEXT NOT NULL, undo_of TEXT, org_id INTEGER, all_orgs INTEGER NOT NULL DEFAULT 0,
    user_id INTEGER, columns_json TEXT NOT NULL DEFAULT '[]', changed INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL DEFAULT (datetime('now')))`);
}

// The new value for one row (only the listed columns), or null when nothing would change.
// A JSON column whose stored text is not exactly what JSON.stringify gives back is skipped: rewriting it
// could change bytes other than the name.
function nameCaseRow(row, target) {
  const out = {}; let any = false, unusual = false;
  for (const col of target.cols) {
    const old = row[col.c];
    if (typeof old !== "string" || !old) continue;
    if (!col.json) { const nv = eikonNameCase(old); if (nv !== old) { out[col.c] = nv; any = true; } continue; }
    let obj; try { obj = JSON.parse(old); } catch (e) { unusual = true; continue; }
    if (!obj || typeof obj !== "object" || JSON.stringify(obj) !== old) { unusual = true; continue; }
    let ch = false; for (const p of col.json) if (nameCaseAtPath(obj, p, eikonNameCase)) ch = true;
    if (ch) { out[col.c] = JSON.stringify(obj); any = true; }
  }
  return { set: any ? out : null, unusual };
}

function nameCaseSample(row, target, set) {
  const s = { id: row.id };
  for (const col of target.cols) if (col.c in set) {
    if (!col.json) { s.from = row[col.c]; s.to = set[col.c]; }
    else if (!("from" in s)) { const a = [], b = []; try { for (const p of col.json) { nameCaseAtPath(JSON.parse(row[col.c]), p, (v) => { a.push(v); return v; }); nameCaseAtPath(JSON.parse(set[col.c]), p, (v) => { b.push(v); return v; }); } } catch (e) {} s.from = a.join(", "); s.to = b.join(", "); }
  }
  return s;
}

async function nameTableColumns(env, table) {
  try { return (await dbAll(env, `PRAGMA table_info(${table})`)).map((r) => r.name); } catch (e) { return []; }
}

async function handleNamesAdmin(request, env, corsOkHeaders, authUser, url) {
  const j = (o, s = 200) => jsonResponse(o, s, corsOkHeaders);
  if (!authUser || authUser.role !== "admin") return j({ ok: false, error: "Only an admin can change names in bulk" }, 403);
  const body = request.method === "POST" ? ((await readJson(request).catch(() => null)) || {}) : {};
  const param = (k) => (body[k] !== undefined ? body[k] : url.searchParams.get(k));
  const allOrgs = String(param("all_orgs") || "") === "1" || param("all_orgs") === true;
  if (allOrgs && !isSuperuser(authUser, env)) return j({ ok: false, error: "Only a superuser can fix every pharmacy group" }, 403);
  const orgFilter = allOrgs ? "" : " AND org_id = ?";
  const orgBind = allOrgs ? [] : [authUser.org_id];
  const path = url.pathname.replace(/\/+$/, "");

  if (path === "/admin/names/titlecase/runs" && request.method === "GET") {
    const have = (await dbAll(env, "SELECT name FROM sqlite_master WHERE type='table' AND name='name_case_runs'")).length > 0;
    if (!have) return j({ ok: true, runs: [] });
    const runs = await dbAll(env, `SELECT run_id, kind, undo_of, org_id, all_orgs, user_id, columns_json, changed, created_at FROM name_case_runs WHERE 1=1${allOrgs ? "" : " AND org_id = ? AND all_orgs = 0"} ORDER BY id DESC LIMIT 50`, orgBind);
    return j({ ok: true, runs: runs.map((r) => ({ ...r, columns: (() => { try { return JSON.parse(r.columns_json); } catch (e) { return []; } })(), columns_json: undefined })) });
  }

  if (path === "/admin/names/titlecase/undo" && request.method === "POST") {
    const runId = String(param("run_id") || "").trim();
    if (!runId) return j({ ok: false, error: "run_id is required" }, 400);
    await ensureNameCaseSchema(env);
    const rows = await dbAll(env, `SELECT id, org_id, table_name, row_id, column_name, old_value, new_value FROM name_case_undo WHERE run_id = ?${orgFilter} ORDER BY id DESC`, [runId, ...orgBind]);
    if (!rows.length) return j({ ok: false, error: "Nothing recorded for that run" }, 404);
    const known = new Set(NAME_COLUMNS.flatMap((t) => t.cols.map((c) => t.table + "." + c.c)));
    let restored = 0, kept = 0;
    for (const r of rows) {
      if (!known.has(r.table_name + "." + r.column_name)) continue; // only ever a column this feature changes
      const res = await dbRun(env, `UPDATE ${r.table_name} SET ${r.column_name} = ? WHERE id = ? AND org_id = ? AND ${r.column_name} = ?`, [r.old_value, r.row_id, r.org_id, r.new_value]);
      if (res && res.meta && res.meta.changes) restored++; else kept++;
    }
    const undoId = "ncu_" + Date.now().toString(36) + "_" + bkRandomHex(4);
    await dbRun(env, `INSERT INTO name_case_runs (run_id, kind, undo_of, org_id, all_orgs, user_id, columns_json, changed) VALUES (?, 'undo', ?, ?, ?, ?, '[]', ?)`,
      [undoId, runId, authUser.org_id, allOrgs ? 1 : 0, authUser.user_id, restored]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "NAMES_TITLECASE_UNDO", "names", runId,
      auditWith({ undo_run_id: undoId, all_orgs: allOrgs }, undefined, { restored, kept_because_changed_since: kept }), authUser.location_id);
    return j({ ok: true, run_id: undoId, undo_of: runId, restored, kept_because_changed_since: kept });
  }

  if (path !== "/admin/names/titlecase" || request.method !== "POST") return j({ ok: false, error: "Not found" }, 404);

  const dry = String(param("dry_run") == null ? "1" : param("dry_run")) !== "0" && param("dry_run") !== false;
  const listOf = (v) => (Array.isArray(v) ? v : String(v || "").split(",")).map((s) => String(s).trim()).filter(Boolean);
  const wantGroups = listOf(param("groups")), wantTables = listOf(param("tables"));
  const bad = wantGroups.filter((g) => !NAME_GROUPS.includes(g));
  if (bad.length) return j({ ok: false, error: "Unknown group: " + bad.join(", "), groups: NAME_GROUPS }, 400);
  // tables: "dda_sales_entries" (every listed name column of it) or "dda_sales_entries.client_name"
  const picked = (t) => {
    if (wantTables.length) return wantTables.some((w) => w === t.table || w === t.table + "." + t.cols[0].c);
    if (wantGroups.length) return wantGroups.includes(t.group);
    return t.group === "customers";
  };
  const limit = Math.max(1, Math.min(5000, Number(param("limit")) || 1000));
  const existing = new Set((await dbAll(env, "SELECT name FROM sqlite_master WHERE type='table'")).map((r) => r.name));
  const runId = dry ? null : "nc_" + Date.now().toString(36) + "_" + bkRandomHex(4);
  if (!dry) await ensureNameCaseSchema(env);

  const report = { customers: [], legal: [], staff: [] };
  let totalWould = 0, totalChanged = 0, totalCells = 0, budget = limit, more = false;
  for (const t of NAME_COLUMNS) {
    const sel = picked(t);
    const entry = { table: t.table, columns: t.cols.map((c) => c.c + (c.json ? " (" + c.json.join(", ") + ")" : "")), key: nameColumnKey(t), selected: sel, rows_checked: 0, would_change: 0, changed: 0, cells_changed: 0, skipped_unusual_json: 0, samples: [] };
    report[t.group].push(entry);
    if (!existing.has(t.table)) { entry.missing = true; continue; }
    const have = await nameTableColumns(env, t.table);
    const cols = t.cols.filter((c) => have.includes(c.c));
    if (cols.length !== t.cols.length || !have.includes("org_id")) { entry.missing = true; continue; }
    // A first sift in SQL (lower() / upper() only know A-Z, so this lets through more rows than change, never fewer).
    const text = cols.filter((c) => !c.json);
    const sift = text.length && !cols.some((c) => c.json) ? " AND (" + text.map((c) => `(${c.c} = lower(${c.c}) OR ${c.c} = upper(${c.c}))`).join(" OR ") + ")" : "";
    let lastId = 0;
    for (;;) {
      const rows = await dbAll(env, `SELECT id, org_id, ${cols.map((c) => c.c).join(", ")} FROM ${t.table} WHERE id > ?${orgFilter}${sift} ORDER BY id LIMIT 500`, [lastId, ...orgBind]);
      if (!rows.length) break;
      lastId = rows[rows.length - 1].id;
      const changes = [];
      for (const row of rows) {
        entry.rows_checked++;
        const r = nameCaseRow(row, { cols });
        if (r.unusual) entry.skipped_unusual_json++;
        if (!r.set) continue;
        entry.would_change++;
        if (entry.samples.length < 5) entry.samples.push(nameCaseSample(row, { cols }, r.set));
        if (!dry && sel) changes.push({ row, set: r.set });
      }
      for (let i = 0; i < changes.length; i += 40) {
        let chunk = changes.slice(i, i + 40);
        if (chunk.length > budget) { chunk = chunk.slice(0, budget); more = true; }
        if (!chunk.length) { more = true; break; }
        const stmtsFor = (ch) => {
          const names = Object.keys(ch.set);
          const where = names.map((n) => `${n} = ?`).join(" AND ");
          const st = [env.DB.prepare(`UPDATE ${t.table} SET ${names.map((n) => `${n} = ?`).join(", ")} WHERE id = ? AND org_id = ? AND ${where}`)
            .bind(...names.map((n) => ch.set[n]), ch.row.id, ch.row.org_id, ...names.map((n) => ch.row[n]))];
          for (const n of names) st.push(env.DB.prepare(`INSERT INTO name_case_undo (run_id, org_id, table_name, row_id, column_name, old_value, new_value)
            SELECT ?, ?, ?, ?, ?, ?, ? WHERE EXISTS (SELECT 1 FROM ${t.table} WHERE id = ? AND ${n} = ?)`).bind(runId, ch.row.org_id, t.table, ch.row.id, n, ch.row[n], ch.set[n], ch.row.id, ch.set[n]));
          return st;
        };
        const nCells = (ch) => Object.keys(ch.set).length;
        try { await env.DB.batch(chunk.flatMap(stmtsFor)); entry.changed += chunk.length; entry.cells_changed += chunk.reduce((n, ch) => n + nCells(ch), 0); }
        catch (e) { for (const ch of chunk) { try { await env.DB.batch(stmtsFor(ch)); entry.changed++; entry.cells_changed += nCells(ch); } catch (e2) { entry.failed = (entry.failed || 0) + 1; } } }
        budget -= chunk.length;
        if (budget <= 0) { more = true; break; }
      }
      if (more || rows.length < 500) break;
    }
    totalWould += entry.would_change; totalChanged += entry.changed; totalCells += entry.cells_changed;
    if (more) break;
  }
  const selectedKeys = NAME_COLUMNS.filter(picked).map(nameColumnKey);
  if (!dry) {
    await dbRun(env, `INSERT INTO name_case_runs (run_id, kind, org_id, all_orgs, user_id, columns_json, changed) VALUES (?, 'apply', ?, ?, ?, ?, ?)`,
      [runId, authUser.org_id, allOrgs ? 1 : 0, authUser.user_id, JSON.stringify(selectedKeys), totalChanged]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "NAMES_TITLECASE", "names", runId,
      auditWith({ all_orgs: allOrgs, columns: selectedKeys, undo_table: "name_case_undo" }, undefined, {
        changed: totalChanged, cells_changed: totalCells, more, by_column: NAME_GROUPS.flatMap((g) => report[g].filter((e) => e.changed).map((e) => ({ key: e.key, changed: e.changed })))
      }), authUser.location_id);
  }
  return j({ ok: true, dry_run: dry, run_id: runId, all_orgs: allOrgs, selected: selectedKeys, would_change: totalWould, changed: totalChanged, cells_changed: totalCells, more,
    note: dry ? "Nothing was changed. Send dry_run=0 to apply to the selected columns (customers by default; legal and staff only when named in groups or tables)." : (more ? "Stopped at the limit; send the same request again to carry on." : "Done."),
    groups: report });
}
// ── End people's names ──────────────────────────────────────────────────────────────────────────────────

/* ══════════════════════════════════════════════════════════════════════════════
   CLIENT ERROR REPORTS (backlog 7) — errors from pharmacies' browsers reach us, with no patient data.
   POST /client-log (signed in): {build, screen, kind, message, stack}. Scrubbed here (and already in the browser):
   e-mails, Maltese ID cards, phone numbers, bearer tokens and long token-like runs, and anything after ? or # in a URL.
   message <= 300 chars, stack <= 2000. Rate limit 20 a minute per session (login_attempts bucket, ip "-" so it never
   counts toward sign-in throttling). One row per day + pharmacy + screen + message; a repeat adds 1 to count.
   At most 200 distinct rows per pharmacy per day; rows older than 30 days are removed.
   GET /su/api/client-errors?days=7 (superusers only): the last N days, grouped.
   Self-contained: the only other lines are two router hooks in fetch().
   ══════════════════════════════════════════════════════════════════════════════ */
const CLIENT_LOG_MAX_PER_MIN = 20;
const CLIENT_LOG_MAX_ROWS_PER_DAY = 200;
const CLIENT_LOG_KINDS = ["error", "rejection", "fatal", "render", "csp"]; // csp: backlog 2-9 (report-only policy)
async function ensureClientErrorsSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS client_errors (id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
    day TEXT NOT NULL, build TEXT NOT NULL DEFAULT '', screen TEXT NOT NULL DEFAULT '', kind TEXT NOT NULL DEFAULT 'error', message TEXT NOT NULL DEFAULT '',
    stack TEXT NOT NULL DEFAULT '', count INTEGER NOT NULL DEFAULT 1, first_at TEXT NOT NULL DEFAULT (datetime('now')), last_at TEXT NOT NULL DEFAULT (datetime('now')),
    UNIQUE(day, org_id, location_id, screen, message))`, []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_client_errors_day ON client_errors (day)", []);
}
const ensureClientErrorsSchema = schemaOnce("ensureClientErrorsSchema", ensureClientErrorsSchema__impl);

// The same rules the browser applies (core.js E._scrubReport), applied again here: the server never trusts the client.
function clientLogScrub(v, max) {
  let s = String(v == null ? "" : v).slice(0, 8000);
  s = s.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, " ");
  // URLs: drop the query and fragment, keep a stack frame's :line:col
  s = s.replace(/[?#][^\s"'<>()]*?(?=(?::\d+:\d+)?(?:[\s"'<>()]|$))/g, "");
  s = s.replace(/\bBearer\s+[^\s"']+/gi, "Bearer [token]");
  s = s.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, "[email]");
  s = s.replace(/\b[A-Za-z0-9_\-+/=]{32,}\b/g, (m) => (/\d/.test(m) && /[A-Za-z]/.test(m)) ? "[token]" : m);
  s = s.replace(/\b\d{1,7}\s?[A-Za-z]\b/g, "[id]");
  s = s.replace(/(?:\+|\b00)?\d(?:[ \-]?\d){6,14}\b/g, (m) => (/^\d{4}-\d\d-\d\d/.test(m) || m.replace(/\D/g, "").length < 8) ? m : "[phone]");
  return s.slice(0, max);
}
function clientLogField(v, re, dflt) { const s = String(v == null ? "" : v).trim(); return re.test(s) ? s : dflt; }

async function handleClientLog(request, env, corsOkHeaders, authUser) {
  try {
    let text = "";
    try { text = await request.text(); } catch (e) {}
    if (text.length > 16384) return jsonResponse({ ok: false, error: "Too large" }, 413, corsOkHeaders);
    let b = null;
    try { b = JSON.parse(text || "{}"); } catch (e) {}
    if (!b || typeof b !== "object") return jsonResponse({ ok: false, error: "Invalid JSON" }, 400, corsOkHeaders);
    const message = clientLogScrub(b.message, 300).trim();
    if (!message) return jsonResponse({ ok: false, error: "message required" }, 400, corsOkHeaders);
    await ensureLoginAttemptsSchema(env);
    const bucket = "client-log:" + String(authUser.session_id);
    const n = await dbFirst(env, "SELECT COUNT(*) AS c FROM login_attempts WHERE email=? AND ip='-' AND attempted_at > datetime('now','-1 minute')", [bucket]);
    if (n && Number(n.c) >= CLIENT_LOG_MAX_PER_MIN) return jsonResponse({ ok: false, error: "Too many reports" }, 429, corsOkHeaders);
    try { await dbRun(env, "INSERT INTO login_attempts (email, ip) VALUES (?, '-')", [bucket]); } catch (e) {}
    await ensureClientErrorsSchema(env);
    const org = Number(authUser.org_id), loc = Number(authUser.location_id);
    const screen = clientLogField(b.screen, /^[A-Za-z][A-Za-z0-9_-]{0,63}$/, "");
    const kind = CLIENT_LOG_KINDS.indexOf(String(b.kind || "")) >= 0 ? String(b.kind) : "error";
    const build = clientLogField(b.build, /^[A-Za-z0-9._-]{1,40}$/, "");
    const stack = clientLogScrub(b.stack, 2000);
    const day = new Date().toISOString().slice(0, 10);
    const known = await dbFirst(env, "SELECT id FROM client_errors WHERE day=? AND org_id=? AND location_id=? AND screen=? AND message=?", [day, org, loc, screen, message]);
    if (known) {
      await dbRun(env, "UPDATE client_errors SET count = count + 1, last_at = datetime('now'), build = ? WHERE id = ?", [build, known.id]);
      return jsonResponse({ ok: true, repeat: true }, 200, corsOkHeaders);
    }
    const rows = await dbFirst(env, "SELECT COUNT(*) AS c FROM client_errors WHERE day=? AND org_id=? AND location_id=?", [day, org, loc]);
    if (rows && Number(rows.c) >= CLIENT_LOG_MAX_ROWS_PER_DAY) return jsonResponse({ ok: true, dropped: true }, 200, corsOkHeaders);
    await dbRun(env, `INSERT INTO client_errors (org_id, location_id, day, build, screen, kind, message, stack) VALUES (?,?,?,?,?,?,?,?)
      ON CONFLICT(day, org_id, location_id, screen, message) DO UPDATE SET count = count + 1, last_at = datetime('now'), build = excluded.build`,
      [org, loc, day, build, screen, kind, message, stack]);
    try { await dbRun(env, "DELETE FROM client_errors WHERE day < ?", [new Date(Date.now() - 30 * 86400000).toISOString().slice(0, 10)]); } catch (e) {}
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  } catch (e) {
    return jsonResponse({ ok: false, error: "Could not store the report" }, 500, corsOkHeaders);
  }
}

async function handleSuClientErrors(request, env, corsOkHeaders, url) {
  await ensureClientErrorsSchema(env);
  let days = Number(url.searchParams.get("days") || 7);
  if (!Number.isInteger(days) || days < 1) days = 7;
  if (days > 30) days = 30;
  const since = new Date(Date.now() - (days - 1) * 86400000).toISOString().slice(0, 10);
  const groups = await dbAll(env, `SELECT screen, kind, message, SUM(count) AS count, COUNT(DISTINCT day) AS days,
      COUNT(DISTINCT org_id || ':' || location_id) AS pharmacies, MIN(first_at) AS first_at, MAX(last_at) AS last_at,
      GROUP_CONCAT(DISTINCT build) AS builds, MAX(stack) AS stack
    FROM client_errors WHERE day >= ? GROUP BY screen, kind, message ORDER BY MAX(last_at) DESC LIMIT 200`, [since]);
  const where = await dbAll(env, `SELECT e.screen, e.message, e.org_id, e.location_id, o.name AS org_name, l.name AS location_name, SUM(e.count) AS count
    FROM client_errors e LEFT JOIN orgs o ON o.id = e.org_id LEFT JOIN locations l ON l.id = e.location_id
    WHERE e.day >= ? GROUP BY e.screen, e.message, e.org_id, e.location_id`, [since]);
  const by = new Map();
  for (const w of where) {
    const k = w.screen + "\u0001" + w.message;
    if (!by.has(k)) by.set(k, []);
    by.get(k).push({ org_id: w.org_id, location_id: w.location_id, org_name: w.org_name || "", location_name: w.location_name || "", count: Number(w.count) || 0 });
  }
  const out = groups.map((g) => ({ screen: g.screen, kind: g.kind, message: g.message, count: Number(g.count) || 0, days: Number(g.days) || 0,
    pharmacies: Number(g.pharmacies) || 0, first_at: g.first_at, last_at: g.last_at, builds: String(g.builds || "").split(",").filter(Boolean),
    stack: g.stack || "", where: by.get(g.screen + "\u0001" + g.message) || [] }));
  return jsonResponse({ ok: true, since, days, groups: out }, 200, corsOkHeaders);
}

/* ══════════════════════════════════════════════════════════════════════════════
   REGISTER SIGN-OFFS (Registers & inspection, "daily") — the pharmacist signs off a month of a daily register.
   GET  /registers/signoffs?month=YYYY-MM   every register's sign-off for that month, this pharmacy only (one read)
   POST /registers/signoffs {register, month, note}   admin only; a month that has ended (Malta time); once per
        register and month (a second call returns the first sign-off unchanged, 200, already: true)
   register: temperature | cleaning | daily | locum | receipts. note: up to 500 characters (why days are missing).
   Additive: a new table only; no existing table, row or route changes. A sign-off is never deleted or changed here:
   a line corrected afterwards is corrected the usual way (with a reason, in the audit), and the screen says so.
   ══════════════════════════════════════════════════════════════════════════════ */
const SIGNOFF_REGISTERS = ["temperature", "cleaning", "daily", "locum", "receipts"];
async function ensureSignoffSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS register_signoffs (id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
    register TEXT NOT NULL, month TEXT NOT NULL, signed_by INTEGER, signed_name TEXT NOT NULL DEFAULT '', note TEXT NOT NULL DEFAULT '',
    signed_at TEXT NOT NULL DEFAULT (datetime('now')), UNIQUE(org_id, location_id, month, register))`, []);
}
const ensureSignoffSchema = schemaOnce("ensureSignoffSchema", ensureSignoffSchema__impl);
function signoffRow(r) { return { register: r.register, month: r.month, signed_name: r.signed_name || "", signed_at: r.signed_at || "", note: r.note || "" }; }
async function handleRegisterSignoffs(request, env, corsOkHeaders, authUser, url) {
  const org = Number(authUser.org_id), loc = Number(authUser.location_id);
  if (request.method === "GET") {
    if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
    const month = String(url.searchParams.get("month") || "").trim();
    if (!/^\d{4}-(0[1-9]|1[0-2])$/.test(month)) return jsonResponse({ ok: false, error: "Missing/invalid month (YYYY-MM)" }, 400, corsOkHeaders);
    await ensureSignoffSchema(env);
    const rows = await dbAll(env, "SELECT register, month, signed_name, signed_at, note FROM register_signoffs WHERE org_id = ? AND location_id = ? AND month = ? ORDER BY register", [org, loc, month]);
    return jsonResponse({ ok: true, month, signoffs: rows.map(signoffRow) }, 200, corsOkHeaders);
  }
  if (request.method !== "POST") return jsonResponse({ ok: false, error: "Method not allowed" }, 405, corsOkHeaders);
  if (!requireRole(authUser, ["admin"])) return jsonResponse({ ok: false, error: "Only the pharmacist can sign off a register" }, 403, corsOkHeaders);
  const body = await readJson(request);
  const register = String((body && body.register) || "").trim(), month = String((body && body.month) || "").trim();
  const note = String((body && body.note) || "").trim().slice(0, 500);
