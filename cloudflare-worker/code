async function handleShortExpiryUpload(request, env, corsOkHeaders, authUser) {
  await ensureCherubinoShortExpirySchema(env);
  // Only the warehouse / company-admin locations (600-900) may replace the list; it wipes every branch's orders.
  const uploaderLoc = Number(authUser.location_id);
  if (!(uploaderLoc >= 600 && uploaderLoc <= 900)) return jsonResponse({ ok: false, error: "Forbidden - warehouse admin only" }, 403, corsOkHeaders);
  const body = await readJson(request);
  const items = Array.isArray(body.items) ? body.items : [];
  if (!items.length) return jsonResponse({ ok: false, error: "No items" }, 400, corsOkHeaders);
  if (items.length > 500) return jsonResponse({ ok: false, error: "Max 500 items per batch" }, 400, corsOkHeaders);

  // Wipe on first batch
  if (body.wipe) {
    await dbRun(env, `DELETE FROM cherubino_short_expiry WHERE org_id = ?`, [authUser.org_id]);
    await dbRun(env, `DELETE FROM cherubino_short_expiry_orders WHERE org_id = ?`, [authUser.org_id]);
  }

  let inserted = 0;
  const seRows = [];
  for (const item of items) {
    const stkCode = String(item.stk_code || "").trim();
    const stkDesc = String(item.stk_desc || "").trim();
    const batch = String(item.batch || "").trim();
    const expiry = String(item.expiry || "").trim();
    const qty = parseInt(item.qty) || 0;
    const locCode = String(item.loc_code || "").trim();
    if (!stkDesc) continue;
    seRows.push([authUser.org_id, stkCode, stkDesc, batch, expiry, qty, locCode]);
    inserted++;
  }
  await wsaveRun(env, wsaveStatements(env,
      `INSERT INTO cherubino_short_expiry (org_id, stk_code, stk_desc, batch, expiry, qty, loc_code)
       VALUES `, ["?", "?", "?", "?", "?", "?", "?"], "", seRows));
  await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_SE_UPLOAD", "cherubino_short_expiry", "", { count: inserted, wipe: !!body.wipe }, authUser.location_id);
  return jsonResponse({ ok: true, inserted }, 200, corsOkHeaders);
}

async function handleShortExpiryOrder(request, env, corsOkHeaders, authUser) {
  await ensureCherubinoShortExpirySchema(env);
  const body = await readJson(request);
  const itemId = parseInt(body.item_id);
  const quantity = Math.max(1, parseInt(body.quantity) || 1);
  if (!itemId) return jsonResponse({ ok: false, error: "item_id required" }, 400, corsOkHeaders);

  // Verify item exists and get WSL stock
  const item = await dbFirst(env, `SELECT id, qty FROM cherubino_short_expiry WHERE id = ? AND org_id = ?`, [itemId, authUser.org_id]);
  if (!item) return jsonResponse({ ok: false, error: "Item not found" }, 404, corsOkHeaders);

  // Check available stock: WSL qty minus all OTHER locations' orders (exclude current location since we're replacing their order)
  const othersSum = await dbFirst(env,
    `SELECT COALESCE(SUM(quantity), 0) as total FROM cherubino_short_expiry_orders WHERE item_id = ? AND org_id = ? AND location_id != ?`,
    [itemId, authUser.org_id, authUser.location_id]);
  const othersTotal = othersSum ? othersSum.total : 0;
  const availableForMe = item.qty - othersTotal;
  let __before = null;
  try { __before = await dbFirst(env, "SELECT * FROM cherubino_short_expiry_orders WHERE item_id = ? AND location_id = ? AND org_id = ?", [itemId, authUser.location_id, authUser.org_id]); } catch (e) {}

  if (quantity > availableForMe) {
    return jsonResponse({ ok: false, error: "Exceeds available stock. Only " + availableForMe + " available." }, 400, corsOkHeaders);
  }

  await dbRun(env,
    `INSERT INTO cherubino_short_expiry_orders (org_id, item_id, location_id, location_name, quantity, created_by)
     VALUES (?, ?, ?, ?, ?, ?)
     ON CONFLICT(item_id, location_id) DO UPDATE SET
       quantity = excluded.quantity, created_by = excluded.created_by, created_at = datetime('now')`,
    [authUser.org_id, itemId, authUser.location_id, authUser.location_name || "", quantity, authUser.user_id]);

  let __after = null;
  try { __after = await dbFirst(env, "SELECT * FROM cherubino_short_expiry_orders WHERE item_id = ? AND location_id = ? AND org_id = ?", [itemId, authUser.location_id, authUser.org_id]); } catch (e) {}
  await writeAudit(env, authUser.org_id, authUser.user_id, __before ? "SHORT_EXPIRY_ORDER_UPDATE" : "SHORT_EXPIRY_ORDER_CREATE", "cherubino_short_expiry_orders", String(itemId), { quantity, before: __before, after: __after }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

