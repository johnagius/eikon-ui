/* ---------- sending ---------- */
function bkIcs(b, svcName, placeName) {
  const dt = (d, t) => d.replace(/-/g, "") + "T" + t.replace(":", "") + "00";
  const esc = (s) => String(s || "").replace(/[\\;,]/g, (c) => "\\" + c).replace(/\n/g, "\\n");
  return ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Eikon//Bookings//EN", "BEGIN:VEVENT",
    `UID:${b.link_id}@eikon`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").slice(0, 15)}Z`,
    `DTSTART;TZID=Europe/Malta:${dt(b.date, b.start_time)}`, `DTEND;TZID=Europe/Malta:${dt(b.date, b.end_time)}`,
    `SUMMARY:${esc(svcName)} at ${esc(placeName)}`, `LOCATION:${esc(placeName)}`, "END:VEVENT", "END:VCALENDAR"].join("\r\n");
}
function bkFirstName(n) { return String(n || "").trim().split(/\s+/)[0] || ""; }
function bkWhen(b) {
  const d = new Date(b.date + "T12:00:00Z");
  return d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", timeZone: "UTC" }) + " at " + b.start_time;
}
