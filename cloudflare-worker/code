function demoNo(cors, error, status = 403) { return jsonResponse({ ok: false, demo: true, error: error || "This is not available in the demo" }, status, cors); }
function demoNotSent(cors) { return jsonResponse({ ok: false, demo: true, not_sent: true, error: "Not sent — this is the demo" }, 403, cors); }
function demoRebuild(request, url, body) {
