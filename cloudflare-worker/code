    await dbRun(env, "UPDATE users SET is_active = ? WHERE id = ? AND org_id = ? AND default_location_id = ?", [val, target.id, authUser.org_id, authUser.location_id]);
    if (!val) await dbRun(env, "DELETE FROM sessions WHERE user_id = ?", [target.id]);
