  return jsonResponse({ ok: true, ...lastInspectionOut(await read()) }, 200, corsOkHeaders);
}

/* ══════════════════════════════════════════════════════════════════════════════
   TEAM SIGN-INS (backlog 2 item 4) — a pharmacy admin manages the sign-ins of their own pharmacy.
   GET  /team/users                 list this pharmacy's sign-ins
   POST /team/users                 {email, full_name, role}  -> temporary_password, returned ONCE
   POST /team/users/:id/password    new temporary password, returned ONCE; every session of that person ends
   POST /team/users/:id/active      {active: true|false}; switching off ends every session of that person
   POST /team/users/:id/role        {role: "staff"|"admin"}
   Admin only. Every query binds the admin's own org_id AND pharmacy (their default_location_id), never the body's:
   another pharmacy's person, or another group's, is "not found" (404). Never a superuser: an e-mail on
   SUPERUSER_EMAILS cannot be added here, and such an account is listed but cannot be changed (403).
   Admin accounts other than your own are changed only when TEAM_ADMINS_MANAGE_ADMINS = "1" (John's decision;
   off by default): with it off an admin adds and manages staff only. Never your own role or active state, never the
   last active admin. Creates and resets: 10 an hour per admin. Audited; a password is never logged or stored in clear.
   Existing accounts are untouched: the new column must_change_password defaults to 0, and only an account made or
   reset here gets 1 (cleared by /auth/change-password). Session length is unchanged.
   ══════════════════════════════════════════════════════════════════════════════ */
const TEAM_RATE_PER_HOUR = 10;
async function ensureTeamSchema__impl(env) {
  // Additive: every existing row reads 0, so nobody who signs in today is asked for anything new.
  try { await dbRun(env, "ALTER TABLE users ADD COLUMN must_change_password INTEGER NOT NULL DEFAULT 0", []); } catch (e) { /* column may already exist */ }
}
const ensureTeamSchema = schemaOnce("ensureTeamSchema", ensureTeamSchema__impl);

function teamAdminsManageAdmins(env) { return String((env && env.TEAM_ADMINS_MANAGE_ADMINS) || "") === "1"; }
function teamIsSuperuserEmail(env, email) {
  const list = String((env && env.SUPERUSER_EMAILS) || "").split(",").map((s) => s.trim().toLowerCase()).filter(Boolean);
  return list.includes(String(email || "").trim().toLowerCase());
}
// 12 letters and digits a person can read aloud (no 0/O, 1/l/I), in three groups: "k7mp-q4xa-9rtd".
function teamTempPassword() {
  const A = "abcdefghjkmnpqrstuvwxyz23456789";
  const out = []; const r = crypto.getRandomValues(new Uint8Array(24));
  for (let i = 0; out.length < 12 && i < r.length; i++) { if (r[i] < 248) out.push(A[r[i] % A.length]); }
  while (out.length < 12) out.push(A[crypto.getRandomValues(new Uint8Array(1))[0] % A.length]);
  return out.slice(0, 4).join("") + "-" + out.slice(4, 8).join("") + "-" + out.slice(8, 12).join("");
}
async function teamHash(password) {
  const iters = 100000;
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const hash = await pbkdf2Hash(password, salt, iters);
  return { salt: base64FromBytes(salt), hash: base64FromBytes(hash), iters };
}
async function teamRateLimited(env, authUser) {
  try {
    await ensureLoginAttemptsSchema(env);
    const r = await dbFirst(env, "SELECT COUNT(*) AS c FROM login_attempts WHERE email = ? AND ip = '-' AND attempted_at > datetime('now', '-1 hour')", ["team:" + authUser.user_id]);
    return !!(r && Number(r.c) >= TEAM_RATE_PER_HOUR);
  } catch (e) { return false; }
}
async function teamCountAction(env, authUser) {
  try { await dbRun(env, "INSERT INTO login_attempts (email, ip) VALUES (?, '-')", ["team:" + authUser.user_id]); } catch (e) {}
}
// The person, only if they belong to the admin's own pharmacy (org AND location).
async function teamTarget(env, authUser, id) {
  if (!Number.isInteger(id) || id <= 0) return null;
  return await dbFirst(env, "SELECT id, org_id, email, full_name, role, is_active, default_location_id, COALESCE(must_change_password, 0) AS must_change_password, is_pharmacist, plans_rota FROM users WHERE id = ? AND org_id = ? AND default_location_id = ?", // FIN-roles: + is_pharmacist, plans_rota
    [id, authUser.org_id, authUser.location_id]);
}
async function teamActiveAdmins(env, authUser) {
  const r = await dbFirst(env, "SELECT COUNT(*) AS c FROM users WHERE org_id = ? AND default_location_id = ? AND role = 'admin' AND is_active = 1", [authUser.org_id, authUser.location_id]);
  return r ? Number(r.c) || 0 : 0;
}
function teamPublic(env, u, lastAt, openSessions) {
  return { id: u.id, email: u.email, full_name: u.full_name || "", role: u.role, is_active: Number(u.is_active) === 1,
    is_pharmacist: Number(u.is_pharmacist) === 1, plans_rota: u.role === "admin" || u.plans_rota === null || u.plans_rota === undefined || Number(u.plans_rota) !== 0, // FIN-roles
    role_word: finRoleWord(u.role, Number(u.is_pharmacist) === 1), // FIN-roles
    must_change_password: Number(u.must_change_password) === 1, created_at: u.created_at || null,
    last_sign_in_at: lastAt || null, signed_in_devices: Number(openSessions) || 0, protected: teamIsSuperuserEmail(env, u.email) };
}
// Refusals shared by reset, active and role: who may be changed by this admin at all.
function teamMayChange(env, authUser, target, cors) {
  if (!target) return jsonResponse({ ok: false, error: "Not found" }, 404, cors);
  if (Number(target.id) === Number(authUser.user_id)) return jsonResponse({ ok: false, error: "You cannot change your own sign-in here. Use Change password." }, 403, cors);
  if (teamIsSuperuserEmail(env, target.email)) return jsonResponse({ ok: false, error: "This sign-in is managed by Eikon support" }, 403, cors);
  if (target.role === "admin" && !teamAdminsManageAdmins(env)) return jsonResponse({ ok: false, error: "Another admin's sign-in is changed by Eikon support" }, 403, cors);
  return null;
}

async function handleTeam(request, env, cors, authUser, url) {
  if (!requireRole(authUser, ["admin"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, cors);
  await ensureTeamSchema(env);
  await finRolesSchema(env); // FIN-roles: is_pharmacist, plans_rota
  const parts = url.pathname.split("/").filter(Boolean); // team, users, :id, action
  if (parts[1] !== "users") return jsonResponse({ ok: false, error: "Not found" }, 404, cors);

  if (parts.length === 2 && request.method === "GET") {
    const rows = await dbAll(env, `SELECT u.id, u.email, u.full_name, u.role, u.is_active, u.created_at, COALESCE(u.must_change_password, 0) AS must_change_password, u.is_pharmacist, u.plans_rota,
        (SELECT MAX(s.created_at) FROM sessions s WHERE s.user_id = u.id) AS last_at,
        (SELECT COUNT(*) FROM sessions s WHERE s.user_id = u.id AND s.expires_at > ?) AS open_sessions
      FROM users u WHERE u.org_id = ? AND u.default_location_id = ? ORDER BY u.is_active DESC, lower(u.full_name), u.id`,
      [new Date().toISOString(), authUser.org_id, authUser.location_id]);
    return jsonResponse({ ok: true, users: rows.map((u) => teamPublic(env, u, u.last_at, u.open_sessions)), me: authUser.user_id,
      admins_manage_admins: teamAdminsManageAdmins(env), location_name: authUser.location_name }, 200, cors);
  }

  if (parts.length === 2 && request.method === "POST") {
    const body = await readJson(request);
    const email = String(body.email || "").trim().toLowerCase();
    const fullName = String(body.full_name || "").trim().replace(/\s+/g, " ").slice(0, 120);
    const asked = String(body.role || "staff").trim().toLowerCase();
    const role = asked === "pharmacist" ? "staff" : asked; // FIN-roles: a pharmacist is a staff sign-in marked is_pharmacist
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) || email.length > 200) return jsonResponse({ ok: false, error: "Enter a valid e-mail address" }, 400, cors);
    if (!fullName) return jsonResponse({ ok: false, error: "Enter the person's name" }, 400, cors);
    if (role !== "staff" && role !== "admin") return jsonResponse({ ok: false, error: "Role must be staff, pharmacist or admin" }, 400, cors);
    // FIN-roles: the pharmacy's admin may add a second admin (owner decision, W3); changing an existing admin still needs TEAM_ADMINS_MANAGE_ADMINS.
    if (teamIsSuperuserEmail(env, email)) return jsonResponse({ ok: false, error: "This e-mail cannot be added here" }, 403, cors);
    if (await teamRateLimited(env, authUser)) return jsonResponse({ ok: false, error: "Too many sign-ins added or reset in the last hour. Try again later." }, 429, { ...cors, "Retry-After": "3600" });
    const dupe = await dbFirst(env, "SELECT id FROM users WHERE lower(email) = lower(?)", [email]);
    if (dupe) return jsonResponse({ ok: false, error: "That e-mail already has a sign-in" }, 409, cors);
    const temp = teamTempPassword();
    const h = await teamHash(temp);
    await teamCountAction(env, authUser);
    const isPh = asked === "pharmacist" || (role === "admin" && body.is_pharmacist === true) ? 1 : 0; // FIN-roles
    const row = await dbFirst(env, `INSERT INTO users (org_id, email, full_name, role, pass_salt_b64, pass_hash_b64, pass_iters, is_active, default_location_id, created_at, must_change_password, is_pharmacist, plans_rota)
      VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?, datetime('now'), 1, ?, ?) RETURNING id`, [authUser.org_id, email, fullName, role, h.salt, h.hash, h.iters, authUser.location_id, isPh, role === "admin" ? null : 0]);
    const id = row && row.id;
    await writeAudit(env, authUser.org_id, authUser.user_id, "TEAM_USER_CREATE", "user", String(id || ""), { after: { id, email, full_name: fullName, role, is_active: 1, must_change_password: 1, is_pharmacist: isPh, plans_rota: role === "admin" ? null : 0 } }, authUser.location_id);
    const u = await teamTarget(env, authUser, Number(id));
    return jsonResponse({ ok: true, user: u ? teamPublic(env, u, null, 0) : { id, email }, temporary_password: temp }, 200, { ...cors, "Cache-Control": "no-store" });
  }

  const id = Number(parts[2]);
  const action = parts[3] || "";
  if (parts.length !== 4 || request.method !== "POST" || !["password", "active", "role", "rights"].includes(action)) return jsonResponse({ ok: false, error: "Not found" }, 404, cors); // FIN-roles: + rights
  const target = await teamTarget(env, authUser, id);
  const refused = teamMayChange(env, authUser, target, cors);
  if (refused) return refused;
  const before = { id: target.id, email: target.email, role: target.role, is_active: target.is_active, must_change_password: target.must_change_password };

  if (action === "password") {
    if (await teamRateLimited(env, authUser)) return jsonResponse({ ok: false, error: "Too many sign-ins added or reset in the last hour. Try again later." }, 429, { ...cors, "Retry-After": "3600" });
    const temp = teamTempPassword();
    const h = await teamHash(temp);
    await teamCountAction(env, authUser);
    await dbRun(env, "UPDATE users SET pass_salt_b64 = ?, pass_hash_b64 = ?, pass_iters = ?, must_change_password = 1 WHERE id = ? AND org_id = ? AND default_location_id = ?",
