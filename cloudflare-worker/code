// Free allowances of each service, kept a little under the real ones so Eikon moves on before a provider refuses.
const BK_SENDER_DEFAULTS = { resend: { label: "Resend", daily: 95, monthly: 2900 }, brevo: { label: "Brevo", daily: 290, monthly: 0 }, smtp: { label: "Mail server", daily: 0, monthly: 0 } };

// One send through one sender. Errors carry .status (HTTP status, 0 for network or mail-server errors).
async function bkSendVia(env, settings, snd, key, { to, toName, subject, html, ics }) {
  const fromEmail = snd.from_email || settings.from_email, fromName = snd.from_name || settings.from_name;
  if (!fromEmail) { const e = new Error("No sender email"); e.status = 400; throw e; }
  const from = fromName ? `${fromName} <${fromEmail}>` : fromEmail;
  const fail = async (who, r) => { const e = new Error(who + " " + r.status + ": " + (await r.text()).slice(0, 200)); e.status = r.status; return e; };
  if (snd.kind === "resend") {
    const r = await fetch("https://api.resend.com/emails", { method: "POST", headers: { "Authorization": "Bearer " + key, "Content-Type": "application/json" },
      body: JSON.stringify({ from, to: [to], subject, html, reply_to: settings.reply_to || undefined,
        attachments: ics ? [{ filename: "booking.ics", content: base64FromBytes(new TextEncoder().encode(ics)) }] : undefined }) });
    if (!r.ok) throw await fail("Resend", r);
    return;
  }
  if (snd.kind === "brevo") {
    const r = await fetch("https://api.brevo.com/v3/smtp/email", { method: "POST", headers: { "api-key": key, "Content-Type": "application/json", "Accept": "application/json" },
      body: JSON.stringify({ sender: { name: fromName || fromEmail, email: fromEmail }, to: [{ email: to, name: toName || to }], subject, htmlContent: html,
        replyTo: settings.reply_to ? { email: settings.reply_to } : undefined,
        attachment: ics ? [{ name: "booking.ics", content: base64FromBytes(new TextEncoder().encode(ics)) }] : undefined }) });
    if (!r.ok) throw await fail("Brevo", r);
    return;
  }
  if (snd.kind === "smtp") {
    try { await bkSmtpSend(env, { smtp_host: snd.smtp_host, smtp_port: snd.smtp_port, smtp_user: snd.smtp_user, smtp_secure: snd.smtp_secure, from_email: fromEmail }, key, { from, fromEmail, to, subject, html, ics }); }
    catch (e) { const er = new Error("Mail server: " + String(e && e.message || e).slice(0, 200)); er.status = /\b535\b|auth/i.test(String(e && e.message)) ? 401 : 0; throw er; }
    return;
  }
  const e = new Error("Unknown sender"); e.status = 400; throw e;
}

// The pharmacy's senders in order. The first time, a pharmacy set up with one provider gets it as its first sender.
async function bkSenders(env, org, loc, settings) {
  let rows = await dbAll(env, `SELECT * FROM bk_senders WHERE org_id=? AND location_id=? ORDER BY position, id`, [org, loc]);
  if (!rows.length && settings && BK_SENDER_DEFAULTS[settings.provider] && settings.api_key_enc) { await bkSyncLegacySender(env, org, loc); rows = await dbAll(env, `SELECT * FROM bk_senders WHERE org_id=? AND location_id=? ORDER BY position, id`, [org, loc]); }
  return rows;
}
// Keeps the sender made from the single-provider settings in step with them (the settings screen still writes there).
async function bkSyncLegacySender(env, org, loc) {
  const st = await bkGetSettings(env, org, loc);
  if (!BK_SENDER_DEFAULTS[st.provider] || !st.api_key_enc) return;
  const d = BK_SENDER_DEFAULTS[st.provider];
  const cur = await dbFirst(env, `SELECT id, kind FROM bk_senders WHERE org_id=? AND location_id=? AND legacy=1`, [org, loc]);
  if (cur) {
    await dbRun(env, `UPDATE bk_senders SET kind=?, label=CASE WHEN kind=? THEN label ELSE ? END, cred_enc=?, smtp_host=?, smtp_port=?, smtp_user=?, smtp_secure=?, enabled=1,
      daily_cap=CASE WHEN kind=? THEN daily_cap ELSE ? END, monthly_cap=CASE WHEN kind=? THEN monthly_cap ELSE ? END, cooldown_until='', updated_at=datetime('now') WHERE id=?`,
      [st.provider, st.provider, d.label, st.api_key_enc, st.smtp_host || "", Number(st.smtp_port) || 465, st.smtp_user || "", st.smtp_secure || "tls", st.provider, d.daily, st.provider, d.monthly, cur.id]);
  } else {
    const top = await dbFirst(env, `SELECT MIN(position) AS p FROM bk_senders WHERE org_id=? AND location_id=?`, [org, loc]);
    await dbRun(env, `INSERT INTO bk_senders (org_id, location_id, kind, label, position, legacy, cred_enc, smtp_host, smtp_port, smtp_user, smtp_secure, daily_cap, monthly_cap)
      VALUES (?,?,?,?,?,1,?,?,?,?,?,?,?)`, [org, loc, st.provider, d.label, top && top.p != null ? Number(top.p) - 1 : 0, st.api_key_enc,
        st.smtp_host || "", Number(st.smtp_port) || 465, st.smtp_user || "", st.smtp_secure || "tls", d.daily, d.monthly]);
  }
}
function bkSenderState(r, nowIso) {
  const day = nowIso.slice(0, 10), month = nowIso.slice(0, 7);
  const usedToday = r.used_day === day ? Number(r.used_today) : 0, usedMonth = r.used_month === month ? Number(r.used_this_month) : 0;
  if (!r.enabled) return { status: "off", usedToday, usedMonth };
  if ((r.daily_cap > 0 && usedToday >= r.daily_cap) || (r.monthly_cap > 0 && usedMonth >= r.monthly_cap)) return { status: "limit", usedToday, usedMonth, restingUntil: r.daily_cap > 0 && usedToday >= r.daily_cap ? bkNextUtcDay(nowIso) : bkNextUtcMonth(nowIso) };
  if (r.cooldown_until && r.cooldown_until > nowIso) return { status: /quota|limit|429|exceed|too many/i.test(r.last_error) ? "limit" : "resting", usedToday, usedMonth, restingUntil: r.cooldown_until };
  if (!r.cred_enc) return { status: "nokey", usedToday, usedMonth };
  return { status: "ready", usedToday, usedMonth };
}
function bkNextUtcDay(iso) { const d = new Date(iso); d.setUTCHours(24, 0, 0, 0); return d.toISOString(); }
function bkNextUtcMonth(iso) { const d = new Date(iso); return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 1)).toISOString(); }

// Sends through the first sender that can: a failure or a used-up allowance hands over to the next.
// onlyId sends through that one sender (the test button). Returns the sender used; throws when none could.
async function bkSendEmail(env, settings, msg, onlyId) {
  const org = settings.org_id, loc = settings.location_id;
  if (demoIsOrg(env, org)) throw new Error("Not sent — this is the demo"); // the one-click demo never e-mails anyone
  const list = (await bkSenders(env, org, loc, settings)).filter((r) => !onlyId || r.id === onlyId);
  const tried = [];
  for (const r of list) {
    const nowIso = new Date().toISOString();
    const stt = bkSenderState(r, nowIso), name = r.label || (BK_SENDER_DEFAULTS[r.kind] || {}).label || r.kind;
    if (!onlyId && stt.status !== "ready") { tried.push(name + ": " + (stt.status === "limit" ? "free limit reached" : stt.status === "resting" ? "resting after an error" : stt.status === "off" ? "switched off" : "no key")); continue; }
    const key = await bkDecrypt(env, r.cred_enc);
    if (!key) { tried.push(name + ": no key"); continue; }
    try {
      await bkSendVia(env, settings, r, key, msg);
      const day = nowIso.slice(0, 10), month = nowIso.slice(0, 7);
      await dbRun(env, `UPDATE bk_senders SET used_today = CASE WHEN used_day=? THEN used_today + 1 ELSE 1 END, used_day=?,
        used_this_month = CASE WHEN used_month=? THEN used_this_month + 1 ELSE 1 END, used_month=?, last_ok_at=?, last_error='', cooldown_until='' WHERE id=?`,
        [day, day, month, month, nowIso, r.id]);
      return { senderId: r.id, sender: name };
    } catch (e) {
      const st = Number(e && e.status) || 0, text = String(e && e.message || e).slice(0, 300);
      // At its limit: rest until tomorrow. Credentials refused: an hour (someone has to fix them). Down: five minutes.
      // Anything else (a bad address, say) is not the sender's fault: no rest, the next one is still tried.
      let until = "";
      if (st === 429 || /quota|limit|exceed|too many/i.test(text)) until = bkNextUtcDay(nowIso);
      else if (st === 401 || st === 403) until = new Date(Date.parse(nowIso) + 3600000).toISOString();
      else if (st === 0 || st >= 500) until = new Date(Date.parse(nowIso) + 300000).toISOString();
      await dbRun(env, `UPDATE bk_senders SET last_error=?, last_fail_at=?, cooldown_until=? WHERE id=?`, [text, nowIso, until, r.id]);
      tried.push(text);
    }
  }
  throw new Error(tried.length ? tried.join(" · ") : "No sender is set up");
}
async function bkCanSend(env, s) {
  if (!s || s.provider === "off" || String(env.BOOKINGS_KEY || "").length < 16) return false;
  if (demoIsOrg(env, s.org_id)) return false; // the one-click demo never e-mails anyone
  const list = await bkSenders(env, s.org_id, s.location_id, s);
  return list.some((r) => r.enabled && r.cred_enc && (r.from_email || s.from_email));
}

// Sends one message about a booking. Never throws: a failed email must not fail a booking.
async function bkNotify(env, request, booking, kind, extra) {
  try {
    await ensureBookingsMsgSchema(env);
    if (!booking || !booking.person_email) return "no-email";
    const s = await bkGetSettings(env, booking.org_id, booking.location_id);
    if (!(await bkCanSend(env, s))) return "off";
    if (await dbFirst(env, `SELECT 1 AS x FROM bk_optout WHERE email=? AND org_id=? AND location_id=?`, [booking.person_email, booking.org_id, booking.location_id])) return "opted-out";
    if (kind === "remind_evening" || kind === "remind_hours") {
      // Claim first: the unique index makes a second claim fail, so a retry never sends twice.
      try { await dbRun(env, `INSERT INTO bk_messages (org_id, location_id, booking_id, kind, status) VALUES (?,?,?,?, 'sending')`, [booking.org_id, booking.location_id, booking.id, kind]); }
      catch (e) { return "already"; }
    } else {
      await dbRun(env, `INSERT INTO bk_messages (org_id, location_id, booking_id, kind, status) VALUES (?,?,?,?, 'sending')`, [booking.org_id, booking.location_id, booking.id, kind]);
    }
    const msgId = (await dbFirst(env, `SELECT id FROM bk_messages WHERE booking_id=? AND kind=? ORDER BY id DESC LIMIT 1`, [booking.id, kind])).id;
    const svc = await dbFirst(env, `SELECT name FROM bk_services WHERE id=?`, [booking.service_id]);
    const loc = await dbFirst(env, `SELECT name FROM locations WHERE id=?`, [booking.location_id]);
    const pharmacy = (loc && loc.name) || "Your pharmacy";
    const base = bkBaseUrl(env, request);
    const tok = await bkLinkToken(env, booking);
    const link = tok && base ? `${base}/b/${tok}` : "";
    const optout = tok && base ? `${base}/b/${tok}/stop` : "";
    const svcName = (svc && svc.name) || "Appointment";
    const first = bkFirstName(booking.person_name);
    const T = {
      confirm: [`Booked: ${svcName}`, [`Hi ${first},`, `you're booked for ${svcName.toLowerCase()} on ${bkWhen(booking)}.`]],
      change: [`Moved: ${svcName}`, [`Hi ${first},`, `your ${svcName.toLowerCase()} is now on ${bkWhen(booking)}.`]],
      cancel: [`Cancelled: ${svcName}`, [`Hi ${first},`, `your ${svcName.toLowerCase()} on ${bkWhen(booking)} is cancelled.`]],
      remind_evening: [`Tomorrow: ${svcName}`, [`Hi ${first},`, `a reminder: ${svcName.toLowerCase()} tomorrow at ${booking.start_time}.`]],
      remind_hours: [`Soon: ${svcName}`, [`Hi ${first},`, `see you at ${booking.start_time} for ${svcName.toLowerCase()}.`]]
    }[kind];
    // A cancellation says why (unless the customer cancelled it) and, when online booking is on, how to book again.
    let lines = T[1], btn = kind === "cancel" ? "" : link, btnText = "";
    if (kind !== "cancel") { const room = await bkRoomNameFor(env, booking); if (room) lines = lines.concat([`In ${room}.`]); }
    // A repeat booking: one e-mail for all of them; each still gets its own reminder.
    if (extra && Array.isArray(extra.also) && extra.also.length) lines = lines.concat([`Also booked at the same time: ${extra.also.join("; ")}.`]);
    // A reminder asks the customer to say they are coming (one tap on their page) or to change the time.
    if (kind === "remind_evening" || kind === "remind_hours") btnText = "Confirm or change";
    if (kind === "cancel") {
      const why = String(booking.cancel_reason || "");
      if (why && !/by the customer/i.test(why)) lines = lines.concat([why + "."]);
      if (s.public_enabled && s.public_slug && base) { btn = `${base}/book/${s.public_slug}`; btnText = "Book another time"; }
    }
    const html = bkEmailHtml({ title: T[0], lines, link: btn, linkText: btnText, pharmacy, address: s.address, phone: s.phone, optout });
    try {
      await bkSendEmail(env, s, { to: booking.person_email, toName: booking.person_name, subject: `${T[0]} · ${pharmacy}`, html,
        ics: kind === "confirm" || kind === "change" ? bkIcs(booking, svcName, pharmacy) : null });
      await dbRun(env, `UPDATE bk_messages SET status='sent' WHERE id=?`, [msgId]);
      return "sent";
    } catch (e) {
      await dbRun(env, `UPDATE bk_messages SET status='failed', error=? WHERE id=?`, [String(e && e.message || e).slice(0, 300), msgId]);
      return "failed";
    }
  } catch (e) { return "error"; }
}

/* ---------- reminders (scheduled handler) ---------- */
async function bkRunReminders(env, nowOverride) {
  await ensureBookingsMsgSchema(env);
  // BK_TEST_NOW ('YYYY-MM-DD HH:MM') lets tests run the job at a chosen local time.
  const tn = /^(\d{4}-\d{2}-\d{2}) (\d{2}):(\d{2})$/.exec(String((env && env.BK_TEST_NOW) || ""));
  const now = nowOverride || (tn ? { date: tn[1], min: Number(tn[2]) * 60 + Number(tn[3]) } : bkNowLocal(env));
  const tomorrow = bkAddDays(now.date, 1);
  let sent = 0;
  // Every pharmacy with emails on that can actually send: a key in the old single slot or any working sender
  // (the senders list is how pharmacies set email up now; the old filter on api_key_enc skipped them all).
  const sets = await dbAll(env, `SELECT * FROM bk_settings WHERE provider<>'off'`, []);
  for (const s of sets) {
    if (!(await bkCanSend(env, s))) continue;
    const rows = [];
    if (s.remind_evening && now.min >= 18 * 60) {
      for (const b of await dbAll(env, `SELECT * FROM bk_bookings WHERE org_id=? AND location_id=? AND date=? AND status IN ('booked','confirmed') AND person_email<>''`, [s.org_id, s.location_id, tomorrow])) rows.push([b, "remind_evening"]);
    }
    if (s.remind_hours > 0) {
      const hi = now.min + s.remind_hours * 60;
      for (const b of await dbAll(env, `SELECT * FROM bk_bookings WHERE org_id=? AND location_id=? AND date=? AND status IN ('booked','confirmed') AND person_email<>''`, [s.org_id, s.location_id, now.date])) {
        const m = bkMin(b.start_time);
        // In the window, and not booked in the last 30 minutes (they just got a confirmation).
        if (m > now.min && m <= hi && (Date.now() - Date.parse(String(b.created_at).replace(" ", "T") + "Z")) > 30 * 60000) rows.push([b, "remind_hours"]);
      }
    }
    for (const [b, kind] of rows) if ((await bkNotify(env, null, b, kind)) === "sent") sent++;
  }
  return sent;
}

/* ---------- staff routes: settings + test ---------- */
// Where a test message goes. The sign-in email can be a made-up address that a stranger owns, so the admin may type
// another one; to keep the pharmacy's sender from becoming a way to mail anyone, at most five tests a day go to an
// address other than the sign-in email (fixed wording, admin only). Anything that is not an email: the sign-in email.
async function bkTestTo(request, authUser, env) {
  const own = String(authUser.email || "");
  let b = null; try { b = await readJson(request); } catch (e) { b = null; }
  const want = String((b && b.to) || "").trim();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(want) || want.length > 254 || want.toLowerCase() === own.toLowerCase()) return { to: own };
  const org = authUser.org_id, loc = authUser.location_id, day = bkNowLocal(env).date;
  const row = await dbFirst(env, `SELECT test_day, test_count FROM bk_settings WHERE org_id=? AND location_id=?`, [org, loc]);
  if (!row) return { to: own };
  const n = row.test_day === day ? (Number(row.test_count) || 0) : 0;
  if (n >= 5) return { error: "Five tests a day can go to another address, and today's are used. Try tomorrow, or send it to your sign-in email." };
  await dbRun(env, `UPDATE bk_settings SET test_day=?, test_count=? WHERE org_id=? AND location_id=?`, [day, n + 1, org, loc]);
  return { to: want };
}
async function handleBookingsSettings(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin"])) return jsonResponse({ ok: false, error: "Only an admin can change messages" }, 403, corsOkHeaders);
  await ensureBookingsMsgSchema(env);
  const org = authUser.org_id, loc = authUser.location_id;
  if (request.method === "GET") return jsonResponse({ ok: true, settings: bkSettingsOut(await bkGetSettings(env, org, loc), env) }, 200, corsOkHeaders);
  if (request.method === "PUT") {
    const b = await readJson(request) || {};
    const cur = await bkGetSettings(env, org, loc);
    await bkSenders(env, org, loc, cur); // an older single-provider set-up becomes a sender before anything changes, so it is never lost
    const provider = ["off", "on", "resend", "brevo", "smtp"].includes(b.provider) ? b.provider : cur.provider;
    if (provider === "smtp") {
      const host = b.smtpHost !== undefined ? String(b.smtpHost).trim().toLowerCase() : (cur.smtp_host || "");
      const port = b.smtpPort !== undefined ? Math.round(Number(b.smtpPort)) : (Number(cur.smtp_port) || 465);
      if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(host)) return jsonResponse({ ok: false, error: "Type the mail server, e.g. smtp.yourprovider.com" }, 400, corsOkHeaders);
      if (port === 25) return jsonResponse({ ok: false, error: "Port 25 is blocked for sending; use 465 (SSL) or 587 (STARTTLS)" }, 400, corsOkHeaders);
      if (!(port > 0 && port < 65536)) return jsonResponse({ ok: false, error: "Invalid port" }, 400, corsOkHeaders);
    }
    const fromEmail = b.fromEmail !== undefined ? String(b.fromEmail).trim().toLowerCase() : cur.from_email;
    if (provider !== "off" && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(fromEmail)) return jsonResponse({ ok: false, error: "A valid sender email is required" }, 400, corsOkHeaders);
    let enc = cur.api_key_enc;
    if (b.apiKey !== undefined) {
      const k = String(b.apiKey).trim();
      if (k && String(env.BOOKINGS_KEY || "").length < 16) return jsonResponse({ ok: false, error: "Messages need the BOOKINGS_KEY secret set on the server" }, 400, corsOkHeaders);
      enc = k ? await bkEncrypt(env, k) : "";
    }
    const hrs = Math.max(0, Math.min(24, Math.round(Number(b.remindHours ?? cur.remind_hours) || 0)));
    const cut = Math.max(0, Math.min(2880, Math.round(Number(b.cancelCutoffMin ?? cur.cancel_cutoff_min) || 0)));
    await dbRun(env, `INSERT INTO bk_settings (org_id, location_id, provider, from_name, from_email, reply_to, api_key_enc, remind_evening, remind_hours, cancel_cutoff_min, address, phone, updated_at)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,datetime('now'))
      ON CONFLICT(org_id, location_id) DO UPDATE SET provider=excluded.provider, from_name=excluded.from_name, from_email=excluded.from_email, reply_to=excluded.reply_to,
        api_key_enc=excluded.api_key_enc, remind_evening=excluded.remind_evening, remind_hours=excluded.remind_hours, cancel_cutoff_min=excluded.cancel_cutoff_min,
        address=excluded.address, phone=excluded.phone, updated_at=datetime('now')`,
      [org, loc, provider, b.fromName !== undefined ? String(b.fromName).trim() : cur.from_name, fromEmail, b.replyTo !== undefined ? String(b.replyTo).trim() : cur.reply_to, enc,
        b.remindEvening === undefined ? cur.remind_evening : (b.remindEvening ? 1 : 0), hrs, cut,
        b.address !== undefined ? String(b.address).trim() : cur.address, b.phone !== undefined ? String(b.phone).trim() : cur.phone]);
    if (provider === "smtp" || b.smtpHost !== undefined) {
      await dbRun(env, `UPDATE bk_settings SET smtp_host=?, smtp_port=?, smtp_user=?, smtp_secure=? WHERE org_id=? AND location_id=?`,
        [b.smtpHost !== undefined ? String(b.smtpHost).trim().toLowerCase() : (cur.smtp_host || ""), b.smtpPort !== undefined ? Math.round(Number(b.smtpPort)) : (Number(cur.smtp_port) || 465),
         b.smtpUser !== undefined ? String(b.smtpUser).trim() : (cur.smtp_user || ""), b.smtpSecure === "starttls" ? "starttls" : (b.smtpSecure === "tls" ? "tls" : (cur.smtp_secure || "tls")), org, loc]);
    }
    if (b.publicSlug !== undefined) {
      const want = String(b.publicSlug || "").trim();
      if (!/^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$/.test(want) || /--/.test(want)) return jsonResponse({ ok: false, error: "Use 3 to 40 small letters, numbers and dashes, e.g. borg-pharmacy-sliema" }, 400, corsOkHeaders);
      if (BK_RESERVED_SLUGS.includes(want)) return jsonResponse({ ok: false, error: "That address is reserved. Try your pharmacy's name." }, 400, corsOkHeaders);
      if (await dbFirst(env, `SELECT 1 AS x FROM bk_settings WHERE public_slug=? AND NOT (org_id=? AND location_id=?)`, [want, org, loc])) return jsonResponse({ ok: false, error: "Another pharmacy already uses that address" }, 409, corsOkHeaders);
      await dbRun(env, `UPDATE bk_settings SET public_slug=?, updated_at=datetime('now') WHERE org_id=? AND location_id=?`, [want, org, loc]);
    }
    if (b.publicEnabled !== undefined) {
      const want = !!b.publicEnabled;
      const fresh = await bkGetSettings(env, org, loc);
      if (want && !(await bkCanSend(env, fresh))) return jsonResponse({ ok: false, error: "Switch on emails first: online booking confirms each customer with an emailed code" }, 400, corsOkHeaders);
      let slug = fresh.public_slug;
      if (want && !slug) {
        // A clean address from the pharmacy's name; a number only if another pharmacy already has it.
        const base = String(authUser.location_name || "pharmacy").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 36) || "pharmacy";
        slug = BK_RESERVED_SLUGS.includes(base) || base.length < 3 ? base + "-pharmacy" : base;
        for (let i = 2; await dbFirst(env, `SELECT 1 AS x FROM bk_settings WHERE public_slug=? AND NOT (org_id=? AND location_id=?)`, [slug, org, loc]); i++) slug = base + "-" + i;
      }
      await dbRun(env, `UPDATE bk_settings SET public_enabled=?, public_slug=?, updated_at=datetime('now') WHERE org_id=? AND location_id=?`, [want ? 1 : 0, slug || "", org, loc]);
    }
    await bkSyncLegacySender(env, org, loc);
    await writeAudit(env, org, authUser.user_id, "BK_SETTINGS_UPDATE", "bk_settings", String(loc), { provider, from_email: fromEmail, key_changed: b.apiKey !== undefined, public_enabled: b.publicEnabled }, loc);
    return jsonResponse({ ok: true, settings: bkSettingsOut(await bkGetSettings(env, org, loc), env) }, 200, corsOkHeaders);
  }
  if (request.method === "POST" && /\/test$/.test(url.pathname)) {
    const s = await bkGetSettings(env, org, loc);
    if (!(await bkCanSend(env, s))) return jsonResponse({ ok: false, error: "Add a sender and switch emails on first" }, 400, corsOkHeaders);
    const tt = await bkTestTo(request, authUser, env); if (tt.error) return jsonResponse({ ok: false, error: tt.error }, 429, corsOkHeaders);
    const to = tt.to;
    try {
      await bkSendEmail(env, s, { to, toName: authUser.full_name, subject: "Eikon test message", html: bkEmailHtml({ title: "It works", lines: ["Booking emails from Eikon will look like this."], pharmacy: authUser.location_name || "", address: s.address, phone: s.phone }) });
      return jsonResponse({ ok: true, sentTo: to }, 200, corsOkHeaders);
    } catch (e) { return jsonResponse({ ok: false, error: String(e && e.message || e) }, 502, corsOkHeaders); }
  }
  return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
}

