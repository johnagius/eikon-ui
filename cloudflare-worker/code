    clean: q("cleaning", (ph) => `SELECT location_id, entry_date FROM cleaning_entries WHERE org_id = ? AND location_id IN (${ph}) AND entry_date >= ? AND entry_date <= ?`, [ymdPlusDays(from, -7), to]),
