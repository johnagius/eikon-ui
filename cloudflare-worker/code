async function readJson(request) {
  const ct = request.headers.get("Content-Type") || "";
  // Be tolerant of missing/incorrect Content-Type (some clients omit it). Still log loudly for debugging.
  if (!ct.toLowerCase().includes("application/json")) {
    try {
      const txt = await request.clone().text();
      try {
        const obj = JSON.parse(txt || "{}");
        console.warn("[shifts][readJson] Non-JSON Content-Type:", ct, " — body still parsed as JSON.");
        return obj;
      } catch (pe) {
        console.error("[shifts][readJson] Failed to parse JSON. Content-Type:", ct, "Body preview:", (txt || "").slice(0, 400));
        throw new Error("Expected application/json (got " + ct + ")");
      }
    } catch (e) {
      console.error("[shifts][readJson] Failed reading request body. Content-Type:", ct, e);
      throw new Error("Expected application/json (got " + ct + ")");
    }
  }
  return await request.json();
}

async function dbFirst(env, sql, bind = []) {
  const stmt = env.DB.prepare(sql);
  const res = bind.length ? await stmt.bind(...bind).first() : await stmt.first();
  return res || null;
}

async function dbAll(env, sql, bind = []) {
  const stmt = env.DB.prepare(sql);
  const res = bind.length ? await stmt.bind(...bind).all() : await stmt.all();
  return res.results || [];
}

// Runs "... IN (?,?,...)" queries in batches: D1 refuses more than 100 bound parameters,
// so a list of ids is split into chunks of 90. makeSql(placeholders) returns the SQL.
async function dbAllChunked(env, makeSql, ids, before = [], after = [], size = 90) {
  const out = [];
  for (let i = 0; i < ids.length; i += size) {
    const chunk = ids.slice(i, i + size);
    const rows = await dbAll(env, makeSql(chunk.map(() => "?").join(",")), [...before, ...chunk, ...after]);
    if (rows) out.push(...rows);
  }
  return out;
}

async function dbRun(env, sql, bind = []) {
  const stmt = env.DB.prepare(sql);
  const res = bind.length ? await stmt.bind(...bind).run() : await stmt.run();
  return res;
}

// Audit rows: never fail the user's action, keep details_json under ~10 KB, and name the pharmacy (location_id)
// for new rows. Older rows keep location_id NULL and stay visible org-wide, as before.
const AUDIT_MAX_BYTES = 10000;
const __auditEnc = new TextEncoder();
function auditBytes(s) { return __auditEnc.encode(s).length; }
// Shrinks the longest text values (EOD and POCT JSON blobs, long notes) until the whole record fits, marking each cut.
function auditDetailsJson(detailsObj) {
  let json;
  try { json = JSON.stringify(detailsObj || {}); } catch (e) { return JSON.stringify({ truncated: true, note: "details could not be serialised" }); }
  if (auditBytes(json) <= AUDIT_MAX_BYTES) return json;
  let obj;
  try { obj = JSON.parse(json); } catch (e) { obj = {}; }
  const leaves = [];
  (function walk(o) {
    if (!o || typeof o !== "object") return;
    for (const k of Object.keys(o)) {
      const v = o[k];
      if (typeof v === "string") leaves.push({ o, k, len: v.length });
      else if (v && typeof v === "object") walk(v);
    }
  })(obj);
  leaves.sort((a, b) => b.len - a.len);
  const cut = [];
  for (const leaf of leaves) {
    if (leaf.len <= 300) break;
    const v = leaf.o[leaf.k];
    leaf.o[leaf.k] = v.slice(0, 300) + "…[truncated " + (v.length - 300) + " chars]";
    cut.push(leaf.k);
    obj.truncated = true;
    obj.truncated_fields = cut.slice(0, 50);
    json = JSON.stringify(obj);
    if (auditBytes(json) <= AUDIT_MAX_BYTES) return json;
  }
  // Still too big (very many fields): keep the identifying keys only.
  const keep = { truncated: true, note: "details over " + AUDIT_MAX_BYTES + " bytes; only identifying fields kept" };
  for (const k of Object.keys(obj)) {
    const v = obj[k];
    if (v === null || typeof v === "number" || typeof v === "boolean" || (typeof v === "string" && v.length <= 300)) keep[k] = v;
  }
  for (const side of ["before", "after"]) {
    const r = obj[side];
    if (r && typeof r === "object" && !Array.isArray(r)) {
      keep[side] = {};
      for (const k of Object.keys(r)) { const v = r[k]; if (v === null || typeof v === "number" || typeof v === "boolean" || (typeof v === "string" && v.length <= 300)) keep[side][k] = v; }
    }
  }
  json = JSON.stringify(keep);
  return auditBytes(json) <= AUDIT_MAX_BYTES ? json : JSON.stringify({ truncated: true, note: keep.note });
}

async function ensureAuditSchema__impl(env) {
  // Nullable, added once; no existing row is touched (an ADD COLUMN without a default leaves old rows NULL).
  try { await dbRun(env, "ALTER TABLE audit_log ADD COLUMN location_id INTEGER", []); } catch (e) { /* column may already exist */ }
  // The Audit trail reads newest-first inside a date range (30 days by default): without this every page and its
  // total read the whole group's history (SCALE-2: 1.2M rows per page at 600k audit rows). The filter columns ride
  // along so a page with a filter and no dates checks them in the index, not row by row. Additive; no row changes.
  try { await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_audit_log_org_created ON audit_log (org_id, created_at, location_id, entity_type, action)", []); } catch (e) {}
}

async function writeAudit(env, orgId, userId, action, entityType, entityId, detailsObj, locationId) {
  try {
    const detailsJson = auditDetailsJson(detailsObj);
    let loc = locationId;
    if ((loc === undefined || loc === null) && detailsObj && typeof detailsObj === "object") loc = detailsObj.location_id;
    loc = Number.isInteger(Number(loc)) && Number(loc) > 0 ? Number(loc) : null;
    try { await ensureAuditSchema(env); } catch (e) {}
    try {
      await dbRun(
        env,
        `INSERT INTO audit_log (org_id, user_id, action, entity_type, entity_id, details_json, created_at, location_id)
         VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?)`,
        [orgId, userId || null, action, entityType, entityId || "", detailsJson, loc]
      );
    } catch (e) {
      // No location_id column (the ALTER could not run): write the row the old way.
      await dbRun(
        env,
        `INSERT INTO audit_log (org_id, user_id, action, entity_type, entity_id, details_json, created_at)
         VALUES (?, ?, ?, ?, ?, ?, datetime('now'))`,
        [orgId, userId || null, action, entityType, entityId || "", detailsJson]
      );
    }
  } catch (e) {
    // An audit write must never fail the user's action.
    try { console.log("[audit] write failed", action, e && e.message); } catch (e2) {}
  }
}

// The whole row as it stands, for details.before / details.after. Read by its primary key inside the caller's org AND
// pharmacy, the same scope the handler writes in; pass { group: true } only where the handler is deliberately
// group-wide (quotations; credit-note uses and notes, whose pharmacy is checked through their credit note).
// null when it cannot be read: a snapshot never blocks the action.
async function auditSnap(env, table, id, authUser, opts) {
  try {
    if (id === undefined || id === null || id === "") return null;
    const col = (opts && opts.key) || "id";
    if (!authUser || authUser.org_id == null) return await dbFirst(env, `SELECT * FROM ${table} WHERE ${col} = ?`, [id]);
    if (authUser.location_id != null && !(opts && opts.group)) {
      return await dbFirst(env, `SELECT * FROM ${table} WHERE ${col} = ? AND org_id = ? AND location_id = ?`, [id, authUser.org_id, authUser.location_id]);
    }
    return await dbFirst(env, `SELECT * FROM ${table} WHERE ${col} = ? AND org_id = ?`, [id, authUser.org_id]);
  } catch (e) { return null; }
}
async function auditSnapAll(env, table, col, id, authUser) {
  try { return await dbAll(env, `SELECT * FROM ${table} WHERE ${col} = ? AND org_id = ? ORDER BY id`, [id, authUser.org_id]); } catch (e) { return null; }
}
// Adds before/after to a handler's existing detail keys (kept, so the Audit trail still reads them).
function auditWith(details, before, after) {
  const o = (details && typeof details === "object" && !Array.isArray(details)) ? Object.assign({}, details) : {};
  if (before !== undefined) o.before = before;
  if (after !== undefined) o.after = after;
  return o;
}

// ===== Register corrections (2026-11-03): the reason a line was corrected travels into that update's audit entry. =====
// The new layout's "Correct" sends the whole record plus correction_reason. Nothing is stored on the register row (its
// columns and its printout are unchanged): the reason is one more key of the audit entry's details, next to before/after.
// A body without the field (the classic screens, older apps) gives the same audit entry as before. Max 500 characters.
function auditCorrection(body, details) {
  const raw = body && typeof body === "object" ? body.correction_reason : undefined;
  const reason = raw == null ? "" : String(raw).replace(/\s+/g, " ").trim().slice(0, 500);
  if (!reason) return details;
  return Object.assign({}, details && typeof details === "object" ? details : {}, { correction_reason: reason });
}
// ===== end register corrections =====

function requireRole(user, roles) {
  return user && roles.includes(user.role);
}

async function authFromRequest(request, env) {
  const auth = request.headers.get("Authorization") || "";
  const m = auth.match(/^Bearer\s+(.+)$/i);
  if (!m) return null;

  const token = m[1].trim();
  if (!token) return null;

  const tokenHashB64 = await sha256B64FromString(token);

  const SESS_SQL = (extra) => `SELECT
       s.id AS session_id,
       s.user_id,
       s.expires_at,
       u.org_id,
       u.email,
       u.full_name,
       u.role,
       u.is_active,
       u.default_location_id${extra}
     FROM sessions s
     JOIN users u ON u.id = s.user_id
     WHERE s.token_hash_b64 = ?`;
  // Team sign-ins (backlog 2 item 4): must_change_password is read in the same query. A database that does not have
  // the column yet (before the first /team call) answers with the query as it always was: nobody is affected.
  let sess;
  try { sess = await dbFirst(env, SESS_SQL(",\n       u.must_change_password"), [tokenHashB64]); }
  catch (e) {
    sess = await dbFirst(env, SESS_SQL(""), [tokenHashB64]);
    try { await ensureTeamSchema(env); } catch (e2) {} // adds the column once (default 0), so the next request needs one query again
  }

  if (!sess) return null;
  if (sess.is_active !== 1) return null;

  const now = new Date();
  const exp = new Date(sess.expires_at);
  if (!(exp > now)) return null;

  const locId = sess.default_location_id ? Number(sess.default_location_id) : null;
  if (!locId) return null;

  const loc = await dbFirst(env, "SELECT id, name FROM locations WHERE id = ? AND org_id = ?", [locId, sess.org_id]);
  if (!loc) return null;

  const org = await dbFirst(env, "SELECT id, name FROM orgs WHERE id = ?", [sess.org_id]);

  const out = {
    session_id: sess.session_id,
    user_id: sess.user_id,
    org_id: sess.org_id,
    org_name: org ? org.name : "",
    email: sess.email,
    full_name: sess.full_name,
    role: sess.role,
    location_id: loc.id,
    location_name: loc.name
  };
  if (Number(sess.must_change_password) === 1) out.must_change = true; // only ever set for a sign-in made or reset on /team
  if (demoIsOrg(env, out.org_id)) out.demo = true; // a session of the one-click demo's group (never when the demo is off)
  return out;
}

