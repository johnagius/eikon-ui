const STOCK_FLOW_SOURCES = ["order", "alert", "need"];
function stockFlowIds(v) {
  const out = [];
  (Array.isArray(v) ? v : []).forEach((x) => { const n = parseInt(x, 10); if (n > 0 && out.indexOf(n) < 0) out.push(n); });
  return out.slice(0, 500);
}
// The ids among `ids` that are order diary lines of this pharmacy.
async function stockFlowOwnDiary(env, authUser, ids) {
  if (!ids.length) return [];
  const rows = await dbAll(env, `SELECT id FROM order_diary_entries WHERE org_id = ? AND location_id = ? AND id IN (${ids.map(() => "?").join(",")})`, [authUser.org_id, authUser.location_id, ...ids]);
  return (rows || []).map((r) => r.id);
}

// GET /stock-flow/open?from=YYYY-MM-DD — every diary line from that day on that is still open (waiting, not received,
// wrong pick) and has not been carried forward to a later day, plus the lines received recently (for "who to tell"),
// with each line's ordered mark and links. Read only.
async function handleStockFlowOpen(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureOrderDiarySchema(env);
  await ensureStockFlowSchema(env);
  let from = String(url.searchParams.get("from") || "").trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(from)) from = new Date(Date.now() - 60 * 864e5).toISOString().slice(0, 10);
  const loc = [authUser.org_id, authUser.location_id];
  const rows = await dbAll(env, `SELECT * FROM order_diary_entries WHERE org_id = ? AND location_id = ? AND order_date >= ? ORDER BY order_date, id`, [...loc, from]) || [];
  const carriedOn = new Set(rows.filter((r) => r.carried_from_id).map((r) => Number(r.carried_from_id)));
  const byId = new Map(rows.map((r) => [r.id, r]));
  const marks = await dbAll(env, `SELECT m.diary_id, m.supplier, m.ordered_at, m.ordered_by, u.full_name AS ordered_by_name FROM stock_flow_ordered m LEFT JOIN users u ON u.id = m.ordered_by
    WHERE m.org_id = ? AND m.location_id = ? AND m.diary_id IN (SELECT id FROM order_diary_entries WHERE org_id = ? AND location_id = ? AND order_date >= ?)`, [...loc, ...loc, from]) || [];
  const markOf = new Map(marks.map((m) => [Number(m.diary_id), m]));
  const links = await dbAll(env, `SELECT diary_id, source, source_id FROM stock_flow_links WHERE org_id = ? AND location_id = ? AND diary_id IN (SELECT id FROM order_diary_entries WHERE org_id = ? AND location_id = ? AND order_date >= ?)`, [...loc, ...loc, from]) || [];
  const linksOf = new Map();
  links.forEach((l) => { const k = Number(l.diary_id); if (!linksOf.has(k)) linksOf.set(k, []); linksOf.get(k).push({ source: l.source, source_id: l.source_id }); });
  // A line carried forward keeps what its earlier day knew: the ordered mark (while it is still waiting) and the links.
  const inherit = (r, pick) => { let cur = r, n = 0; while (cur && n++ < 30) { const v = pick(Number(cur.id)); if (v) return v; cur = cur.carried_from_id ? byId.get(Number(cur.carried_from_id)) : null; } return null; };
  const recentFrom = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 19).replace("T", " ");
  const open = [], received = [];
  for (const r of rows) {
    const isOpen = ["pending", "not_received", "wrong_pick"].includes(r.status) && !carriedOn.has(Number(r.id));
    const isRecent = r.status === "received" && String(r.updated_at || "") >= recentFrom;
    if (!isOpen && !isRecent) continue;
    const mark = inherit(r, (id) => markOf.get(id));
    const lk = []; let cur = r, n = 0; while (cur && n++ < 30) { (linksOf.get(Number(cur.id)) || []).forEach((l) => { if (!lk.some((x) => x.source === l.source && x.source_id === l.source_id)) lk.push(l); }); cur = cur.carried_from_id ? byId.get(Number(cur.carried_from_id)) : null; }
    let first = r, fn = 0; while (first.carried_from_id && byId.get(Number(first.carried_from_id)) && fn++ < 30) first = byId.get(Number(first.carried_from_id));
    const line = { ...r, first_date: first.order_date, ordered_at: mark ? mark.ordered_at : null, ordered_by_name: mark ? (mark.ordered_by_name || "") : "", ordered_supplier: mark ? mark.supplier : "", links: lk };
    (isOpen ? open : received).push(line);
  }
  return jsonResponse({ ok: true, from, open, received }, 200, corsOkHeaders);
}

// POST /stock-flow/ordered { diary_ids: [..], supplier } — these lines were ordered from the supplier now.
// POST /stock-flow/ordered/undo { diary_ids: [..] } — take the mark off again. Lines of another pharmacy are ignored.
async function handleStockFlowOrdered(request, env, corsOkHeaders, authUser, undo) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureOrderDiarySchema(env);
  await ensureStockFlowSchema(env);
  const body = await readJson(request);
  const ids = await stockFlowOwnDiary(env, authUser, stockFlowIds(body && body.diary_ids));
  if (!ids.length) return jsonResponse({ ok: false, error: "No order diary lines of this pharmacy were given" }, 400, corsOkHeaders);
  const supplier = String((body && body.supplier) || "").trim().slice(0, 200);
  let n = 0;
  for (const id of ids) {
    if (undo) { const r = await dbRun(env, `DELETE FROM stock_flow_ordered WHERE org_id = ? AND location_id = ? AND diary_id = ?`, [authUser.org_id, authUser.location_id, id]); n += Number((r && r.meta && r.meta.changes) || 0); }
    else {
      const r = await dbRun(env, `INSERT INTO stock_flow_ordered (org_id, location_id, diary_id, supplier, ordered_by, ordered_at) VALUES (?, ?, ?, ?, ?, datetime('now'))
        ON CONFLICT(org_id, location_id, diary_id) DO UPDATE SET supplier = excluded.supplier, ordered_by = excluded.ordered_by, ordered_at = excluded.ordered_at`, [authUser.org_id, authUser.location_id, id, supplier, authUser.user_id]);
      n += Number((r && r.meta && r.meta.changes) || 0);
    }
  }
  await writeAudit(env, authUser.org_id, authUser.user_id, undo ? "STOCK_FLOW_ORDERED_UNDO" : "STOCK_FLOW_ORDERED", "stock_flow_ordered", ids.join(","), { diary_ids: ids, supplier }, authUser.location_id);
  return jsonResponse({ ok: true, marked: undo ? 0 : ids.length, cleared: undo ? n : 0, diary_ids: ids }, 200, corsOkHeaders);
}

// POST /stock-flow/links { diary_id, source: "order"|"alert"|"need", source_id } — this diary line is for that customer
// order, recall or shortage. Both ends must belong to this pharmacy.
async function handleStockFlowLink(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureOrderDiarySchema(env);
  await ensureStockFlowSchema(env);
  const body = await readJson(request) || {};
  const diaryId = parseInt(body.diary_id, 10), sourceId = parseInt(body.source_id, 10), source = String(body.source || "");
  if (!(diaryId > 0) || !(sourceId > 0) || STOCK_FLOW_SOURCES.indexOf(source) < 0) return jsonResponse({ ok: false, error: "diary_id, source (order, alert or need) and source_id are required" }, 400, corsOkHeaders);
  if (!(await stockFlowOwnDiary(env, authUser, [diaryId])).length) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  let own = null;
  if (source === "order") { await ensureClientOrdersSchema(env); own = await dbFirst(env, `SELECT id FROM client_orders_entries WHERE org_id = ? AND location_id = ? AND id = ?`, [authUser.org_id, authUser.location_id, sourceId]); }
  else if (source === "alert") { await ensureAlertsSchema(env); own = await dbFirst(env, `SELECT id FROM alerts_entries WHERE org_id = ? AND location_id = ? AND id = ?`, [authUser.org_id, authUser.location_id, sourceId]); }
  else { await ensureScarceStockSchema(env); own = await dbFirst(env, `SELECT id FROM scarce_stock_needs WHERE org_id = ? AND location_id = ? AND id = ?`, [authUser.org_id, authUser.location_id, sourceId]); }
  if (!own) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  await dbRun(env, `INSERT OR IGNORE INTO stock_flow_links (org_id, location_id, diary_id, source, source_id, created_by) VALUES (?, ?, ?, ?, ?, ?)`, [authUser.org_id, authUser.location_id, diaryId, source, sourceId, authUser.user_id]);
  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_FLOW_LINK", "stock_flow_links", String(diaryId), { diary_id: diaryId, source, source_id: sourceId }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}
