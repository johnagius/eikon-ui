    status TEXT NOT NULL DEFAULT 'done', rows_changed INTEGER NOT NULL DEFAULT 0, summary_json TEXT NOT NULL DEFAULT '{}',
    reason TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT (datetime('now')), created_by INTEGER,
    undo_until TEXT NOT NULL, undone_at TEXT, undone_by INTEGER, purged_at TEXT)`, []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_gdpr_erasures_person ON gdpr_erasures (org_id, location_id, person_id, created_at)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_gdpr_erasures_due ON gdpr_erasures (undo_until) WHERE purged_at IS NULL", []);
  // The values an erase replaced, kept only for the undo window, then deleted (gdprPurgeExpired).
  await dbRun(env, `CREATE TABLE IF NOT EXISTS gdpr_erasure_rows (
    id INTEGER PRIMARY KEY AUTOINCREMENT, erasure_id TEXT NOT NULL, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
    table_name TEXT NOT NULL, row_id INTEGER NOT NULL, column_name TEXT NOT NULL, old_value, new_value)`, []);
