  }
  await ensureLabelsSchema(env);
  const orgId = authUser.org_id;
  const locId = authUser.location_id;

  // Get label history
  const rows = await dbAll(env,
    `SELECT label_json FROM label_history WHERE org_id = ? AND location_id = ? ORDER BY updated_at DESC, id DESC`,
    [orgId, locId]);
  const labelHistory = [];
  for (const row of rows) {
    try { const v = JSON.parse(String(row.label_json)); if (v) labelHistory.push(v); } catch (e) {}
  }

  // Get settings (templates + pharmacy details)
  const settingsRow = await dbFirst(env,
    `SELECT settings_json FROM label_settings WHERE org_id = ? AND location_id = ?`,
    [orgId, locId]);
  let templates = [];
  let pharmacyDetails = {};
  if (settingsRow) {
    try {
      const s = JSON.parse(String(settingsRow.settings_json));
      if (s.templates) templates = s.templates;
      if (s.pharmacyDetails) pharmacyDetails = s.pharmacyDetails;
    } catch (e) {}
  }

  return jsonResponse({ ok: true, state: { labelHistory, templates, pharmacyDetails } }, 200, corsOkHeaders);
}

async function handleLabelsStatePut(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }
  await ensureLabelsSchema(env);
  const body = await readJson(request);
  const st = body && (body.state || body.data) ? (body.state || body.data) : body;
  const orgId = authUser.org_id;
  const locId = authUser.location_id;
  const userId = authUser.user_id;

  // Save label history
  const historyIn = st && st.labelHistory ? st.labelHistory : [];
  const history = Array.isArray(historyIn) ? historyIn : [];

  const idSet = new Set();
  const cleaned = [];
  for (const l of history) {
    const lid = l && l.id ? String(l.id).trim() : "";
    if (!lid) continue;
    if (!idSet.has(lid)) { idSet.add(lid); cleaned.push(l); }
  }

  // The classic screen sends the whole history on every save. Only rows that are new or
  // whose JSON differs from what is stored are written (one read to compare), several rows
  // per statement (6 bound values each, under D1's 100) and many statements per batch, so a
  // save costs a handful of queries instead of one per label ever printed.
  const storedJson = new Map();
  for (const r of await dbAll(env, `SELECT label_id, label_json FROM label_history WHERE org_id = ? AND location_id = ?`, [orgId, locId])) {
    storedJson.set(String(r.label_id), String(r.label_json));
  }
  const toWrite = [];
  for (const l of cleaned) {
    const j = JSON.stringify(l);
    if (storedJson.get(String(l.id)) !== j) toWrite.push([String(l.id), j]);
  }
  const LB_ROWS = 16, LB_STMTS = 50;
  const lbStmts = [];
  for (let i = 0; i < toWrite.length; i += LB_ROWS) {
    const part = toWrite.slice(i, i + LB_ROWS);
    const binds = [];
    for (const [lid, j] of part) binds.push(orgId, locId, lid, j, userId, userId);
    lbStmts.push(env.DB.prepare(`INSERT INTO label_history (org_id, location_id, label_id, label_json, created_by, updated_by, updated_at)
    VALUES ${part.map(() => "(?,?,?,?,?,?, datetime('now'))").join(",")}
    ON CONFLICT(org_id, location_id, label_id) DO UPDATE SET
      label_json = excluded.label_json, updated_by = excluded.updated_by, updated_at = datetime('now')`).bind(...binds));
  }
  for (let i = 0; i < lbStmts.length; i += LB_STMTS) await env.DB.batch(lbStmts.slice(i, i + LB_STMTS));

  // Label history is an audit trail: nothing is ever deleted by omission. Explicit
  // deletes (deleted_ids) are honoured for the rare correction.
  const lbDeleted = poctExplicitIds(st && (st.deleted_ids || st.deletedIds));
  for (const did of lbDeleted) {
    await dbRun(env, `DELETE FROM label_history WHERE org_id = ? AND location_id = ? AND label_id = ?`, [orgId, locId, did]);
  }

  // Save settings (templates + pharmacy details)
  const settingsJson = JSON.stringify({
    templates: st && st.templates ? st.templates : [],
    pharmacyDetails: st && st.pharmacyDetails ? st.pharmacyDetails : {}
  });
  await dbRun(env, `INSERT INTO label_settings (org_id, location_id, settings_json, updated_by, updated_at)
    VALUES (?,?,?,?, datetime('now'))
    ON CONFLICT(org_id, location_id) DO UPDATE SET
      settings_json = excluded.settings_json, updated_by = excluded.updated_by, updated_at = datetime('now')`,
    [orgId, locId, settingsJson, userId]);

  await writeAudit(env, orgId, userId, "LABELS_STATE_PUT", "label_history", "", { historyCount: cleaned.length, written: toWrite.length }, authUser.location_id);
  return jsonResponse({ ok: true, saved: cleaned.length }, 200, corsOkHeaders);
}

