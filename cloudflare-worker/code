      [String(body.scheduled_delivery_date).trim(), orderId]);
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_ORDER_UPDATE", "supplier_orders", String(orderId), { status: newStatus || order.status, before: order, after: await auditSnap(env, "supplier_orders", orderId, null) }, authUser.location_id);
