}
function bkRandomHex(bytes) { const a = crypto.getRandomValues(new Uint8Array(bytes)); return Array.from(a, (b) => b.toString(16).padStart(2, "0")).join(""); }
function bkRef() { const c = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"; const a = crypto.getRandomValues(new Uint8Array(6)); return "B-" + Array.from(a, (b) => c[b % c.length]).join(""); }

/* ---------- free slots ---------- */
async function bkLoadDay(env, org, loc, date, providerIds, excludeId) {
  if (!providerIds.length) return { exc: [], booked: [] };
  const ph = providerIds.map(() => "?").join(",");
  const exc = await dbAll(env, `SELECT provider_id, kind, start_time, end_time FROM bk_exceptions WHERE org_id=? AND location_id=? AND date=? AND provider_id IN (${ph})`, [org, loc, date, ...providerIds]);
  const booked = await dbAll(env,
    `SELECT b.provider_id, b.start_time, b.end_time, COALESCE(s.buffer_min,0) AS buffer_min
       FROM bk_bookings b LEFT JOIN bk_services s ON s.id=b.service_id
      WHERE b.org_id=? AND b.location_id=? AND b.date=? AND b.status<>'cancelled' AND b.id<>? AND b.provider_id IN (${ph})`,
    [org, loc, date, Number(excludeId) || 0, ...providerIds]);
  return { exc, booked };
}

// Pure: windows minus exceptions minus bookings → candidate start times for one provider.
function bkFreeStarts({ hours, date, exc, booked, durationMin, bufferMin, notBeforeMin }) {
  let wins = (hours[bkWeekday(date)] || []).map((w) => [bkMin(w[0]), bkMin(w[1])]);
  for (const e of exc) {
    if (e.kind === "extra") wins.push([bkMin(e.start_time), bkMin(e.end_time)]);
  }
  for (const e of exc) {
    if (e.kind !== "off") continue;
    if (!e.start_time) { wins = []; break; } // whole day off
    const a = bkMin(e.start_time), b = bkMin(e.end_time);
    const next = [];
    for (const [s, t] of wins) {
      if (b <= s || a >= t) { next.push([s, t]); continue; }
      if (a > s) next.push([s, a]);
      if (b < t) next.push([b, t]);
    }
    wins = next;
  }
  const busy = booked.map((b) => [bkMin(b.start_time), bkMin(b.end_time) + (Number(b.buffer_min) || 0)]);
  const step = durationMin + bufferMin;
  const out = [];
  wins.sort((x, y) => x[0] - y[0]);
  for (const [s, t] of wins) {
    for (let m = s; m + durationMin <= t; m += step) {
      if (m < notBeforeMin) continue;
      const end = m + durationMin + bufferMin;
      if (busy.some(([bs, be]) => m < be && end > bs)) continue;
      out.push(m);
    }
  }
  return Array.from(new Set(out)).sort((a, b) => a - b);
}

async function bkSlotsFor(env, org, loc, service, date, onlyProviderId, excludeId) {
  const now = bkNowLocal(env);
  if (date < now.date) return [];
  const pids = (service.providerIds || []).map(Number).filter((n) => !onlyProviderId || n === Number(onlyProviderId));
  if (!pids.length) return [];
  const provs = await dbAll(env, `SELECT * FROM bk_providers WHERE org_id=? AND location_id=? AND active=1 AND id IN (${pids.map(() => "?").join(",")})`, [org, loc, ...pids]);
  const { exc, booked } = await bkLoadDay(env, org, loc, date, provs.map((p) => p.id), excludeId);
  const notBefore = date === now.date ? now.min + 1 : 0;
  const slots = [];
  for (const p of provs) {
    const starts = bkFreeStarts({ hours: bkJson(p.hours_json, {}), date, exc: exc.filter((e) => e.provider_id === p.id),
      booked: booked.filter((b) => b.provider_id === p.id), durationMin: service.durationMin, bufferMin: service.bufferMin, notBeforeMin: notBefore });
    for (const m of starts) slots.push({ time: bkTime(m), providerId: p.id, providerName: p.name });
  }
  slots.sort((a, b) => (a.time < b.time ? -1 : a.time > b.time ? 1 : a.providerId - b.providerId));
  return slots;
}

async function bkNextSlots(env, org, loc, service, fromDate, count, days) {
  const out = [];
  for (let i = 0; i < days && out.length < count; i++) {
    const d = bkAddDays(fromDate, i);
    const s = await bkSlotsFor(env, org, loc, service, d, null);
    for (const x of s) { out.push({ date: d, ...x }); if (out.length >= count) break; }
  }
  return out;
}

async function bkGetService(env, org, loc, id) {
  const r = await dbFirst(env, `SELECT * FROM bk_services WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
  return r ? bkServiceRow(r) : null;
}

/* ---------- router ---------- */
async function handleBookings(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureBookingsSchema(env);
  const org = authUser.org_id, loc = authUser.location_id, me = authUser.user_id;
  const isAdmin = requireRole(authUser, ["admin"]);
  const parts = url.pathname.replace(/^\/bookings\/?/, "").split("/").filter(Boolean);
  const m = request.method;
  const ok = (data, status = 200) => jsonResponse({ ok: true, serverNow: bkNowLocal(env), ...data }, status, corsOkHeaders);
  const bad = (error, status = 400, extra = {}) => jsonResponse({ ok: false, error, ...extra }, status, corsOkHeaders);

  if (parts[0] === "settings") return await handleBookingsSettings(request, env, corsOkHeaders, authUser, url);

  // Email senders, tried in order (see bkSendEmail). Admin only; credentials are write-only.
  if (parts[0] === "senders") {
    if (!isAdmin) return bad("Only an admin can change how emails are sent", 403);
    await ensureBookingsMsgSchema(env);
    const settings = await bkGetSettings(env, org, loc);
    const out = (r) => { const st = bkSenderState(r, new Date().toISOString());
      return { id: r.id, kind: r.kind, label: r.label, position: r.position, enabled: !!r.enabled, fromName: r.from_name, fromEmail: r.from_email, hasKey: !!r.cred_enc,
        smtpHost: r.smtp_host, smtpPort: Number(r.smtp_port) || 465, smtpUser: r.smtp_user, smtpSecure: r.smtp_secure, dailyCap: Number(r.daily_cap) || 0, monthlyCap: Number(r.monthly_cap) || 0,
        usedToday: st.usedToday, usedThisMonth: st.usedMonth, status: st.status, restingUntil: st.restingUntil || "", lastError: r.last_error, lastOkAt: r.last_ok_at }; };
    const mine = async (id) => dbFirst(env, `SELECT * FROM bk_senders WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
    // Checks shared by add and edit; returns an error message or the cleaned fields.
    const clean = (b, cur) => {
      const kind = cur ? cur.kind : String(b.kind || "");
      if (!BK_SENDER_DEFAULTS[kind]) return "Choose Resend, Brevo or your own mail server";
      const f = {};
      if (b.label !== undefined) f.label = String(b.label).trim().slice(0, 40);
      if (b.fromName !== undefined) f.from_name = String(b.fromName).trim().slice(0, 80);
      if (b.fromEmail !== undefined) { f.from_email = String(b.fromEmail).trim().toLowerCase(); if (f.from_email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(f.from_email)) return "That sender email does not look right"; }
      for (const [k, col] of [["dailyCap", "daily_cap"], ["monthlyCap", "monthly_cap"]]) if (b[k] !== undefined) { const n = Math.round(Number(b[k])); if (!(n >= 0 && n <= 100000)) return "Limits are whole numbers"; f[col] = n; }
      if (b.enabled !== undefined) f.enabled = b.enabled ? 1 : 0;
      if (kind === "smtp") {
        const host = b.smtpHost !== undefined ? String(b.smtpHost).trim().toLowerCase() : (cur ? cur.smtp_host : "");
        const port = b.smtpPort !== undefined ? Math.round(Number(b.smtpPort)) : (cur ? Number(cur.smtp_port) : 465);
        if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(host)) return "Type the mail server, e.g. smtp.yourprovider.com";
        if (port === 25) return "Port 25 is blocked for sending; use 465 (SSL) or 587 (STARTTLS)";
        if (!(port > 0 && port < 65536)) return "Invalid port";
        f.smtp_host = host; f.smtp_port = port;
        if (b.smtpUser !== undefined) f.smtp_user = String(b.smtpUser).trim();
        if (b.smtpSecure !== undefined) f.smtp_secure = b.smtpSecure === "starttls" ? "starttls" : "tls";
      }
      return f;
    };
    const secretOf = (b) => { const k = String((b.apiKey !== undefined ? b.apiKey : b.password) || "").trim(); return k; };

    if (m === "GET" && parts.length === 1) {
      const rows = await bkSenders(env, org, loc, settings);
      return ok({ senders: rows.map(out), emailsOn: settings.provider !== "off", fromName: settings.from_name, fromEmail: settings.from_email, canStoreKeys: String(env.BOOKINGS_KEY || "").length >= 16 });
    }
    if (m === "POST" && parts.length === 1) {
      const b = await readJson(request) || {};
      const f = clean(b, null); if (typeof f === "string") return bad(f);
      const secret = secretOf(b); if (!secret) return bad(b.kind === "smtp" ? "Type the mail server password" : "Paste the API key");
      if (String(env.BOOKINGS_KEY || "").length < 16) return bad("Messages need the BOOKINGS_KEY secret set on the server");
      const d = BK_SENDER_DEFAULTS[b.kind];
      const last = await dbFirst(env, `SELECT MAX(position) AS p FROM bk_senders WHERE org_id=? AND location_id=?`, [org, loc]);
      await bkSenders(env, org, loc, settings); // an older single-provider set-up becomes the first sender before this one is added
      const r = await dbRun(env, `INSERT INTO bk_senders (org_id, location_id, kind, label, position, enabled, from_name, from_email, cred_enc, smtp_host, smtp_port, smtp_user, smtp_secure, daily_cap, monthly_cap)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
        [org, loc, b.kind, f.label || d.label, last && last.p != null ? Number(last.p) + 1 : 0, f.enabled === 0 ? 0 : 1, f.from_name || "", f.from_email || "", await bkEncrypt(env, secret),
         f.smtp_host || "", f.smtp_port || 465, f.smtp_user || "", f.smtp_secure || "tls", f.daily_cap !== undefined ? f.daily_cap : d.daily, f.monthly_cap !== undefined ? f.monthly_cap : d.monthly]);
      const id = r && r.meta && r.meta.last_row_id;
      await writeAudit(env, org, me, "BK_SENDER_ADD", "bk_senders", String(id), { kind: b.kind }, loc);
      return ok({ sender: out(await mine(id)) }, 201);
    }
    if (m === "POST" && parts[1] === "order") {
      const b = await readJson(request) || {};
      const ids = (Array.isArray(b.ids) ? b.ids : []).map(Number);
      const rows = await dbAll(env, `SELECT id FROM bk_senders WHERE org_id=? AND location_id=?`, [org, loc]);
      if (ids.length !== rows.length || !rows.every((r) => ids.includes(r.id))) return bad("Send every sender once, in the new order");
      for (let i = 0; i < ids.length; i++) await dbRun(env, `UPDATE bk_senders SET position=? WHERE id=? AND org_id=? AND location_id=?`, [i, ids[i], org, loc]);
      return ok({ senders: (await bkSenders(env, org, loc, settings)).map(out) });
    }
    const id = Number(parts[1]);
    const cur = id ? await mine(id) : null;
    if (!cur) return bad("Sender not found", 404);
    if (m === "POST" && parts[2] === "test") {
      // Admin only, fixed wording. To the address the admin typed (shown filled with their sign-in email):
      // a sign-in email can be a made-up one that belongs to a stranger.
      const tt = await bkTestTo(request, authUser, env); if (tt.error) return bad(tt.error, 429);
      const to = tt.to;
      try {
        const r = await bkSendEmail(env, settings, { to, toName: authUser.full_name, subject: "Eikon test message", html: bkEmailHtml({ title: "It works", lines: ["Booking emails from Eikon will look like this.", "Sent through " + (cur.label || cur.kind) + "."], pharmacy: authUser.location_name || "", address: settings.address, phone: settings.phone }) }, cur.id);
        return ok({ sentTo: to, sender: r.sender });
      } catch (e) { return bad(String(e && e.message || e), 502); }
    }
    if (m === "PATCH") {
      const b = await readJson(request) || {};
      const f = clean(b, cur); if (typeof f === "string") return bad(f);
      const secret = secretOf(b);
      if (secret) { if (String(env.BOOKINGS_KEY || "").length < 16) return bad("Messages need the BOOKINGS_KEY secret set on the server"); f.cred_enc = await bkEncrypt(env, secret); f.cooldown_until = ""; f.last_error = ""; }
      const cols = Object.keys(f);
      if (cols.length) await dbRun(env, `UPDATE bk_senders SET ${cols.map((c) => c + "=?").join(", ")}, updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=?`, [...cols.map((c) => f[c]), id, org, loc]);
      await writeAudit(env, org, me, "BK_SENDER_EDIT", "bk_senders", String(id), { fields: cols.filter((c) => c !== "cred_enc"), key_changed: !!secret }, loc);
      return ok({ sender: out(await mine(id)) });
    }
    if (m === "DELETE") {
      await dbRun(env, `DELETE FROM bk_senders WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
      if (cur.legacy) await dbRun(env, `UPDATE bk_settings SET api_key_enc='', provider=CASE WHEN provider='off' THEN 'off' ELSE 'on' END WHERE org_id=? AND location_id=?`, [org, loc]);
      await writeAudit(env, org, me, "BK_SENDER_DELETE", "bk_senders", String(id), { kind: cur.kind }, loc);
      return ok({ deleted: id });
    }
    return bad("Not found", 404);
  }

  if (parts[0] === "import-legacy" && m === "POST") {
    if (!isAdmin) return bad("Only an admin can import", 403);
    return ok({ report: await bkImportLegacy(env, authUser, url.searchParams.get("dry") === "1") });
  }

  // Waiting list: people waiting for a service, first come first served.
  if (parts[0] === "waitlist") {
    const wlRow = (w) => ({ id: w.id, serviceId: w.service_id, personName: w.person_name, personPhone: w.person_phone, personEmail: w.person_email,
      note: w.note, status: w.status, bookingId: w.booking_id, createdAt: w.created_at });
    if (m === "GET" && parts.length === 1) {
      const rows = await dbAll(env, `SELECT * FROM bk_waitlist WHERE org_id=? AND location_id=? AND status='waiting' ORDER BY id`, [org, loc]);
      return ok({ waiting: rows.map(wlRow) });
    }
    if (m === "POST" && parts.length === 1) {
      const b = await readJson(request) || {};
      const svc = await bkGetService(env, org, loc, Number(b.serviceId));
      const name = String(b.personName || "").trim();
      if (!svc) return bad("Unknown service", 404);
      if (!name) return bad("Name is required");
      const r = await dbFirst(env, `INSERT INTO bk_waitlist (org_id, location_id, service_id, person_name, person_phone, person_email, note, created_by) VALUES (?,?,?,?,?,?,?,?) RETURNING *`,
        [org, loc, svc.id, name, String(b.personPhone || "").trim(), String(b.personEmail || "").trim().toLowerCase(), String(b.note || "").trim(), me]);
      await writeAudit(env, org, me, "BK_WAITLIST_ADD", "bk_waitlist", String(r.id), { service_id: svc.id }, loc);
      return ok({ entry: wlRow(r) }, 201);
    }
    if (m === "PATCH" && parts.length === 2) {
      const b = await readJson(request) || {};
      if (b.status !== "removed") return bad("Only removing is allowed here; booking marks it automatically");
      const r = await dbFirst(env, `UPDATE bk_waitlist SET status='removed', updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=? AND status='waiting' RETURNING *`, [Number(parts[1]), org, loc]);
      if (!r) return bad("Not found", 404);
      return ok({ entry: wlRow(r) });
    }
    return bad("Not found", 404);
  }

  // GET /bookings/setup → services + providers
  if (parts[0] === "setup" && m === "GET") {
    const services = await dbAll(env, `SELECT * FROM bk_services WHERE org_id=? AND location_id=? ORDER BY active DESC, sort, name`, [org, loc]);
    const providers = await dbAll(env, `SELECT * FROM bk_providers WHERE org_id=? AND location_id=? ORDER BY active DESC, name`, [org, loc]);
    return ok({ services: services.map(bkServiceRow), providers: providers.map(bkProviderRow) });
  }

  // Services
  if (parts[0] === "services" && (m === "POST" || m === "PUT")) {
    if (!isAdmin) return bad("Only an admin can change services", 403);
    const b0 = await readJson(request) || {};
    // An update keeps whatever is not sent (buffer, colour, sort… are not on every screen).
    const curSvc = m === "PUT" && parts.length === 2 ? await dbFirst(env, `SELECT * FROM bk_services WHERE id=? AND org_id=? AND location_id=?`, [Number(parts[1]), org, loc]) : null;
    if (m === "PUT" && parts.length === 2 && !curSvc) return bad("Not found", 404);
    const cs = curSvc ? bkServiceRow(curSvc) : null;
    const b = cs ? { name: cs.name, durationMin: cs.durationMin, bufferMin: cs.bufferMin, priceCents: cs.priceCents, color: cs.color, providerIds: cs.providerIds, online: cs.online, active: cs.active, sort: cs.sort, ...Object.fromEntries(Object.entries(b0).filter(([, v]) => v !== undefined)) } : b0;
    const name = String(b.name || "").trim();
    const dur = Math.round(Number(b.durationMin));
    const buf = Math.max(0, Math.round(Number(b.bufferMin) || 0));
    const price = Math.max(0, Math.round(Number(b.priceCents) || 0));
    const pids = Array.isArray(b.providerIds) ? b.providerIds.map(Number).filter((n) => n > 0) : [];
    if (!name) return bad("Name is required");
    if (!(dur >= 5 && dur <= 480)) return bad("Length must be 5 to 480 minutes");
    if (buf > 120) return bad("Buffer must be at most 120 minutes");
    if (pids.length) {
      const n = await dbFirst(env, `SELECT COUNT(*) AS c FROM bk_providers WHERE org_id=? AND location_id=? AND id IN (${pids.map(() => "?").join(",")})`, [org, loc, ...pids]);
      if (Number(n.c) !== pids.length) return bad("Unknown provider");
    }
    if (m === "POST" && parts.length === 1) {
      const r = await dbFirst(env, `INSERT INTO bk_services (org_id, location_id, name, duration_min, buffer_min, price_cents, color, provider_ids_json, online, active, sort)
        VALUES (?,?,?,?,?,?,?,?,?,1,?) RETURNING *`, [org, loc, name, dur, buf, price, String(b.color || ""), JSON.stringify(pids), b.online ? 1 : 0, Math.round(Number(b.sort) || 0)]);
      await writeAudit(env, org, me, "BK_SERVICE_CREATE", "bk_services", String(r.id), { name }, loc);
      return ok({ service: bkServiceRow(r) }, 201);
    }
    if (m === "PUT" && parts.length === 2) {
      const r = await dbFirst(env, `UPDATE bk_services SET name=?, duration_min=?, buffer_min=?, price_cents=?, color=?, provider_ids_json=?, online=?, active=?, sort=?, updated_at=datetime('now')
        WHERE id=? AND org_id=? AND location_id=? RETURNING *`, [name, dur, buf, price, String(b.color || ""), JSON.stringify(pids), b.online ? 1 : 0, b.active === false ? 0 : 1, Math.round(Number(b.sort) || 0), Number(parts[1]), org, loc]);
      if (!r) return bad("Not found", 404);
      await writeAudit(env, org, me, "BK_SERVICE_UPDATE", "bk_services", String(r.id), { name }, loc);
      return ok({ service: bkServiceRow(r) });
    }
  }

  // Providers (people or rooms) with weekly hours
  // A practitioner (or room) away for a day, several days or some hours: the time is closed and the bookings in it
  // are cancelled with the reason; customers with an email are told (with a link to book again); the rest are listed to call.
  if (parts[0] === "providers" && parts[2] === "away" && m === "POST") {
    if (!isAdmin) return bad("Only an admin can mark someone away", 403);
    const pid = Number(parts[1]);
    const prov = await dbFirst(env, `SELECT * FROM bk_providers WHERE id=? AND org_id=? AND location_id=?`, [pid, org, loc]);
    if (!prov) return bad("Not found", 404);
    const b = await readJson(request) || {};
    const from = String(b.from || ""), to = String(b.to || b.from || ""), st = String(b.start || ""), en = String(b.end || "");
    const reason = String(b.reason || "").trim().slice(0, 140) || (prov.name + " is unavailable");
    if (!isValidYmd(from) || !isValidYmd(to) || to < from) return bad("Choose the day, or the first and last day");
    if (bkDaysBetween(from, to) > 30) return bad("At most 31 days at once");
    if ((st || en) && !(bkMin(en) > bkMin(st))) return bad("End must be after start");
    for (let d = from; d <= to; d = bkAddDays(d, 1))
      await dbRun(env, `INSERT INTO bk_exceptions (org_id, location_id, provider_id, date, kind, start_time, end_time, note) VALUES (?,?,?,?, 'off', ?,?,?)`, [org, loc, pid, d, st, en, reason]);
    const hit = await dbAll(env, `SELECT * FROM bk_bookings WHERE org_id=? AND location_id=? AND provider_id=? AND date BETWEEN ? AND ? AND status IN ('booked','confirmed')
      ${st ? "AND start_time < ? AND end_time > ?" : ""} ORDER BY date, start_time`, st ? [org, loc, pid, from, to, en, st] : [org, loc, pid, from, to]);
    let cancelled = 0, emailed = 0; const toCall = [];
    for (const x of hit) {
      const r = await dbFirst(env, `UPDATE bk_bookings SET status='cancelled', cancel_reason=?, version=version+1, updated_by=?, updated_at=datetime('now')
        WHERE id=? AND status IN ('booked','confirmed') RETURNING *`, [reason, me, x.id]);
      if (!r) continue;
      cancelled++;
      const sent = b.notify === false ? "off" : await bkNotify(env, request, r, "cancel");
      if (sent === "sent") emailed++;
      else toCall.push({ id: r.id, personName: r.person_name, personPhone: r.person_phone, date: r.date, start: r.start_time });
    }
    await writeAudit(env, org, me, "BK_PROVIDER_AWAY", "bk_providers", String(pid), { from, to, start: st, end: en, reason, cancelled }, loc);
    return ok({ cancelled, emailed, toCall });
  }

  // Clinic rooms: everyone can see them; admins set them up.
  if (parts[0] === "rooms") {
    if (m === "GET") return ok({ rooms: (await dbAll(env, `SELECT id, name, active FROM bk_rooms WHERE org_id=? AND location_id=? ORDER BY active DESC, name`, [org, loc])).map((r) => ({ id: r.id, name: r.name, active: !!r.active })) });
    if (!isAdmin) return bad("Only an admin can set up rooms", 403);
    const b = await readJson(request) || {};
    const name = String(b.name || "").trim().slice(0, 40);
    if (!name) return bad("Give the room a name, e.g. Room 1");
    if (m === "POST" && parts.length === 1) {
      const r = await dbFirst(env, `INSERT INTO bk_rooms (org_id, location_id, name) VALUES (?,?,?) RETURNING *`, [org, loc, name]);
      await writeAudit(env, org, me, "BK_ROOM_CREATE", "bk_rooms", String(r.id), { name }, loc);
      return ok({ room: { id: r.id, name: r.name, active: true } }, 201);
    }
    if (m === "PUT" && parts.length === 2) {
      const r = await dbFirst(env, `UPDATE bk_rooms SET name=?, active=CASE WHEN ? THEN ? ELSE active END WHERE id=? AND org_id=? AND location_id=? RETURNING *`,
        [name, b.active !== undefined ? 1 : 0, b.active === false ? 0 : 1, Number(parts[1]), org, loc]);
      if (!r) return bad("Not found", 404);
      return ok({ room: { id: r.id, name: r.name, active: !!r.active } });
    }
    return bad("Not found", 404);
  }

  if (parts[0] === "providers" && (m === "POST" || m === "PUT")) {
    if (!isAdmin) return bad("Only an admin can change providers", 403);
    const b0p = await readJson(request) || {};
    // An update keeps whatever is not sent: kind, weekly hours, active, title, speciality.
    const curP = m === "PUT" && parts.length === 2 ? await dbFirst(env, `SELECT * FROM bk_providers WHERE id=? AND org_id=? AND location_id=?`, [Number(parts[1]), org, loc]) : null;
    const b = curP ? { name: curP.name, kind: curP.kind, hours: bkJson(curP.hours_json, {}), active: !!curP.active, ...Object.fromEntries(Object.entries(b0p).filter(([, v]) => v !== undefined)) } : b0p;
    const name = String(b.name || "").trim();
    const kind = ["pharmacist", "doctor", "nurse", "room", "other"].includes(b.kind) ? b.kind : "pharmacist";
    const hours = bkCleanHours(b.hours);
    if (!name) return bad("Name is required");
    const title = String(b.title || "").trim().slice(0, 20), speciality = String(b.speciality || "").trim().slice(0, 60);
    // Rooms named in the sessions must exist here, and no one else may hold the same room at the same time.
    const wanted = new Set(); for (const wd of Object.keys(hours)) for (const w of hours[wd]) if (w[2]) wanted.add(w[2]);
    if (wanted.size) {
      const rooms = await dbAll(env, `SELECT id, name FROM bk_rooms WHERE org_id=? AND location_id=? AND active=1`, [org, loc]);
      const rn = Object.fromEntries(rooms.map((r) => [r.id, r.name]));
      for (const id of wanted) if (!rn[id]) return bad("Choose a room that is set up here");
      const selfId = m === "PUT" ? Number(parts[1]) : 0, DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
      const others = await dbAll(env, `SELECT id, name, title, hours_json FROM bk_providers WHERE org_id=? AND location_id=? AND active=1 AND id<>?`, [org, loc, selfId]);
      for (const o of others) {
        const oh = bkJson(o.hours_json, {});
        for (const wd of Object.keys(hours)) for (const w of hours[wd]) {
          if (!w[2]) continue;
          const hit = (oh[wd] || []).find((x) => Number(x[2]) === w[2] && x[0] < w[1] && w[0] < x[1]);
          if (hit) return bad(`${rn[w[2]]} is ${bkProviderLabel(o)}'s on ${DAYS[wd]} ${hit[0]}–${hit[1]}`, 409);
        }
      }
    }
    if (m === "POST" && parts.length === 1) {
      const r = await dbFirst(env, `INSERT INTO bk_providers (org_id, location_id, name, kind, hours_json, title, speciality) VALUES (?,?,?,?,?,?,?) RETURNING *`, [org, loc, name, kind, JSON.stringify(hours), title, speciality]);
      await writeAudit(env, org, me, "BK_PROVIDER_CREATE", "bk_providers", String(r.id), { name }, loc);
      return ok({ provider: bkProviderRow(r) }, 201);
    }
    if (m === "PUT" && parts.length === 2) {
      // Fields not sent are kept (the hours screen sends only name and hours).
      const r = await dbFirst(env, `UPDATE bk_providers SET name=?, kind=?, hours_json=?, active=?, title=CASE WHEN ? THEN ? ELSE title END, speciality=CASE WHEN ? THEN ? ELSE speciality END,
          updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=? RETURNING *`,
        [name, kind, JSON.stringify(hours), b.active === false ? 0 : 1, b.title !== undefined ? 1 : 0, title, b.speciality !== undefined ? 1 : 0, speciality, Number(parts[1]), org, loc]);
      if (!r) return bad("Not found", 404);
      await writeAudit(env, org, me, "BK_PROVIDER_UPDATE", "bk_providers", String(r.id), { name }, loc);
      return ok({ provider: bkProviderRow(r) });
    }
  }

  // GET /bookings/exceptions?from&to → time off, blocked time and extra hours in a range (everyone may read them:
  // the calendar shows lunch, training and days away). Changing them stays admin only (below).
  if (parts[0] === "exceptions" && parts.length === 1 && m === "GET") {
    const from = String(url.searchParams.get("from") || ""), to = String(url.searchParams.get("to") || from);
    if (!isValidYmd(from) || !isValidYmd(to) || to < from) return bad("from and to are required (YYYY-MM-DD)");
    if (bkDaysBetween(from, to) > BK_MAX_RANGE_DAYS) return bad(`At most ${BK_MAX_RANGE_DAYS} days at a time`);
    const rows = await dbAll(env, `SELECT * FROM bk_exceptions WHERE org_id=? AND location_id=? AND date>=? AND date<=? ORDER BY date, start_time, id`, [org, loc, from, to]);
    return ok({ from, to, exceptions: rows.map((e) => ({ id: e.id, providerId: e.provider_id, date: e.date, kind: e.kind, start: e.start_time, end: e.end_time, note: e.note })) });
  }
  // GET /bookings/person?card&email&phone&name → one customer's record here: how many bookings, how many missed.
  if (parts[0] === "person" && m === "GET") {
    const q = bkPersonQuery({ card: url.searchParams.get("card"), email: url.searchParams.get("email"), phone: url.searchParams.get("phone"), name: url.searchParams.get("name") });
    if (!q.card && !q.email && !q.phone && !q.name) return bad("Give an ID card, e-mail, phone or name");
    const like = q.phone ? "%" + q.phone.slice(-3) : "";
    const cand = await dbAll(env, `SELECT id, date, start_time, status, service_id, person_name, person_phone, person_email, person_id_card FROM bk_bookings
      WHERE org_id=? AND location_id=? AND ((?<>'' AND UPPER(TRIM(person_id_card))=?) OR (?<>'' AND LOWER(TRIM(person_email))=?) OR (?<>'' AND person_phone LIKE ?) OR (?<>'' AND LOWER(TRIM(person_name))=?))
      ORDER BY date DESC, start_time DESC LIMIT 2000`, [org, loc, q.card, q.card, q.email, q.email, like, like, q.name, q.name]);
    const rows = cand.filter((r) => bkSamePerson(q, r));
    const today = bkNowLocal(env).date;
    const missed = rows.filter((r) => r.status === "no_show");
    return ok({ by: q.card ? "card" : q.email ? "email" : q.phone ? "phone" : "name",
      total: rows.filter((r) => r.status !== "cancelled").length, noShows: missed.length, cancelled: rows.filter((r) => r.status === "cancelled").length,
      done: rows.filter((r) => r.status === "done").length, lastNoShow: missed.length ? missed[0].date : "",
      upcoming: rows.filter((r) => r.date >= today && (r.status === "booked" || r.status === "confirmed")).length,
      recent: rows.slice(0, 6).map((r) => ({ id: r.id, date: r.date, start: r.start_time, status: r.status, serviceId: r.service_id })) });
  }

  // Exceptions: a day or a few hours off, or an extra window
  if (parts[0] === "exceptions") {
    if (!isAdmin) return bad("Only an admin can change hours", 403);
    if (m === "POST" && parts.length === 1) {
      const b = await readJson(request) || {};
      const pid = Number(b.providerId), date = String(b.date || ""), kind = b.kind === "extra" ? "extra" : "off";
      const st = String(b.start || ""), en = String(b.end || "");
      if (!isValidYmd(date)) return bad("Invalid date");
      if (!(await dbFirst(env, `SELECT id FROM bk_providers WHERE id=? AND org_id=? AND location_id=?`, [pid, org, loc]))) return bad("Unknown provider");
      if (kind === "extra" || st || en) { if (!(bkMin(en) > bkMin(st))) return bad("End must be after start"); }
      const r = await dbFirst(env, `INSERT INTO bk_exceptions (org_id, location_id, provider_id, date, kind, start_time, end_time, note) VALUES (?,?,?,?,?,?,?,?) RETURNING id`,
        [org, loc, pid, date, kind, st, en, String(b.note || "")]);
      return ok({ id: r.id }, 201);
    }
    if (m === "DELETE" && parts.length === 2) {
      await dbRun(env, `DELETE FROM bk_exceptions WHERE id=? AND org_id=? AND location_id=?`, [Number(parts[1]), org, loc]);
      return ok({});
    }
  }

  // GET /bookings/slots?service_id&date[&provider_id]
  if (parts[0] === "slots" && m === "GET") {
    const svc = await bkGetService(env, org, loc, Number(url.searchParams.get("service_id")));
    const date = String(url.searchParams.get("date") || "");
    if (!svc) return bad("Unknown service", 404);
    if (!isValidYmd(date)) return bad("Invalid date");
    return ok({ date, slots: await bkSlotsFor(env, org, loc, svc, date, url.searchParams.get("provider_id")) });
  }
  // GET /bookings/next?service_id → the next free times, today first
  if (parts[0] === "next" && m === "GET") {
    const svc = await bkGetService(env, org, loc, Number(url.searchParams.get("service_id")));
    if (!svc) return bad("Unknown service", 404);
    const count = Math.min(12, Math.max(1, Number(url.searchParams.get("count")) || 6));
    return ok({ slots: await bkNextSlots(env, org, loc, svc, bkNowLocal(env).date, count, 21) });
  }

  // GET /bookings?from&to → one date range only
  if (parts.length === 0 && m === "GET") {
    const from = String(url.searchParams.get("from") || ""), to = String(url.searchParams.get("to") || from);
    if (!isValidYmd(from) || !isValidYmd(to) || to < from) return bad("from and to are required (YYYY-MM-DD)");
    if (bkDaysBetween(from, to) > BK_MAX_RANGE_DAYS) return bad(`At most ${BK_MAX_RANGE_DAYS} days at a time`);
    const rows = await dbAll(env, `SELECT * FROM bk_bookings WHERE org_id=? AND location_id=? AND date>=? AND date<=? ORDER BY date, start_time, provider_id`, [org, loc, from, to]);
    const provs = await dbAll(env, `SELECT id, hours_json FROM bk_providers WHERE org_id=? AND location_id=?`, [org, loc]);
    const ph = Object.fromEntries(provs.map((p) => [p.id, bkJson(p.hours_json, {})]));
    const rn = Object.fromEntries((await dbAll(env, `SELECT id, name FROM bk_rooms WHERE org_id=? AND location_id=?`, [org, loc])).map((r) => [r.id, r.name]));
    // Reminders and confirmations at a glance: every message sent (or tried) for these bookings, and whether this
    // pharmacy can send at all. And each customer's earlier no-shows here.
    await ensureBookingsMsgSchema(env);
    const messages = {};
    for (const x of await dbAll(env, `SELECT m.booking_id, m.kind, m.status, m.created_at FROM bk_messages m JOIN bk_bookings b ON b.id=m.booking_id
        WHERE b.org_id=? AND b.location_id=? AND b.date>=? AND b.date<=? ORDER BY m.id`, [org, loc, from, to]))
      (messages[x.booking_id] = messages[x.booking_id] || []).push({ kind: x.kind, status: x.status, at: x.created_at });
    const st = await bkGetSettings(env, org, loc);
    const mail = { on: await bkCanSend(env, st), evening: !!st.remind_evening, hours: Number(st.remind_hours) || 0 };
    const missed = rows.length ? await dbAll(env, `SELECT id, date, person_name, person_phone, person_email, person_id_card FROM bk_bookings WHERE org_id=? AND location_id=? AND status='no_show' ORDER BY date DESC LIMIT 5000`, [org, loc]) : [];
    const noShows = {};
    if (missed.length) for (const r of rows) {
      const q = bkPersonQuery({ card: r.person_id_card, email: r.person_email, phone: r.person_phone, name: r.person_name });
      const n = missed.filter((x) => x.id !== r.id && bkSamePerson(q, x)).length;
      if (n) noShows[r.id] = n;
    }
    return ok({ from, to, mail, messages, noShows, bookings: rows.map((r) => { const rid = bkRoomIdFor(ph[r.provider_id], r.date, r.start_time); return { ...bkBookingRow(r), roomId: rid || null, roomName: rn[rid] || "" }; }) });
  }

  // POST /bookings → book a slot
  if (parts.length === 0 && m === "POST") {
    const b = await readJson(request) || {};
    const svc = await bkGetService(env, org, loc, Number(b.serviceId));
    if (!svc || !svc.active) return bad("Unknown service", 404);
    const date = String(b.date || ""), start = String(b.start || ""), pid = Number(b.providerId);
    const name = String(b.personName || "").trim();
    if (!name) return bad("Name is required");
    // A walk-in: someone at the counter now. It starts now (to the 5 minutes) with the first person who does the
    // service and has nothing booked or blocked for its length; it is marked Here and no e-mail is sent.
    if (b.walkIn === true) {
      const now = bkNowLocal(env), a = Math.floor(now.min / 5) * 5, z = a + svc.durationMin;
      if (z > 24 * 60) return bad("Too late in the day for a walk-in of this length");
      const pids = (svc.providerIds || []).map(Number).filter((n) => !pid || n === pid);
      if (pid && !pids.length) return bad("That person does not do this service");
      const provs = pids.length ? await dbAll(env, `SELECT id, name FROM bk_providers WHERE org_id=? AND location_id=? AND active=1 AND id IN (${pids.map(() => "?").join(",")})`, [org, loc, ...pids]) : [];
      const { exc, booked } = await bkLoadDay(env, org, loc, now.date, provs.map((p) => p.id));
      const order = pid ? provs : pids.map((n) => provs.find((p) => p.id === n)).filter(Boolean);
      const who = order.find((p) => !bkBusyAt(exc.filter((e) => e.provider_id === p.id), booked.filter((x) => x.provider_id === p.id), a, z + (svc.bufferMin || 0)));
      if (!who) return bad(pid ? "Busy right now" : "Nobody who does this is free right now", 409, { next: await bkNextSlots(env, org, loc, svc, now.date, 3, 1) });
      try {
        const r = await dbFirst(env, `INSERT INTO bk_bookings (org_id, location_id, ref, service_id, provider_id, person_name, person_phone, person_email, person_id_card,
            date, start_time, end_time, status, price_cents, notes, link_id, created_by, updated_by, walk_in)
          VALUES (?,?,?,?,?,?,?,?,?,?,?,?,'arrived',?,?,?,?,?,1) RETURNING *`,
          [org, loc, bkRef(), svc.id, who.id, name, String(b.personPhone || "").trim(), String(b.personEmail || "").trim().toLowerCase(),
            String(b.personIdCard || "").trim().toUpperCase(), now.date, bkTime(a), bkTime(z), svc.priceCents, String(b.notes || ""), bkRandomHex(16), me, me]);
        await writeAudit(env, org, me, "BK_WALKIN", "bk_bookings", String(r.id), { date: now.date, start: bkTime(a), service_id: svc.id, provider_id: who.id }, loc);
        return ok({ booking: bkBookingRow(r), message: "" }, 201);
      } catch (e) {
        if (/UNIQUE/i.test(String(e && e.message))) return bad("Someone was just booked at this minute. Try again.", 409);
        throw e;
      }
    }
    if (!isValidYmd(date) || !Number.isFinite(bkMin(start))) return bad("Invalid date or time");
    // Repeat: the same time every 1, 2, 3 or 4 weeks, 2 to 12 times in all. Each one must be free on its day.
    let rep = null;
    if (b.repeat && typeof b.repeat === "object") {
      rep = { every: Math.round(Number(b.repeat.everyDays)), count: Math.round(Number(b.repeat.count)) };
      if (![7, 14, 21, 28].includes(rep.every) || !(rep.count >= 2 && rep.count <= 12)) return bad("Repeat every 1 to 4 weeks, 2 to 12 times");
    }
    // The slot must be one the rules allow right now (hours, exceptions, other bookings, buffers, not in the past).
    const free = await bkSlotsFor(env, org, loc, svc, date, pid || null);
    const slot = free.find((s) => s.time === start && (!pid || s.providerId === pid));
    const suggest = async () => (await bkNextSlots(env, org, loc, svc, date, 3, 14));
    if (!slot) return bad("That time is no longer free", 409, { next: await suggest() });
    const end = bkTime(bkMin(start) + svc.durationMin);
    try {
      const r = await dbFirst(env, `INSERT INTO bk_bookings (org_id, location_id, ref, service_id, provider_id, person_name, person_phone, person_email, person_id_card,
          date, start_time, end_time, status, price_cents, notes, link_id, created_by, updated_by)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,'booked',?,?,?,?,?) RETURNING *`,
        [org, loc, bkRef(), svc.id, slot.providerId, name, String(b.personPhone || "").trim(), String(b.personEmail || "").trim().toLowerCase(),
          String(b.personIdCard || "").trim().toUpperCase(), date, start, end, svc.priceCents, String(b.notes || ""), bkRandomHex(16), me, me]);
      await writeAudit(env, org, me, "BK_CREATE", "bk_bookings", String(r.id), { date, start, service_id: svc.id, provider_id: slot.providerId }, loc);
      if (rep) {
        // The first is booked; the rest follow it, each only when that time is still free with the same person.
        const sid = bkRandomHex(8), series = [], skipped = [];
        const first = await dbFirst(env, `UPDATE bk_bookings SET series_id=? WHERE id=? RETURNING *`, [sid, r.id]);
        series.push(bkBookingRow(first));
        for (let i = 1; i < rep.count; i++) {
          const d = bkAddDays(date, rep.every * i);
          const freeD = (await bkSlotsFor(env, org, loc, svc, d, slot.providerId)).some((x) => x.time === start);
          if (!freeD) { skipped.push({ date: d, start }); continue; }
          try {
            const n = await dbFirst(env, `INSERT INTO bk_bookings (org_id, location_id, ref, service_id, provider_id, person_name, person_phone, person_email, person_id_card,
                date, start_time, end_time, status, price_cents, notes, link_id, created_by, updated_by, series_id)
              VALUES (?,?,?,?,?,?,?,?,?,?,?,?,'booked',?,?,?,?,?,?) RETURNING *`,
              [org, loc, bkRef(), svc.id, slot.providerId, name, String(b.personPhone || "").trim(), String(b.personEmail || "").trim().toLowerCase(),
                String(b.personIdCard || "").trim().toUpperCase(), d, start, end, svc.priceCents, String(b.notes || ""), bkRandomHex(16), me, me, sid]);
            series.push(bkBookingRow(n));
          } catch (e) { if (/UNIQUE/i.test(String(e && e.message))) { skipped.push({ date: d, start }); continue; } throw e; }
        }
        await writeAudit(env, org, me, "BK_CREATE_SERIES", "bk_bookings", String(r.id), { series_id: sid, every_days: rep.every, booked: series.length, skipped: skipped.map((x) => x.date) }, loc);
        const message = await bkNotify(env, request, first, "confirm", { also: series.slice(1).map((x) => bkWhen({ date: x.date, start_time: x.start })) });
        if (b.waitlistId) await dbRun(env, `UPDATE bk_waitlist SET status='booked', booking_id=?, updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=? AND status='waiting'`, [r.id, Number(b.waitlistId), org, loc]);
        return ok({ booking: bkBookingRow(first), series, skipped, message }, 201);
      }
      const message = await bkNotify(env, request, r, "confirm");
      // Booked from the waiting list: mark that entry as done (only if it is for this pharmacy and still waiting).
      if (b.waitlistId) await dbRun(env, `UPDATE bk_waitlist SET status='booked', booking_id=?, updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=? AND status='waiting'`, [r.id, Number(b.waitlistId), org, loc]);
      return ok({ booking: bkBookingRow(r), message }, 201);
    } catch (e) {
      if (/UNIQUE/i.test(String(e && e.message))) return bad("That time was just taken", 409, { next: await suggest() });
      throw e;
    }
  }

  // PATCH /bookings/:id  { version, status? , cancelReason?, notes?, date?+start? (move) }
  if (parts.length === 1 && m === "PATCH") {
    const id = Number(parts[0]);
    const b = await readJson(request) || {};
    const cur = await dbFirst(env, `SELECT * FROM bk_bookings WHERE id=? AND org_id=? AND location_id=?`, [id, org, loc]);
    if (!cur) return bad("Not found", 404);
    if (Number(b.version) !== cur.version) return bad("Changed by someone else", 409, { current: bkBookingRow(cur) });
    let { status, date, start_time: start, end_time: end, provider_id: pid } = cur;
    if (b.status !== undefined) { if (!BK_STATUSES.includes(b.status)) return bad("Unknown status"); status = b.status; }
    if (status === "cancelled" && !String(b.cancelReason || cur.cancel_reason || "").trim()) return bad("Say why it was cancelled");
    if (b.date !== undefined || b.start !== undefined) {
      if (cur.status === "cancelled" || status === "cancelled") return bad("A cancelled booking cannot be moved");
      const svc = await bkGetService(env, org, loc, cur.service_id);
      const nd = String(b.date || cur.date), ns = String(b.start || cur.start_time), np = Number(b.providerId || cur.provider_id);
      // The booking being moved does not block its own new time.
      const free = (await bkSlotsFor(env, org, loc, svc, nd, np, cur.id)).map((s) => s.time);
      if (!free.includes(ns)) return bad("That time is not free", 409, { next: await bkNextSlots(env, org, loc, svc, nd, 3, 14) });
      date = nd; start = ns; end = bkTime(bkMin(ns) + svc.durationMin); pid = np;
    }
    try {
      // One statement: the move or status change is atomic, guarded by version.
      const r = await dbFirst(env, `UPDATE bk_bookings SET status=?, date=?, start_time=?, end_time=?, provider_id=?, notes=?, cancel_reason=?,
          version=version+1, updated_by=?, updated_at=datetime('now') WHERE id=? AND org_id=? AND location_id=? AND version=? RETURNING *`,
        [status, date, start, end, pid, b.notes !== undefined ? String(b.notes) : cur.notes, status === "cancelled" ? String(b.cancelReason || cur.cancel_reason) : cur.cancel_reason,
          me, id, org, loc, cur.version]);
      if (!r) return bad("Changed by someone else", 409);
      await writeAudit(env, org, me, "BK_UPDATE", "bk_bookings", String(id), { status, date, start, provider_id: pid }, loc);
      let message = "";
      let offer = null;
      // notify: false — the pharmacist tells the customer another way (they are on the phone, or at the counter).
      const tell = b.notify !== false;
      // Confirmed by the pharmacy (they called): remembered with when, as the customer's own confirmation is.
      let out = r;
      if (status === "confirmed" && cur.status !== "confirmed") out = await dbFirst(env, `UPDATE bk_bookings SET confirmed_at=datetime('now'), confirmed_via='staff' WHERE id=? RETURNING *`, [id]) || r;
      if (status === "cancelled" && cur.status !== "cancelled") {
        message = tell ? await bkNotify(env, request, r, "cancel") : "not-told";
        // A freed time: offer it to the first person waiting for this service.
        const w = await dbFirst(env, `SELECT * FROM bk_waitlist WHERE org_id=? AND location_id=? AND service_id=? AND status='waiting' ORDER BY id LIMIT 1`, [org, loc, r.service_id]);
        if (w) offer = { waitlistId: w.id, personName: w.person_name, personPhone: w.person_phone, personEmail: w.person_email,
          serviceId: r.service_id, providerId: r.provider_id, date: r.date, start: r.start_time };
      }
      else if (r.date !== cur.date || r.start_time !== cur.start_time) {
        message = tell ? await bkNotify(env, request, r, "change") : "not-told";
        // The time it left is free again: offer it to the first person waiting for this service, when it really is free.
        const now = bkNowLocal(env);
        if (cur.date > now.date || (cur.date === now.date && bkMin(cur.start_time) > now.min)) {
          const w = await dbFirst(env, `SELECT * FROM bk_waitlist WHERE org_id=? AND location_id=? AND service_id=? AND status='waiting' ORDER BY id LIMIT 1`, [org, loc, r.service_id]);
          const svcW = w ? await bkGetService(env, org, loc, r.service_id) : null;
          if (w && svcW && (await bkSlotsFor(env, org, loc, svcW, cur.date, cur.provider_id)).some((x) => x.time === cur.start_time))
            offer = { waitlistId: w.id, personName: w.person_name, personPhone: w.person_phone, personEmail: w.person_email,
              serviceId: r.service_id, providerId: cur.provider_id, date: cur.date, start: cur.start_time };
        }
      }
      return ok({ booking: bkBookingRow(out), message, offer });
    } catch (e) {
      if (/UNIQUE/i.test(String(e && e.message))) return bad("That time was just taken", 409);
      throw e;
    }
  }

  return bad("Not found", 404);
}

/* ══════════════════════════════════════════════════════════════════════════════
   BOOKINGS — customer messages (optional) and the private booking link.
   - Off by default. A pharmacy picks Resend or Brevo and pastes its API key.
     Keys are encrypted at rest with the BOOKINGS_KEY worker secret and never
     returned to the browser. Without BOOKINGS_KEY, messages and links stay off.
   - Each booking has a private link /b/<token>: 128 random bits + a versioned
     HMAC with an expiry (7 days after the appointment). It shows that one
     booking only (first name, service, time, place) and lets the person cancel
     up to the pharmacy's cut-off. Rate-limited per network. No login, no notes,
     no ID card, no other bookings.
   - Reminders run from the scheduled handler: the evening before (18:00 local)
     and optionally N hours before. Each is claimed in the database before it is
     sent, so a retry never sends twice. One-click opt-out per email.
   ══════════════════════════════════════════════════════════════════════════════ */

async function ensureBookingsMsgSchema__impl(env) {
  await ensureBookingsSchema(env);
  const stmts = [
    `CREATE TABLE IF NOT EXISTS bk_settings (
      org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
      provider TEXT NOT NULL DEFAULT 'off', from_name TEXT NOT NULL DEFAULT '', from_email TEXT NOT NULL DEFAULT '',
      reply_to TEXT NOT NULL DEFAULT '', api_key_enc TEXT NOT NULL DEFAULT '',
      remind_evening INTEGER NOT NULL DEFAULT 1, remind_hours INTEGER NOT NULL DEFAULT 0,
      cancel_cutoff_min INTEGER NOT NULL DEFAULT 120, address TEXT NOT NULL DEFAULT '', phone TEXT NOT NULL DEFAULT '',
      updated_at TEXT NOT NULL DEFAULT (datetime('now')), PRIMARY KEY (org_id, location_id))`,
    `CREATE TABLE IF NOT EXISTS bk_messages (
      id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
      booking_id INTEGER NOT NULL, kind TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending',
      error TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT (datetime('now')))`,
    `CREATE UNIQUE INDEX IF NOT EXISTS uq_bk_msg_reminder ON bk_messages (booking_id, kind) WHERE kind IN ('remind_evening','remind_hours')`,
    `CREATE INDEX IF NOT EXISTS idx_bk_msg_loc ON bk_messages (org_id, location_id, created_at)`,
    `CREATE TABLE IF NOT EXISTS bk_optout (email TEXT NOT NULL, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
      created_at TEXT NOT NULL DEFAULT (datetime('now')), PRIMARY KEY (email, org_id, location_id))`
  ];
  for (const s of stmts) await dbRun(env, s, []);
  // Online booking (public page), added later: columns are added if missing.
  for (const col of ["public_enabled INTEGER NOT NULL DEFAULT 0", "public_slug TEXT NOT NULL DEFAULT ''",
                     "smtp_host TEXT NOT NULL DEFAULT ''", "smtp_port INTEGER NOT NULL DEFAULT 465", "smtp_user TEXT NOT NULL DEFAULT ''", "smtp_secure TEXT NOT NULL DEFAULT 'tls'",
                     "test_day TEXT NOT NULL DEFAULT ''", "test_count INTEGER NOT NULL DEFAULT 0"]) {
    try { await dbRun(env, `ALTER TABLE bk_settings ADD COLUMN ${col}`, []); } catch (e) {}
  }
  await dbRun(env, `CREATE UNIQUE INDEX IF NOT EXISTS uq_bk_public_slug ON bk_settings (public_slug) WHERE public_slug <> ''`, []);
  // Several senders per pharmacy (Resend, Brevo, own mail server), tried in order. Credentials encrypted (bkEncrypt).
  await dbRun(env, `CREATE TABLE IF NOT EXISTS bk_senders (
      id INTEGER PRIMARY KEY AUTOINCREMENT, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL,
      kind TEXT NOT NULL, label TEXT NOT NULL DEFAULT '', position INTEGER NOT NULL DEFAULT 0, enabled INTEGER NOT NULL DEFAULT 1, legacy INTEGER NOT NULL DEFAULT 0,
      from_name TEXT NOT NULL DEFAULT '', from_email TEXT NOT NULL DEFAULT '', cred_enc TEXT NOT NULL DEFAULT '',
      smtp_host TEXT NOT NULL DEFAULT '', smtp_port INTEGER NOT NULL DEFAULT 465, smtp_user TEXT NOT NULL DEFAULT '', smtp_secure TEXT NOT NULL DEFAULT 'tls',
      daily_cap INTEGER NOT NULL DEFAULT 0, monthly_cap INTEGER NOT NULL DEFAULT 0,
      used_day TEXT NOT NULL DEFAULT '', used_today INTEGER NOT NULL DEFAULT 0, used_month TEXT NOT NULL DEFAULT '', used_this_month INTEGER NOT NULL DEFAULT 0,
      cooldown_until TEXT NOT NULL DEFAULT '', last_error TEXT NOT NULL DEFAULT '', last_ok_at TEXT NOT NULL DEFAULT '', last_fail_at TEXT NOT NULL DEFAULT '',
      created_at TEXT NOT NULL DEFAULT (datetime('now')), updated_at TEXT NOT NULL DEFAULT (datetime('now')))`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_bk_senders_loc ON bk_senders (org_id, location_id, position)`, []);
  await dbRun(env, `CREATE TABLE IF NOT EXISTS bk_holds (
    id TEXT PRIMARY KEY, org_id INTEGER NOT NULL, location_id INTEGER NOT NULL, payload_json TEXT NOT NULL,
    code_hash TEXT NOT NULL, attempts INTEGER NOT NULL DEFAULT 0, expires_at INTEGER NOT NULL, used INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT (datetime('now')))`, []);
}
const ensureBookingsMsgSchema = schemaOnce("ensureBookingsMsgSchema", ensureBookingsMsgSchema__impl);

/* ---------- crypto ---------- */
function bkB64url(bytes) { return base64FromBytes(bytes).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""); }
async function bkKeyBytes(env, purpose) {
  const secret = String((env && env.BOOKINGS_KEY) || "");
  if (secret.length < 16) return null;
  return new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(purpose + "|" + secret)));
}
async function bkEncrypt(env, plain) {
  const kb = await bkKeyBytes(env, "enc"); if (!kb) throw new Error("BOOKINGS_KEY is not set");
  const key = await crypto.subtle.importKey("raw", kb, "AES-GCM", false, ["encrypt"]);
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ct = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, new TextEncoder().encode(plain)));
  return "v1." + base64FromBytes(iv) + "." + base64FromBytes(ct);
}
async function bkDecrypt(env, enc) {
  if (!enc) return "";
  const kb = await bkKeyBytes(env, "enc"); if (!kb) return "";
  const [v, ivB, ctB] = String(enc).split(".");
  if (v !== "v1") return "";
  const key = await crypto.subtle.importKey("raw", kb, "AES-GCM", false, ["decrypt"]);
  const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv: bytesFromBase64(ivB) }, key, bytesFromBase64(ctB));
  return new TextDecoder().decode(pt);
}
async function bkHmac(env, msg) {
  const kb = await bkKeyBytes(env, "link"); if (!kb) return null;
  const key = await crypto.subtle.importKey("raw", kb, { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
  return bkB64url(new Uint8Array(await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(msg))));
}
function bkSafeEq(a, b) { a = String(a || ""); b = String(b || ""); if (a.length !== b.length) return false; let r = 0; for (let i = 0; i < a.length; i++) r |= a.charCodeAt(i) ^ b.charCodeAt(i); return r === 0; }
function bkDayNum(ymd) { return Math.floor(Date.parse(ymd + "T00:00:00Z") / 86400000); }
async function bkLinkToken(env, booking) {
  const exp = bkDayNum(booking.date) + 7;
  const sig = await bkHmac(env, `v1|${booking.link_id}|${exp}`);
  return sig ? `${booking.link_id}.${exp.toString(36)}.${sig}` : "";
}
async function bkVerifyToken(env, token) {
  const m = /^([0-9a-f]{32})\.([0-9a-z]{1,8})\.([A-Za-z0-9_-]{43})$/.exec(String(token || ""));
  if (!m) return null;
  const exp = parseInt(m[2], 36);
  const want = await bkHmac(env, `v1|${m[1]}|${exp}`);
  if (!want || !bkSafeEq(want, m[3])) return null;
  if (Math.floor(Date.now() / 86400000) > exp) return { expired: true };
  return { linkId: m[1], exp };
}
function bkBaseUrl(env, request) {
  if (env && env.PUBLIC_BASE_URL) return String(env.PUBLIC_BASE_URL).replace(/\/+$/, "");
  try { return new URL(request.url).origin; } catch (e) { return ""; }
}

