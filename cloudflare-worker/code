// The till count for an expected amount (End of day's sums: X readings - card - paid outs + float), off by `delta`:
// notes from 50 down to 5, the rest in coins, so the day closes within a euro, as a careful pharmacy's does.
function demoCash(x, epos, paid, float, delta) {
  let left = Math.round((Number(x) - Number(epos) - Number(paid) + Number(float) + (delta || 0)) * 100) / 100;
  const out = { n500: "0", n200: "0", n100: "0" };
  for (const v of [50, 20, 10, 5]) { const k = Math.max(0, Math.floor((left - 15) / v)); out["n" + v] = String(v === 5 ? Math.min(k, 3) : Math.min(k, v === 50 ? 12 : 10)); left = Math.round((left - v * Number(out["n" + v])) * 100) / 100; }
  out.coins_total = left.toFixed(2);
  return out;
}

