// Controlled drugs as one running register per medicine (new layout cdreg). READ ONLY: no table, column or row is
// added or changed. Every read is bounded by date and uses the registers' (org_id, location_id, entry_date) indexes
// and the stock takes' (org_id, location_id, created_at) index; at most 400 days per request.
//   GET /dda-register/medicines?from&to   the medicines written in received / supplied / POYC and counted in stock
//                                         takes in the period (default the last 92 days), one row per spelling.
//                                         `warned` (Finish round): over-supply warnings seen at entry, per spelling.
//   GET /dda-register/ledger?term&from&to every line whose medicine contains `term` (received, supplied, POYC) and every
//                                         stock-take count of it. Without `from`, the period starts at the count before
//                                         the latest (a balance needs every line since a count, and the latest count is
//                                         checked against it), else at the only count, else 92 days back.
function ddaRegYmdShift(ymd, days) {
  const d = new Date(ymd + "T00:00:00Z");
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}
function ddaRegPeriod(url, needFrom) {
  const today = tzYmd(); // the pharmacy's day (Malta), as the registers date their lines
  const to = (url.searchParams.get("to") || "").trim() || today;
  let from = (url.searchParams.get("from") || "").trim();
  if (!isValidYmd(to) || (from && !isValidYmd(from))) return { error: "Invalid from/to (YYYY-MM-DD)" };
  if (!from && needFrom) from = ddaRegYmdShift(to, -92);
  if (from && from > to) return { error: "to must be >= from" };
  const floor = ddaRegYmdShift(to, -400);
  if (from && from < floor) from = floor; // never more than 400 days in one read
  return { from, to, floor };
}
function ddaRegLike(term) { return "%" + String(term).toLowerCase().replace(/[\\%_]/g, (c) => "\\" + c) + "%"; }

async function handleDdaRegisterMedicines(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const p = ddaRegPeriod(url, true);
  if (p.error) return jsonResponse({ ok: false, error: p.error }, 400, corsOkHeaders);
  await ensureDdaPurchasesSchema(env); await ensureDdaSalesSchema(env); await ensureDdaPoycSchema(env); await ensureDdaStockTakesSchema(env);
  const o = authUser.org_id, l = authUser.location_id;
  const grouped = (t, col) => dbAll(env, `SELECT ${col} AS name, COUNT(*) AS n, SUM(quantity) AS qty, MAX(entry_date) AS last FROM ${t}
    WHERE org_id = ? AND location_id = ? AND entry_date >= ? AND entry_date <= ? GROUP BY ${col}`, [o, l, p.from, p.to]);
  const [received, supplied, poyc, counted] = await Promise.all([
    grouped("dda_purchases_entries", "dda_name_dose"),
    grouped("dda_sales_entries", "medicine_name_dose"),
    grouped("dda_poyc_entries", "medicine_name_dose"),
    dbAll(env, `SELECT i.item_name, i.dosage, COUNT(*) AS n, MAX(s.created_at) AS last
      FROM dda_stocktakes s JOIN dda_stocktake_items i ON i.org_id = s.org_id AND i.location_id = s.location_id AND i.stocktake_id = s.id
      WHERE s.org_id = ? AND s.location_id = ? AND s.created_at >= ? AND s.created_at < ?
      GROUP BY i.item_name, i.dosage`, [o, l, p.from, ddaRegYmdShift(p.to, 1)])
  ]);
  const out = { ok: true, from: p.from, to: p.to, received, supplied, poyc, counted };
  try { // over-supply warnings seen at entry, per spelling (the key only when there are some); read only, as above
    const warned = await dbAll(env, `SELECT medicine AS name, COUNT(*) AS n, MAX(entry_date) AS last FROM dda_balance_warnings
      WHERE org_id = ? AND location_id = ? AND entry_date >= ? AND entry_date <= ? GROUP BY medicine`, [o, l, p.from, p.to]);
    if (warned.length) out.warned = warned;
  } catch (e) {}
  return jsonResponse(out, 200, corsOkHeaders);
}

async function handleDdaRegisterLedger(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const term = (url.searchParams.get("term") || "").trim();
  if (term.length < 2 || term.length > 80) return jsonResponse({ ok: false, error: "Write at least 2 letters of the medicine" }, 400, corsOkHeaders);
  const p = ddaRegPeriod(url, false);
  if (p.error) return jsonResponse({ ok: false, error: p.error }, 400, corsOkHeaders);
  await ensureDdaPurchasesSchema(env); await ensureDdaSalesSchema(env); await ensureDdaPoycSchema(env); await ensureDdaStockTakesSchema(env);
  const o = authUser.org_id, l = authUser.location_id, like = ddaRegLike(term);
  // the counts first: every count of it in the last 400 days (stock takes are few; their items are read by stock take)
  const counts = await dbAll(env, `SELECT i.id, i.stocktake_id, i.item_name, i.dosage, i.qty_tablets, i.created_at, i.updated_at,
      s.created_at AS stocktake_at, s.closed_at AS stocktake_closed_at
    FROM dda_stocktakes s JOIN dda_stocktake_items i ON i.org_id = s.org_id AND i.location_id = s.location_id AND i.stocktake_id = s.id
    WHERE s.org_id = ? AND s.location_id = ? AND s.created_at >= ? AND s.created_at < ?
      AND lower(i.item_name || ' ' || COALESCE(i.dosage, '')) LIKE ? ESCAPE '\\'
    ORDER BY s.created_at ASC, i.id ASC`, [o, l, p.floor, ddaRegYmdShift(p.to, 1), like]);
  let from = p.from, auto = false;
  if (!from) { // from the count before the latest (so the latest count can be checked against the lines before it),
    // else the only count, else 92 days back. A count's UTC day is never later than its Malta day.
    auto = true;
    const days = [];
    counts.forEach((c) => { const d = String(c.stocktake_at || "").slice(0, 10); if (isValidYmd(d) && days[days.length - 1] !== d) days.push(d); });
