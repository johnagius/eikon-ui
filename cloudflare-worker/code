    const cols = Object.keys(ch);
    await dbRun(env, "UPDATE users SET " + cols.map((c) => c + " = ?").join(", ") + " WHERE id = ? AND org_id = ? AND default_location_id = ?", [...cols.map((c) => ch[c]), target.id, authUser.org_id, authUser.location_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "TEAM_USER_RIGHTS", "user", String(target.id), { before: b4, after: { ...b4, ...ch } }, authUser.location_id);
    return jsonResponse({ ok: true }, 200, cors);
  }

  // role
  const askedRole = String(body.role || "").trim().toLowerCase();
  const role = askedRole === "pharmacist" ? "staff" : askedRole; // FIN-roles: pharmacist = staff + is_pharmacist
  if (role !== "staff" && role !== "admin") return jsonResponse({ ok: false, error: "Role must be staff, pharmacist or admin" }, 400, cors);
  // FIN-roles: making someone an admin is the pharmacy admin's call (W3); an existing admin is still changed only with the flag (teamMayChange).
