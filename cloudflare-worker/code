// ----- Confirm delivery (requester confirms receipt)
async function handleStockTransferRequestDelivery(request, env, corsOkHeaders, authUser, requestId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const req = await dbFirst(env, "SELECT r.*, i.org_id AS item_org_id, i.location_id AS item_location_id, i.id AS item_id, i.quantity_available FROM stock_transfer_requests r JOIN stock_transfer_items i ON i.id = r.item_id WHERE r.id = ?", [requestId]);
  if (!req) return jsonResponse({ ok: false, error: "Request not found" }, 404, corsOkHeaders);
  if (req.requester_org_id !== authUser.org_id || req.requester_location_id !== authUser.location_id) {
    return jsonResponse({ ok: false, error: "Forbidden: only the requester can confirm delivery" }, 403, corsOkHeaders);
  }
  if (req.status !== "dispatched") return jsonResponse({ ok: false, error: "Request must be dispatched before confirming delivery (current: " + req.status + ")" }, 400, corsOkHeaders);

  await dbRun(env, "UPDATE stock_transfer_requests SET status = 'delivered', updated_at = datetime('now'), updated_by = ? WHERE id = ?", [authUser.user_id, requestId]);

  // Check if all quantity has been delivered — if so, close the item
  const totalDelivered = await dbFirst(env,
    "SELECT COALESCE(SUM(quantity_requested), 0) AS total FROM stock_transfer_requests WHERE item_id = ? AND status = 'delivered'",
    [req.item_id]);
  const delivered = (totalDelivered?.total || 0);
  if (delivered >= req.quantity_available) {
    await dbRun(env, "UPDATE stock_transfer_items SET is_closed = 1, close_reason = 'Fully transferred', updated_at = datetime('now'), updated_by = ? WHERE id = ?",
      [authUser.user_id, req.item_id]);

    // Also remove from scarce stock if linked and depleted
    const item = await dbFirst(env, "SELECT * FROM stock_transfer_items WHERE id = ?", [req.item_id]);
    if (item && item.placed_on_scarce_stock && item.placed_on_scarce_stock_id) {
      await dbRun(env, "DELETE FROM scarce_stock_offer_requests WHERE offer_id = ?", [item.placed_on_scarce_stock_id]);
      await dbRun(env, "DELETE FROM scarce_stock_offers WHERE id = ? AND org_id = ? AND location_id = ?",
        [item.placed_on_scarce_stock_id, item.org_id, item.location_id]);
    }
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_REQUEST_DELIVERY", "stock_transfer_requests", String(requestId), { item_id: req.item_id, quantity: req.quantity_requested }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

// ----- Delete/cancel transfer request
async function handleStockTransferRequestDelete(request, env, corsOkHeaders, authUser, requestId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const req = await dbFirst(env, "SELECT r.*, i.org_id AS item_org_id, i.location_id AS item_location_id FROM stock_transfer_requests r JOIN stock_transfer_items i ON i.id = r.item_id WHERE r.id = ?", [requestId]);
  if (!req) return jsonResponse({ ok: false, error: "Request not found" }, 404, corsOkHeaders);

  // Either the requester or the item owner can delete
  const isRequester = (req.requester_org_id === authUser.org_id && req.requester_location_id === authUser.location_id);
  const isOwner = (req.item_org_id === authUser.org_id && req.item_location_id === authUser.location_id);
  if (!isRequester && !isOwner) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  if (req.status === "delivered") return jsonResponse({ ok: false, error: "Cannot cancel a delivered transfer" }, 400, corsOkHeaders);

  await dbRun(env, "DELETE FROM stock_transfer_requests WHERE id = ?", [requestId]);
  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_REQUEST_DELETE", "stock_transfer_requests", String(requestId), { item_id: req.item_id }, authUser.location_id);

  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

