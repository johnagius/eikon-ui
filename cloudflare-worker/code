async function handleOosUpdate(request, env, corsOkHeaders, authUser, id) {
  await ensureCherubinoOosSchema(env);
  const existing = await dbFirst(env, `SELECT * FROM cherubino_oos WHERE id = ? AND org_id = ?`, [id, authUser.org_id]);
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

  const body = await readJson(request);
  const action = String(body.action || "").trim();
  const isAdmin = Number(authUser.location_id) >= 600;

  if (action === "approve" && isAdmin) {
    // Admin approves a pending pharmacy item → becomes admin-owned active
    await dbRun(env, `UPDATE cherubino_oos SET source='admin', status='active', source_location_id=NULL, source_location_name='' WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_APPROVE", "cherubino_oos", String(id), {}, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  if ((action === "keep" || action === "reject_removal") && isAdmin) {
    // Admin keeps the item on the list: denies a back-in-stock report or a removal request.
    await dbRun(env, `UPDATE cherubino_oos SET status='active' WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_KEEP", "cherubino_oos", String(id), { from_status: String(existing.status || "") }, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  if (action === "reject" && isAdmin) {
    // Admin rejects a pending pharmacy proposal → delete it. Only valid while pending.
    if (String(existing.status || "") !== "pending") return jsonResponse({ ok: false, error: "Only a pending proposal can be rejected" }, 400, corsOkHeaders);
    await dbRun(env, `DELETE FROM cherubino_oos WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_REJECT", "cherubino_oos", String(id), {}, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  if (action === "approve_back_in_stock" && isAdmin) {
    // Admin approves back-in-stock → remove the item
    await dbRun(env, `DELETE FROM cherubino_oos WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_BACK_IN_STOCK", "cherubino_oos", String(id), {}, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  if (action === "mark_back_in_stock" && !isAdmin) {
    // Pharmacy marks admin item as back in stock → pending approval
    await dbRun(env, `UPDATE cherubino_oos SET status='back_in_stock' WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_MARK_BACK", "cherubino_oos", String(id), { location: authUser.location_name }, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  if (action === "request_removal" && !isAdmin) {
    // Pharmacy requests removal of an admin-approved item
    await dbRun(env, `UPDATE cherubino_oos SET status='removal_requested' WHERE id=? AND org_id=?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_REQUEST_REMOVAL", "cherubino_oos", String(id), { location: authUser.location_name }, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  return jsonResponse({ ok: false, error: "Invalid action" }, 400, corsOkHeaders);
}

async function handleOosDelete(request, env, corsOkHeaders, authUser, id) {
  await ensureCherubinoOosSchema(env);
  const existing = await dbFirst(env, `SELECT * FROM cherubino_oos WHERE id = ? AND org_id = ?`, [id, authUser.org_id]);
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);

  const isAdmin = Number(authUser.location_id) >= 600;

  // Admin can delete anything
  if (isAdmin) {
    await dbRun(env, `DELETE FROM cherubino_oos WHERE id = ? AND org_id = ?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_DELETE", "cherubino_oos", String(id), {}, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  // Pharmacy can only delete their own unapproved items
  if (existing.source === "pharmacy" && existing.status === "pending" && Number(existing.source_location_id) === Number(authUser.location_id)) {
    await dbRun(env, `DELETE FROM cherubino_oos WHERE id = ? AND org_id = ?`, [id, authUser.org_id]);
    await writeAudit(env, authUser.org_id, authUser.user_id, "CHERUBINO_OOS_DELETE", "cherubino_oos", String(id), {}, authUser.location_id);
    return jsonResponse({ ok: true }, 200, corsOkHeaders);
  }

  return jsonResponse({ ok: false, error: "Cannot delete this item. Request removal instead." }, 403, corsOkHeaders);
}

