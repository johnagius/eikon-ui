async function handleDdaSalesClientsSearch(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await ensureDdaSalesSchema(env);

  const qRaw = String((url && url.searchParams ? url.searchParams.get("q") : "") || "").trim();
  const limitRaw = parseInt(String((url && url.searchParams ? url.searchParams.get("limit") : "") || "12"), 10);
  const limit = Number.isFinite(limitRaw) ? Math.max(1, Math.min(50, limitRaw)) : 12;

  let sql = `
    SELECT client_name, client_id_card, client_address, MAX(entry_date) AS last_date
    FROM dda_sales_entries
    WHERE org_id = ? AND location_id = ?
      AND client_name IS NOT NULL AND TRIM(client_name) <> ''
  `;
  const bind = [authUser.org_id, authUser.location_id];

  if (qRaw) {
    const q = "%" + qRaw.toLowerCase() + "%";
    const cardKeys = /^\d{1,7}[A-Za-z]$/.test(qRaw.replace(/\s+/g, "")) ? mtIdCardLookupKeys(qRaw) : [];
    sql += " AND (" + mtFoldSql("LOWER(client_name)") + " LIKE ? OR LOWER(client_id_card) LIKE ? OR LOWER(client_address) LIKE ?" +
      (cardKeys.length ? " OR upper(replace(client_id_card, ' ', '')) IN (" + cardKeys.map(() => "?").join(", ") + ")" : "") + ") ";
    bind.push(mtFoldText(q), q, q, ...cardKeys); // W2
  }

  sql += `
    GROUP BY LOWER(TRIM(client_name)), LOWER(TRIM(client_id_card))
    ORDER BY last_date DESC
    LIMIT ?
  `;
  bind.push(limit * 3); // spellings of one card are folded together below

  const rows = await dbAll(env, sql, bind);

  // Older lines keep the spelling they were written with (123M, 0000123M): one suggestion per name and card.
  const out = [];
  const seen = new Set();
  for (const r of rows) {
    const k = String(r.client_name || "").trim().toLowerCase() + "|" + normalizeMtIdCard(r.client_id_card);
    if (seen.has(k)) continue;
    seen.add(k);
    out.push({
      client_name: r.client_name || "",
      client_id_card: normalizeMtIdCard(r.client_id_card) || r.client_id_card || "",
      client_address: r.client_address || "",
    });
    if (out.length >= limit) break;
  }

  return jsonResponse({ ok: true, clients: out }, 200, corsOkHeaders);
}

