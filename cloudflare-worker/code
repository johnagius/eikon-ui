    if (body.plans_rota !== undefined) { if (typeof body.plans_rota !== "boolean") return jsonResponse({ ok: false, error: "plans_rota must be true or false" }, 400, cors); ch.plans_rota = body.plans_rota ? 1 : 0; }
    if (!Object.keys(ch).length) return jsonResponse({ ok: false, error: "Nothing to change" }, 400, cors);
