}


// ------------------------------------------------------------
// Stock Transfers
// ------------------------------------------------------------
async function ensureStockTransfersSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS stock_transfer_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    entry_date TEXT NOT NULL,
    item_description TEXT NOT NULL,
    batch TEXT NOT NULL DEFAULT '',
    expiry_date TEXT,
    quantity_available INTEGER NOT NULL DEFAULT 0,
    is_closed INTEGER NOT NULL DEFAULT 0,
    close_reason TEXT NOT NULL DEFAULT '',
    source_module TEXT NOT NULL DEFAULT '',
    source_id INTEGER,
    placed_on_returns INTEGER NOT NULL DEFAULT 0,
    placed_on_returns_id INTEGER,
    placed_on_scarce_stock INTEGER NOT NULL DEFAULT 0,
    placed_on_scarce_stock_id INTEGER,
    created_by INTEGER,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_by INTEGER
  )`, []);

  await dbRun(env, `CREATE TABLE IF NOT EXISTS stock_transfer_requests (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER NOT NULL,
    requester_org_id INTEGER NOT NULL,
    requester_location_id INTEGER NOT NULL,
    quantity_requested INTEGER NOT NULL DEFAULT 0,
    note TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'pending',
    created_by INTEGER,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_by INTEGER
  )`, []);

  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_st_items_org_loc ON stock_transfer_items (org_id, location_id)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_st_items_org ON stock_transfer_items (org_id)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_st_items_source ON stock_transfer_items (source_module, source_id)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_st_requests_item ON stock_transfer_requests (item_id)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_st_requests_requester ON stock_transfer_requests (requester_org_id, requester_location_id)", []);
}

function stText(v, max) {
  let s = String(v ?? "").trim();
  if (max && s.length > max) s = s.slice(0, max);
  return s;
}
function stInt(v) {
  const n = Number(v);
  if (!Number.isFinite(n)) return null;
  return Math.floor(n);
}
function isValidYmdSt(s) {
  return /^\d{4}-\d{2}-\d{2}$/.test(String(s || "").trim());
}
function todayYmdSt() {
  return tzYmd();
}

// ----- List all transfer items (visible to same org)
async function handleStockTransferItemsList(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const todayStr = todayYmdSt();

  // Auto-close expired items owned by this location and cascade to scarce stock
  const expiredTransfers = await dbAll(env, `
    SELECT id, placed_on_scarce_stock, placed_on_scarce_stock_id
    FROM stock_transfer_items
    WHERE org_id = ? AND location_id = ? AND expiry_date IS NOT NULL AND expiry_date <> '' AND expiry_date < ? AND is_closed = 0
  `, [authUser.org_id, authUser.location_id, todayStr]);

  for (const expItem of expiredTransfers) {
    await dbRun(env, "UPDATE stock_transfer_items SET is_closed = 1, close_reason = 'Expired', updated_at = datetime('now'), updated_by = ? WHERE id = ?", [authUser.user_id, expItem.id]);

    // Remove linked scarce stock offer (expired items cannot be on scarce stock)
    if (expItem.placed_on_scarce_stock && expItem.placed_on_scarce_stock_id) {
      await ensureScarceStockSchema(env);
      await dbRun(env, "DELETE FROM scarce_stock_offer_requests WHERE offer_id = ?", [expItem.placed_on_scarce_stock_id]);
      await dbRun(env, "DELETE FROM scarce_stock_offers WHERE id = ? AND org_id = ? AND location_id = ?",
        [expItem.placed_on_scarce_stock_id, authUser.org_id, authUser.location_id]);
      await dbRun(env, "UPDATE stock_transfer_items SET placed_on_scarce_stock = 0, placed_on_scarce_stock_id = NULL WHERE id = ?", [expItem.id]);
      await writeAudit(env, authUser.org_id, authUser.user_id, "SCARCE_OFFER_AUTO_DELETE", "scarce_stock_offers", String(expItem.placed_on_scarce_stock_id), { reason: "transfer_item_expired", transfer_item_id: expItem.id }, authUser.location_id);
    }
    // Note: expired items CAN still be on Returns (user requirement), so we don't remove placed_on_returns
  }

  // Get all items in the same org (cross-location visibility)
  const items = await dbAll(env, `
    SELECT i.*,
           o.name AS org_name,
           l.name AS location_name
    FROM stock_transfer_items i
    LEFT JOIN orgs o ON o.id = i.org_id
    LEFT JOIN locations l ON l.id = i.location_id
    WHERE i.org_id = ?${url && url.searchParams.get("open") === "1" ? " AND i.is_closed = 0" : ""}
    ORDER BY i.is_closed ASC, i.entry_date DESC, i.id DESC
  `, [authUser.org_id]);

  // Get all requests grouped by item
  const allRequests = await dbAll(env, `
    SELECT r.*,
           ro.name AS requester_org_name,
           rl.name AS requester_location_name
    FROM stock_transfer_requests r
    LEFT JOIN orgs ro ON ro.id = r.requester_org_id
    LEFT JOIN locations rl ON rl.id = r.requester_location_id
    WHERE r.item_id IN (SELECT id FROM stock_transfer_items WHERE org_id = ?${url && url.searchParams.get("open") === "1" ? " AND is_closed = 0" : ""})
    ORDER BY r.created_at ASC
  `, [authUser.org_id]);

  // Group requests by item_id
  const reqMap = {};
  for (const r of allRequests) {
    if (!reqMap[r.item_id]) reqMap[r.item_id] = [];
    reqMap[r.item_id].push(r);
  }

  // Build response
  const result = items.map(item => {
    const requests = (reqMap[item.id] || []).map(r => {
      const canSee = ssCanSeeSensitive(authUser, item.org_id, item.location_id, r.requester_org_id, r.requester_location_id);
      return {
        id: r.id,
        quantity_requested: r.quantity_requested,
        status: r.status,
        note: canSee ? (r.note || "") : "",
        mine: (r.requester_org_id === authUser.org_id && r.requester_location_id === authUser.location_id),
        requester_display: canSee ? ((r.requester_org_name || "") + " — " + (r.requester_location_name || "")) : "Another pharmacy",
        created_at: r.created_at
      };
    });

    const totalRequested = requests.reduce((sum, r) => {
      if (r.status !== "rejected" && r.status !== "cancelled") return sum + (r.quantity_requested || 0);
      return sum;
    }, 0);

    const totalDelivered = requests.reduce((sum, r) => {
      if (r.status === "delivered") return sum + (r.quantity_requested || 0);
      return sum;
    }, 0);

    const remaining = Math.max(0, (item.quantity_available || 0) - totalDelivered);

    return {
      id: item.id,
      entry_date: item.entry_date,
      item_description: item.item_description,
      batch: item.batch || "",
      expiry_date: item.expiry_date || "",
      quantity_available: item.quantity_available,
      remaining_quantity: remaining,
      total_requested: totalRequested,
      is_closed: item.is_closed,
      close_reason: item.close_reason || "",
      source_module: item.source_module || "",
      source_id: item.source_id,
      placed_on_returns: item.placed_on_returns,
      placed_on_returns_id: item.placed_on_returns_id,
      placed_on_scarce_stock: item.placed_on_scarce_stock,
      placed_on_scarce_stock_id: item.placed_on_scarce_stock_id,
      mine_owner: (item.org_id === authUser.org_id && item.location_id === authUser.location_id),
      org_name: item.org_name || "",
      location_name: item.location_name || "",
      requests: requests
    };
  });

  return jsonResponse({ ok: true, items: result }, 200, corsOkHeaders);
}

// ----- Create transfer item
async function handleStockTransferItemCreate(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const body = await readJson(request);
  const entryDate = stText(body.entry_date, 10) || todayYmdSt();
  const itemDesc = stText(body.item_description, 500);
  const batch = stText(body.batch, 200);
  const expiryDate = stText(body.expiry_date, 10);
  const qty = stInt(body.quantity_available);
  const sourceModule = stText(body.source_module, 50);
  const sourceId = body.source_id ? stInt(body.source_id) : null;

  if (!isValidYmdSt(entryDate)) return jsonResponse({ ok: false, error: "Invalid entry_date" }, 400, corsOkHeaders);
  if (!itemDesc) return jsonResponse({ ok: false, error: "item_description is required" }, 400, corsOkHeaders);
  if (expiryDate && !isValidYmdSt(expiryDate)) return jsonResponse({ ok: false, error: "Invalid expiry_date format" }, 400, corsOkHeaders);
  if (expiryDate && expiryDate < todayYmdSt()) return jsonResponse({ ok: false, error: "Expired items cannot be placed for transfer" }, 400, corsOkHeaders);
  if (qty === null || qty < 1) return jsonResponse({ ok: false, error: "quantity_available must be at least 1" }, 400, corsOkHeaders);

  // Prevent duplicate source linking
  if (sourceModule && sourceId) {
    const dup = await dbFirst(env, `
      SELECT id FROM stock_transfer_items
      WHERE org_id = ? AND location_id = ? AND source_module = ? AND source_id = ? AND is_closed = 0
    `, [authUser.org_id, authUser.location_id, sourceModule, sourceId]);
    if (dup) return jsonResponse({ ok: false, error: "This item is already on the transfer list" }, 409, corsOkHeaders);
  }

  const res = await dbRun(env, `
    INSERT INTO stock_transfer_items (org_id, location_id, entry_date, item_description, batch, expiry_date, quantity_available, source_module, source_id, created_by, updated_by)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `, [authUser.org_id, authUser.location_id, entryDate, itemDesc, batch, expiryDate || null, qty, sourceModule, sourceId, authUser.user_id, authUser.user_id]);

  const newId = res.meta?.last_row_id || null;
  await writeAudit(env, authUser.org_id, authUser.user_id, "STOCK_TRANSFER_CREATE", "stock_transfer_items", String(newId), { item_description: itemDesc, quantity: qty, source_module: sourceModule, source_id: sourceId }, authUser.location_id);

  return jsonResponse({ ok: true, id: newId }, 201, corsOkHeaders);
}

// ----- Update transfer item
async function handleStockTransferItemUpdate(request, env, corsOkHeaders, authUser, itemId) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  await ensureStockTransfersSchema(env);

  const existing = await dbFirst(env, "SELECT * FROM stock_transfer_items WHERE id = ?", [itemId]);
  if (!existing) return jsonResponse({ ok: false, error: "Not found" }, 404, corsOkHeaders);
  if (existing.org_id !== authUser.org_id || existing.location_id !== authUser.location_id) {
    return jsonResponse({ ok: false, error: "Forbidden: not your item" }, 403, corsOkHeaders);
  }

  const body = await readJson(request);
  const itemDesc = stText(body.item_description, 500) || existing.item_description;
  const batch = body.batch !== undefined ? stText(body.batch, 200) : existing.batch;
  const expiryDate = body.expiry_date !== undefined ? stText(body.expiry_date, 10) : existing.expiry_date;
  const qty = body.quantity_available !== undefined ? stInt(body.quantity_available) : existing.quantity_available;
  const isClosed = body.is_closed !== undefined ? (body.is_closed ? 1 : 0) : existing.is_closed;
  const closeReason = body.close_reason !== undefined ? stText(body.close_reason, 500) : existing.close_reason;

  if (expiryDate && !isValidYmdSt(expiryDate)) return jsonResponse({ ok: false, error: "Invalid expiry_date format" }, 400, corsOkHeaders);
  if (qty !== null && qty < 0) return jsonResponse({ ok: false, error: "quantity_available cannot be negative" }, 400, corsOkHeaders);

  await dbRun(env, `
    UPDATE stock_transfer_items
    SET item_description = ?, batch = ?, expiry_date = ?, quantity_available = ?,
