async function handlePaidOutNames(request, env, corsOkHeaders, authUser, url) {
  if (!requireRole(authUser, ["admin", "staff", "user"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await ensurePaidOutSchema(env);

  const q = (url.searchParams.get("q") || "").trim();
  const hasQ = !!q;
  const qLike = `%${q}%`;

  const rows = await dbAll(
    env,
    `
    SELECT payee_name, MAX(entry_date) AS last_date, COUNT(1) AS c
    FROM paid_out_entries
    WHERE org_id = ?
      AND location_id = ?
      ${hasQ ? "AND payee_name LIKE ?" : ""}
    GROUP BY payee_name
    ORDER BY last_date DESC, c DESC, payee_name ASC
    LIMIT 25
