let _boardSchemaReady = false;
let _boardLastCleanup = 0;

async function ensureBoardSchema__impl(env) {
  if (_boardSchemaReady) return;

  await dbRun(env, `CREATE TABLE IF NOT EXISTS board_messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    user_name TEXT NOT NULL DEFAULT '',
    location_name TEXT NOT NULL DEFAULT '',
    org_name TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL,
    scope TEXT NOT NULL DEFAULT 'all',
    is_pinned INTEGER NOT NULL DEFAULT 0,
    pinned_at TEXT,
    pinned_by INTEGER,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_msg_scope_created ON board_messages(scope, created_at DESC)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_msg_org_created ON board_messages(org_id, scope, created_at DESC)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_msg_pinned ON board_messages(is_pinned, created_at DESC)`, []);
  // Board cost (Team round 2): the list, its minute refresh, the pinned list and the dashboard read only the rows they
  // show. Each visibility branch walks its own index in id order and stops at the LIMIT (see boardVisibleSql).
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_msg_scope_id ON board_messages(scope, id)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_msg_org_scope_id ON board_messages(org_id, scope, id)`, []);

  await dbRun(env, `CREATE TABLE IF NOT EXISTS board_mentions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    message_id INTEGER NOT NULL,
    mentioned_user_id INTEGER NOT NULL,
    is_read INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_mention_user ON board_mentions(mentioned_user_id, is_read)`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_mention_msg ON board_mentions(message_id)`, []);

  await dbRun(env, `CREATE TABLE IF NOT EXISTS board_suggestions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    message_id INTEGER,
    title TEXT NOT NULL,
    priority TEXT NOT NULL DEFAULT 'medium',
    created_by INTEGER,
    created_by_name TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'open',
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    updated_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_sug_created ON board_suggestions(created_at DESC)`, []);

  await dbRun(env, `CREATE TABLE IF NOT EXISTS board_user_state (
    user_id INTEGER PRIMARY KEY,
    last_read_id INTEGER NOT NULL DEFAULT 0
  )`, []);

  await dbRun(env, `CREATE TABLE IF NOT EXISTS board_suggestion_comments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    suggestion_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    user_name TEXT NOT NULL DEFAULT '',
    body TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
  )`, []);
  await dbRun(env, `CREATE INDEX IF NOT EXISTS idx_board_sugcom_sug ON board_suggestion_comments(suggestion_id)`, []);

  _boardSchemaReady = true;
}

async function boardCleanupOldMessages(env) {
  const now = Date.now();
  if (now - _boardLastCleanup < 5 * 60 * 1000) return; // at most every 5 min
  _boardLastCleanup = now;
  try {
    await dbRun(env, `DELETE FROM board_messages WHERE is_pinned = 0 AND created_at < datetime('now', '-6 months')`, []);
  } catch (e) {
    console.log("[board] cleanup error", e && (e.message || e));
  }
}

// Board visibility, verbatim everywhere: (m.scope = 'all' OR (m.scope = 'org' AND m.org_id = ?)) — a group's private
// messages never reach another group. The planner turns that OR into a MULTI-INDEX OR over the scope indexes and then
// sorts every visible row to find the newest few (~13k rows read for 50 shown on a 20k board; D1 keeps no ANALYZE
// statistics). Here the same rows come from the two disjoint halves of that clause, each walking its own index
// (idx_board_msg_scope_id, idx_board_msg_org_scope_id) in id order and stopping at the LIMIT, then merged and cut to the
// same LIMIT: the same messages in the same order, at most 2 x LIMIT rows read. `extra` is extra conditions on m (id
// cursors), `order` is "DESC" or "ASC"; bind: [...extraBind, limit, orgId, ...extraBind, limit, limit].
// orgOnly: the "Our group only" view (the second half alone, as before: m.scope = 'org' AND m.org_id = ?).
const BOARD_MSG_COLS = `m.id, m.org_id, m.location_id, m.user_id, m.user_name, m.location_name, m.org_name,
           m.body, m.scope, m.is_pinned, m.pinned_at, m.pinned_by, m.created_at, m.updated_at`;
function boardVisibleSql(cols, extra, order, orgOnly) {
  const grp = `SELECT ${cols} FROM board_messages m WHERE m.org_id = ? AND m.scope = 'org'${extra} ORDER BY m.id ${order} LIMIT ?`;
  if (orgOnly) return { sql: grp, bind: (orgId, extraBind, limit) => [orgId, ...extraBind, limit] };
  return {
    sql: `SELECT * FROM (SELECT ${cols} FROM board_messages m WHERE m.scope = 'all'${extra} ORDER BY m.id ${order} LIMIT ?)
          UNION ALL SELECT * FROM (${grp})
          ORDER BY id ${order} LIMIT ?`,
    bind: (orgId, extraBind, limit) => [...extraBind, limit, orgId, ...extraBind, limit, limit]
  };
}

// --- List messages (cursor-based) ---
async function handleBoardMessagesList(request, env, corsOkHeaders, authUser, url) {
  await ensureBoardSchema(env);
  await boardCleanupOldMessages(env);

  const scope = (url.searchParams.get("scope") || "all").trim().toLowerCase();
  const before = parseInt(url.searchParams.get("before")) || 0;
  const after = parseInt(url.searchParams.get("after")) || 0;
  const limit = Math.min(parseInt(url.searchParams.get("limit")) || 50, 100);
  const pinnedOnly = url.searchParams.get("pinned") === "1";

  // Cursors, as before: older than `before`, newer than `after` (both may be given).
  let extra = "", extraBind = [];
  if (before > 0) { extra += " AND m.id < ?"; extraBind.push(before); }
  if (after > 0) { extra += " AND m.id > ?"; extraBind.push(after); }
  const order = after > 0 ? "ASC" : "DESC";

  let rows;
  if (pinnedOnly) {
    // Pinned view: the same visibility as the All view (a group's own messages never reach other groups). Pinned rows
    // are few (30 per group): read them on idx_board_msg_pinned and sort those; the unary + keeps the planner off the
    // scope indexes (a MULTI-INDEX OR there would read every visible message).
    rows = await dbAll(env, `
      SELECT ${BOARD_MSG_COLS}
      FROM board_messages m
      WHERE m.is_pinned = 1 AND (+m.scope = ${boardAllLit(authUser)} OR (+m.scope = 'org' AND +m.org_id = ?))${extra}
      ORDER BY m.id ${order}
      LIMIT ?
    `, [authUser.org_id, ...extraBind, limit]);
  } else {
    // "Our group only" (scope=org): only the group's own messages; Everything: everyone's + the group's own.
    const q = boardVisibleSql(BOARD_MSG_COLS, extra, order, scope === "org" || !!authUser.demo);
    rows = await dbAll(env, q.sql, q.bind(authUser.org_id, extraBind, limit));
  }

  // If we fetched with ASC (polling for new), reverse so newest is first
  if (after > 0) rows.reverse();

  // Track last-read message on initial load (no before/after = fresh page open)
  if (!before && !after && !pinnedOnly && rows.length > 0) {
    const maxId = rows[0].id; // rows are DESC, so first is newest
    try {
      await dbRun(env, `INSERT INTO board_user_state(user_id, last_read_id) VALUES(?, ?)
        ON CONFLICT(user_id) DO UPDATE SET last_read_id = MAX(last_read_id, excluded.last_read_id)`,
        [authUser.user_id, maxId]);
    } catch (e) {
      console.log("[board] last_read_id upsert error", e && (e.message || e));
    }
  }

  return jsonResponse({ ok: true, messages: rows }, 200, corsOkHeaders);
}

// @mentions: which known location names a board message names. Each "@" takes the longest name that
// follows it (case-insensitive, letters as stored) and is not followed by more of a word. Returns one
// list of stored spellings per distinct name (names differing only in case are the same pharmacy name).
function boardMentionedLocationNames(text, names) {
  const byKey = new Map();
  for (const n of names || []) {
    const stored = String(n == null ? "" : n);
    if (!stored.trim()) continue;
    const key = stored.toLowerCase();
    if (!byKey.has(key)) byKey.set(key, []);
    if (!byKey.get(key).includes(stored)) byKey.get(key).push(stored);
  }
  const keys = [...byKey.keys()].sort((a, b) => b.length - a.length);
  const found = new Map();
  for (let i = text.indexOf("@"); i !== -1; i = text.indexOf("@", i + 1)) {
    for (const key of keys) {
      const end = i + 1 + key.length;
      if (text.slice(i + 1, end).toLowerCase() !== key) continue;
      if (end < text.length && /[\p{L}\p{N}_]/u.test(text[end])) continue;
      found.set(key, byKey.get(key));
      break;
    }
  }
  return [...found.values()];
}

// --- Create message ---
async function handleBoardMessageCreate(request, env, corsOkHeaders, authUser) {
  await ensureBoardSchema(env);
  const body = await readJson(request);
  const msgBody = String(body.body || "").trim();
  if (!msgBody) return jsonResponse({ ok: false, error: "Message body is required" }, 400, corsOkHeaders);
  if (msgBody.length > 2000) return jsonResponse({ ok: false, error: "Message too long (max 2000 characters)" }, 400, corsOkHeaders);

  const scope = (String(body.scope || "all").trim().toLowerCase() === "org") ? "org" : "all";

  const res = await dbRun(env, `
    INSERT INTO board_messages (org_id, location_id, user_id, user_name, location_name, org_name, body, scope, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))
  `, [authUser.org_id, authUser.location_id, authUser.user_id, authUser.full_name || "", authUser.location_name || "", authUser.org_name || "", msgBody, scope]);

  const newId = (res && res.meta && res.meta.last_row_id) ? Number(res.meta.last_row_id) : null;

  // Parse @mentions — match @ against the known pharmacy names (longest first, case-insensitive, a word
  // boundary after the name), so "@Birkirkara can you…" and "@Birkirkara, can you…" both reach Birkirkara
  // and "@Birk" reaches nobody. A group-only message only considers, and only reaches, that group.
  if (newId && msgBody.includes("@")) {
    const locRows = await dbAll(env, `SELECT DISTINCT name FROM locations WHERE COALESCE(name,'') != ''${scope === "org" ? " AND org_id = ?" : ""}`,
      scope === "org" ? [authUser.org_id] : []);
    const seenUsers = new Set();
    for (const storedNames of boardMentionedLocationNames(msgBody, locRows.map((r) => r.name))) {
      // Look up all users at the mentioned location
      // A group-only message only reaches people in that group, even when it names another group's pharmacy
      const mentionedUsers = await dbAll(env, `
        SELECT u.id FROM users u
        LEFT JOIN locations l ON l.id = u.default_location_id
        WHERE u.is_active = 1 AND u.id != ? AND l.name IN (${storedNames.map(() => "?").join(",")})
          ${scope === "org" ? "AND u.org_id = ?" : ""}
      `, scope === "org" ? [authUser.user_id, ...storedNames, authUser.org_id] : [authUser.user_id, ...storedNames]);
      for (const mu of mentionedUsers) {
        if (seenUsers.has(mu.id)) continue;
        seenUsers.add(mu.id);
        await dbRun(env, `INSERT INTO board_mentions (message_id, mentioned_user_id, created_at) VALUES (?, ?, datetime('now'))`, [newId, mu.id]);
      }
    }
  }

  // Parse #suggestion
  if (newId && /#suggestion/i.test(msgBody)) {
    // Use the message body (minus the #suggestion tag) as title, truncate to 500 chars
    const sugTitle = msgBody.replace(/#suggestion/gi, "").trim().slice(0, 500) || msgBody.slice(0, 500);
    await dbRun(env, `
      INSERT INTO board_suggestions (org_id, message_id, title, priority, created_by, created_by_name, status, created_at, updated_at)
      VALUES (?, ?, ?, 'medium', ?, ?, 'open', datetime('now'), datetime('now'))
    `, [authUser.org_id, newId, sugTitle, authUser.user_id, authUser.full_name || ""]);
  }

  // Update last_read_id so the user's own message doesn't count as unread
  try {
    await dbRun(env, `INSERT INTO board_user_state(user_id, last_read_id) VALUES(?, ?)
      ON CONFLICT(user_id) DO UPDATE SET last_read_id = MAX(last_read_id, excluded.last_read_id)`,
      [authUser.user_id, newId]);
  } catch (e) {}

  // Return the created message
  const msg = await dbFirst(env, `SELECT * FROM board_messages WHERE id = ?`, [newId]);
  await writeAudit(env, authUser.org_id, authUser.user_id, "BOARD_MESSAGE_CREATE", "board_messages", String(newId || ""), { scope, after: msg }, authUser.location_id);
  return jsonResponse({ ok: true, id: newId, message: msg }, 200, corsOkHeaders);
}

// --- Pin/Unpin ---
async function handleBoardMessagePin(request, env, corsOkHeaders, authUser, msgId) {
  await ensureBoardSchema(env);
  // Only a message this person can see: everyone's, or their own group's (not another group's private ones)
  const existing = await dbFirst(env, `SELECT id, is_pinned FROM board_messages WHERE id = ? AND (scope = ${boardAllLit(authUser)} OR (scope = 'org' AND org_id = ?))`, [msgId, authUser.org_id]);
  if (!existing) return jsonResponse({ ok: false, error: "Message not found" }, 404, corsOkHeaders);

  const newPinned = existing.is_pinned ? 0 : 1;

  if (newPinned === 1) {
    // At most 30 pinned per group (Team round 2; it used to be 30 across all groups together): what counts is what this
    // person's group sees pinned — everyone's pinned messages plus its own group-only ones, the board's visibility clause
    // — so one group's group-only pins never block another group. Reads only pinned rows (idx_board_msg_pinned; the
    // unary + keeps the planner off the scope indexes).
    const countRow = await dbFirst(env, `SELECT COUNT(*) as c FROM board_messages m
      WHERE m.is_pinned = 1 AND (+m.scope = ${boardAllLit(authUser)} OR (+m.scope = 'org' AND +m.org_id = ?))`, [authUser.org_id]);
    if (countRow && countRow.c >= 30) {
      return jsonResponse({ ok: false, error: "Maximum 30 pinned messages reached. Unpin another message first." }, 400, corsOkHeaders);
    }
  }

  await dbRun(env, `UPDATE board_messages SET is_pinned = ?, pinned_at = ?, pinned_by = ?, updated_at = datetime('now') WHERE id = ?`,
    [newPinned, newPinned ? nowIso() : null, newPinned ? authUser.user_id : null, msgId]);

  await writeAudit(env, authUser.org_id, authUser.user_id, "BOARD_MESSAGE_PIN", "board_messages", String(msgId), { is_pinned: newPinned }, authUser.location_id);
  return jsonResponse({ ok: true, is_pinned: newPinned }, 200, corsOkHeaders);
}

// --- Delete message (own only) ---
async function handleBoardMessageDelete(request, env, corsOkHeaders, authUser, msgId) {
  await ensureBoardSchema(env);
  const existing = await dbFirst(env, `SELECT id, user_id FROM board_messages WHERE id = ?`, [msgId]);
  if (!existing) return jsonResponse({ ok: false, error: "Message not found" }, 404, corsOkHeaders);
  if (existing.user_id !== authUser.user_id) return jsonResponse({ ok: false, error: "You can only delete your own messages" }, 403, corsOkHeaders);
  const __before = await auditSnap(env, "board_messages", msgId, null);

  await dbRun(env, `DELETE FROM board_mentions WHERE message_id = ?`, [msgId]);
  await dbRun(env, `DELETE FROM board_messages WHERE id = ?`, [msgId]);
  await writeAudit(env, authUser.org_id, authUser.user_id, "BOARD_MESSAGE_DELETE", "board_messages", String(msgId), { before: __before }, authUser.location_id);
  return jsonResponse({ ok: true }, 200, corsOkHeaders);
}

// --- Mentions list ---
async function handleBoardMentionsList(request, env, corsOkHeaders, authUser, url) {
  await ensureBoardSchema(env);
  const unreadOnly = url.searchParams.get("unread") === "1";

  let sql = `SELECT bm.id, bm.message_id, bm.is_read, bm.created_at,
                    m.body, m.user_name, m.location_name, m.scope, m.created_at AS msg_created_at
             FROM board_mentions bm
             JOIN board_messages m ON m.id = bm.message_id
             WHERE bm.mentioned_user_id = ? AND (m.scope = ${boardAllLit(authUser)} OR (m.scope = 'org' AND m.org_id = ?))`;
  const bind = [authUser.user_id, authUser.org_id];
  if (unreadOnly) {
    sql += ` AND bm.is_read = 0`;
  }
