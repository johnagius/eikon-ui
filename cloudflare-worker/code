  const jsonOut = (o, st = 200) => new Response(JSON.stringify(o), { status: st, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "X-Robots-Tag": "noindex" } });
  const lateMsg = `Too late to change online. Please call ${pharmacy}${s.phone ? " on " + s.phone : ""}.`;
  const dayOk = (d) => /^\d{4}-\d{2}-\d{2}$/.test(d) && d >= now.date && bkDaysBetween(now.date, d) <= 62;
  if (m[3] === "/times" || m[3] === "/days") {
    if (!canChange) return jsonOut({ ok: false, error: b.status === "cancelled" ? "This booking is cancelled." : lateMsg }, 409);
    const svcRow = await bkGetService(env, b.org_id, b.location_id, b.service_id);
    if (m[3] === "/days") {
      const days = [];
      for (let i = 0; i < 14; i++) { const d = bkAddDays(now.date, i); days.push({ date: d, free: (await bkSlotsFor(env, b.org_id, b.location_id, svcRow, d, null, b.id)).length > 0 }); }
      return jsonOut({ ok: true, days, current: { date: b.date, start: b.start_time } });
    }
    const d = String(url.searchParams.get("date") || "");
    if (!dayOk(d)) return jsonOut({ ok: false, error: "Choose a day from today up to two months ahead" }, 400);
    const slots = (await bkSlotsFor(env, b.org_id, b.location_id, svcRow, d, null, b.id)).filter((x) => !(d === b.date && x.time === b.start_time));
    const seen = {}; // one button per time, whoever is free
    return jsonOut({ ok: true, date: d, slots: slots.filter((x) => (seen[x.time] ? false : (seen[x.time] = 1))).map((x) => ({ time: x.time })) });
  }
  if (m[3] === "/move" && request.method === "POST") {
    if (!canChange) return jsonOut({ ok: false, error: b.status === "cancelled" ? "This booking is cancelled." : lateMsg }, 409);
    const body = await readJson(request) || {};
    const nd = String(body.date || ""), ns = String(body.start || "");
    if (!dayOk(nd) || !/^\d{2}:\d{2}$/.test(ns)) return jsonOut({ ok: false, error: "Choose a day from today up to two months ahead" }, 400);
    const svcRow = await bkGetService(env, b.org_id, b.location_id, b.service_id);
    const free = await bkSlotsFor(env, b.org_id, b.location_id, svcRow, nd, null, b.id);
    // Keep the same person when they are free; otherwise whoever is.
    const pick = free.find((x) => x.time === ns && x.providerId === b.provider_id) || free.find((x) => x.time === ns);
    if (!pick) return jsonOut({ ok: false, error: "That time is no longer free. Please pick another." }, 409);
    let r = null;
    try {
      r = await dbFirst(env, `UPDATE bk_bookings SET date=?, start_time=?, end_time=?, provider_id=?, version=version+1, updated_at=datetime('now')
        WHERE id=? AND version=? AND status IN ('booked','confirmed') RETURNING *`, [nd, ns, bkTime(bkMin(ns) + svcRow.durationMin), pick.providerId, b.id, b.version]);
    } catch (e) { return jsonOut({ ok: false, error: "That time is no longer free. Please pick another." }, 409); }
    if (!r) return jsonOut({ ok: false, error: "Your booking changed meanwhile. Please reload." }, 409);
    await writeAudit(env, b.org_id, null, "BK_MOVE_ONLINE", "bk_bookings", String(b.id), { from: b.date + " " + b.start_time, to: nd + " " + ns }, b.location_id);
    await bkNotify(env, request, r, "change");
    return jsonOut({ ok: true, when: bkWhen(r) });
  }
  if (m[3] === "/move") return bkMovePage(pharmacy, svcName, bkWhen(b), base, canChange ? "" : (b.status === "cancelled" ? "This booking is cancelled." : lateMsg));

  // "I'll be there": the customer confirms from the reminder (a button on this page, never the e-mail link itself,
  // so a mail scanner opening links confirms nothing).
  if (m[3] === "/confirm" && request.method === "POST") {
    if (!(b.status === "booked" || b.status === "confirmed") || startsIn < 0) return bkPage("Can't confirm", `<div class="c"><h1>This booking can't be confirmed</h1><div class="s">Please call ${e(pharmacy)}${s.phone ? " on " + e(s.phone) : ""}.</div></div>`, 409);
    const r = await dbFirst(env, `UPDATE bk_bookings SET status='confirmed', confirmed_at=datetime('now'), confirmed_via='customer', version=version+1, updated_at=datetime('now')
      WHERE id=? AND status='booked' RETURNING *`, [b.id]);
    if (r) await writeAudit(env, b.org_id, null, "BK_CONFIRM_ONLINE", "bk_bookings", String(b.id), {}, b.location_id);
    return bkPage("Confirmed", `<div class="c"><h1>Thank you</h1><div class="s">See you on ${e(bkWhen(b))}. ${e(pharmacy)} can see you confirmed.</div><a class="b" style="background:rgba(118,118,128,.12);color:inherit" href="${base}">Back to my booking</a></div>`);
  }
  if (m[3] === "/cancel" && request.method === "POST") {
    if (!canCancel) return bkPage("Can't cancel", `<div class="c"><h1>Too late to cancel online</h1><div class="s">Please call ${e(pharmacy)}${s.phone ? " on " + e(s.phone) : ""}.</div></div>`, 409);
    const r = await dbFirst(env, `UPDATE bk_bookings SET status='cancelled', cancel_reason='Cancelled by the customer online', version=version+1, updated_at=datetime('now')
      WHERE id=? AND status IN ('booked','confirmed') RETURNING *`, [b.id]);
    if (r) { await writeAudit(env, b.org_id, null, "BK_CANCEL_ONLINE", "bk_bookings", String(b.id), {}, b.location_id); await bkNotify(env, request, r, "cancel"); }
    return bkPage("Cancelled", `<div class="c"><h1>Cancelled</h1><div class="s">Your ${e(svcName.toLowerCase())} on ${e(bkWhen(b))} is cancelled. ${e(pharmacy)} has been told.</div></div>`);
  }

  const state = b.status === "cancelled" ? "Cancelled" : b.status === "done" ? "Done" : b.status === "confirmed" ? "Confirmed" : "Booked";
  const canConfirm = b.status === "booked" && startsIn >= 0;
  const roomName = b.status === "cancelled" ? "" : await bkRoomNameFor(env, b);
  return bkPage(`${svcName} · ${pharmacy}`, `<div class="c">
    <div class="s">${e(pharmacy)}</div><h1>${e(bkFirstName(b.person_name))}, you're ${b.status === "cancelled" ? "not booked" : "booked"}</h1>
    <div class="big">${e(svcName)}</div><div class="row">${e(bkWhen(b))}</div>
    <div class="row s">${e(state)}${roomName ? " · " + e(roomName) : ""}${s.address ? " · " + e(s.address) : ""}</div>
    ${canConfirm ? `<form method="post" action="${base}/confirm"><button class="b g">Yes, I'll be there</button></form>` : ""}
    ${b.status !== "cancelled" ? `<a class="b ${canConfirm ? "" : "g"}" ${canConfirm ? 'style="background:rgba(10,143,106,.11);color:#0A7A5B"' : ""} href="${base}.ics">Add to calendar</a>` : ""}
    ${canChange ? `<a class="b" style="background:rgba(10,143,106,.11);color:#0A7A5B" href="${base}/move">Change time</a>` : ""}
    ${canCancel ? `<form method="post" action="${base}/cancel" onsubmit="return confirm('Cancel this booking?')"><button class="b r">Cancel booking</button></form>` : ""}
    ${s.phone ? `<a class="b" style="background:rgba(118,118,128,.12);color:inherit" href="tel:${e(s.phone)}">Call ${e(pharmacy)}</a>` : ""}
  </div><div class="f">This page is only for you. Don't share the link.</div>`);
}

/* ══════════════════════════════════════════════════════════════════════════════
   BOOKINGS — import from the old Appointments tables (read-only on appt_*).
   POST /bookings/import-legacy?dry=1 reports what would move; without dry it moves it.
   Safe to run again: everything imported is remembered in bk_legacy_map and skipped.
   Doctor → provider (weekly hours from recurring schedules, one-off sessions as extras),
   doctor + clinic → service (length from the schedule, price = doctor + clinic fee),
   appointment → booking (statuses mapped), waiting list → waiting list.
   ══════════════════════════════════════════════════════════════════════════════ */
// The customer's "Change time" page: a day strip and the free times of the chosen day, then one tap to move.
function bkMovePage(pharmacy, svcName, whenText, base, blocked) {
  const e = (x) => String(x || "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  if (blocked) return bkPage("Change time", `<div class="c"><h1>Can't change online</h1><div class="s">${e(blocked)}</div></div>`, 409);
  return bkPage(`Change time · ${pharmacy}`, `<div class="c"><div class="s">${e(pharmacy)}</div><h1>Change time</h1>
  <div class="row s">${e(svcName)} · now ${e(whenText)}</div>
  <div id="days" style="display:flex;gap:6px;overflow-x:auto;margin:16px -4px 12px;padding:0 4px 4px"></div>
  <div id="times" style="display:flex;flex-wrap:wrap;gap:8px;min-height:44px"></div>
  <div id="msg" class="s" style="margin-top:12px"></div>
  <button id="go" class="b g" disabled style="opacity:.45">Choose a new time</button>
  <a class="b" style="background:rgba(118,118,128,.12);color:inherit" href="${e(base)}">Keep my booking</a></div>
  <style>.dy{flex:0 0 auto;width:52px;height:60px;border-radius:14px;border:0;background:rgba(118,118,128,.12);font:inherit;display:flex;flex-direction:column;align-items:center;justify-content:center;color:inherit}
  .dy small{font-size:11px;font-weight:600;opacity:.65;text-transform:uppercase}.dy b{font-size:18px}.dy.on{background:#066B4F;color:#fff}.dy:disabled{opacity:.3}
  .tm{height:42px;padding:0 14px;border-radius:12px;border:0;background:rgba(118,118,128,.12);font:600 16px -apple-system,Segoe UI,Arial,sans-serif;color:inherit}.tm.on{background:#066B4F;color:#fff}
  @media(prefers-color-scheme:dark){.dy.on,.tm.on{background:#32D39C;color:#00261B}}</style>
  <script>
  const B=${JSON.stringify(base)};let st={days:[],date:null,times:[],time:null,busy:false};
  const $=(i)=>document.getElementById(i),esc=(x)=>String(x).replace(/[&<>"]/g,(c)=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]);
  async function j(p,o){const r=await fetch(B+p,o);const x=await r.json().catch(()=>({ok:false,error:"Something went wrong"}));if(!x.ok)throw new Error(x.error);return x;}
  function paint(){
    $("days").innerHTML=st.days.map(d=>{const a=new Date(d.date+"T12:00:00");return '<button class="dy'+(st.date===d.date?" on":"")+'" data-d="'+d.date+'"'+(d.free?"":" disabled")+'><small>'+a.toLocaleDateString("en-GB",{weekday:"short"})+'</small><b>'+a.getDate()+'</b></button>';}).join("");
    $("times").innerHTML=st.times.length?st.times.map(t=>'<button class="tm'+(st.time===t.time?" on":"")+'" data-t="'+t.time+'">'+t.time+'</button>').join(""):(st.date?'<span class="s">No free times this day.</span>':'');
    const g=$("go");g.disabled=!st.time||st.busy;g.style.opacity=g.disabled?".45":"1";
    g.textContent=st.busy?"Moving…":st.time?"Move to "+new Date(st.date+"T12:00:00").toLocaleDateString("en-GB",{weekday:"short",day:"numeric",month:"short"})+" "+st.time:"Choose a new time";
  }
  async function day(d){st.date=d;st.time=null;st.times=[];paint();try{st.times=(await j("/times?date="+d)).slots;}catch(e){$("msg").textContent=e.message;}paint();}
  document.addEventListener("click",async(ev)=>{const t=ev.target.closest("[data-d],[data-t],#go");if(!t||t.disabled)return;$("msg").textContent="";
    if(t.dataset.d)return day(t.dataset.d);
    if(t.dataset.t){st.time=t.dataset.t;return paint();}
    st.busy=true;paint();try{const r=await j("/move",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({date:st.date,start:st.time})});
      document.querySelector(".c").innerHTML='<h1>Moved</h1><div class="s">Your booking is now '+esc(r.when)+'. We emailed you the new details.</div>';}
    catch(e){$("msg").textContent=e.message;st.busy=false;await day(st.date);}});
  (async()=>{try{const r=await j("/days");st.days=r.days;const f=r.days.find(d=>d.free);paint();if(f)await day(f.date);}catch(e){$("msg").textContent=e.message;}})();
  </script>`);
}

async function bkImportLegacy(env, authUser, dry) {
  await ensureBookingsSchema(env); await ensureApptSchema(env);
  await dbRun(env, `CREATE TABLE IF NOT EXISTS bk_legacy_map (org_id INTEGER NOT NULL, location_id INTEGER NOT NULL, kind TEXT NOT NULL, legacy_id TEXT NOT NULL, new_id INTEGER NOT NULL,
    PRIMARY KEY (org_id, location_id, kind, legacy_id))`, []);
  const org = authUser.org_id, loc = authUser.location_id;
  const mapGet = async (kind, id) => { const r = await dbFirst(env, `SELECT new_id FROM bk_legacy_map WHERE org_id=? AND location_id=? AND kind=? AND legacy_id=?`, [org, loc, kind, String(id)]); return r ? r.new_id : null; };
  const mapSet = async (kind, id, nid) => dbRun(env, `INSERT OR IGNORE INTO bk_legacy_map (org_id, location_id, kind, legacy_id, new_id) VALUES (?,?,?,?,?)`, [org, loc, kind, String(id), nid]);
  const rep = { providers: 0, services: 0, extras: 0, bookings: 0, upcoming: 0, clashes: 0, waiting: 0, skipped: 0, dry: !!dry };

  const doctors = await dbAll(env, `SELECT * FROM appt_doctors WHERE org_id=? AND location_id=?`, [org, loc]);
  const clinics = await dbAll(env, `SELECT * FROM appt_clinics WHERE org_id=? AND location_id=?`, [org, loc]);
  const scheds = await dbAll(env, `SELECT * FROM appt_schedules WHERE org_id=? AND location_id=? AND COALESCE(cancelled,0)=0`, [org, loc]);
  const appts = await dbAll(env, `SELECT * FROM appt_appointments WHERE org_id=? AND location_id=? ORDER BY date, time, id`, [org, loc]);
  const waits = await dbAll(env, `SELECT * FROM appt_waitlist WHERE org_id=? AND location_id=? AND LOWER(COALESCE(status,''))='waiting'`, [org, loc]);
  const clinicById = Object.fromEntries(clinics.map((c) => [c.id, c]));
  const today = bkNowLocal(env).date;

  // Providers with weekly hours (only schedules still valid today or later).
  const provFor = {};
  for (const d of doctors) {
    let pid = await mapGet("doctor", d.id);
    if (!pid) {
      const hours = {};
      for (const s of scheds.filter((x) => x.doctor_id === d.id && !x.is_one_off && (!x.valid_until || x.valid_until >= today))) {
        const wd = Number(s.day_of_week); if (!(wd >= 0 && wd <= 6)) continue;
        (hours[wd] = hours[wd] || []).push([String(s.start_time).slice(0, 5), String(s.end_time).slice(0, 5)]);
      }
      rep.providers++;
      if (!dry) { const r = await dbFirst(env, `INSERT INTO bk_providers (org_id, location_id, name, kind, hours_json) VALUES (?,?,?,?,?) RETURNING id`, [org, loc, String(d.name || "Doctor"), "doctor", JSON.stringify(bkCleanHours(hours))]); pid = r.id; await mapSet("doctor", d.id, pid); }
    }
    provFor[d.id] = pid;
  }
  // A "Pharmacy" provider for appointments that had no doctor.
  const noDoc = appts.some((a) => !a.doctor_id) || waits.some((w) => !w.doctor_id);
  if (noDoc) {
    let pid = await mapGet("doctor", "none");
    if (!pid) { rep.providers++; if (!dry) { const r = await dbFirst(env, `INSERT INTO bk_providers (org_id, location_id, name, kind, hours_json) VALUES (?,?,?,?,?) RETURNING id`, [org, loc, "Pharmacy", "pharmacist", "{}"]); pid = r.id; await mapSet("doctor", "none", pid); } }
    provFor["none"] = pid;
  }
  // Services: one per doctor + clinic pair actually used.
  const pairs = new Map();
  const pairKey = (d, c) => (d || "none") + "|" + (c || "none");
  for (const s of scheds) pairs.set(pairKey(s.doctor_id, s.clinic_id), { d: s.doctor_id, c: s.clinic_id, dur: s.slot_duration });
  for (const a of appts.concat(waits)) { const k = pairKey(a.doctor_id, a.clinic_id); if (!pairs.has(k)) pairs.set(k, { d: a.doctor_id, c: a.clinic_id, dur: a.duration_mins }); }
  const svcFor = {};
  for (const [k, p] of pairs) {
    let sid = await mapGet("service", k);
    if (!sid) {
      const doc = doctors.find((x) => x.id === p.d), cl = clinicById[p.c];
      const name = [doc ? doc.name : "Appointment", cl ? cl.name : ""].filter(Boolean).join(" · ");
      const dur = Math.min(480, Math.max(5, Math.round(Number(p.dur) || 15)));
      const price = Math.round(((Number(doc && doc.default_fee) || 0) + (Number(cl && cl.fee) || 0)) * 100);
      rep.services++;
      if (!dry) { const r = await dbFirst(env, `INSERT INTO bk_services (org_id, location_id, name, duration_min, price_cents, provider_ids_json) VALUES (?,?,?,?,?,?) RETURNING id`,
        [org, loc, name, dur, price, JSON.stringify([provFor[p.d || "none"]].filter(Boolean))]); sid = r.id; await mapSet("service", k, sid); }
    }
    svcFor[k] = sid;
  }
  // One-off sessions from today on become extra hours.
  for (const s of scheds.filter((x) => x.is_one_off && x.date && x.date >= today)) {
    if (await mapGet("oneoff", s.id)) continue;
    rep.extras++;
    if (!dry && provFor[s.doctor_id]) { const r = await dbFirst(env, `INSERT INTO bk_exceptions (org_id, location_id, provider_id, date, kind, start_time, end_time, note) VALUES (?,?,?,?,'extra',?,?,?) RETURNING id`,
      [org, loc, provFor[s.doctor_id], s.date, String(s.start_time).slice(0, 5), String(s.end_time).slice(0, 5), "Imported session"]); await mapSet("oneoff", s.id, r.id); }
  }
  // Bookings.
  const ST = { "scheduled": "booked", "confirmed": "confirmed", "completed": "done", "cancelled": "cancelled", "no show": "no_show", "no_show": "no_show", "promoted": "booked" };
  for (const a of appts) {
    if (await mapGet("appt", a.id)) { rep.skipped++; continue; }
    const st = ST[String(a.status || "").toLowerCase()] || "booked";
    const start = String(a.time || "").slice(0, 5); if (!isValidYmd(a.date) || !Number.isFinite(bkMin(start))) { rep.skipped++; continue; }
    const end = bkTime(bkMin(start) + (Math.round(Number(a.duration_mins)) || 15));
    const k = pairKey(a.doctor_id, a.clinic_id);
    rep.bookings++;
    if (a.date >= today && st !== "cancelled" && st !== "done" && st !== "no_show") rep.upcoming++; // still to come: what the move must not lose
    if (dry) continue;
    const vals = (status, reason) => [org, loc, a.appt_ref || bkRef(), svcFor[k], provFor[a.doctor_id || "none"], String(a.patient_name || "Unknown"), String(a.patient_phone || ""), String(a.patient_email || "").toLowerCase(),
      String(a.patient_id_card || "").toUpperCase(), a.date, start, end, status, Math.round(((Number(a.doctor_fee) || 0) + (Number(a.clinic_fee) || 0)) * 100), String(a.notes || ""), reason, bkRandomHex(16), authUser.user_id, authUser.user_id];
    const sql = `INSERT INTO bk_bookings (org_id, location_id, ref, service_id, provider_id, person_name, person_phone, person_email, person_id_card, date, start_time, end_time, status, price_cents, notes, cancel_reason, link_id, created_by, updated_by)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) RETURNING id`;
    let r;
    try { r = await dbFirst(env, sql, vals(st, st === "cancelled" ? String(a.cancellation_reason || "Cancelled") : "")); }
    catch (e) {
      if (!/UNIQUE/i.test(String(e && e.message))) throw e;
      // Two old bookings at the same time with the same doctor: keep the record, visibly, without double-booking.
      rep.clashes++; r = await dbFirst(env, sql, vals("cancelled", "Imported: clashed with another booking at the same time"));
    }
    await mapSet("appt", a.id, r.id);
  }
  // Waiting list.
  for (const w of waits) {
    if (await mapGet("wait", w.id)) continue;
    rep.waiting++;
    if (!dry) { const r = await dbFirst(env, `INSERT INTO bk_waitlist (org_id, location_id, service_id, person_name, person_phone, person_email, note, created_by) VALUES (?,?,?,?,?,?,?,?) RETURNING id`,
      [org, loc, svcFor[pairKey(w.doctor_id, w.clinic_id)], String(w.patient_name || "Unknown"), String(w.patient_phone || ""), String(w.patient_email || "").toLowerCase(), String(w.notes || ""), authUser.user_id]); await mapSet("wait", w.id, r.id); }
  }
  if (!dry) await writeAudit(env, org, authUser.user_id, "BK_IMPORT_LEGACY", "bk_bookings", String(loc), rep, loc);
  return rep;
}

/* ══════════════════════════════════════════════════════════════════════════════
   BOOKINGS — the pharmacy's public booking page /book/<slug> (off unless switched on).
   Only services marked "online" are offered. The customer picks a time, types name and
   email, and confirms with a 6-digit code sent by email (10 minutes, 5 tries), so bots
   cannot fill the diary. The slot is checked again when the code is confirmed.
   Rate-limited per network. Needs customer emails switched on.
   ══════════════════════════════════════════════════════════════════════════════ */
async function bkPublicLimit(env, request, bucket, max) {
  const ip = clientIp(request);
  await ensureLoginAttemptsSchema(env);
  const n = await dbFirst(env, "SELECT COUNT(*) AS c FROM login_attempts WHERE email=? AND ip=? AND attempted_at > datetime('now','-15 minutes')", [bucket, ip]);
  if (n && Number(n.c) >= max) return false;
  try { await dbRun(env, "INSERT INTO login_attempts (email, ip) VALUES (?, ?)", [bucket, ip]); } catch (e) {}
  return true;
}
async function handlePublicBooking(request, env, url) {
  await ensureBookingsMsgSchema(env);
  const m = /^\/book\/([a-z0-9-]{3,48})(?:\/(services|next|days|day|hold|confirm))?$/.exec(url.pathname);
  const json = (o, st = 200) => new Response(JSON.stringify(o), { status: st, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "X-Robots-Tag": "noindex" } });
  if (!m) return bkPage("Not found", `<div class="c"><h1>Page not found</h1></div>`, 404);
  const s = await dbFirst(env, `SELECT * FROM bk_settings WHERE public_slug=? AND public_enabled=1`, [m[1]]);
  if (!s) return m[2] ? json({ ok: false, error: "Online booking is not available" }, 404) : bkPage("Not available", `<div class="c"><h1>Online booking is not available</h1><div class="s">Please call the pharmacy.</div></div>`, 404);
  const org = s.org_id, loc = s.location_id;
  const locRow = await dbFirst(env, `SELECT name FROM locations WHERE id=?`, [loc]);
  const pharmacy = (locRow && locRow.name) || "Pharmacy";
  if (!(await bkPublicLimit(env, request, "bk-public", 120))) return m[2] ? json({ ok: false, error: "Too many requests. Try again in 15 minutes." }, 429) : bkPage("Please wait", `<div class="c"><h1>Please wait a moment</h1></div>`, 429);
  const onlineSvc = async (id) => { const r = await dbFirst(env, `SELECT * FROM bk_services WHERE id=? AND org_id=? AND location_id=? AND active=1 AND online=1`, [Number(id), org, loc]); return r ? bkServiceRow(r) : null; };

  if (m[2] === "services") {
    const rows = await dbAll(env, `SELECT * FROM bk_services WHERE org_id=? AND location_id=? AND active=1 AND online=1 ORDER BY sort, name`, [org, loc]);
