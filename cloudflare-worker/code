      updated_at = datetime('now')`,
    [authUser.org_id, authUser.location_id, idCard, name]);

  const row = await dbFirst(env,
    `SELECT id, id_card, name FROM loyalty_clients WHERE org_id=? AND location_id=? AND id_card=?`,
