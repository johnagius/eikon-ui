  if (!st || typeof st !== "object" || Array.isArray(st)) st = {};
  const before = pharmacyDetailsOf(st);
  const merged = Object.assign({}, st.pharmacyDetails && typeof st.pharmacyDetails === "object" ? st.pharmacyDetails : {}, next);
  // a first save makes the row the labels PUT would make: { templates: [], pharmacyDetails }
