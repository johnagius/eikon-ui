async function handleNearExpiryCreateReturn(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await ensureNearExpirySchema(env);
  await ensureReturnsSchema(env);

  const body = await readJson(request);
  const nearExpiryId = Number(body.near_expiry_id || 0);
  const supplier = String(body.supplier || "").trim();
  const quantity = String(body.quantity || "").trim();

  if (!nearExpiryId) return jsonResponse({ ok: false, error: "Missing near_expiry_id" }, 400, corsOkHeaders);

  // Look up the near expiry entry
  const ne = await dbFirst(env,
    `SELECT id, product_name, expiry_date, location, notes, return_id, return_status
     FROM near_expiry_entries WHERE id = ? AND org_id = ? AND location_id = ?`,
    [nearExpiryId, authUser.org_id, authUser.location_id]
  );
  if (!ne) return jsonResponse({ ok: false, error: "Near expiry entry not found" }, 404, corsOkHeaders);

  // Prevent duplicate returns
  if (ne.return_id) return jsonResponse({ ok: false, error: "A return already exists for this item" }, 409, corsOkHeaders);

  const entryDate = tzYmd(); // the pharmacy's (Malta's) day, not UTC's

  // Create the return entry
  const res = await dbRun(env, `
    INSERT INTO returns_entries (
      org_id, location_id,
      entry_date, description,
      expiry, batch, quantity, supplier, invoice_number, remarks, location_stored,
      return_arranged, handed_over, collection_note_received, credit_note_received,
      near_expiry_id,
      created_at, updated_at, created_by, updated_by
    ) VALUES (
      ?, ?,
      ?, ?,
      ?, NULL, ?, ?, NULL, ?, NULL,
      0, 0, 0, 0,
      ?,
      datetime('now'), datetime('now'), ?, ?
    )
  `, [
    authUser.org_id, authUser.location_id,
    entryDate, ne.product_name,
    ne.expiry_date || null, quantity || null, supplier || null, "Expiring soon",
    nearExpiryId,
    authUser.user_id, authUser.user_id
  ]);

  const returnId = (res && res.meta && res.meta.last_row_id) ? Number(res.meta.last_row_id) : null;

  // Link back: update near_expiry_entries
  await dbRun(env,
    `UPDATE near_expiry_entries SET return_id = ?, return_status = 'pending', updated_at = datetime('now'), updated_by = ?
     WHERE id = ? AND org_id = ? AND location_id = ?`,
    [returnId, authUser.user_id, nearExpiryId, authUser.org_id, authUser.location_id]
  );

  await writeAudit(env, authUser.org_id, authUser.user_id, "NEAR_EXPIRY_CREATE_RETURN", "near_expiry_entries", String(nearExpiryId), {
    return_id: returnId, product_name: ne.product_name
  }, authUser.location_id);

  // Return the updated near_expiry entry
  const updated = await dbFirst(env,
    `SELECT id, product_name, expiry_date, location, notes, return_id, return_status, created_by, created_at, updated_at, updated_by
     FROM near_expiry_entries WHERE id = ? AND org_id = ? AND location_id = ?`,
    [nearExpiryId, authUser.org_id, authUser.location_id]
  );

  return jsonResponse({ ok: true, return_id: returnId, near_expiry_entry: nearExpiryRowToUi(updated) }, 200, corsOkHeaders);
}

async function handleNearExpiryCreateReturnsBulk(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }

  await ensureNearExpirySchema(env);
  await ensureReturnsSchema(env);

  const body = await readJson(request);
  const ids = Array.isArray(body.near_expiry_ids) ? body.near_expiry_ids.map(Number).filter(Boolean) : [];
  const supplier = String(body.supplier || "").trim();
  const quantity = String(body.quantity || "").trim();

  if (!ids.length) return jsonResponse({ ok: false, error: "No items selected" }, 400, corsOkHeaders);
  if (ids.length > 100) return jsonResponse({ ok: false, error: "Too many items (max 100)" }, 400, corsOkHeaders);

  const entryDate = tzYmd(); // the pharmacy's (Malta's) day, not UTC's
  const returnIds = [];
  let skipped = 0;

  for (const neId of ids) {
    const ne = await dbFirst(env,
      `SELECT id, product_name, expiry_date, location, notes, return_id
       FROM near_expiry_entries WHERE id = ? AND org_id = ? AND location_id = ?`,
      [neId, authUser.org_id, authUser.location_id]
    );
    if (!ne || ne.return_id) { skipped++; continue; }

    const res = await dbRun(env, `
      INSERT INTO returns_entries (
        org_id, location_id,
        entry_date, description,
        expiry, batch, quantity, supplier, invoice_number, remarks, location_stored,
        return_arranged, handed_over, collection_note_received, credit_note_received,
        near_expiry_id,
        created_at, updated_at, created_by, updated_by
      ) VALUES (
        ?, ?,
        ?, ?,
        ?, NULL, ?, ?, NULL, ?, NULL,
        0, 0, 0, 0,
        ?,
        datetime('now'), datetime('now'), ?, ?
      )
    `, [
      authUser.org_id, authUser.location_id,
      entryDate, ne.product_name,
      ne.expiry_date || null, quantity || null, supplier || null, "Expiring soon",
      neId,
      authUser.user_id, authUser.user_id
    ]);

    const returnId = (res && res.meta && res.meta.last_row_id) ? Number(res.meta.last_row_id) : null;
