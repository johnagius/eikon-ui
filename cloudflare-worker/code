const BOARD_UNREAD_CAP = 100; // unread messages counted up to here; 100 means "99+" (owner, 2026-11-10)
async function handleBoardDashboard(request, env, corsOkHeaders, authUser) {
  await ensureBoardSchema(env);

  // Unread mention count
  const countRow = await dbFirst(env, `SELECT COUNT(*) as c FROM board_mentions bm JOIN board_messages m ON m.id = bm.message_id
    WHERE bm.mentioned_user_id = ? AND bm.is_read = 0 AND (m.scope = ${boardAllLit(authUser)} OR (m.scope = 'org' AND m.org_id = ?))`, [authUser.user_id, authUser.org_id]);
  const unreadMentions = (countRow && countRow.c) || 0;

  // Recent messages (org + all scope): the five newest visible, each half of the visibility clause on its own index
  const rq = boardVisibleSql("m.id, m.user_name, m.location_name, m.body, m.scope, m.created_at", "", "DESC", !!authUser.demo);
  const recent = await dbAll(env, rq.sql, rq.bind(authUser.org_id, [], 5));

  // Recent mentions for this user
  const recentMentions = await dbAll(env, `
    SELECT bm.id, bm.message_id, m.body, m.user_name, m.created_at
    FROM board_mentions bm
    JOIN board_messages m ON m.id = bm.message_id
    WHERE bm.mentioned_user_id = ? AND bm.is_read = 0 AND (m.scope = ${boardAllLit(authUser)} OR (m.scope = 'org' AND m.org_id = ?))
    ORDER BY bm.created_at DESC LIMIT 5
  `, [authUser.user_id, authUser.org_id]);

  // Unread messages count (messages since user last opened the board): exact up to 99, then capped at 100 (screens show
  // "99+", as /team/today does). Each half of the visibility clause walks its own covering index (id > last read) and the
  // UNION ALL stops at 100, so at most ~100 unread rows are read, however long the person has been away.
  const unreadMsgRow = await dbFirst(env, `
    SELECT COUNT(*) AS c FROM (
      SELECT 1 FROM board_messages m WHERE m.scope = ${boardAllLit(authUser)} AND m.id > COALESCE((SELECT last_read_id FROM board_user_state WHERE user_id = ?), 0)
      UNION ALL
      SELECT 1 FROM board_messages m WHERE m.org_id = ? AND m.scope = 'org' AND m.id > COALESCE((SELECT last_read_id FROM board_user_state WHERE user_id = ?), 0)
      LIMIT ${BOARD_UNREAD_CAP})
  `, [authUser.user_id, authUser.org_id, authUser.user_id]);
  const unreadMessages = (unreadMsgRow && unreadMsgRow.c) || 0;

  return jsonResponse({ ok: true, unread_mentions: unreadMentions, unread_messages: unreadMessages, recent_messages: recent, recent_mentions: recentMentions }, 200, corsOkHeaders);
}



// FIN-dayzero begin ═════════════════════════════════════════════════════════════════════════════════════════════
// (1) The day this pharmacy started, so no screen blames a day, a month or a sign-off from before it existed.
//     E.startYmd(user) contract: the earlier of the Malta day of locations.created_at and the first saved day in the
//     registers that are judged day by day (end of day, daily register, locum register, controlled drugs supplied,
//     paid out, temperature) — never later than any of those rows. "" when nothing can be read (then nothing is
//     clipped, as before). Read on the sign-in and /auth/me only (each page load): the day screens add no statement.
//     Each read is one index probe (MIN on an (org, location, date) index; temperature: one per
//     device). The answer is kept per database for the isolate's life only once it is DZ_SINCE_KEEP_DAYS or more before
//     today: no screen looks that far back, so a row typed later with an older date cannot change what any screen says.
//     A younger pharmacy is asked each time (a backfilled day or an import moves its start back at once; the
//     probes read a handful of index rows). Sent as user.location_since on /auth/me and the sign-in (and
//     `since` on /pharmacy/details); the day screens add no statement for it (/team/today only says hours_saved).
// (2) GET/PUT /pharmacy/details: the pharmacy's name, address, phone and registration no. for labels and prints,
//     stored where the label screens keep them (label_settings.settings_json.pharmacyDetails).
const __dzSince = new WeakMap();
const DZ_SINCE_KEEP_DAYS = 70; // longer than any look-back that uses it (last month's sign-off and stock take: at most 62 days)
function dzMaltaDay(s) { // a UTC "YYYY-MM-DD HH:MM:SS" stamp as the Malta day it fell on; "" if not a stamp
  const t = String(s || "").trim(); if (!/^\d{4}-\d{2}-\d{2}/.test(t)) return "";
  if (t.length <= 10) return t;
  const ms = Date.parse(t.replace(" ", "T") + (/[zZ]$|[+-]\d\d:?\d\d$/.test(t) ? "" : "Z"));
  return Number.isFinite(ms) ? tzYmd(new Date(ms)) : t.slice(0, 10);
}
async function locationSince(env, authUser) {
  const loc = Number(authUser && authUser.location_id) || 0, org = Number(authUser && authUser.org_id) || 0;
  if (!loc || !env || !env.DB) return "";
  let m = __dzSince.get(env.DB); if (!m) { m = new Map(); __dzSince.set(env.DB, m); }
  if (m.has(loc)) return m.get(loc);
  const one = async (sql) => { try { const r = await dbFirst(env, sql, [org, loc]); return r && r.d ? dzMaltaDay(r.d) : ""; } catch (e) { return ""; } };
  const days = await Promise.all([
    one("SELECT created_at AS d FROM locations WHERE org_id = ? AND id = ?"),
    one("SELECT MIN(eod_date) AS d FROM end_of_day WHERE org_id = ? AND location_id = ?"),
    one("SELECT MIN(entry_date) AS d FROM daily_register_entries WHERE org_id = ? AND location_id = ?"),
    one("SELECT MIN(entry_date) AS d FROM locum_register_entries WHERE org_id = ? AND location_id = ?"),
    one("SELECT MIN(entry_date) AS d FROM dda_sales_entries WHERE org_id = ? AND location_id = ?"),
    one("SELECT MIN(entry_date) AS d FROM paid_out_entries WHERE org_id = ? AND location_id = ?"),
    one(`SELECT MIN((SELECT MIN(t.entry_date) FROM temperature_entries t WHERE t.org_id = d.org_id AND t.location_id = d.location_id AND t.device_id = d.id)) AS d
           FROM temperature_devices d WHERE d.org_id = ? AND d.location_id = ?`)
  ]);
  if (!days[0]) return ""; // no creation stamp: say nothing (not kept: an older row stays as it always was)
  const since = days.filter((d) => /^\d{4}-\d{2}-\d{2}$/.test(d)).sort()[0] || "";
  if (since && since <= ymdPlusDays(tzYmd(), -DZ_SINCE_KEEP_DAYS)) m.set(loc, since);
  return since;
}

