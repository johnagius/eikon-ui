  if (a.length !== 3 || b.length !== 3) return null;
  return Math.round((Date.UTC(b[0], b[1] - 1, b[2]) - Date.UTC(a[0], a[1] - 1, a[2])) / 86400000);
}
function todayNum(v) { const n = Number(v); return Number.isFinite(n) ? n : null; }

async function handleToday(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  const today = tzYmd(), yesterday = ymdPlusDays(today, -1), in30 = ymdPlusDays(today, 30), sixMonthsAgo = ymdPlusDays(today, -183);
  const all = async (sql, bind) => { try { return await dbAll(env, sql, bind); } catch (e) { return []; } };
  const one = async (sql, bind) => { try { return await dbFirst(env, sql, bind); } catch (e) { return null; } };

  const ensures = [ensureDailyRegisterSchema, ensureCertificatesSchema, ensureAlertsSchema, ensureReturnsSchema, ensureNearExpirySchema,
    ensureClientOrdersSchema, ensureClientTicketsSchema, ensureDeliveriesSchema, ensureEndOfDaySchema, ensurePaidOutSchema, ensureShiftsSchema, ensureSupplierProductsSchema,
    ensureRepeatPrescriptionsSchema];
  // The schema steps do not depend on each other: all at once, then the two default seeds (they need the tables).
  await Promise.all(ensures.map(function (fn) { return Promise.resolve().then(function () { return fn(env); }).catch(function () {}); }));
  await Promise.all([ensureDefaultTempDevicesIfMissing(env, authUser).catch(function () {}), ensureDefaultCertificatesIfMissing(env, authUser).catch(function () {})]);
  const nowHm = tzHm();
  // Every read below depends only on the pharmacy and today's dates: start them together (one round trip of
  // waiting instead of ~20 in a row); each one is awaited where it is used.
  const __p_devs = all(
    `SELECT d.id, d.name, d.device_type, d.min_limit, d.max_limit,
            t.min_temp AS t_min, t.max_temp AS t_max, y.min_temp AS y_min, y.max_temp AS y_max
       FROM temperature_devices d
       LEFT JOIN temperature_entries t ON t.device_id = d.id AND t.org_id = d.org_id AND t.location_id = d.location_id AND t.entry_date = ?
       LEFT JOIN temperature_entries y ON y.device_id = d.id AND y.org_id = d.org_id AND y.location_id = d.location_id AND y.entry_date = ?
      WHERE d.org_id = ? AND d.location_id = ? AND d.active = 1
      ORDER BY d.id`, [today, yesterday, org, loc]);
  const __p_drCount = one(`SELECT COUNT(*) AS c FROM daily_register_entries WHERE org_id = ? AND location_id = ? AND entry_date = ?`, [org, loc, today]);
  const __p_lastClean = one(`SELECT entry_date, cleaner_name FROM cleaning_entries WHERE org_id = ? AND location_id = ? ORDER BY entry_date DESC, time_in DESC LIMIT 1`, [org, loc]);
  const __p_orders = all(
    `SELECT id, client_name, client_phone, items_text, priority, needed_by, pickup_date, order_date, follow_up_status, order_code
       FROM client_orders_entries WHERE org_id = ? AND location_id = ? AND fulfilled = 0
      ORDER BY priority ASC, COALESCE(NULLIF(needed_by, ''), '9999-12-31') ASC, order_date ASC LIMIT 50`, [org, loc]);
  const __p_tickets = all(
    `SELECT id, ticket_id, client_name, phone, issue, status, priority, open_date, followup_date
       FROM client_tickets_entries WHERE org_id = ? AND location_id = ? AND resolved = 0 AND status NOT IN ('Resolved', 'Closed')
      ORDER BY priority ASC, open_date ASC LIMIT 50`, [org, loc]);
  const __p_deliveries = all(
    `SELECT id, delivery_id, client_name, phone, delivery_address, scheduled_date, scheduled_time_slot, order_date, status, cold_chain_required, contains_controlled
       FROM client_deliveries WHERE org_id = ? AND location_id = ? AND status IN ('Scheduled', 'Dispatched', 'Out for Delivery')
        AND COALESCE(NULLIF(scheduled_date, ''), order_date) <= ?
      ORDER BY COALESCE(NULLIF(scheduled_date, ''), order_date) ASC, priority ASC, id ASC LIMIT 50`, [org, loc, today]);
  const __p_certs = all(`SELECT item_key, title, last_date, interval_months FROM certificates_items WHERE org_id = ? AND location_id = ?`, [org, loc]);
  // Repeats coming due (backlog 3 item 7). The worker does NOT decide what "due" means: that rule waits for the
  // pharmacist and lives in one place, ui/eikon.repeatdue.js. Here only a generous superset is sent: every still-valid
  // line of every patient who has a line with a collection interval, or a line running out within
  // REPEATS_LOOKAHEAD_DAYS (all of that patient's valid lines come, so the screen can tell a renewed one apart).
  const __p_rep = all(
    `SELECT id, entry_date, expires_date, client_name, client_id, medicine_name_dose, posology, collect_every_days, last_collected_date
       FROM repeat_prescription_entries
      WHERE org_id = ? AND location_id = ? AND expires_date >= ?
        AND lower(replace(client_id, ' ', '')) IN (
          SELECT lower(replace(client_id, ' ', '')) FROM repeat_prescription_entries
           WHERE org_id = ? AND location_id = ? AND expires_date >= ? AND (collect_every_days IS NOT NULL OR expires_date <= ?))
      ORDER BY expires_date ASC, id ASC LIMIT ${REPEATS_MAX_ROWS + 1}`, [org, loc, today, org, loc, today, ymdPlusDays(today, REPEATS_LOOKAHEAD_DAYS)]);
  const __p_alerts = all(
    `SELECT id, item_name, alert_type, status, entry_date, team_informed, supplier_informed, authorities_informed, return_arranged, handed_over, collection_note_received, credit_note_received
       FROM alerts_entries WHERE org_id = ? AND location_id = ? AND lower(status) != 'closed' ORDER BY entry_date DESC LIMIT 20`, [org, loc]);
  const __p_retOpen = one(
    `SELECT COUNT(*) AS c FROM returns_entries WHERE org_id = ? AND location_id = ? AND entry_date >= ? AND COALESCE(supplier_refused, 0) = 0
        AND NOT (return_arranged = 1 AND handed_over = 1 AND collection_note_received = 1 AND credit_note_received = 1)`, [org, loc, sixMonthsAgo]);
  const __p_ne = all(`SELECT product_name, expiry_date FROM near_expiry_entries WHERE org_id = ? AND location_id = ? AND COALESCE(return_status, '') != 'handed_over' AND expiry_date <= ? ORDER BY expiry_date ASC LIMIT 200`, [org, loc, in30]);
  const __p_eod = one(`SELECT id, locked_at, saved_at, staff_name FROM end_of_day WHERE org_id = ? AND location_id = ? AND eod_date = ?`, [org, loc, today]);
  const __p_po = one(`SELECT COALESCE(SUM(fee), 0) AS total, COUNT(*) AS c FROM paid_out_entries WHERE org_id = ? AND location_id = ? AND entry_date = ?`, [org, loc, today]);
  const __p_so = all(`SELECT status, COUNT(*) AS c FROM supplier_orders WHERE org_id = ? AND pharmacy_location_id = ? AND status IN ('pending', 'shipped') GROUP BY status`, [org, loc]);
  const __p_shifts = all(
    `SELECT a.start_time, a.end_time, s.full_name, s.designation FROM shift_assignments a JOIN shift_staff s ON s.id = a.staff_id
      WHERE a.org_id = ? AND a.location_id = ? AND a.shift_date = ? ORDER BY a.start_time ASC`, [org, loc, today]);
  const __p_hand = one(`SELECT ymd, notes, handover_json FROM instructions_daily WHERE org_id = ? AND location_id = ? AND ymd = ?`, [org, loc, yesterday]);
  const __p_notesToday = one(`SELECT notes FROM instructions_daily WHERE org_id = ? AND location_id = ? AND ymd = ?`, [org, loc, today]);
  const __p_bkRows = all(
    `SELECT b.id, b.start_time, b.end_time, b.person_name, b.status, s.name AS service, p.name AS provider
       FROM bk_bookings b LEFT JOIN bk_services s ON s.id = b.service_id LEFT JOIN bk_providers p ON p.id = b.provider_id
      WHERE b.org_id = ? AND b.location_id = ? AND b.date = ? AND b.status IN ('booked','confirmed','arrived') AND b.end_time > ?
      ORDER BY b.start_time ASC, b.id ASC LIMIT 6`, [org, loc, today, nowHm]);
  const __p_bkTotal = one(`SELECT COUNT(*) AS c FROM bk_bookings WHERE org_id = ? AND location_id = ? AND date = ? AND status <> 'cancelled'`, [org, loc, today]);

  // ---- Before opening: the registers that must be filled today
  const before = [];
  const devs = await __p_devs;
  for (const d of devs) {
    const done = d.t_min != null && d.t_max != null;
    const lo = todayNum(d.min_limit), hi = todayNum(d.max_limit);
    const out = done && ((lo != null && Number(d.t_min) < lo) || (hi != null && Number(d.t_max) > hi));
    const yText = (d.y_min != null && d.y_max != null) ? ("Yesterday " + d.y_min + " to " + d.y_max) : "No reading yesterday";
    const lim = (lo != null || hi != null) ? (" · limits " + (lo != null ? lo : "–") + " to " + (hi != null ? hi : "–")) : "";
    before.push({
      kind: "temperature", device_id: d.id, title: String(d.name || "Device") + " · reading", sub: yText + lim,
      status: done ? "done" : "todo", out_of_range: !!out,
      limits: { min: lo, max: hi }, yesterday: (d.y_min != null ? { min: Number(d.y_min), max: Number(d.y_max) } : null),
      today: done ? { min: Number(d.t_min), max: Number(d.t_max) } : null,
      action: { method: "POST", path: "/temperature/entries", body: { device_id: d.id, entry_date: today }, fields: ["min_temp", "max_temp", "notes"], label: "Log" }
    });
  }
  const drCount = await __p_drCount;
  const drN = Number(drCount && drCount.c || 0);
  before.push({
    kind: "daily_register", title: "Daily register", sub: drN ? (drN + (drN === 1 ? " entry" : " entries") + " today") : "No entry yet today",
    status: drN ? "done" : "todo", count_today: drN,
    action: { type: "open", path: "#dailyregister", label: "Open" }
  });
  const lastClean = await __p_lastClean;
  const cleanDays = lastClean ? ymdDiffDays(lastClean.entry_date, today) : null;
  before.push({
    kind: "cleaning", title: "Cleaning",
    sub: lastClean ? ("Last done " + (cleanDays === 0 ? "today" : cleanDays === 1 ? "yesterday" : cleanDays + " days ago") + (lastClean.cleaner_name ? " by " + lastClean.cleaner_name : "")) : "Never recorded",
    status: cleanDays === 0 ? "done" : (cleanDays == null || cleanDays >= 14 ? "overdue" : "ok"),
    days_since: cleanDays, last_date: lastClean ? lastClean.entry_date : null,
    action: { method: "POST", path: "/cleaning/entries", body: { entry_date: today }, fields: ["time_in", "cleaner_name", "staff_name"], label: "Done now" }
  });

  // ---- Customers waiting: orders to hand over, questions to answer
  const waiting = [];
  const orders = await __p_orders;
  for (const o of orders) {
    waiting.push({ kind: "order", id: o.id, name: o.client_name, phone: o.client_phone || "", detail: o.items_text || "", code: o.order_code || "",
      needed_by: o.needed_by || null, pickup_date: o.pickup_date || null, priority: Number(o.priority) || 2,
      waiting_days: ymdDiffDays(o.order_date, today), due_today: !!(o.needed_by && o.needed_by <= today),
      action: { type: "open", path: "#clientorders", label: "Open" } });
  }
  const tickets = await __p_tickets;
  for (const t of tickets) {
    waiting.push({ kind: "question", id: t.id, ref: t.ticket_id || "", name: t.client_name, phone: t.phone || "", detail: t.issue || "", status: t.status,
      priority: Number(t.priority) || 2, waiting_days: ymdDiffDays(t.open_date, today), followup_date: t.followup_date || null,
      action: { type: "open", path: "#tickets", label: "Reply" } });
  }
  // deliveries still to go out today, and any that slipped past their day
  const deliveries = await __p_deliveries;
  for (const d of deliveries) {
    const due = d.scheduled_date || d.order_date || today;
    waiting.push({ kind: "delivery", id: d.id, ref: d.delivery_id || "", name: d.client_name, phone: d.phone || "", detail: d.delivery_address || "", slot: d.scheduled_time_slot || "",
      status: d.status, due_date: due, late_days: due < today ? ymdDiffDays(due, today) : 0, cold: !!Number(d.cold_chain_required), controlled: !!Number(d.contains_controlled),
      action: { type: "open", path: "#deliveries", label: "Open" } });
  }

  // ---- Attention: paperwork and dates that are slipping
  const attention = [];
  const certs = await __p_certs;
  for (const c of certs) {
    if (!c.last_date) continue;
    let due = "";
    try { due = addMonthsToYmd(c.last_date, Number(c.interval_months) || 12) || ""; } catch (e) { due = ""; }
    if (!due) continue;
    if (due < today) attention.push({ kind: "certificate", title: c.title, status: "expired", due, days: ymdDiffDays(due, today), action: { type: "open", path: "#certificates", label: "Open" } });
    else if (due <= in30) attention.push({ kind: "certificate", title: c.title, status: "due_soon", due, days: ymdDiffDays(today, due), action: { type: "open", path: "#certificates", label: "Open" } });
  }
  const alerts = await __p_alerts;
  for (const a of alerts) {
    const flags = ["team_informed", "supplier_informed", "authorities_informed", "return_arranged", "handed_over", "collection_note_received", "credit_note_received"];
    const left = flags.filter((f) => Number(a[f] || 0) !== 1).length;
    attention.push({ kind: "alert", id: a.id, title: a.item_name, alert_type: a.alert_type, status: a.status, steps_left: left, date: a.entry_date, action: { type: "open", path: "#alerts", label: "Open" } });
  }
  const retOpen = await __p_retOpen;
  if (Number(retOpen && retOpen.c || 0) > 0) attention.push({ kind: "returns", open_count: Number(retOpen.c), title: Number(retOpen.c) + (Number(retOpen.c) === 1 ? " return" : " returns") + " awaiting paperwork", action: { type: "open", path: "#returns", label: "Open" } });
  const ne = await __p_ne;
  if (ne.length) {
    const expired = ne.filter((x) => x.expiry_date < today);
    attention.push({ kind: "near_expiry", expired_count: expired.length, due30_count: ne.length - expired.length, first: ne[0].product_name, first_expiry: ne[0].expiry_date,
      title: (expired.length ? expired.length + " expired" : "") + (expired.length && ne.length - expired.length ? ", " : "") + (ne.length - expired.length ? (ne.length - expired.length) + " expiring within 30 days" : ""),
      action: { type: "open", path: "#nearexpiry", label: "Open" } });
  }

  // ---- Takings, stock, team
  const eod = await __p_eod;
  const po = await __p_po;
  const takings = { end_of_day_saved: !!eod, end_of_day_locked: !!(eod && eod.locked_at), paid_out_today: Math.round(Number(po && po.total || 0) * 100) / 100, paid_out_count: Number(po && po.c || 0),
    action: { type: "open", path: "#endofday", label: eod ? (eod.locked_at ? "View" : "Close the day") : "Close the day" } };
  const so = await __p_so;
  const stock = { supplier_orders_pending: 0, supplier_orders_shipped: 0 };
  for (const r of so) { if (r.status === "pending") stock.supplier_orders_pending = Number(r.c); if (r.status === "shipped") stock.supplier_orders_shipped = Number(r.c); }
  const shifts = await __p_shifts;
  const hand = await __p_hand;
  const notesToday = await __p_notesToday;
  let incoming = [];
  try { incoming = hand ? parseHandoverJson(hand.handover_json) : []; } catch (e) { incoming = []; }
  const team = { on_today: shifts.map((x) => ({ name: x.full_name, role: x.designation, from: x.start_time, to: x.end_time })),
    handover_incoming: Array.isArray(incoming) ? incoming : [], notes_today: notesToday ? String(notesToday.notes || "") : "" };

  // ---- Bookings today (new appointments): the next few still to come. Empty if Bookings is not set up.
  const bkRows = await __p_bkRows;
  const bkTotal = await __p_bkTotal;
  const bookings = { total_today: bkTotal ? Number(bkTotal.c) || 0 : 0,
    next: bkRows.map((r) => ({ id: r.id, start: r.start_time, end: r.end_time, name: r.person_name, status: r.status, service: r.service || "", provider: r.provider || "" })),
    action: { type: "open", path: "#bookings", label: "Bookings" } };

  // ---- First-run list (backlog 2 item 4), for the pharmacy's admin: how many people can sign in here, and whether
  // opening hours were ever saved. Two small reads; left out (not guessed) if either cannot be read.
  let setup;
  if (authUser.role === "admin") {
    const [su, sh, pd] = await Promise.all([
      one("SELECT COUNT(*) AS c FROM users WHERE org_id = ? AND default_location_id = ? AND is_active = 1", [org, loc]),
      one("SELECT COUNT(*) AS c FROM shift_opening_hours WHERE org_id = ? AND location_id = ?", [org, loc]),
      dzDetailsSaved(env, org, loc)]); // FIN-dayzero hook
    if (su && sh) setup = { sign_ins: Number(su.c) || 0, opening_hours_saved: Number(sh.c) > 0, ...(pd == null ? {} : { details_saved: pd }) };
  }
  const repRows = await __p_rep;
  const repeats = { entries: repRows.slice(0, REPEATS_MAX_ROWS), lookahead_days: REPEATS_LOOKAHEAD_DAYS, truncated: repRows.length > REPEATS_MAX_ROWS,
    action: { type: "open", path: "#repreg", label: "Open" } };
  const counts = {
    before_opening: before.filter((x) => x.status === "todo" || x.status === "overdue").length,
    customers_waiting: waiting.length,
    attention: attention.length
  };
  return jsonResponse({ ok: true, date: today, time: tzHm(), timezone: PHARMACY_TZ,
    pharmacy: { name: authUser.location_name, location_id: loc, org: authUser.org_name },
    before_opening: before, customers_waiting: waiting, attention, takings, stock, team, bookings, repeats, counts, ...(setup ? { setup } : {}) },
    200, { ...corsOkHeaders, "Cache-Control": "private, max-age=10", "Vary": "Origin, Authorization" }); // Authorization: a page load of /today (clean address) must not get this from the browser's cache
}

// ═══════════════════════════════════════════════════════════════════════════
// TODAY'S REGISTERS  (regs-hub)
// What the registers need today, in ONE read: GET /registers/today, asked when the Registers hub opens (not by Today,
// which is re-read every minute: nothing here is added to /today). Read-only, every statement bounded by the
// pharmacy and a date or LIMIT, on the existing (org_id, location_id, …) indexes. Nothing decides "done" here except
// plain facts (is there a line today, when was the last one): the words and colours are the screen's
// (ui/eikon.regtoday.js), with the same rules as the Inspection check.
// ═══════════════════════════════════════════════════════════════════════════
const REG_COUNT_GRACE_DAYS = 7; // a controlled-drug stock-take in the first week of a month counts for the month before (as the Inspection check)
function regTzDayOfUtc(s) { // the server's UTC "YYYY-MM-DD HH:MM:SS" as the Malta day it fell on
  const t = String(s || "").trim(); if (!t) return "";
  const ms = Date.parse(t.replace(" ", "T") + (/[zZ]$|[+-]\d\d:?\d\d$/.test(t) ? "" : "Z"));
  return Number.isFinite(ms) ? tzYmd(new Date(ms)) : t.slice(0, 10);
}
function regShiftYm(ym, n) { const a = String(ym).split("-").map(Number); const d = new Date(Date.UTC(a[0], a[1] - 1 + n, 1)); return d.toISOString().slice(0, 7); }
function regCountsFor(day) { // the month a stock-take on this Malta day counts for
  return Number(day.slice(8, 10)) <= REG_COUNT_GRACE_DAYS ? regShiftYm(day.slice(0, 7), -1) : day.slice(0, 7);
}
// The parts /today does not read: the pharmacist in charge today, the controlled-drug stock-take, and the
// month sign-offs (register_signoffs, written by the Daily registers' sign-off; read only if that table exists).
async function registersTodayExtra(env, org, loc, today) {
  const all = async (sql, bind) => { try { return await dbAll(env, sql, bind); } catch (e) { return null; } };
  const one = async (sql, bind) => { try { return await dbFirst(env, sql, bind); } catch (e) { return null; } };
  await Promise.all([ensureLocumRegisterSchema, ensureDdaStockTakesSchema, ensureDdaSalesSchema, ensureDdaPoycSchema, ensureDdaPurchasesSchema, ensureSignoffSchema] // V2: the sign-off table exists before the hub reads it (it was made only when a daily register was opened)
    .map((fn) => Promise.resolve().then(() => fn(env)).catch(() => {})));
  const ym = today.slice(0, 7), lastYm = regShiftYm(ym, -1);
  const since = ymdPlusDays(lastYm + "-01", -1) + " 00:00:00"; // UTC stamps: a day early so a Malta-midnight take is not missed
  const [loc1, takes, open, signs] = await Promise.all([
    all(`SELECT locum_full_name, registration_number, time_in, time_out FROM locum_register_entries
          WHERE org_id = ? AND location_id = ? AND entry_date = ? ORDER BY time_in ASC, id ASC LIMIT 6`, [org, loc, today]),
    all(`SELECT id, created_at, closed_at FROM dda_stocktakes WHERE org_id = ? AND location_id = ? AND created_at >= ?
          ORDER BY created_at DESC LIMIT 20`, [org, loc, since]),
    one(`SELECT id, created_at FROM dda_stocktakes WHERE org_id = ? AND location_id = ? AND closed_at IS NULL
          ORDER BY created_at DESC LIMIT 1`, [org, loc]),
    all(`SELECT register, month, signed_name, signed_at FROM register_signoffs WHERE org_id = ? AND location_id = ? AND month IN (?, ?)
          ORDER BY month DESC LIMIT 40`, [org, loc, ym, lastYm])
  ]);
  const locum = loc1 == null ? null : {
    signed: loc1.length > 0,
    entries: loc1.map((r) => ({ name: String(r.locum_full_name || ""), reg: String(r.registration_number || ""), from: String(r.time_in || ""), to: String(r.time_out || "") }))
  };
  let stocktake = null;
  if (takes != null) {
    const list = takes.map((s) => { const day = regTzDayOfUtc(s.created_at); return { id: s.id, day, closed: !!s.closed_at, for_month: day ? regCountsFor(day) : "" }; }).filter((s) => s.day);
    const forLast = list.filter((s) => s.for_month === lastYm), forThis = list.filter((s) => s.for_month === ym);
    let lines = null; // were controlled drugs supplied or received last month? asked only when it has no stock-take
    if (!forLast.length) {
      const f = lastYm + "-01", t = ymdPlusDays(regShiftYm(lastYm, 1) + "-01", -1);
      const x = await one(`SELECT EXISTS(SELECT 1 FROM dda_sales_entries WHERE org_id = ? AND location_id = ? AND entry_date BETWEEN ? AND ?)
            OR EXISTS(SELECT 1 FROM dda_poyc_entries WHERE org_id = ? AND location_id = ? AND entry_date BETWEEN ? AND ?)
            OR EXISTS(SELECT 1 FROM dda_purchases_entries WHERE org_id = ? AND location_id = ? AND entry_date BETWEEN ? AND ?) AS any_line`,
        [org, loc, f, t, org, loc, f, t, org, loc, f, t]);
      lines = x == null ? null : !!Number(x.any_line);
    }
    const openDay = open ? regTzDayOfUtc(open.created_at) : "";
    stocktake = {
      this_month: ym, last_month: lastYm, grace_days: REG_COUNT_GRACE_DAYS,
      last_month_counted: forLast.length ? forLast[0].day : null, this_month_counted: forThis.length ? forThis[0].day : null,
      last_month_lines: forLast.length ? true : lines,
      open: open && openDay ? { id: open.id, day: openDay } : null
    };
  }
  const signoffs = signs == null ? null : signs.map((s) => ({ register: String(s.register || ""), month: String(s.month || ""), signed_by: String(s.signed_name || ""), signed_at: String(s.signed_at || "") }));
  return { locum, stocktake, signoffs };
}

async function handleRegistersToday(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  const today = tzYmd(), in30 = ymdPlusDays(today, 30);
  const all = async (sql, bind) => { try { return await dbAll(env, sql, bind); } catch (e) { return null; } };
  const one = async (sql, bind) => { try { return await dbFirst(env, sql, bind); } catch (e) { return null; } };
  await Promise.all([ensureDailyRegisterSchema, ensureCertificatesSchema, ensureEndOfDaySchema].map((fn) => Promise.resolve().then(() => fn(env)).catch(() => {})));
  await Promise.all([ensureDefaultTempDevicesIfMissing(env, authUser).catch(() => {}), ensureDefaultCertificatesIfMissing(env, authUser).catch(() => {})]);
  const [devs, dr, clean, certs, eod, extra] = await Promise.all([
    all(`SELECT d.id, d.name, d.device_type, d.min_limit, d.max_limit, t.min_temp AS t_min, t.max_temp AS t_max, t.notes AS t_notes
           FROM temperature_devices d
           LEFT JOIN temperature_entries t ON t.device_id = d.id AND t.org_id = d.org_id AND t.location_id = d.location_id AND t.entry_date = ?
          WHERE d.org_id = ? AND d.location_id = ? AND d.active = 1 ORDER BY d.id LIMIT 50`, [today, org, loc]),
    one(`SELECT COUNT(*) AS c FROM daily_register_entries WHERE org_id = ? AND location_id = ? AND entry_date = ?`, [org, loc, today]),
    one(`SELECT entry_date, cleaner_name FROM cleaning_entries WHERE org_id = ? AND location_id = ? ORDER BY entry_date DESC, time_in DESC LIMIT 1`, [org, loc]),
    all(`SELECT title, last_date, interval_months FROM certificates_items WHERE org_id = ? AND location_id = ? LIMIT 100`, [org, loc]),
    one(`SELECT saved_at, locked_at FROM end_of_day WHERE org_id = ? AND location_id = ? AND eod_date = ?`, [org, loc, today]),
    registersTodayExtra(env, org, loc, today)
  ]);
  const temperature = devs == null ? null : devs.map((d) => {
    const done = d.t_min != null && d.t_max != null, lo = todayNum(d.min_limit), hi = todayNum(d.max_limit);
    const out = done && ((lo != null && Number(d.t_min) < lo) || (hi != null && Number(d.t_max) > hi));
    return { device_id: d.id, name: String(d.name || "Device"), device_type: d.device_type || "", limits: { min: lo, max: hi },
      today: done ? { min: Number(d.t_min), max: Number(d.t_max) } : null, out_of_range: !!out, note: done ? String(d.t_notes || "").trim() !== "" : false };
  });
  let certificates = null, notRecorded = 0;
  if (certs != null) {
    certificates = [];
    for (const c of certs) {
      if (!c.last_date) { notRecorded++; continue; }
      let due = ""; try { due = addMonthsToYmd(c.last_date, Number(c.interval_months) || 12) || ""; } catch (e) { due = ""; }
      if (!due) continue;
      if (due < today) certificates.push({ title: c.title, status: "expired", due, days: ymdDiffDays(due, today) });
      else if (due <= in30) certificates.push({ title: c.title, status: "due_soon", due, days: ymdDiffDays(today, due) });
    }
    certificates.sort((a, b) => (a.due < b.due ? -1 : a.due > b.due ? 1 : 0));
  }
  return jsonResponse({ ok: true, date: today, time: tzHm(), timezone: PHARMACY_TZ,
    temperature,
    daily_register: dr == null ? null : { count_today: Number(dr.c) || 0 },
    cleaning: { last_date: clean ? clean.entry_date : null, by: clean ? String(clean.cleaner_name || "") : "", days_since: clean ? ymdDiffDays(clean.entry_date, today) : null },
    certificates, certificates_not_recorded: notRecorded,
    end_of_day: { saved: !!eod, locked: !!(eod && eod.locked_at) },
    locum: extra.locum, stocktake: extra.stocktake, signoffs: extra.signoffs },
    200, { ...corsOkHeaders, "Cache-Control": "private, max-age=10", "Vary": "Origin, Authorization" });
}

