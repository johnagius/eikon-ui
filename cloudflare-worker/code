    [orgId, locId, JSON.stringify(out), authUser.user_id]);
  await writeAudit(env, orgId, authUser.user_id, "PHARMACY_DETAILS_PUT", "label_settings", String(locId), { before, after: pharmacyDetailsOf(out) }, locId);
