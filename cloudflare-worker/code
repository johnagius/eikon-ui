async function handleShiftApplyPattern(request, env, corsOkHeaders, authUser) {
  await ensureShiftsSchema(env);
  const body = await readJson(request);

  const staffId = parseInt(body.staff_id || body.staffId);
  if (!staffId) return jsonResponse({ ok:false, error:"staff_id required" }, 400, corsOkHeaders);

  // verify staff belongs to org/location
  const st = await dbFirst(env, `SELECT id FROM shift_staff WHERE id=? AND org_id=? AND location_id=?`, [staffId, authUser.org_id, authUser.location_id]);
  if (!st) return jsonResponse({ ok:false, error:"Staff not found" }, 404, corsOkHeaders);

  const mode = String(body.mode || "overwrite"); // overwrite | fill
  const start = String(body.start_date || body.startDate || "").trim();
  const end = String(body.end_date || body.endDate || "").trim();
  try {
    const pat = body && (body.pattern || body.week_pattern || {});
    const week = pat && pat.week;
    console.log("[shifts][apply-pattern] staffId:", staffId, "mode:", mode, "start:", start, "end:", end,
                "hasDates:", Array.isArray(body.dates) ? body.dates.length : 0,
                "weekLen:", Array.isArray(week) ? week.length : 0);
  } catch(e) {}
  if (!/^\d{4}-\d{2}-\d{2}$/.test(start) || !/^\d{4}-\d{2}-\d{2}$/.test(end)) {
    return jsonResponse({ ok:false, error:"start_date and end_date required (YYYY-MM-DD)" }, 400, corsOkHeaders);
  }
  if (end < start) return jsonResponse({ ok:false, error:"end_date must be >= start_date" }, 400, corsOkHeaders);
  { const ms = (d) => { const [Y, M, D] = d.split("-").map((n) => parseInt(n, 10)); return Date.UTC(Y, M - 1, D); };
    if ((ms(end) - ms(start)) / 864e5 >= BIMP_SHIFT_MAX_DAYS) return jsonResponse({ ok:false, error:"A pattern can cover at most 10 years (3,660 days) at a time" }, 400, corsOkHeaders); }

  // Normalize inputs
  const explicitDates = Array.isArray(body.dates) ? body.dates : null;
  const week = body.pattern && Array.isArray(body.pattern.week) ? body.pattern.week : (body.week && Array.isArray(body.week) ? body.week : null);

  function dow(dateStr) {
    const [Y,M,D] = dateStr.split("-").map(n=>parseInt(n,10));
    const dt = new Date(Date.UTC(Y, M-1, D));
    return dt.getUTCDay(); // 0 Sun .. 6 Sat
  }
  function addDays(dateStr, n) {
    const [Y,M,D] = dateStr.split("-").map(n=>parseInt(n,10));
    const dt = new Date(Date.UTC(Y, M-1, D));
    dt.setUTCDate(dt.getUTCDate()+n);
    const yy = dt.getUTCFullYear();
    const mm = String(dt.getUTCMonth()+1).padStart(2,"0");
    const dd = String(dt.getUTCDate()).padStart(2,"0");
    return `${yy}-${mm}-${dd}`;
  }

  // Build list of candidate rows
  const rows = [];
  if (explicitDates) {
    for (const it of explicitDates) {
      const date = String(it.date || it.shift_date || "").trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) continue;
      if (date < start || date > end) continue;
      const stt = String(it.start_time || it.start || "").trim();
      const ett = String(it.end_time || it.end || "").trim();
      if (!stt || !ett) continue;
      rows.push({ date, start_time: stt, end_time: ett, role_override: String(it.role_override||"").trim(), notes: String(it.notes||"").trim() });
    }
  } else if (week) {
    // Week array indexed 0..6; each entry {off,start,end}
    let cur = start;
    while (cur <= end) {
      const d = dow(cur);
      const entry = week[d] || {};
      const off = !!entry.off;
      const stt = String(entry.start || entry.start_time || "").trim();
      const ett = String(entry.end || entry.end_time || "").trim();
      if (!off && stt && ett) {
        rows.push({ date: cur, start_time: stt, end_time: ett, role_override: String(entry.role_override||"").trim(), notes: String(entry.notes||"").trim() });
      }
      cur = addDays(cur, 1);
    }
  } else {
    return jsonResponse({ ok:false, error:"Provide either body.dates[] or body.pattern.week[]" }, 400, corsOkHeaders);
  }
  if (rows.length > BIMP_SHIFT_MAX_ROWS) return jsonResponse({ ok:false, error:"At most 3,660 shifts can be applied at a time" }, 400, corsOkHeaders);

  // Determine which dates already have shifts (for fill mode)
  let existing = new Set();
  if (mode === "fill") {
    const ex = await dbAll(env, `SELECT shift_date FROM shift_assignments WHERE org_id=? AND location_id=? AND staff_id=? AND shift_date>=? AND shift_date<=?`,
      [authUser.org_id, authUser.location_id, staffId, start, end]);
    for (const r of ex) existing.add(r.shift_date);
  } else {
    // overwrite
    await dbRun(env, `DELETE FROM shift_assignments WHERE org_id=? AND location_id=? AND staff_id=? AND shift_date>=? AND shift_date<=?`,
      [authUser.org_id, authUser.location_id, staffId, start, end]);
  }

  let inserted = 0;
  const insRows = [];
  for (const r of rows) {
    if (mode === "fill" && existing.has(r.date)) continue;
    insRows.push([null, null, null, r.date, r.start_time, r.end_time, r.role_override || "", r.notes || ""]);
    inserted++;
  }
  await wsaveRun(env, bimpStatements(env,
      `INSERT INTO shift_assignments (org_id, location_id, staff_id, shift_date, start_time, end_time, role_override, notes, created_at, updated_at, created_by)
       VALUES `, [authUser.org_id, authUser.location_id, staffId, authUser.user_id],
      ["?1", "?2", "?3", "?", "?", "?", "?", "?", "datetime('now')", "datetime('now')", "?4"], "", insRows));

  await writeAudit(env, authUser.org_id, authUser.user_id, "SHIFT_APPLY_PATTERN", "shift_assignments", String(staffId), { mode, start, end, inserted }, authUser.location_id);

  try { console.log("[shifts][apply-pattern] done staffId:", staffId, "inserted:", inserted); } catch(e) {}
  return jsonResponse({ ok:true, inserted }, 200, corsOkHeaders);
}

// ── Roster planner: one-step apply (W1, John 2026-11-10 decision 4a) ─────────────────────────────
// POST /shifts/apply-plan {items:[{staff_id, from, to, add:[{date,start_time,end_time,role_override,notes}],
//   remove:[shift ids], seen?:[shift ids], fill?:bool}]}
// All or nothing: every item is checked first (person in this pharmacy, dates inside its range, times HH:MM, each
// removed shift is that person's and inside the range, and — when `seen` is sent — the person's shifts in the range are
// still exactly the ones the screen previewed); then every DELETE and INSERT runs in ONE env.DB.batch (one transaction):
// a failure leaves the rota as it was. A row added here is stored as POST /shifts/assignments stores it (same columns,
// same text, created_by = the user); a row removed is removed as DELETE /shifts/assignments/:id removes it. Rights as
// every /shifts route (anyone signed in to this pharmacy). Bounded: <= 12 people, <= 3,660 shifts added per person and
// 8,000 in all, one SELECT for the shifts in range, <= 30 statements in the batch (dates/times/ids are written as
// checked SQL literals, so a statement holds hundreds of rows), one audit entry per person. `fill` adds only on days
// the person has no shift left (as apply-pattern "fill").
const SHP_MAX_ITEMS = 12, SHP_MAX_ADD_PER = 3660, SHP_MAX_ADD = 8000, SHP_MAX_REMOVE = 8000, SHP_MAX_STMTS = 30;
const SHP_TEXT_MAX = 2000;
function shpYmdOk(s) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
  const [Y, M, D] = s.split("-").map((n) => parseInt(n, 10));
  const dt = new Date(Date.UTC(Y, M - 1, D));
  return dt.getUTCFullYear() === Y && dt.getUTCMonth() === M - 1 && dt.getUTCDate() === D;
}
function shpAddDays(ymd, n) {
  const [Y, M, D] = ymd.split("-").map((x) => parseInt(x, 10));
  return new Date(Date.UTC(Y, M - 1, D + n)).toISOString().slice(0, 10);
}
function shpTimeOk(s) { return /^([01]\d|2[0-3]):[0-5]\d$/.test(s); }
// INSERT statements for one person: consts ?1 org, ?2 location, ?3 staff, ?4 user; date and times are checked literals.
function shpInsertStatements(env, consts, rows) {
  const head = `INSERT INTO shift_assignments (org_id, location_id, staff_id, shift_date, start_time, end_time, role_override, notes, created_at, updated_at, created_by) VALUES `;
  const out = [];
  let parts = [], params = [], sqlLen = head.length, bytes = 0;
  const flush = () => { if (parts.length) out.push({ stmt: env.DB.prepare(head + parts.join(", ")).bind(...consts, ...params), bytes: bytes + wsaveBytes(consts) }); parts = []; params = []; sqlLen = head.length; bytes = 0; };
  for (const r of rows) {
    const vals = [];
    const slot = (v) => { if (v === "") return "''"; vals.push(v); return null; };
    const a = slot(r.role_override), b = slot(r.notes);
    const render = (n) => "(?1,?2,?3,'" + r.date + "','" + r.start_time + "','" + r.end_time + "'," + (a === null ? "?" + (++n) : a) + "," + (b === null ? "?" + (++n) : b) + ",datetime('now'),datetime('now'),?4)";
    let part = render(consts.length + params.length);
    const vb = wsaveBytes(vals);
    if (parts.length && (consts.length + params.length + vals.length > WSAVE_MAX_PARAMS || bytes + vb > WSAVE_STMT_BYTES || sqlLen + part.length + 2 > BIMP_SQL_BYTES)) { flush(); part = render(consts.length); }
    parts.push(part); for (const v of vals) params.push(v); sqlLen += part.length + 2; bytes += vb;
  }
  flush();
  return out;
}
async function handleShiftApplyPlan(request, env, corsOkHeaders, authUser) {
  await ensureShiftsSchema(env);
  const body = await readJson(request);
  const bad = (error, extra) => jsonResponse(Object.assign({ ok: false, error }, extra || {}), 400, corsOkHeaders);
  const raw = body && Array.isArray(body.items) ? body.items : null;
  if (!raw || !raw.length) return bad("items[] required");
  if (raw.length > SHP_MAX_ITEMS) return bad("At most " + SHP_MAX_ITEMS + " people at a time", { code: "split" });
  const items = [];
  let addTotal = 0, removeTotal = 0;
  const seenStaff = new Set();
  for (const it of raw) {
    const staffId = parseInt(it && it.staff_id, 10);
    if (!staffId || staffId < 1) return bad("staff_id required");
    if (seenStaff.has(staffId)) return bad("Each person once per request");
    seenStaff.add(staffId);
    const from = String(it.from || "").trim(), to = String(it.to || "").trim();
    if (!shpYmdOk(from) || !shpYmdOk(to)) return bad("from and to required (YYYY-MM-DD)");
    if (to < from) return bad("to must be >= from");
    { const ms = (d) => { const [Y, M, D] = d.split("-").map((n) => parseInt(n, 10)); return Date.UTC(Y, M - 1, D); };
      if ((ms(to) - ms(from)) / 864e5 >= BIMP_SHIFT_MAX_DAYS) return bad("A plan can cover at most 10 years (3,660 days) at a time"); }
    const add = [];
    for (const a of (Array.isArray(it.add) ? it.add : [])) {
      const date = String(a && (a.date || a.shift_date) || "").trim();
      const st = String(a && a.start_time || "").trim(), et = String(a && a.end_time || "").trim();
      if (!shpYmdOk(date) || date < from || date > to) return bad("Every added shift needs a date inside its range (" + (date || "no date") + ")");
      if (!shpTimeOk(st) || !shpTimeOk(et)) return bad("Every added shift needs a start and end time (HH:MM) on " + date);
      const ro = String(a.role_override == null ? "" : a.role_override), no = String(a.notes == null ? "" : a.notes);
      if (ro.length > SHP_TEXT_MAX || no.length > SHP_TEXT_MAX) return bad("A note is too long on " + date);
      add.push({ date, start_time: st, end_time: et, role_override: ro, notes: no });
    }
    if (add.length > SHP_MAX_ADD_PER) return bad("At most 3,660 shifts can be applied at a time", { code: "split" });
    const ids = (x) => { const o = []; for (const v of (Array.isArray(x) ? x : [])) { const n = Number(v); if (!Number.isSafeInteger(n) || n < 1) return null; o.push(n); } return o; };
    const remove = ids(it.remove);
    if (!remove) return bad("remove[] must be shift ids");
    const seen = it.seen === undefined || it.seen === null ? null : ids(it.seen);
    if (it.seen !== undefined && it.seen !== null && !seen) return bad("seen[] must be shift ids");
    addTotal += add.length; removeTotal += remove.length;
    items.push({ staffId, from, to, add, remove: [...new Set(remove)], seen: seen ? new Set(seen) : null, fill: !!it.fill });
  }
  if (addTotal > SHP_MAX_ADD || removeTotal > SHP_MAX_REMOVE) return bad("Too many shifts for one step", { code: "split" });

  const org = authUser.org_id, loc = authUser.location_id;
  const staffIds = items.map((x) => x.staffId);
  const found = await dbAll(env, `SELECT id FROM shift_staff WHERE org_id=? AND location_id=? AND id IN (${staffIds.map(() => "?").join(",")})`, [org, loc, ...staffIds]);
  const have = new Set((found || []).map((r) => Number(r.id)));
  const missing = staffIds.filter((id) => !have.has(id));
  if (missing.length) return jsonResponse({ ok: false, error: "Staff not found", staff_ids: missing }, 404, corsOkHeaders);

  // The people's shifts in the whole span, once (the (org, location, shift_date) index bounds it).
  let lo = items[0].from, hi = items[0].to;
  for (const x of items) { if (x.from < lo) lo = x.from; if (x.to > hi) hi = x.to; }
  const rows = await dbAll(env,
    `SELECT id, staff_id, shift_date FROM shift_assignments WHERE org_id=? AND location_id=? AND shift_date>=? AND shift_date<=? AND staff_id IN (${staffIds.map(() => "?").join(",")})`,
    [org, loc, lo, hi, ...staffIds]);
  const changed = [];
  const plans = [];
  for (const x of items) {
    const mine = (rows || []).filter((r) => Number(r.staff_id) === x.staffId && r.shift_date >= x.from && r.shift_date <= x.to);
    const byId = new Map(mine.map((r) => [Number(r.id), r]));
    let ok = x.remove.every((id) => byId.has(id));
    if (ok && x.seen) ok = x.seen.size === byId.size && [...byId.keys()].every((id) => x.seen.has(id));
    if (!ok) { changed.push(x.staffId); continue; }
    const gone = new Set(x.remove);
    const taken = new Set(mine.filter((r) => !gone.has(Number(r.id))).map((r) => r.shift_date));
    const add = x.fill ? x.add.filter((a) => !taken.has(a.date)) : x.add;
    plans.push({ x, add, skipped: x.add.length - add.length });
  }
  if (changed.length) return jsonResponse({ ok: false, code: "changed", error: "Someone changed these shifts meanwhile. Nothing was saved.", staff_ids: changed }, 409, corsOkHeaders);

  const stmts = [];
  for (const p of plans) {
    for (let i = 0; i < p.x.remove.length; i += 900) {
      const chunk = p.x.remove.slice(i, i + 900);
      stmts.push({ stmt: env.DB.prepare(`DELETE FROM shift_assignments WHERE org_id=? AND location_id=? AND staff_id=? AND id IN (${chunk.join(",")})`).bind(org, loc, p.x.staffId), bytes: 64 });
    }
    for (const s of shpInsertStatements(env, [org, loc, p.x.staffId, authUser.user_id], p.add)) stmts.push(s);
  }
  if (stmts.length > SHP_MAX_STMTS) return bad("Too many shifts for one step", { code: "split" });
  if (stmts.length) {
    let bytes = 0; for (const s of stmts) bytes += s.bytes;
    if (bytes > WSAVE_BATCH_BYTES) return bad("Too many shifts for one step", { code: "split" });
    await env.DB.batch(stmts.map((s) => s.stmt)); // one transaction: all of it or none of it
  }
  const results = plans.map((p) => ({ staff_id: p.x.staffId, added: p.add.length, removed: p.x.remove.length, skipped: p.skipped }));
  for (const p of plans) {
    await writeAudit(env, org, authUser.user_id, "SHIFT_APPLY_PLAN", "shift_assignments", String(p.x.staffId),
      { from: p.x.from, to: p.x.to, added: p.add.length, removed: p.x.remove.length, removed_ids: p.x.remove.slice(0, 500), skipped: p.skipped }, loc);
  }
  return jsonResponse({ ok: true, results, added: results.reduce((n, r) => n + r.added, 0), removed: results.reduce((n, r) => n + r.removed, 0) }, 200, corsOkHeaders);
}

