  const supplierLocationId = Number(body.supplier_location_id);
  if (!supplierLocationId) return jsonResponse({ ok: false, error: "supplier_location_id is required" }, 400, corsOkHeaders);

  const items = Array.isArray(body.items) ? body.items : [];
  if (items.length === 0) return jsonResponse({ ok: false, error: "No items in order" }, 400, corsOkHeaders);

  // Get pharmacy location name
  const locRow = await dbFirst(env, "SELECT name FROM locations WHERE id = ?", [authUser.location_id]);
  const pharmacyName = locRow ? locRow.name : "";

  const order = await dbFirst(env,
    `INSERT INTO supplier_orders
     (org_id, pharmacy_location_id, supplier_location_id, supplier_name, pharmacy_name, status, notes, created_by, created_at, updated_at)
     VALUES (?,?,?,?,?,?,?,?,datetime('now'),datetime('now'))
     RETURNING id`,
    [
      authUser.org_id, authUser.location_id, supplierLocationId,
      String(body.supplier_name || "").trim(), pharmacyName,
      "pending", String(body.notes || "").trim(), authUser.user_id
    ]
  );

  for (const item of items) {
    await dbRun(env,
      `INSERT INTO supplier_order_items
       (order_id, product_id, description, barcode, stock_code, qty_requested, cost_excl_vat, vat_rate, retail_price, notes, batch, expiry_date, qty_free, discount_pct, discount_euro)
       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
      [
        order.id,
        item.product_id || null,
        String(item.description || "").trim(),
        String(item.barcode || "").trim(),
        String(item.stock_code || "").trim(),
        Math.max(1, Math.round(Number(item.qty_requested) || 1)),
        Math.max(0, Number(item.cost_excl_vat) || 0),
        normalizeVatRate(item.vat_rate),
        Math.max(0, Number(item.retail_price) || 0),
        String(item.notes || "").trim(),
        String(item.batch || "").trim(),
        String(item.expiry_date || "").trim(),
        Math.max(0, Math.round(Number(item.qty_free) || 0)),
        Math.max(0, Number(item.discount_pct) || 0),
        Math.max(0, Number(item.discount_euro) || 0)
      ]
    );
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "SUPPLIER_ORDER_CREATE", "supplier_orders", String(order.id), { items: items.length }, authUser.location_id);

  return jsonResponse({ ok: true, id: order.id }, 200, corsOkHeaders);
}

