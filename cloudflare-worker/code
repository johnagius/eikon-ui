  const aliases = await dbAll(env, "SELECT * FROM people WHERE id = ? AND org_id = ? AND location_id = ? UNION ALL SELECT * FROM people WHERE merged_into = ? AND org_id = ? AND location_id = ?", [person.id, org, loc, person.id, org, loc]);
