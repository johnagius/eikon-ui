          WHERE org_id = ? AND location_id = ? AND fulfilled = 1 AND substr(COALESCE(fulfilled_at, ''), 1, 10) >= ? AND ${inN("client_name")} ORDER BY fulfilled_at DESC LIMIT 10`, [org, loc, back14, ...names]),
    all(`SELECT id, ticket_id, issue, status, open_date, followup_date, resolved, resolved_at, notes_log, phone, email FROM client_tickets_entries
          WHERE org_id = ? AND location_id = ? AND ${inN("client_name")} AND (resolved = 0 AND status NOT IN ('Resolved', 'Closed') OR substr(COALESCE(resolved_at, ''), 1, 10) >= ?) ORDER BY open_date DESC LIMIT 20`, [org, loc, ...names, back14]),
    all(`SELECT id, delivery_id, items, status, scheduled_date, scheduled_time_slot, delivery_address, order_date FROM client_deliveries
          WHERE org_id = ? AND location_id = ? AND status IN ('Scheduled', 'Dispatched', 'Out for Delivery') AND ${inN("client_name")} ORDER BY COALESCE(NULLIF(scheduled_date, ''), order_date) ASC LIMIT 20`, [org, loc, ...names]),
    idKeys.length || names.length ? all(`SELECT id, entry_date, expires_date, client_name, client_id, medicine_name_dose, posology, collect_every_days, last_collected_date FROM repeat_prescription_entries
          WHERE org_id = ? AND location_id = ? AND expires_date >= ? AND (${inI("client_id")} OR ${inN("client_name")}) ORDER BY expires_date ASC, id ASC LIMIT 60`, [org, loc, today, ...idKeys, ...names]) : [],
    all(`SELECT b.id, b.ref, b.date, b.start_time, b.status, b.person_email, b.person_phone, s.name AS service FROM bk_bookings b LEFT JOIN bk_services s ON s.id = b.service_id
          WHERE b.org_id = ? AND b.location_id = ? AND b.date >= ? AND b.status IN ('booked', 'confirmed') AND (${inN("b.person_name")} OR ${inI("b.person_id_card")}) ORDER BY b.date ASC, b.start_time ASC LIMIT 10`, [org, loc, today, ...names, ...idKeys]),
    dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, person.id]),
    all(`SELECT * FROM cust_messages WHERE org_id = ? AND location_id = ? AND (person_id = ? OR (person_id = 0 AND ${inN("person_name")})) ORDER BY id DESC LIMIT 60`, [org, loc, person.id, ...names]),
    cmEmailState(env, org, loc),
    cmPharmacy(env, org, loc)
  ]);
  const optedOut = person.email ? await cmOptedOut(env, org, loc, person.email) : false;
  // The person's story across every register (as GET /people/:id gives it, with the names asked as above).
  const activity = [], counts = {};
  const per = await Promise.all(PEOPLE_SOURCES.map(async (src) => {
    const conds = [], bb = [org, loc];
    if (names.length) { conds.push(inN(src.name)); bb.push(...names); }
    if (src.id_card && idKeys.length) { conds.push(inI(src.id_card)); bb.push(...idKeys); }
    if (!conds.length) return null;
    try { return { src, rows: await dbAll(env, peopleSourceSelect(src) + " WHERE org_id = ? AND location_id = ? AND (" + conds.join(" OR ") + ") ORDER BY " + src.date + " DESC LIMIT 60", bb) }; } catch (e) { return null; }
  }));
  for (const got of per) {
