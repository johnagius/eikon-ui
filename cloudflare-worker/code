  dda_sale:         { table: "dda_sales_entries",           key: "id",         card: "client_id_card",  name: "client_name",  date: "entry_date",     label: "DDA sale",            title: "medicine_name_dose", ref: "prescription_serial_no" },
  poyc:             { table: "dda_poyc_entries",            key: "id",         card: "client_id_card",  name: "client_name",  date: "entry_date",     label: "POYC",                title: "medicine_name_dose", ref: "prescription_serial_no" },
  repeat:           { table: "repeat_prescription_entries", key: "id",         card: "client_id",       name: "client_name",  date: "entry_date",     label: "Repeat prescription", title: "medicine_name_dose" },
  poct:             { table: "poct_patients",               key: "patient_id", card: "patient_id",      name: "name",         date: "last_seen_iso",  label: "POCT" },
  loyalty:          { table: "loyalty_clients",             key: "id",         card: "id_card",         name: "name",         date: "created_at",     label: "Loyalty" },
  appointment:      { table: "appt_appointments",           key: "id",         card: "patient_id_card", name: "patient_name", date: "date",           label: "Appointment",         title: "notes", ref: "appt_ref" },
  waitlist:         { table: "appt_waitlist",               key: "id",         card: "patient_id_card", name: "patient_name", date: "added_date",     label: "Waiting list",        ref: "wl_ref" },
  calculator:       { table: "pharmacy_calc_patients",      key: "id",         card: "id_card",         name: "patient_name", date: "updated_at",     label: "Calculator" },
  booking:          { table: "bk_bookings",                 key: "id",         card: "person_id_card",  name: "person_name",  date: "date",           label: "Booking",             title: "notes", ref: "ref" },
  booking_waitlist: { table: "bk_waitlist",                 key: "id",         card: null,              name: "person_name",  date: "created_at",     label: "Bookings waiting list", title: "note" },
  vaccine:          { table: "vaccines_orders",             key: "id",         card: null,              name: "TRIM(client_first || ' ' || client_last)", date: "created_at", label: "Vaccine order", title: "country_name" },
  credit_note:      { table: "credit_notes",                key: "id",         card: null,              name: "TRIM(client_name || ' ' || client_surname)", date: "issue_date", label: "Credit note", title: "receipt_number" },
  contact:          { table: "contacts_clients",            key: "id",         card: "id_card",         name: "name",         date: "updated_at",     label: "Client contact" },
  screening:        { table: "screening_campaigns",         key: "campaign_id", json: true,                                   date: "updated_at",     label: "Screening" }
};
const PEOPLE_LINK_MAX = 50;
const PEOPLE_LINK_ROLES = ["admin", "staff"];

async function ensurePeopleLinksSchema__impl(env) {
  await dbRun(env, `CREATE TABLE IF NOT EXISTS people_links (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    link_group TEXT NOT NULL,
    source_kind TEXT NOT NULL,
    source_table TEXT NOT NULL,
    source_id TEXT NOT NULL,
    op_id TEXT NOT NULL DEFAULT '',
    moved_from INTEGER,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    created_by INTEGER,
    undone_at TEXT,
    undone_by INTEGER,
    undone_why TEXT)`, []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_people_links_group ON people_links (org_id, location_id, link_group)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_people_links_source ON people_links (org_id, location_id, source_table, source_id)", []);
  await dbRun(env, "CREATE INDEX IF NOT EXISTS idx_people_links_op ON people_links (org_id, location_id, op_id)", []);
  await dbRun(env, "CREATE UNIQUE INDEX IF NOT EXISTS uq_people_links_live ON people_links (org_id, location_id, source_table, source_id) WHERE undone_at IS NULL", []);
  await dbRun(env, `CREATE TABLE IF NOT EXISTS people_not_same (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    org_id INTEGER NOT NULL,
    location_id INTEGER NOT NULL,
    fingerprint TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    created_by INTEGER,
    undone_at TEXT,
    undone_by INTEGER,
    UNIQUE (org_id, location_id, fingerprint))`, []);
}
const ensurePeopleLinksSchema = schemaOnce("ensurePeopleLinksSchema", ensurePeopleLinksSchema__impl);

// Only something that can be an ID card tells people apart (modules.dupreg.js idKey): a digit, 4+ characters, not all zeros.
function peopleLinkCardKey(raw) {
  const n = normalizeMtIdCard(raw);
  if (n.length < 4 || !/\d/.test(n) || /^0+[A-Z]?$/.test(n)) return "";
  return n;
}

// One record in THIS pharmacy, or null. { kind, table, source_id, card, name, date, title, ref }.
async function peopleLinkRecord(env, org, loc, kind, rawId) {
  const d = PEOPLE_LINK_KINDS[kind];
  if (!d) return null;
  const sid = String(rawId == null ? "" : rawId).trim();
  if (!sid || sid.length > 200) return null;
  try {
    if (d.json) { // screening: "<campaign id>/<participant id>"
      const i = sid.lastIndexOf("/");
      if (i <= 0 || i === sid.length - 1) return null;
      const row = await dbFirst(env, "SELECT campaign_json, updated_at FROM screening_campaigns WHERE org_id = ? AND location_id = ? AND campaign_id = ?", [org, loc, sid.slice(0, i)]);
      if (!row) return null;
      let c = null; try { c = JSON.parse(String(row.campaign_json || "")); } catch (e) { c = null; }
      const p = c && Array.isArray(c.participants) ? c.participants.find((x) => x && String(x.id) === sid.slice(i + 1)) : null;
      if (!p) return null;
      return { kind, table: d.table, source_id: sid, card: String(p.idCard || ""), name: String(p.name || ""), date: String(p.date || row.updated_at || ""), title: String(c.name || ""), ref: "" };
    }
    if (d.key === "id" && !/^\d{1,15}$/.test(sid)) return null;
    const sel = "SELECT " + d.key + " AS k, " + (d.card ? d.card : "''") + " AS card, " + d.name + " AS name, " + d.date + " AS date, " + (d.title || "''") + " AS title, " + (d.ref || "''") + " AS ref FROM " + d.table +
      " WHERE org_id = ? AND location_id = ? AND " + d.key + " = ?";
    const r = await dbFirst(env, sel, [org, loc, d.key === "id" ? Number(sid) : sid]);
    if (!r) return null;
    return { kind, table: d.table, source_id: String(r.k), card: String(r.card || ""), name: String(r.name || ""), date: String(r.date || ""), title: String(r.title || ""), ref: String(r.ref || "") };
  } catch (e) { return null; } // table not created for this pharmacy
}

function peopleLinkRowOut(r) {
  return { id: r.id, link_group: r.link_group, kind: r.source_kind, source_id: r.source_id, created_at: r.created_at, created_by: r.created_by, undone_at: r.undone_at || null };
}
async function peopleLinksLive(env, org, loc, groups) {
  if (!groups.length) return [];
  return dbAllChunked(env, (ph) => "SELECT * FROM people_links WHERE org_id = ? AND location_id = ? AND undone_at IS NULL AND link_group IN (" + ph + ") ORDER BY id", groups, [org, loc]);
}
// Live links of the given (table, source_id) pairs.
async function peopleLinksOfSources(env, org, loc, pairs) {
  const byTable = {};
  for (const p of pairs) (byTable[p.table] = byTable[p.table] || new Set()).add(String(p.source_id));
  const out = [];
  for (const t of Object.keys(byTable)) {
    const ids = Array.from(byTable[t]);
    out.push(...await dbAllChunked(env, (ph) => "SELECT * FROM people_links WHERE org_id = ? AND location_id = ? AND undone_at IS NULL AND source_table = ? AND source_id IN (" + ph + ")", ids, [org, loc, t]));
  }
  return out;
}

// POST /people/links { records: [{ kind, id }, …] } — says these records are one person. Nothing else is written.
async function handlePeopleLinkCreate(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, PEOPLE_LINK_ROLES)) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  const body = (await readJson(request)) || {};
  const list = Array.isArray(body.records) ? body.records : [];
  if (list.length > PEOPLE_LINK_MAX) return jsonResponse({ ok: false, error: "Link at most " + PEOPLE_LINK_MAX + " records at a time" }, 400, corsOkHeaders);
  const want = [], seen = new Set();
  for (const x of list) {
    const kind = String((x && x.kind) || "");
    if (!Object.prototype.hasOwnProperty.call(PEOPLE_LINK_KINDS, kind)) return jsonResponse({ ok: false, error: "Unknown kind of record", kind: kind.slice(0, 40) }, 400, corsOkHeaders);
    const k = kind + ":" + String(x.id);
    if (!seen.has(k)) { seen.add(k); want.push({ kind, id: x.id }); }
  }
  if (want.length < 2) return jsonResponse({ ok: false, error: "Choose at least two records" }, 400, corsOkHeaders);
  await ensurePeopleLinksSchema(env);

  // 1. Every record exists in THIS pharmacy; any miss -> 404, nothing written.
  const recs = [];
  for (const w of want) {
    const r = await peopleLinkRecord(env, org, loc, w.kind, w.id);
    if (!r) return jsonResponse({ ok: false, error: "Record not found", kind: w.kind, id: String(w.id).slice(0, 60) }, 404, corsOkHeaders);
    recs.push(r);
  }
  // 2. The groups these records are already in, and every member of those groups.
  const already = await peopleLinksOfSources(env, org, loc, recs);
  const groups = Array.from(new Set(already.map((l) => l.link_group)));
  const members = await peopleLinksLive(env, org, loc, groups);
  // 3. Two different ID cards among the records and their groups' members -> 409, nothing written.
  const cards = new Set(recs.map((r) => peopleLinkCardKey(r.card)).filter(Boolean));
  const inReq = new Set(recs.map((r) => r.table + ":" + r.source_id));
  for (const m of members) {
    if (inReq.has(m.source_table + ":" + m.source_id)) continue;
    const r = await peopleLinkRecord(env, org, loc, m.source_kind, m.source_id);
    const c = r ? peopleLinkCardKey(r.card) : "";
    if (c) cards.add(c);
  }
  if (cards.size > 1) return jsonResponse({ ok: false, error: "These records have different ID cards, so they are not one person", id_cards: Array.from(cards) }, 409, corsOkHeaders);

  // 4. One group: the oldest of the groups already there, else a new one. Members of a younger group move into it
  // (their row goes out of force and a new row points back at it, so undoing this link puts them back).
  const firstId = {};
  for (const m of members) if (!(m.link_group in firstId) || m.id < firstId[m.link_group]) firstId[m.link_group] = m.id;
  const target = groups.length ? groups.slice().sort((a, b) => firstId[a] - firstId[b])[0] : "lg_" + crypto.randomUUID();
  const opId = "lop_" + crypto.randomUUID();
  const stmts = [];
  const ins = "INSERT INTO people_links (org_id, location_id, link_group, source_kind, source_table, source_id, op_id, moved_from, created_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT DO NOTHING";
  const moved = members.filter((m) => m.link_group !== target);
  for (const m of moved) {
    stmts.push(env.DB.prepare("UPDATE people_links SET undone_at = datetime('now'), undone_by = ?, undone_why = ? WHERE id = ? AND org_id = ? AND location_id = ? AND undone_at IS NULL").bind(authUser.user_id, "moved:" + opId, m.id, org, loc));
    stmts.push(env.DB.prepare(ins).bind(org, loc, target, m.source_kind, m.source_table, m.source_id, opId, m.id, authUser.user_id));
  }
  const live = new Set(members.filter((m) => m.link_group === target).map((m) => m.source_table + ":" + m.source_id));
  for (const m of moved) live.add(m.source_table + ":" + m.source_id);
  for (const r of recs) if (!live.has(r.table + ":" + r.source_id)) stmts.push(env.DB.prepare(ins).bind(org, loc, target, r.kind, r.table, r.source_id, opId, null, authUser.user_id));
  if (stmts.length) await env.DB.batch(stmts);
  const made = await dbAll(env, "SELECT * FROM people_links WHERE org_id = ? AND location_id = ? AND op_id = ? ORDER BY id", [org, loc, opId]);
  const all = await peopleLinksLive(env, org, loc, [target]);
  if (made.length) {
    await writeAudit(env, org, authUser.user_id, "PERSON_LINK", "people_links", target, auditWith({ location_id: loc, op_id: opId,
      records: recs.map((r) => ({ kind: r.kind, id: r.source_id })), moved_from_groups: Array.from(new Set(moved.map((m) => m.link_group))) },
      members.map(peopleLinkRowOut), made.map(peopleLinkRowOut)), loc);
  }
  return jsonResponse({ ok: true, link_group: target, link_ids: made.map((r) => r.id), already: !made.length, links: all.map(peopleLinkRowOut) }, 200, corsOkHeaders);
}

// POST /people/links/undo { link_ids: [...] } — those links go out of force; links this one moved come back.
async function handlePeopleLinkUndo(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, PEOPLE_LINK_ROLES)) return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  const org = authUser.org_id, loc = authUser.location_id;
  const body = (await readJson(request)) || {};
  const ids = Array.from(new Set((Array.isArray(body.link_ids) ? body.link_ids : []).map(Number).filter((n) => Number.isInteger(n) && n > 0)));
  if (!ids.length) return jsonResponse({ ok: false, error: "Nothing to undo" }, 400, corsOkHeaders);
  if (ids.length > 500) return jsonResponse({ ok: false, error: "Too many links at once" }, 400, corsOkHeaders);
  await ensurePeopleLinksSchema(env);
  const rows = await dbAllChunked(env, (ph) => "SELECT * FROM people_links WHERE org_id = ? AND location_id = ? AND id IN (" + ph + ") ORDER BY id", ids, [org, loc]);
  if (rows.length !== ids.length) return jsonResponse({ ok: false, error: "Link not found" }, 404, corsOkHeaders); // another pharmacy's, or none: nothing written
  const liveRows = rows.filter((r) => !r.undone_at);
  if (!liveRows.length) return jsonResponse({ ok: true, undone: 0, restored: 0, already: true }, 200, corsOkHeaders);
  const stmts = [];
  for (const r of liveRows) stmts.push(env.DB.prepare("UPDATE people_links SET undone_at = datetime('now'), undone_by = ?, undone_why = 'undo' WHERE id = ? AND org_id = ? AND location_id = ? AND undone_at IS NULL").bind(authUser.user_id, r.id, org, loc));
  // A link this one moved into its group comes back into force, if nothing else holds that record now.
  const back = liveRows.filter((r) => r.moved_from);
  for (const r of back) {
    stmts.push(env.DB.prepare("UPDATE people_links SET undone_at = NULL, undone_by = NULL, undone_why = NULL WHERE id = ? AND org_id = ? AND location_id = ? AND undone_why = ? AND NOT EXISTS (SELECT 1 FROM people_links x WHERE x.org_id = ? AND x.location_id = ? AND x.source_table = ? AND x.source_id = ? AND x.undone_at IS NULL)")
      .bind(r.moved_from, org, loc, "moved:" + r.op_id, org, loc, r.source_table, r.source_id));
  }
  await env.DB.batch(stmts);
  const after = await dbAllChunked(env, (ph) => "SELECT * FROM people_links WHERE org_id = ? AND location_id = ? AND id IN (" + ph + ") ORDER BY id", ids.concat(back.map((r) => r.moved_from)), [org, loc]);
  const restored = after.filter((r) => back.some((b) => b.moved_from === r.id) && !r.undone_at).length;
  await writeAudit(env, org, authUser.user_id, "PERSON_UNLINK", "people_links", liveRows[0].link_group, auditWith({ location_id: loc, link_ids: liveRows.map((r) => r.id), restored },
    liveRows.map(peopleLinkRowOut), after.map(peopleLinkRowOut)), loc);
  return jsonResponse({ ok: true, undone: liveRows.length, restored }, 200, corsOkHeaders);
}

// GET /people/links?group=  — the live links of one group (404 when this pharmacy has none);
// GET /people/links          — every live link of this pharmacy (for Possible duplicates).
