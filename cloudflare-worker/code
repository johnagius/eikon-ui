async function handleOwnerRecords(request, env, cors, authUser, url) {
  const sc = await ownerScope(env, authUser, url);
  if (sc.err) return jsonResponse({ ok: false, error: sc.err.error }, sc.err.status, cors);
  const today = tzYmd();
  const rg = ownerRange(url, today);
  if (rg.error) return jsonResponse({ ok: false, error: rg.error }, 400, cors);
  const kinds = String(url.searchParams.get("kinds") || url.searchParams.get("kind") || "").split(",").map((s) => s.trim()).filter(Boolean);
  if (!kinds.length || kinds.length > 12 || kinds.some((k) => !Object.prototype.hasOwnProperty.call(OWNER_KINDS, k))) return jsonResponse({ ok: false, error: "Choose what to show: " + Object.keys(OWNER_KINDS).join(", ") }, 400, cors);
  const ids = sc.locs.map((l) => l.id), names = {}; sc.locs.forEach((l) => { names[l.id] = l.name; });
  const records = {}, capped = {};
  await Promise.all(kinds.map(async (k) => {
    const K = OWNER_KINDS[k];
    let rows = [];
    try { rows = ids.length ? await dbAllChunked(env, K.sql, ids, [authUser.org_id], K.bind ? K.bind(rg, today) : [rg.from, rg.to]) : []; }
    catch (e) { if (!/no such table/i.test(String(e && e.message))) { records[k] = null; return; } rows = []; }
    if (K.day) rows = rows.filter((r) => { const d = ownerMaltaDay(r[K.day]); return d >= rg.from && d <= rg.to; });
    if (rows.length > OWNER_MAX_ROWS) { rows = rows.slice(0, OWNER_MAX_ROWS); capped[k] = OWNER_MAX_ROWS; }
    rows = rows.map((r) => {
      const o = K.map ? K.map(r) : Object.assign({}, r);
      o.location_id = Number(r.location_id); o.pharmacy = names[o.location_id] || "";
      if (sc.group && K.patient) K.patient.forEach((f) => { if (f in o) o[f] = ""; }); // head office: no patient details
      return o;
    });
    records[k] = rows;
  }));
  const failed = kinds.filter((k) => records[k] === null);
  return jsonResponse({ ok: true, today, from: rg.from, to: rg.to, group: sc.group, patient_details: !sc.group, records, capped, unread: failed }, 200, cors);
}

