// ── reset: wipe, then seed ─────────────────────────────────────────────────
// Tables never wiped: the accounts and places themselves, sign-in throttles, schema bookkeeping, the demo's own state,
// and the name-fix undo records (a superuser's all-groups run is stored under a group id).
const DEMO_KEEP = ["orgs", "locations", "users", "sessions", "login_attempts", "recover_attempts", "eikon_schema", "demo_state", "demo_signins", "name_case_runs", "name_case_undo", "sqlite_sequence"];
// Tables with no group or pharmacy column of their own: their rows go with their parent's (wiped before the parent).
const DEMO_CHILDREN = {
  supplier_order_items: ["order_id", "supplier_orders"],
  board_mentions: ["message_id", "board_messages"],
  board_suggestion_comments: ["suggestion_id", "board_suggestions"],
  board_user_state: ["user_id", "users:demo"]
};
function demoOwnerCols(cols) { return cols.filter((x) => /^(org_id|location_id)$/.test(x) || /_(org_id|location_id)$/.test(x)); }
// A row is the demo's when one of its owner columns names the demo group or a demo location, and none names anything
// else (empty and 0 count as "none": org-wide rows keep location 0). A row shared with a live group is never deleted.
function demoRowWhere(c, owners) {
  const set = (x) => /org_id$/.test(x) ? String(c.org) : c.locs.join(",");
  const any = owners.map((x) => `${x} IN (${set(x)})`).join(" OR ");
  const all = owners.map((x) => `(${x} IS NULL OR ${x} = 0 OR ${x} IN (${set(x)}))`).join(" AND ");
  return `(${any}) AND ${all}`;
}
function demoParseCols(sql) {
  const s = String(sql || ""), i = s.indexOf("("), j = s.lastIndexOf(")");
  if (i < 0 || j < i) return [];
  const body = s.slice(i + 1, j), out = [];
  let depth = 0, cur = "";
  for (const ch of body) { if (ch === "(") depth++; if (ch === ")") depth--; if (ch === "," && depth === 0) { out.push(cur); cur = ""; } else cur += ch; }
  out.push(cur);
  return out.map((d) => d.trim()).filter((d) => d && !/^(CONSTRAINT|PRIMARY|UNIQUE|FOREIGN|CHECK)\b/i.test(d))
    .map((d) => d.replace(/^["`\[]?([A-Za-z_][A-Za-z0-9_]*)["`\]]?.*$/s, "$1"));
}
async function demoWipePlan(env, c) {
  const rows = await dbAll(env, "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE '_cf_%' AND name NOT LIKE 'd1_%' ORDER BY name", []);
  const plan = [], skipped = [];
  for (const r of rows) {
    const t = String(r.name);
    if (DEMO_KEEP.includes(t) || !/^[A-Za-z_][A-Za-z0-9_]*$/.test(t)) continue;
    const owners = demoOwnerCols(demoParseCols(r.sql));
    if (owners.length) plan.push({ t, w: demoRowWhere(c, owners) });
    else if (DEMO_CHILDREN[t]) plan.unshift({ t, child: DEMO_CHILDREN[t] });
    else skipped.push(t);
  }
  return { plan, skipped };
}
async function demoWipeOne(env, c, step, tables) {
  if (step.child) {
    const [col, parent] = step.child;
    if (parent === "users:demo") {
      await dbRun(env, `DELETE FROM ${step.t} WHERE ${col} IN (SELECT id FROM users WHERE org_id = ? AND lower(email) IN (${DEMO_EMAILS.map(() => "?").join(",")}))`, [c.org, ...DEMO_EMAILS]);
      return;
    }
    const ps = tables.find((x) => x.t === parent);
    if (ps && ps.w) await dbRun(env, `DELETE FROM ${step.t} WHERE ${col} IN (SELECT id FROM ${parent} WHERE ${ps.w})`, []);
    return;
  }
  await dbRun(env, `DELETE FROM ${step.t} WHERE ${step.w}`, []);
}

