  await writeAudit(env, authUser.org_id, authUser.user_id, "PHARMACY_CALC_RECORD_CREATE", "pharmacy_calc_records", String(row ? row.id : ""), { calc_type: calcType, start_date: startDate, after: row ? await auditSnap(env, "pharmacy_calc_records", row.id, authUser) : null }, authUser.location_id);
