// ===================================================================================
// People, server side (BACKLOG2 item 12; PEOPLE-AUDIT §5.3, DUPES-DESIGN). Separate block:
// the code above calls into it only through one-line hooks, each marked "people links block".
//
//  (a) Small fixes
//    - PEOPLE_SOURCES gains five read-only sources (bookings, bookings waiting list, vaccine
//      orders, credit notes, client contacts): Customers search, the timeline and the backfill
//      see them. Nothing here writes to them. The ID card change keeps its own table list.
//    - POST /people without an ID card returns the one existing person with the same name and
//      the same phone digits or e-mail (existing: true), the rule the UI uses since .130.
//    - Loyalty: new writes store normalizeMtIdCard; a client already stored under the old
//      normaliser's spelling keeps that row. No existing row is changed.
//    - /contacts/clients/aggregated: one client per name + normalised ID card.
//  (b) Links (DUPES-DESIGN): "these records are one person", insert-only.
//    - people_links / people_not_same are new tables. No existing table is altered, updated or
//      deleted from; the only UPDATE is people_links.undone_at (and its own bookkeeping
//      columns) on rows this block inserted, and people_not_same.undone_at.
//    - Every read and write is org_id = ? AND location_id = ? of the caller.
//    - Table names come from PEOPLE_LINK_KINDS (an allow-list keyed by kind), never from a request.
// ===================================================================================

// (a) Read-only sources added to Customers search, the timeline and the backfill.
const PEOPLE_SOURCES_MORE = [
  { kind: "booking",          label: "Booking",               table: "bk_bookings",      name: "person_name", id_card: "person_id_card", phone: "person_phone", email: "person_email", date: "date",       title: "notes",       ref: "ref" },
  { kind: "booking_waitlist", label: "Bookings waiting list", table: "bk_waitlist",      name: "person_name",                            phone: "person_phone", email: "person_email", date: "created_at", title: "note" },
  { kind: "vaccine",          label: "Vaccine order",         table: "vaccines_orders",  name: "TRIM(client_first || ' ' || client_last)", phone: "phone",   email: "email",        date: "created_at", title: "country_name" },
  { kind: "credit_note",      label: "Credit note",           table: "credit_notes",     name: "TRIM(client_name || ' ' || client_surname)", phone: "telephone", email: "email",    date: "issue_date", title: "receipt_number" },
  { kind: "contact",          label: "Client contact",        table: "contacts_clients", name: "name",        id_card: "id_card",        phone: "phone",        alt_phone: "alt_phone", address: "address", date: "updated_at" }
];
for (const s of PEOPLE_SOURCES_MORE) if (!PEOPLE_SOURCES.some((x) => x.kind === s.kind)) PEOPLE_SOURCES.push(s);

// Phones compared on their digits, without Malta's +356 / 00356 (E.people.normPhone in the UI, line for line).
function peoplePhoneDigits(raw) {
  let d = String(raw == null ? "" : raw).replace(/\D+/g, "");
  if (d.length > 8 && d.indexOf("00356") === 0) d = d.slice(5);
  else if (d.length === 11 && d.indexOf("356") === 0) d = d.slice(3);
  return d;
}
function peopleNameKey(raw) { return String(raw || "").trim().replace(/\s+/g, " ").toLowerCase(); }

// (a) POST /people without an ID card: the one person with the same name and the same phone or e-mail, and no phone
// or e-mail that differs (the UI's find(), rules 2 and "conflicts"). Returns a Response, or null to insert as before.
async function peopleCreateNoCardExisting(env, authUser, clean, corsOkHeaders) {
  if (!clean || clean.id_card || !clean.name) return null;
  const org = authUser.org_id, loc = authUser.location_id;
  const k = peopleNameKey(clean.name);
  const rows = await dbAll(env, "SELECT * FROM people WHERE org_id = ? AND location_id = ? AND merged_into IS NULL AND (LOWER(name) = LOWER(?) OR name = ?) ORDER BY id LIMIT 50", [org, loc, clean.name, clean.name]);
  const wPhones = [peoplePhoneDigits(clean.phone), peoplePhoneDigits(clean.alt_phone)].filter(Boolean);
  const wEmail = String(clean.email || "").toLowerCase();
  if (!wPhones.length && !wEmail) return null;
  const sure = rows.map(peopleRowToPerson).filter((p) => {
    if (peopleNameKey(p.name) !== k) return false;
    const pp = [peoplePhoneDigits(p.phone), peoplePhoneDigits(p.alt_phone)].filter(Boolean);
    if (wPhones.length && pp.length && !wPhones.some((x) => pp.includes(x))) return false;     // a different phone: a namesake
    if (wEmail && p.email && String(p.email).toLowerCase() !== wEmail) return false;           // a different e-mail: a namesake
    return wPhones.some((x) => pp.includes(x)) || (!!wEmail && String(p.email || "").toLowerCase() === wEmail);
  });
  if (sure.length !== 1) return null; // nobody, or two possible people: insert as before (staff link or merge later)
  const target = sure[0];
  const fill = {};
  for (const f of PEOPLE_FIELDS) if (f !== "id_card" && f !== "name" && !target[f] && clean[f]) fill[f] = clean[f];
  if (!Object.keys(fill).length) return jsonResponse({ ok: true, person: target, created: false, existing: true, matched: "name+contact" }, 200, corsOkHeaders);
  const next = Object.assign({}, target, fill);
  const res = await dbRun(env, "UPDATE people SET phone = ?, alt_phone = ?, email = ?, address = ?, doctor_name = ?, date_of_birth = ?, notes = ?, version = version + 1, updated_at = datetime('now'), updated_by = ? WHERE id = ? AND org_id = ? AND location_id = ? AND version = ?",
    [next.phone, next.alt_phone, next.email, next.address, next.doctor_name, next.date_of_birth, next.notes, authUser.user_id, target.id, org, loc, target.version]);
  const after = await peopleLoad(env, org, loc, target.id);
  if (res && res.meta && !res.meta.changes) return jsonResponse({ ok: true, person: after, created: false, existing: true, matched: "name+contact" }, 200, corsOkHeaders);
  await writeAudit(env, org, authUser.user_id, "PERSON_UPDATE", "people", String(target.id), { location_id: loc, before: target, after, filled: Object.keys(fill), matched: "name+contact" });
  return jsonResponse({ ok: true, person: after, created: false, existing: true, matched: "name+contact" }, 200, corsOkHeaders);
}

// (a) Loyalty: the card a NEW write stores. normalizeMtIdCard, unless this client is already stored under the old
// normaliser's spelling (normMtIdCard: digits-only padded, inner spaces kept), in which case that row is used.
async function loyaltyIdCardForWrite(env, authUser, rawCard) {
  const raw = String(rawCard || "").trim();
  const next = normalizeMtIdCard(raw) || raw;
  const old = normMtIdCard(raw) || raw;
  if (!old || old === next) return next;
  try {
    const rows = await dbAll(env, "SELECT id_card FROM loyalty_clients WHERE org_id = ? AND location_id = ? AND id_card IN (?, ?)", [authUser.org_id, authUser.location_id, next, old]);
    if (!rows.some((r) => r.id_card === next) && rows.some((r) => r.id_card === old)) return old;
  } catch (e) { /* loyalty not set up: the new spelling */ }
  return next;
}

// (a) /contacts/clients/aggregated: one client per name + normalised ID card ("123456 m" = "0123456M").
function contactsAggregatedKey(name, idCard) { return String(name || "").trim().toLowerCase() + "|" + normalizeMtIdCard(idCard).toLowerCase(); }

