// The names a person's records may carry: their own and merged-in names, each also with its two words turned round
// ("Zammit Carmel" / "Carmel Zammit"), lower case; and their ID card keys.
async function cmNamesOf(env, org, loc, person) {
  const aliases = await dbAll(env, "SELECT name, id_card FROM people WHERE id = ? AND org_id = ? AND location_id = ? UNION ALL SELECT name, id_card FROM people WHERE merged_into = ? AND org_id = ? AND location_id = ?", [person.id, org, loc, person.id, org, loc]);
  // SQLite's LOWER() knows only A to Z: LOWER('Micallef Ċettina') is 'micallef Ċettina'. Each name is asked both as
  // JavaScript lower-cases it and as SQLite does, so a name with Ċ, Ġ, Ħ or Ż as a capital is found (GET /people/:id
  // misses those: its Story and counts come back empty; written up for John, that route is not changed here).
  const names = new Set();
  const asciiLower = (x) => x.replace(/[A-Z]/g, (c) => c.toLowerCase());
  for (const a of aliases) {
    const n0 = String(a.name || "").trim().replace(/\s+/g, " "); if (!n0) continue;
    const w0 = n0.split(" "), forms = [n0]; if (w0.length === 2) forms.push(w0[1] + " " + w0[0]);
    for (const f of forms) { names.add(f.toLowerCase()); names.add(asciiLower(f)); }
  }
  const idKeys = Array.from(new Set(aliases.flatMap((a) => mtIdCardLookupKeys(a.id_card)).filter(Boolean)));
  return { names: Array.from(names), idKeys };
}

