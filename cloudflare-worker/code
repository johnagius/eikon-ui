async function handlePvStatePut(request, env, corsOkHeaders, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) {
    return jsonResponse({ ok: false, error: "Forbidden" }, 403, corsOkHeaders);
  }
  await ensurePvSchema(env);
  const body = await readJson(request);
  const st = body && (body.state || body.data) ? (body.state || body.data) : body;
  const reportsIn = st && st.reports ? st.reports : [];
  const reports = Array.isArray(reportsIn) ? reportsIn : [];
  const orgId = authUser.org_id;
  const locId = authUser.location_id;
  const userId = authUser.user_id;

  const idSet = new Set();
  const cleaned = [];
  for (const r of reports) {
    const rid = r && r.id ? String(r.id).trim() : "";
    if (!rid) continue;
    if (!idSet.has(rid)) { idSet.add(rid); cleaned.push(r); }
  }

  // Upsert the new or changed reports only, many per statement (wsaveJsonDocs)
  const pvWritten = await wsaveJsonDocs(env, "pv_reports", "report_id", "report_json", orgId, locId, userId, cleaned);

  // Deletes are explicit (deleted_ids); a payload that lacks a report never removes it.
  const pvDeleted = poctExplicitIds(st && (st.deleted_ids || st.deletedIds));
  const pvRemoved = await wsaveDeleteIds(env, "pv_reports", "report_id", orgId, locId, pvDeleted);

  await writeAudit(env, orgId, userId, "PV_STATE_PUT", "pv_reports", "", { count: cleaned.length, written: pvWritten, deleted: pvRemoved, deleted_ids: pvDeleted }, authUser.location_id);
  return jsonResponse({ ok: true, saved: cleaned.length, written: pvWritten }, 200, corsOkHeaders);
}

