// POST /messages { person_id?, name?, channel, purpose, ref_kind?, ref_id?, to, subject?, body, client_key? }
async function handleCustMsgSend(request, env, cors, authUser) {
  if (!requireRole(authUser, ["admin", "staff"])) return jsonResponse({ ok: false, error: "Forbidden" }, 403, cors);
  const org = authUser.org_id, loc = authUser.location_id;
  await ensurePeopleSchema(env); await ensureCustMsgSchema(env);
  const b = (await readJson(request)) || {};
  const channel = String(b.channel || "").toLowerCase();
  if (!CM_CHANNELS.includes(channel)) return jsonResponse({ ok: false, error: "Choose WhatsApp, SMS or e-mail" }, 400, cors);
  const purpose = CM_PURPOSES.includes(String(b.purpose || "")) ? String(b.purpose) : "other";
  const text = String(b.body || "").replace(/\r\n/g, "\n").trim();
  if (!text) return jsonResponse({ ok: false, error: "Write the message" }, 400, cors);
  if (text.length > 2000) return jsonResponse({ ok: false, error: "The message is too long (2,000 letters at most)" }, 400, cors);
  const key = String(b.client_key || "").slice(0, 64);
  if (key) { const dup = await dbFirst(env, `SELECT * FROM cust_messages WHERE org_id=? AND location_id=? AND client_key=?`, [org, loc, key]); if (dup) return jsonResponse({ ok: dup.status !== "failed", repeat: true, message: cmMsgOut(dup), error: dup.status === "failed" ? dup.error : undefined }, dup.status === "failed" ? 502 : 200, cors); }
  let pid = Number(b.person_id || 0) || 0, person = null;
  if (pid) { person = await peopleLoad(env, org, loc, pid); if (!person) return jsonResponse({ ok: false, error: "Not found" }, 404, cors); if (person.merged_into) { const t = await peopleLoad(env, org, loc, person.merged_into); if (t) person = t; } pid = person.id; }
  const name = String((person && person.name) || b.name || "").trim().slice(0, 120);
  let to = String(b.to || "").trim();
  if (channel === "email") { to = to.toLowerCase(); if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to)) return jsonResponse({ ok: false, error: "Write their e-mail address" }, 400, cors); }
  else { to = to.replace(/[^\d+]/g, ""); if (to.replace(/\D/g, "").length < 8) return jsonResponse({ ok: false, error: "Write their mobile number" }, 400, cors); }
  if (pid) {
    const pr = cmProfileOut(await dbFirst(env, `SELECT * FROM cust_profile WHERE org_id = ? AND location_id = ? AND person_id = ?`, [org, loc, pid]));
    const said = { email: pr.email_ok, sms: pr.sms_ok, whatsapp: pr.whatsapp_ok }[channel];
    if (said === false) return jsonResponse({ ok: false, error: name + " asked not to get " + ({ email: "e-mails", sms: "text messages", whatsapp: "WhatsApp messages" })[channel] + ".", refused: "consent" }, 409, cors);
  }
  if (channel === "email" && await cmOptedOut(env, org, loc, to)) return jsonResponse({ ok: false, error: "This address stopped e-mails from the pharmacy.", refused: "opted-out" }, 409, cors);
  const subject = String(b.subject || "").trim().slice(0, 150);
  const refKind = String(b.ref_kind || "").slice(0, 20), refId = Math.max(0, Number(b.ref_id) || 0);
  const by = String((authUser.full_name || authUser.email || "")).slice(0, 80);
  let row;
  try {
    row = await dbFirst(env, `INSERT INTO cust_messages (org_id, location_id, person_id, person_name, channel, purpose, ref_kind, ref_id, to_addr, subject, body, status, client_key, created_by, created_by_name)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) RETURNING id`, [org, loc, pid, name, channel, purpose, refKind, refId, to, subject, text, channel === "email" ? "sending" : "device", key, authUser.user_id, by]);
  } catch (e) { const dup = key ? await dbFirst(env, `SELECT * FROM cust_messages WHERE org_id=? AND location_id=? AND client_key=?`, [org, loc, key]) : null; if (dup) return jsonResponse({ ok: true, repeat: true, message: cmMsgOut(dup) }, 200, cors); throw e; }
  const id = row.id;
  let status = channel === "email" ? "sent" : "device", error = "", sender = "";
  if (channel === "email") {
    const st = await cmEmailState(env, org, loc);
    if (!st.ready) { status = "failed"; error = st.why; }
    else {
      try {
        const s = await bkGetSettings(env, org, loc);
        const ph = await cmPharmacy(env, org, loc);
        const base = bkBaseUrl(env, request), tok = await cmStopToken(env, id);
        const html = cmEmailHtml({ lines: text.split("\n"), pharmacy: ph.name || "Your pharmacy", address: s.address, phone: s.phone, stop: tok && base ? `${base}/m/${tok}/stop` : "" });
        const r = await bkSendEmail(env, s, { to, toName: name, subject: subject || ("A message from " + (ph.name || "your pharmacy")), html, ics: null });
        sender = (r && r.sender) || "";
      } catch (e) { status = "failed"; error = String(e && e.message || e).slice(0, 300); }
    }
  }
  await dbRun(env, `UPDATE cust_messages SET status=?, error=?, sender=? WHERE id=?`, [status, error, sender, id]);
  const out = cmMsgOut(await dbFirst(env, `SELECT * FROM cust_messages WHERE id=?`, [id]));
  await writeAudit(env, org, authUser.user_id, "CUST_MESSAGE", "cust_messages", String(id), { location_id: loc, person_id: pid, channel, purpose, ref_kind: refKind, ref_id: refId, to, status, error: error || undefined }, loc);
  if (status === "failed") return jsonResponse({ ok: false, error: "Not sent: " + error, message: out }, 502, cors);
  return jsonResponse({ ok: true, message: out }, 200, cors);
}

// GET|POST /m/<token>/stop — public
async function handleCustMsgLink(request, env, url) {
  await ensureCustMsgSchema(env);
  const m = /^\/m\/([0-9a-z]{1,10})\.([A-Za-z0-9_-]{43})\/stop$/.exec(url.pathname);
