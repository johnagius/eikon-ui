async function handleEodContactsBulkSave(contacts, env, corsOkHeaders, authUser) {
  // Bulk save: deactivate all existing, then upsert each contact from the UI list
  await ensureEndOfDaySchema(env);
  if (contacts.length > BIMP_EOD_CONTACTS_MAX) return jsonResponse({ ok: false, error: "At most 1,000 contacts can be saved at once" }, 400, corsOkHeaders);

  // One entry per name (display_name is unique per pharmacy), in first-seen order, with the last copy's phone and
  // email: what the old row-by-row insert-then-update left stored.
  const names = [], latest = new Map();
  for (const c of contacts) {
    const name = String(c.display_name || c.name || "").trim();
    const phone = String(c.phone || "").trim();
    const email = String(c.email || "").trim();
    if (!name) continue;
    names.push(name);
    latest.set(name, [phone, email]);
  }
  const idsByName = async () => {
    const m = new Map();
    for (const r of await dbAll(env, "SELECT id, display_name FROM end_of_day_contacts WHERE org_id = ? AND location_id = ? ORDER BY id", [authUser.org_id, authUser.location_id])) if (!m.has(r.display_name)) m.set(r.display_name, r.id);
    return m;
  };
  const stored = await idsByName();

  // Mark all existing contacts inactive
  await dbRun(env, "UPDATE end_of_day_contacts SET is_active = 0, updated_at = datetime('now'), updated_by = ? WHERE org_id = ? AND location_id = ?", [authUser.user_id, authUser.org_id, authUser.location_id]);

  // Re-activate existing ones by name, insert new ones: many rows per statement.
  const upd = [], ins = [];
  for (const [name, [phone, email]] of latest) {
    if (stored.has(name)) upd.push([stored.get(name), phone, email, authUser.user_id]);
    else ins.push([authUser.org_id, authUser.location_id, name, phone, email, null, null, null, authUser.user_id, authUser.user_id]);
  }
  await wsaveRun(env, wsaveStatements(env,
    "UPDATE end_of_day_contacts SET phone = v.column2, email = v.column3, is_active = 1, updated_at = datetime('now'), updated_by = v.column4 FROM (VALUES ",
    ["?", "?", "?", "?"], ") AS v WHERE end_of_day_contacts.id = v.column1", upd).concat(wsaveStatements(env,
    "INSERT INTO end_of_day_contacts (org_id, location_id, display_name, phone, email, is_active, created_at, updated_at, created_by, updated_by) VALUES ",
    ["?", "?", "?", "?", "?", "1", "datetime('now')", "datetime('now')", "?", "?"], "", ins)));
  const idOf = ins.length ? await idsByName() : stored;
  const ids = names.map((n) => idOf.get(n));

  await writeAudit(env, authUser.org_id, authUser.user_id, "EOD_CONTACTS_BULK_SAVE", "end_of_day_contacts", "", { count: ids.length }, authUser.location_id);
  return jsonResponse({ ok: true, ids: ids }, 200, corsOkHeaders);
}

