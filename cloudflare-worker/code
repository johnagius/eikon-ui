      computed.cost_excl_vat, computed.cost_incl_vat,
      computed.discount_pct, computed.discount_euro, computed.total_incl_vat,
      computed.retail_price, computed.profit, computed.profit_margin,
      quoteDate, String(body.notes !== undefined ? (body.notes ?? "") : (existing.notes ?? "")).trim(),
      authUser.org_id, entryId
    ]
  );

  await writeAudit(env, authUser.org_id, authUser.user_id, "QUOTATION_UPDATE", "quotation_entries", String(entryId), auditWith({ item_description: itemDescription, quote_date: quoteDate }, __before, await auditSnap(env, "quotation_entries", entryId, authUser, { group: true })), authUser.location_id);

