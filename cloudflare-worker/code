async function handleOrderDiaryCarryOver(request, env, corsOkHeaders, authUser) {
  await ensureOrderDiarySchema(env);
  const body = await readJson(request);
  const from_date = String(body.from_date || "").trim();
  const to_date   = String(body.to_date   || "").trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(from_date)) return jsonResponse({ ok: false, error: "Invalid from_date" }, 400, corsOkHeaders);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(to_date))   return jsonResponse({ ok: false, error: "Invalid to_date" }, 400, corsOkHeaders);
  if (to_date <= from_date) return jsonResponse({ ok: false, error: "to_date must be after from_date" }, 400, corsOkHeaders);

  const outstanding = await dbAll(env,
    `SELECT * FROM order_diary_entries
     WHERE org_id = ? AND location_id = ? AND order_date = ? AND status IN ('pending','not_received','wrong_pick')`,
    [authUser.org_id, authUser.location_id, from_date]
  );
  if (!outstanding || outstanding.length === 0) {
    return jsonResponse({ ok: true, carried: 0, message: "No outstanding items to carry over" }, 200, corsOkHeaders);
  }

  let carried = 0;
  for (const entry of outstanding) {
    const existing = await dbFirst(env,
      `SELECT id FROM order_diary_entries
       WHERE org_id=? AND location_id=? AND order_date=? AND item_name=? AND supplier=?`,
      [authUser.org_id, authUser.location_id, to_date, entry.item_name, entry.supplier]
    );
    if (existing) continue; // already exists for target date, skip duplicate
    await dbRun(env,
      `INSERT INTO order_diary_entries
         (org_id, location_id, order_date, item_name, qty, supplier, status, notes, carried_from_id, created_by, created_at, updated_at)
       VALUES (?,?,?,?,?,?,'pending',?,?,?,datetime('now'),datetime('now'))`,
      [authUser.org_id, authUser.location_id, to_date, entry.item_name, entry.qty,
       entry.supplier, entry.notes || "", entry.id, authUser.user_id]
    );
    carried++;
  }

  await writeAudit(env, authUser.org_id, authUser.user_id, "ORDER_DIARY_CARRY_OVER", "order_diary_entries", from_date, { from_date, to_date, carried }, authUser.location_id);
  return jsonResponse({ ok: true, carried, to_date }, 200, corsOkHeaders);
}

