  return `<!doctype html><html><body style="margin:0;background:#F2F2F7;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#000">
<div style="max-width:480px;margin:0 auto;padding:28px 18px">
<div style="background:#fff;border-radius:20px;padding:24px 22px">
<div style="font-size:22px;font-weight:700;margin-bottom:12px">${e(title)}</div>
${lines.map((l) => `<div style="font-size:16px;line-height:23px;margin:4px 0">${e(l)}</div>`).join("")}
${link ? `<a href="${e(link)}" style="display:inline-block;margin-top:18px;background:#066B4F;color:#fff;text-decoration:none;font-weight:600;padding:12px 20px;border-radius:22px">${e(linkText || "See or change your booking")}</a>` : ""}
</div>
<div style="font-size:13px;line-height:19px;color:#6b6b70;text-align:center;margin-top:16px">${e(pharmacy)}${address ? " · " + e(address) : ""}${phone ? " · " + e(phone) : ""}<br>
${optout ? `<a href="${e(optout)}" style="color:#6b6b70">Stop booking emails</a>` : ""}</div></div></body></html>`;
