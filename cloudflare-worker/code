// Helper: if full_name looks like an email, derive a readable name from the local part
function cleanMentionName(fullName) {
  if (!fullName) return "";
  const s = String(fullName).trim();
  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s)) {
    const local = s.split("@")[0];
    return local.replace(/[._\-]+/g, " ").replace(/\b\w/g, c => c.toUpperCase());
  }
  return s;
}

