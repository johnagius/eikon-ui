      FROM client_orders_entries WHERE org_id = ? AND location_id IN (${ph}) GROUP BY location_id`, ids, [from, to, today, ymdPlusDays(today, -30), org], [])
    .catch((e) => { if (!/no such table/i.test(String(e && e.message))) unread.orders = true; return []; }) : Promise.resolve([]);

  const R = {};
  for (const k of Object.keys(P)) R[k] = await P[k];
  const inR = (d, a, b) => !!d && d >= a && d <= b;
  const out = sc.locs.map((l) => {
    const id = l.id, mine = (rows) => rows.filter((r) => Number(r.location_id) === id);
    // Money: the end-of-day days, the paid-out register, credit notes, locums
    const eodAll = mine(R.eod).map(ownerEodFigures);
    const days = eodAll.filter((d) => inR(d.date, from, to)).sort((a, b) => (a.date < b.date ? -1 : 1));
    const sumOf = (list, k) => ownerR2(list.reduce((t, d) => t + (Number(d[k]) || 0), 0));
    const poRows = mine(R.po);
    const poIn = (a, b) => poRows.filter((r) => inR(r.entry_date, a, b));
    const moneyOf = (a, b, list) => {
      const ou = list.filter((d) => d.over_under != null);
      return { takings: sumOf(list, "takings"), epos: sumOf(list, "epos"), cheques: sumOf(list, "cheques"), cash: sumOf(list, "cash"), till_paid_outs: sumOf(list, "paid_outs"),
        paid_outs: ownerR2(poIn(a, b).reduce((t, r) => t + Number(r.total || 0), 0)), paid_out_lines: poIn(a, b).reduce((t, r) => t + Number(r.n || 0), 0),
        over_under: sumOf(ou, "over_under"), short_days: ou.filter((d) => d.over_under < -0.005).length, over_days: ou.filter((d) => d.over_under > 0.005).length,
